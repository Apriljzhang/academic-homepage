---
import { grants } from '../data/cv';
---

<div class="mt-6 space-y-6">
  {
    grants.map((g) => (
      <div class="border-l-2 border-primary/25 pl-5">
        <p class="type-card-title text-pretty">{g.title}</p>
        <p class="type-meta mt-2">{g.role} · {g.years}</p>
        <p class="type-meta mt-1">{g.institution}</p>
      </div>
    ))
  }
</div>
