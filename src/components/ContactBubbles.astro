---
import { contact } from '../data/contact';
import { academicIds } from '../data/profiles';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

/** w-full min-w-0 lets grid columns shrink so text wraps instead of overflowing */
const bubbleClass =
  'flex min-h-11 w-full min-w-0 items-center justify-center whitespace-nowrap rounded-md border border-border bg-surface px-3 py-2 text-center text-sm font-semibold text-primary no-underline transition-colors duration-[var(--dur-micro)] ease-[var(--ease-out)] hover:bg-neutral-hover hover:text-ink focus-visible:outline-offset-2';

const mailBubbleClass = `${bubbleClass} gap-2`;

const mailIconClass = 'h-3.5 w-3.5 shrink-0 text-primary';

/** Mail links span two columns on large screens so every label remains a single-line affordance. */
const institutionalBubbleClass = `${mailBubbleClass} lg:col-span-2 lg:h-full lg:min-h-0 lg:justify-center`;
---

<div
  class:list={[
    'grid items-stretch gap-2 sm:grid-cols-2 lg:grid-cols-4',
    className,
  ]}
>
  <a class={institutionalBubbleClass} href={`mailto:${contact.cityu}`} title={contact.cityu}>
    <svg class={mailIconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
      <polyline points="22,6 12,13 2,6" />
    </svg>
    <span>CityU email</span>
  </a>

  <a class:list={[mailBubbleClass, 'lg:col-span-2']} href={`mailto:${contact.gmail}`} title={contact.gmail}>
    <svg class={mailIconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
      <polyline points="22,6 12,13 2,6" />
    </svg>
    <span>Gmail</span>
  </a>

  <a href={academicIds.cityuProfile.href} target="_blank" rel="noopener noreferrer" class={bubbleClass}>
    CityU Macau
  </a>
  <a href={academicIds.researchGate.href} target="_blank" rel="noopener noreferrer" class={bubbleClass}>
    ResearchGate
  </a>
  <a href="https://github.com/Apriljzhang" target="_blank" rel="noopener noreferrer" class={bubbleClass}>
    GitHub
  </a>
  <a href={academicIds.webOfScience.href} target="_blank" rel="noopener noreferrer" class={bubbleClass}>
    Web of Science
  </a>

  <a class:list={[mailBubbleClass, 'lg:col-span-2']} href={`mailto:${contact.outlook}`} title={contact.outlook}>
    <svg class={mailIconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
      <polyline points="22,6 12,13 2,6" />
    </svg>
    <span>Outlook</span>
  </a>
  <a href={academicIds.googleScholar.href} target="_blank" rel="noopener noreferrer" class={bubbleClass}>
    Google Scholar
  </a>
  <a href="https://www.linkedin.com/in/april-jiawei-zhang-485813110/" target="_blank" rel="noopener noreferrer" class={bubbleClass}>
    LinkedIn
  </a>
  <a href={academicIds.orcid.href} target="_blank" rel="noopener noreferrer" class={bubbleClass}>
    ORCID
  </a>
  <a href={academicIds.scopus.href} target="_blank" rel="noopener noreferrer" class={bubbleClass}>
    Scopus
  </a>
</div>
