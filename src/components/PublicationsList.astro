---
import { publications } from '../data/cv';
import { withBase } from '../utils/paths';
---

<div class="mt-6 space-y-6">
  {
    publications.map((item) => (
      <div class="border-l-2 border-primary/25 pl-5">
        <p
          class="text-pretty text-lg leading-relaxed text-ink/95 [&_em]:font-serif [&_em]:italic [&_em]:text-primary"
          set:html={item.citationHtml}
        />
        <div class="mt-3 flex flex-wrap items-center gap-3">
          {item.pdfPath ? (
            <a
              href={withBase(item.pdfPath)}
              download
              class="inline-flex items-center rounded-full bg-primary px-4 py-2 text-sm font-semibold text-white no-underline hover:opacity-95"
            >
              Download PDF
            </a>
          ) : null}
          {item.doiUrl ? (
            <a
              href={item.doiUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="break-all text-base font-medium text-primary no-underline hover:underline"
            >
              {item.doiUrl}
            </a>
          ) : null}
        </div>
      </div>
    ))
  }
</div>
