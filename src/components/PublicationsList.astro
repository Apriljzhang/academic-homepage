---
import { publications } from '../data/cv';
import { withBase } from '../utils/paths';
---

<div class="mt-6 space-y-5">
  {
    publications.map((item) => (
      <div class="flex items-start gap-3">
        <p
          class="min-w-0 flex-1 pl-8 -indent-8 text-pretty text-base leading-relaxed text-ink/95 [&_em]:italic [&_a]:font-medium [&_a]:text-primary [&_a]:no-underline hover:[&_a]:underline"
          set:html={item.citationHtml}
        />
        {item.pdfPath ? (
          <a
            href={withBase(item.pdfPath)}
            download
            class="mt-0.5 shrink-0 rounded border border-border px-1.5 py-0.5 text-[11px] font-medium uppercase tracking-wide text-muted no-underline hover:border-primary/40 hover:text-primary"
            aria-label="Download PDF"
          >
            PDF
          </a>
        ) : null}
      </div>
    ))
  }
</div>
