---
interface Props {
  class?: string;
  /** Decorative colour bar (inner pages). */
  accentBar?: boolean;
}

const { accentBar = false } = Astro.props;
---

<div
  class:list={[
    'page-shell mx-auto w-full max-w-[96rem] px-5 py-7 sm:px-8 sm:py-9 md:px-12 lg:px-16 xl:px-20 2xl:px-24',
    Astro.props.class,
  ]}
>
  {
    accentBar ? (
      <div class="mb-4" aria-hidden="true">
        <span class="block h-1.5 w-16 rounded-full bg-strip-1" />
      </div>
    ) : null
  }
  <slot />
</div>
