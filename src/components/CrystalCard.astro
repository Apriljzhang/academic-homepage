---
interface Props {
  as?: 'div' | 'li' | 'a';
  href?: string;
  class?: string;
  padding?: 'sm' | 'md' | 'lg';
  hoverLift?: boolean;
}

const { as = 'div', href, class: className, padding = 'md', hoverLift = false } = Astro.props;

const base =
  'rounded-lg border border-border bg-surface text-ink';

const pad =
  padding === 'sm' ? 'p-3.5' : padding === 'lg' ? 'p-5' : 'p-4';

const hover = hoverLift
  ? 'transition-transform duration-[var(--dur-short)] ease-[var(--ease-out)] hover:-translate-y-px active:translate-y-0'
  : '';
---

{as === 'a' ? (
  <a href={href} class:list={[base, pad, hover, className]}>
    <slot />
  </a>
) : as === 'li' ? (
  <li class:list={[base, pad, hover, className]}>
    <slot />
  </li>
) : (
  <div class:list={[base, pad, hover, className]}>
    <slot />
  </div>
)}
