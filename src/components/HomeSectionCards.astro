---
import { homeSectionCards } from '../data/cv';
import { withBase } from '../utils/paths';
import CrystalCard from './CrystalCard.astro';
---

<section
  class="w-full border-t border-main/20 bg-main/8 px-5 py-10 sm:px-8 md:px-12 lg:px-16 lg:py-12 xl:px-20 2xl:px-24"
  aria-labelledby="explore-heading"
>
  <h2 id="explore-heading" class="font-serif text-2xl font-semibold text-ink sm:text-3xl">Explore</h2>

  <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3 lg:gap-5">
    {
      homeSectionCards.map((card) => (
          <CrystalCard
            as="a"
            href={withBase(`/${card.slug}`)}
            hoverLift
            padding="lg"
            class:list={[
              'group relative flex min-h-[180px] flex-col overflow-hidden ring-2 ring-transparent',
              'hover:ring-2 hover:ring-main/30',
            ]}
          >
            <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-main">
              <span class="h-2 w-2 shrink-0 bg-accent-purple" aria-hidden="true" />
              {card.kicker}
            </p>
            <h3 class="mt-2 font-serif text-2xl font-semibold text-ink group-hover:text-primary">
              {card.title}
            </h3>
            <p class="mt-3 flex-1 text-pretty text-sm leading-relaxed text-muted">{card.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary group-hover:text-main">
              Open section
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </CrystalCard>
        ))
    }
  </div>
</section>
