---
import { professionalMemberships } from '../data/cv';
import CrystalCard from './CrystalCard.astro';

interface Props {
  /** Extra classes on outer section (e.g. aside spacing vs main column). */
  class?: string;
  /** aside: sidebar stack; inline: under cards; page: dedicated subpage (no duplicate h1). */
  variant?: 'aside' | 'inline' | 'page';
}

const { class: className, variant = 'aside' } = Astro.props;

const sectionClass =
  variant === 'aside'
    ? 'scroll-mt-24 mt-8 border-t border-border pt-8'
    : variant === 'inline'
      ? 'scroll-mt-28 mt-12 border-t border-border/50 pt-10'
      : 'mt-0 scroll-mt-24';
---

<section
  id="memberships"
  class:list={[sectionClass, className]}
  aria-labelledby="memberships-heading"
>
  {
    variant !== 'page' ? (
      <h2 id="memberships-heading" class="font-serif text-xl font-semibold text-ink sm:text-2xl">
        Scholarly communities
      </h2>
    ) : null
  }
  <p class:list={['max-w-3xl text-sm leading-relaxed text-muted', variant === 'page' ? 'mt-4' : 'mt-3']}>
    Membership of learned societies and language-assessment networks connects my work to wider academic communities.
  </p>
  <ul
    class:list={[
      'grid gap-3 sm:grid-cols-2 xl:grid-cols-3',
      variant === 'page' ? 'mt-6' : 'mt-4',
    ]}
  >
    {
      professionalMemberships.map((m) => (
        <li class="min-w-0 list-none">
          {m.href ? (
            <CrystalCard
              as="a"
              href={m.href}
              padding="sm"
              hoverLift
              class="flex h-full min-h-16 items-center no-underline"
            >
              <span class="block break-words text-sm font-semibold leading-snug text-ink">
                {m.name}
              </span>
            </CrystalCard>
          ) : (
            <CrystalCard as="div" padding="sm" class="flex h-full min-h-16 items-center">
              <span class="block break-words text-sm font-semibold leading-snug text-ink">
                {m.name}
              </span>
            </CrystalCard>
          )}
        </li>
      ))
    }
  </ul>
</section>
