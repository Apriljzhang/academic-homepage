---
import { person } from '../data/cv';
---

<footer
  class="site-footer fixed inset-x-0 bottom-0 z-40 w-full border-t border-page/25 bg-secondary px-5 text-page sm:px-8 md:px-12 lg:px-16 xl:px-20 2xl:px-24"
>
  <p class="mx-auto w-full max-w-[96rem] whitespace-nowrap text-xs leading-none text-page">
    © 2026 {person.fullDisplayName}
  </p>
</footer>

<style>
  .site-footer {
    min-height: 2.25rem;
    display: flex;
    align-items: center;
    padding-top: 0.375rem;
    padding-bottom: max(0.375rem, env(safe-area-inset-bottom));
  }
</style>
