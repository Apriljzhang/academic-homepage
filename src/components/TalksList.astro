---
import { talks } from '../data/cv';
---

<ul class="mt-6 space-y-4">
  {
    talks.map((t) => (
      <li class="border-l-2 border-primary/40 pl-4">
        {t.paperTitle ? (
          <p class="type-card-title">{t.paperTitle}</p>
        ) : null}
        <p class:list={[t.paperTitle ? 'type-meta mt-1' : 'type-card-title']}>
          {t.event}
        </p>
        <p class="type-meta mt-0.5">
          {t.place} · {t.date}
        </p>
      </li>
    ))
  }
</ul>
