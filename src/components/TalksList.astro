---
import { talks } from '../data/cv';
---

<section class="mt-8" aria-labelledby="conference-presentations-heading">
  <h2 id="conference-presentations-heading" class="type-label text-secondary">
    Selected conference presentations
  </h2>

  <ul class="mt-4 space-y-6">
    {
      talks.map((talk) => (
        <li class="border-l-2 border-main/50 pl-4">
          <p class="text-sm font-semibold tracking-wide text-secondary">
            {talk.date} <span aria-hidden="true">📍</span>{talk.place.replace(/,\s*/g, ' ')}
          </p>
          <p class="mt-1 text-sm font-semibold leading-relaxed text-ink">{talk.event}</p>
          {talk.paperTitle ? (
            <p class="mt-1 text-pretty text-base italic leading-relaxed text-primary">
              {talk.paperTitle}
            </p>
          ) : null}
        </li>
      ))
    }
  </ul>
</section>
