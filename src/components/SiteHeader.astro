---
import { navItems } from '../data/nav';
import { withBase } from '../utils/paths';

function normPath(pathname: string): string {
  const x = pathname.replace(/\/$/, '') || '/';
  return x;
}

const current = normPath(Astro.url.pathname);

function isActive(href: string): boolean {
  const target = normPath(new URL(href, Astro.url).pathname);
  if (target === '/') return current === '/';

  for (const section of ['/research', '/teaching', '/service', '/networking'] as const) {
    const root = normPath(withBase(section));
    if (target === root) {
      return current === root || current.startsWith(`${root}/`);
    }
  }

  return current === target;
}

const homeHref = withBase('/');
---

<header class="sticky top-0 z-40 w-full border-b border-page/25 bg-secondary">
  <div
    class="relative mx-auto flex w-full max-w-[96rem] flex-wrap items-center justify-between gap-x-5 gap-y-2 px-5 py-3 sm:px-8 md:px-12 lg:px-16 xl:px-20 2xl:px-24"
  >
    <p class="font-serif text-lg font-semibold tracking-[-0.015em] text-page">
      <a
        href={homeHref}
        class="text-page no-underline hover:text-page hover:underline"
      >
        April Jiawei Zhang 張家維
      </a>
    </p>
    <nav
      aria-label="Primary"
      class="flex flex-wrap gap-x-1 gap-y-1 text-sm font-medium"
    >
      {
        navItems.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'inline-flex items-center whitespace-nowrap border-b-2 border-transparent px-2.5 py-1 no-underline transition-colors duration-[var(--dur-micro)] focus-visible:outline-page',
              isActive(href)
                ? 'border-page bg-page/10 text-page'
                : 'text-page hover:border-page/60 hover:text-page',
            ]}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
