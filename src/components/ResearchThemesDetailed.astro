---
import { researchThemesDetailed } from '../data/cv';
---

<div class="space-y-8">
  {
    researchThemesDetailed.map((theme) => (
      <section id={theme.id} class="scroll-mt-24">
        <h2 class="type-section-title flex min-w-0 items-start gap-3">
          <span class="mt-[0.45em] h-2.5 w-2.5 shrink-0 bg-accent-purple" aria-hidden="true" />
          <span>{theme.title}</span>
        </h2>
        <p class="mt-3 max-w-3xl text-pretty text-base leading-relaxed text-muted">{theme.description}</p>
        {theme.upcoming.length > 0 ? (
          <div class="mt-5">
            <h3 class="type-label text-secondary">Upcoming manuscripts</h3>
            <ul class="mt-3 space-y-4">
              {theme.upcoming.map((u) => (
                <li class="border-l-2 border-main/50 pl-4">
                  <p class="text-xs font-semibold uppercase tracking-wide text-muted">{u.status}</p>
                  <p
                    class="mt-1 text-pretty text-base leading-relaxed text-ink/95 [&_em]:italic [&_em]:text-primary"
                    set:html={u.citationHtml}
                  />
                </li>
              ))}
            </ul>
          </div>
        ) : null}
      </section>
    ))
  }
</div>
