---
interface Props { kind: 'jobs' | 'timeline'; lang: 'en' | 'zh'; }
const {kind,lang} = Astro.props;
const label = kind==='jobs' ? (lang==='en'?'Job spider mat: four jobs and two skills each':'職業蜘蛛圖：四個職業，各配兩項技能') : (lang==='en'?'Blank life-event timeline with five slots':'五個空格的人生事件時間線');
---
<div class="u9-mat-preview">
  {kind==='jobs' ? <svg viewBox="0 0 800 300" role="img" aria-label={label}>
    <g stroke="#a7b8ae" fill="none" stroke-width="2"><path d="M400 150 190 65M400 150 610 65M400 150 190 230M400 150 610 230"/>
      <path d="M120 65 72 28M120 65 72 106M680 65 728 28M680 65 728 106M120 230 72 192M120 230 72 270M680 230 728 192M680 230 728 270"/>
    </g>
    <rect x="322" y="125" width="156" height="50" rx="25" fill="#edf7f0" stroke="#a7b8ae"/><text x="400" y="156" text-anchor="middle" fill="#0f4a32" font-size="19">{lang==='en'?'Jobs and skills':'職業與技能'}</text>
    {[{x:120,y:45},{x:540,y:45},{x:120,y:210},{x:540,y:210}].map(p=><g><rect {...p} width="140" height="40" fill="white" stroke="#1f6b45" stroke-dasharray="5 3"/><text x={p.x+70} y={p.y+26} text-anchor="middle" fill="#607b6d" font-size="17">{lang==='en'?'job card':'職業卡'}</text></g>)}
    {[{x:8,y:8},{x:8,y:86},{x:688,y:8},{x:688,y:86},{x:8,y:172},{x:8,y:250},{x:688,y:172},{x:688,y:250}].map(p=><g><rect {...p} width="104" height="40" fill="white" stroke="#a7b8ae" stroke-dasharray="5 3"/><text x={p.x+52} y={p.y+26} text-anchor="middle" fill="#607b6d" font-size="15">{lang==='en'?'skill card':'技能卡'}</text></g>)}
  </svg> : <svg viewBox="0 0 800 220" role="img" aria-label={label}>
    {[0,1,2,3,4].map(i=><g><rect x={16+i*151} y="20" width="135" height="68" fill="white" stroke="#1f6b45" stroke-dasharray="5 3"/><text x={83+i*151} y="58" text-anchor="middle" fill="#607b6d" font-size="17">{lang==='en'?'event card':'事件卡'}</text><text x={83+i*151} y="113" text-anchor="middle" fill="#607b6d" font-size="14">{lang==='en'?'age / date: ____':'年齡／日期：____'}</text></g>)}
    <path d="M16 145H748V133L788 161 748 189V177H16Z" fill="#edf7f0" stroke="#1f6b45"/><text x="16" y="210" fill="#607b6d" font-size="16">{lang==='en'?'Earlier':'較早'}</text><text x="749" y="122" fill="#0f4a32" font-size="17">NOW</text>
  </svg>}
</div>
<style>.u9-mat-preview{max-width:900px;margin:1rem 0}.u9-mat-preview svg{display:block;width:100%;height:auto;font-family:'Source Sans 3',sans-serif}</style>
