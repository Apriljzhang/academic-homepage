---
import type { SpssGuide } from '../../data/dedc02SpssGuides';
import { spssPracticePath } from '../../data/dedc02SpssGuides';
import { withBase } from '../../utils/paths';
interface Props { guide:SpssGuide; language:'en'|'zh'; }
const {guide,language}=Astro.props;
const zh=language==='zh';
const t=(v:[string,string])=>v[zh?1:0];
---
<section class="qm-spss-guide" data-spss-guide={guide.method} data-no-glossary aria-label={zh?'SPSS操作步驟':'SPSS procedure steps'}>
 <p class="qm-caption"><a href={withBase(spssPracticePath)} download="topic8-practice.csv" data-spss-practice>{zh?'下載練習CSV':'Download practice CSV'}</a> · {zh?'36位虛構學習者，並非論文資料。':'36 fictional learners; not the papers’ data.'}<br/><strong>File → Import Data → CSV</strong> · {zh?'首列為变量名稱，分隔符選Comma。':'First row = variable names; delimiter = Comma.'}</p>
 {guide.workflows.map(flow=><section class="qm-spss-workflow" data-spss-workflow={flow.id}>
  {guide.workflows.length>1&&<h3>{t(flow.title)}</h3>}
  <p>{t(flow.layout)}</p>
  <p class="qm-spss-menu"><strong>{flow.menu}</strong></p>
  <ol class="qm-spss-steps">{flow.steps.map(step=><li><p><strong>{step.click}</strong><br/>{t(step.explanation)}</p></li>)}</ol>
  <div class="qm-core-table-scroll" role="region" aria-label={zh?'SPSS輸出閱讀指引':'SPSS output-reading guide'} tabindex="0"><table class="qm-source-table qm-core-table">
   <thead><tr><th scope="col">{zh?'輸出表':'Output table'}</th><th scope="col">{zh?'讀甚麼':'What to read'}</th></tr></thead>
   <tbody>{flow.output.map(row=><tr><th scope="row">{row.table}</th><td>{t(row.read)}</td></tr>)}</tbody>
  </table></div>
  <p class="qm-caption">{t(flow.checks[0])}</p>
  <p class="qm-source">{flow.sources.map(source=><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a>)}</p>
 </section>)}
 <p class="qm-caption">{zh?'部分版本的Compare Means and Proportions稱為Compare Means。':'Some versions call Compare Means and Proportions simply Compare Means.'}</p>
</section>
