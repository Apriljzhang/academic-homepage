---
interface Props { lang:'en'|'zh'; }
const {lang}=Astro.props;const zh=lang==='zh';
---
<section class="u9-relay" data-relay-lang={lang} data-deck-scroll aria-label={zh?'詞組接力':'Phrase relay'}>
  <p class="relay-rules">{zh?'四人一組，分為A、B兩對。每回合60秒，兩人輪流說三句相連的故事，用完三個詞組；下一輪換人先說；共四回合。另一對評分：每個準確詞組1分，每句意思清楚1分，故事連貫加1分。':'Four students: pairs A and B. Take turns to tell a three-sentence story in 60 seconds, using all three chunks. Alternate speakers; swap the first speaker next round. Play four turns. The other pair awards 1 point per accurate chunk, 1 per meaningful sentence, and 1 for a connected story.'}</p>
  <div class="relay-status"><strong data-relay-turn></strong><output data-relay-clock aria-label={zh?'剩餘時間':'Time remaining'}>1:00</output><span data-relay-scores></span></div>
  <p class="relay-context" data-relay-context></p>
  <div class="relay-cards">{[0,1,2].map(i=><article><h3 data-relay-phrase={i}></h3><details><summary>{zh?'意思與例句':'Meaning and example'}</summary><p data-relay-meaning={i}></p><p data-relay-example={i} lang="en"></p></details></article>)}</div>
  <fieldset class="relay-scoring" data-relay-scoring hidden><legend>{zh?'另一對評分':'Other pair: award points'}</legend><div>{[0,1,2].map(i=><section><strong>{zh?'第':'Sentence '}{i+1}{zh?'句':''}</strong><label><input type="checkbox" data-relay-point={i*2} />{zh?'詞組準確 +1':'Accurate chunk +1'}</label><label><input type="checkbox" data-relay-point={i*2+1} />{zh?'意思清楚 +1':'Meaningful sentence +1'}</label></section>)}</div><label><input type="checkbox" data-relay-point="6" />{zh?'三句組成連貫故事 +1':'Connected story +1'}</label><output data-relay-points></output></fieldset>
  <div class="relay-actions"><button type="button" data-relay-action>{zh?'開始60秒':'Start 60-second turn'}</button><button type="button" data-relay-finish hidden>{zh?'結束並評分':'Finish and score'}</button></div>
  <p class="relay-message" data-relay-message role="status" aria-live="polite"></p>
  <details class="relay-options"><summary>{zh?'遊戲設定':'Game options'}</summary><label>{zh?'詞庫':'Bank'} <select data-relay-bank><option value="core">{zh?'12個核心詞組':'12 core chunks'}</option><option value="all">{zh?'全部60個詞組':'All 60 chunks'}</option></select></label><button type="button" data-relay-reset>{zh?'新遊戲':'New game'}</button></details>
</section>
<script>import '../../scripts/generalEnglishUnit9PhraseRelay';</script>
<style is:global>
.u9-relay{margin:1.3rem 0;border-top:1px solid var(--lesson-line);padding-top:1rem}.u9-relay [hidden]{display:none!important}.u9-relay p{font-size:1rem;line-height:1.5}.relay-status{display:flex;gap:1rem;align-items:center;flex-wrap:wrap;margin:1rem 0}.relay-status strong{font-size:1.25rem}.relay-status [data-relay-clock]{font-size:2rem;font-variant-numeric:tabular-nums}.relay-context{padding:1rem;background:var(--lesson-soft);border-left:3px solid var(--lesson-green);font-size:1.2rem!important}.relay-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.relay-cards article{border:1px solid var(--lesson-line);padding:1rem;min-width:0}.relay-cards h3{font-size:1.35rem;margin:0 0 .8rem}.relay-cards summary,.relay-options summary{cursor:pointer;min-height:44px;font-size:1rem;padding:.5rem 0}.relay-actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:1rem 0}.u9-relay button,.u9-relay select{font:inherit;min-height:44px;padding:.6rem 1rem;background:#fff;border:1px solid var(--lesson-green);border-radius:.3rem;color:var(--lesson-green);cursor:pointer}.u9-relay [data-relay-action]{background:var(--lesson-green);color:#fff}.u9-relay button:disabled,.u9-relay select:disabled{opacity:.5;cursor:default}.u9-relay :is(button,select,summary,input):focus-visible{outline:3px solid var(--lesson-green);outline-offset:3px}.relay-scoring{padding:1rem;border:1px solid var(--lesson-line);margin-top:1rem}.relay-scoring>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.relay-scoring label{display:flex;gap:.5rem;align-items:center;min-height:44px;font-size:1rem}.relay-scoring input{width:1.15rem;height:1.15rem;flex-shrink:0}.relay-scoring>output{display:block;margin-top:.5rem;font-weight:600}.relay-message{min-height:1.5em}.relay-options{border-top:1px solid var(--lesson-line);margin-top:1.5rem;padding-top:.5rem}.relay-options>label{display:inline-flex;gap:.7rem;align-items:center;margin-right:.7rem}.relay-options select{max-width:210px}@media(max-width:600px){.relay-cards,.relay-scoring>div{grid-template-columns:1fr}.relay-status{gap:.5rem 1rem}}
</style>
