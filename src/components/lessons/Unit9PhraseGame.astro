---
interface Props {lang:'en'|'zh';}
const {lang}=Astro.props;const zh=lang==='zh';
---
<section class="u9-phrase-game" data-phrase-game-lang={lang} data-deck-scroll aria-label={zh?'詞組選擇題':'Phrase multiple choice'}>
  <div class="pg-settings"><label>{zh?'詞庫':'Bank'} <select data-pg-bank><option value="core">{zh?'12個核心詞組':'12 core phrases'}</option><option value="all">{zh?'全部60個詞組':'All 60 phrases'}</option></select></label><label>{zh?'題型':'Format'} <select data-pg-mode><option value="meaning">{zh?'意思':'Meaning'}</option><option value="preposition">{zh?'缺少的介詞':'Missing preposition'}</option><option value="context">{zh?'句中運用':'Use in a sentence'}</option></select></label><output data-pg-progress></output></div>
  <p class="pg-instruction" data-pg-instruction></p>
  <p class="pg-question" data-pg-question lang="en" tabindex="-1"></p>
  <fieldset class="pg-choices"><legend class="pg-sr-only">{zh?'選擇正確答案':'Choose the correct answer'}</legend>{[0,1,2,3].map(i=><label data-pg-option={i}><input type="radio" name={`u9-phrase-answer-${lang}`} value={i} data-pg-choice={i} /><span data-pg-choice-text></span></label>)}</fieldset>
  <div class="pg-actions"><button type="button" data-pg-check disabled>{zh?'核對答案':'Check answer'}</button><button type="button" data-pg-next hidden>{zh?'下一題':'Next question'}</button></div>
  <div class="pg-feedback" data-pg-feedback role="status" aria-live="polite" hidden><strong data-pg-result></strong><p data-pg-model lang="en"></p><p data-pg-meaning></p><p data-pg-example lang="en"></p></div>
</section>
<script>import '../../scripts/generalEnglishUnit9PhraseGame';</script>
<style is:global>
.u9-phrase-game{margin:1.3rem 0;padding-top:1rem;border-top:1px solid var(--lesson-line)}.u9-phrase-game [hidden]{display:none!important}.pg-settings{display:flex;gap:1rem;align-items:center;flex-wrap:wrap}.pg-settings label,.pg-settings output{font-size:1rem}.pg-settings select{font:inherit;min-height:44px;padding:.4rem;border:1px solid var(--lesson-line);background:#fff;color:var(--lesson-ink);max-width:100%}.pg-instruction{font-size:1.1rem!important;margin:1.2rem 0 .6rem}.pg-question{font-size:1.7rem!important;line-height:1.45;max-width:70ch;margin:.7rem 0 1.2rem}.pg-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;border:0;padding:0;margin:0;min-width:0}.pg-choices label{display:flex;align-items:center;gap:.7rem;padding:.8rem 1rem;border:1px solid var(--lesson-line);border-radius:.3rem;min-height:54px;cursor:pointer;min-width:0}.pg-choices input{width:1.1rem;height:1.1rem;flex-shrink:0;accent-color:var(--lesson-green)}.pg-choices span{font-size:1.15rem;overflow-wrap:anywhere}.pg-choices label:has(input:checked){outline:2px solid var(--lesson-green)}.pg-choices .pg-correct{background:var(--lesson-soft);border-color:var(--lesson-green)}.pg-choices .pg-incorrect{background:#fff5df;border-color:#8b6519}.pg-actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:1rem 0}.pg-actions button{min-height:44px;font:inherit;padding:.6rem 1rem;border:1px solid var(--lesson-green);border-radius:.3rem;background:white;color:var(--lesson-green);cursor:pointer}.pg-actions [data-pg-check]{background:var(--lesson-green);color:white}.pg-actions button:disabled{opacity:.45;cursor:default}.pg-feedback{padding:1rem;border-left:3px solid var(--lesson-green);background:var(--lesson-soft)}.pg-feedback p{font-size:1.05rem!important;line-height:1.5;margin:.4rem 0}.pg-sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.u9-phrase-game :is(button,input,select,[tabindex]):focus-visible{outline:3px solid var(--lesson-green);outline-offset:3px}@media(max-width:600px){.pg-choices{grid-template-columns:1fr}.pg-question{font-size:1.35rem!important}.pg-settings{gap:.7rem}}
</style>
