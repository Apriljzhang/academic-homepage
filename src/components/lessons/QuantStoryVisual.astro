---
import type { QuantStory } from '../../data/dedc02QuantStories';
interface Props { story: QuantStory; language: 'en'|'zh'; id: string; }
const {story:s,language,id}=Astro.props; const zh=language==='zh'; const t=(x:[string,string])=>x[zh?1:0];
const colors=['#1f6b45','#956519','#386ca0','#825889','#43887f','#ab5240'];
const x=(i:number,n:number)=>80+i*490/Math.max(1,n-1); const y=(v:number)=>220-v/(s.max||100)*175;
const series=s.series||[]; const values=s.values||[];
const legends: Record<string,[string,string][]>={ancova:[['Tutor A','A 導師'],['Tutor B','B 導師']],regression:[['Dry','無雨'],['Rain','下雨']],moderation:[['Quiet','安靜'],['Noisy','嘈雜']]};
---
<figure class="qm-story-visual">
{!['path','matrix'].includes(s.visual)&&<svg viewBox="0 0 650 295" role="img" aria-label={`${t(s.title)}. ${t(s.unit)}`}>
 <text x="20" y="22" class="qm-chart-unit">{t(s.unit)}</text>
 {s.visual==='queue'?<>
  <line x1="65" x2="605" y1="177" y2="177" class="qm-chart-axis"/>
  {[0,3,6,9,12,15,18].map(v=><g><line x1={65+v*30} x2={65+v*30} y1="177" y2="184" class="qm-chart-axis"/><text x={65+v*30} y="206" text-anchor="middle">{v}</text></g>)}
  {values.map((v,i)=><g><circle cx={65+v*30} cy="158" r="12" fill={colors[i===4?1:0]}/><text x={65+v*30} y="133" text-anchor="middle">{v}</text></g>)}
  <g class="qm-story-result-mark"><line x1="245" x2="245" y1="68" y2="177" stroke={colors[1]} stroke-dasharray="5 4"/><text x="253" y="69">{zh?'平均數 6':'Mean 6'}</text><line x1="185" x2="185" y1="95" y2="177" stroke={colors[0]} stroke-dasharray="5 4"/><text x="80" y="92">{zh?'中位數 4':'Median 4'}</text></g>
 </>:<>
 {[0,.5,1].map(p=><g><line x1="65" x2="605" y1={y(p*(s.max||100))} y2={y(p*(s.max||100))} class="qm-chart-grid"/><text x="52" y={y(p*(s.max||100))+5} text-anchor="end">{p*(s.max||100)}</text></g>)}
 <line x1="65" x2="605" y1="220" y2="220" class="qm-chart-axis"/>
 {s.visual==='bars'&&values.map((v,i)=>{const cx=130+i*390/Math.max(1,values.length-1);return <g><rect x={cx-38} y={y(v)} width="76" height={220-y(v)} fill={colors[i%colors.length]} rx="3"/><text x={cx} y={y(v)-10} text-anchor="middle">{v}{id==='chi'?'%':''}</text><text x={cx} y="250" text-anchor="middle">{t(s.labels[i])}</text></g>;})}
 {s.visual==='scatter'&&<>
  {(s.x||[]).map((v,i)=><g><circle cx={70+v*10} cy={y(values[i])} r="7" fill={colors[0]}/><text x={70+v*10} y="247" text-anchor="middle">{v}</text></g>)}
  <line x1="170" x2="570" y1={y(4.4)} y2={y(7.6)} stroke={colors[1]} stroke-width="3" class="qm-story-result-mark"/>
  <text x="330" y="282" text-anchor="middle">{t(s.labels[0])}</text>
 </>}
 {s.visual==='lines'&&<>
  {series.map((row,i)=><polyline points={row.map((v,j)=>`${x(j,row.length)},${y(v)}`).join(' ')} fill="none" stroke={colors[i%colors.length]} stroke-width={id==='repeated'?'2':'4'} stroke-opacity={id==='repeated'?'.65':'1'}/>)}
  {series.filter(()=>id!=='logistic').map((row,i)=>row.map((v,j)=><circle cx={x(j,row.length)} cy={y(v)} r="4" fill={colors[i%colors.length]}/>))}
  {s.labels.map((label,i)=><text x={x(i,s.labels.length)} y="248" text-anchor="middle">{t(label)}</text>)}
  {id==='repeated'&&<polyline class="qm-story-result-mark" points={values.map((v,j)=>`${x(j,values.length)},${y(v)}`).join(' ')} fill="none" stroke="#0f4a32" stroke-width="5" stroke-dasharray="8 4"/>}
 </>}
 </>}
</svg>}
{s.visual==='path'&&<svg viewBox="0 0 650 275" role="img" aria-label={zh?'練習經信心連到歌唱分數，另有直接路徑':'Rehearsal connects to score through confidence, alongside a direct path'}>
 <defs><marker id={`arrow-${id}-${language}`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8" fill="#1f6b45"/></marker></defs>
 <path d="M160,185 L280,80 M370,80 L490,185" fill="none" stroke="#1f6b45" stroke-width="3" marker-end={`url(#arrow-${id}-${language})`}/>
 <path d="M180,205 L470,205" stroke="#956519" stroke-width="3" marker-end={`url(#arrow-${id}-${language})`}/>
 {[[100,205],[325,55],[550,205]].map(([cx,cy],i)=><g><rect x={cx-85} y={cy-25} width="170" height="50" rx="8" fill="#edf7f0" stroke="#bad8c5"/><text x={cx} y={cy+6} text-anchor="middle">{t(s.labels[i])}</text></g>)}
 <text x="154" y="100">a = .8</text><text x="430" y="100">b = 3</text><text x="325" y="190" text-anchor="middle">c′ = 1.6</text>
 <text x="325" y="263" text-anchor="middle" class="qm-story-result-mark">ab = .8 × 3 = 2.4</text>
</svg>}
{s.visual==='matrix'&&<table class="qm-story-matrix"><thead><tr><th>{zh?'室友':'Flatmate'}</th>{s.labels.map(label=><th>{t(label)}</th>)}<th>{zh?'總分':'Total'}</th></tr></thead><tbody>{series.map((row,i)=><tr><th>{i+1}</th>{row.map(v=><td style={`--score:${v/5}`}>{v}</td>)}<td>{row.reduce((a,b)=>a+b,0)}</td></tr>)}</tbody></table>}
<figcaption>
{t(s.unit)}{s.visual==='bars'&&(zh?'；長條呈現摘要值，未繪製誤差線。':'; bars show summary values, without error bars.')}
{legends[id]&&<span class="qm-story-legend">{legends[id].map((label,i)=><span><i style={`background:${colors[i]}`}></i>{t(label)}</span>)}</span>}
{id==='repeated'&&(zh?'；細線為六位朋友；第三步的粗虛線為平均數。':'; thin lines follow six friends; the heavy dashed line in step 3 shows means.')}
</figcaption>
</figure>
