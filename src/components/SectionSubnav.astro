---
type Item = { href: string; label: string };

interface Props {
  ariaLabel: string;
  items: readonly Item[];
}

const { ariaLabel, items } = Astro.props;

function normPath(pathname: string): string {
  const x = pathname.replace(/\/$/, '') || '/';
  return x;
}

const current = normPath(Astro.url.pathname);

function isCurrent(href: string): boolean {
  const target = normPath(new URL(href, Astro.url).pathname);
  return current === target;
}
---

<nav
  aria-label={ariaLabel}
  class="mt-4 flex flex-wrap gap-1.5 border-b border-border/70 pb-3"
>
  {
    items.map(({ href, label }) => (
      <a
        href={href}
        aria-current={isCurrent(href) ? 'page' : undefined}
        class:list={[
          'inline-flex min-h-10 items-center whitespace-nowrap rounded-sm border px-2.5 py-1 text-sm font-semibold no-underline transition-colors duration-[var(--dur-micro)] ease-[var(--ease-out)]',
          isCurrent(href)
            ? 'border-main bg-main text-main-ink'
            : 'border-border bg-surface text-muted hover:bg-neutral-hover hover:text-ink',
        ]}
      >
        {label}
      </a>
    ))
  }
</nav>
