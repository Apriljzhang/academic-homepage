---
import { editorialRoles } from '../data/cv';
---

<ul class="mt-6 space-y-4">
  {
    editorialRoles.map((role) => (
      <li class="grid gap-4 border-l-2 border-primary/40 pl-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
        <div>
          <p class="type-card-title">{role.role}</p>
          {
            role.specialIssue && (
              <p class="type-meta mt-1">
                <em>{role.specialIssue}</em>
              </p>
            )
          }
          <p class:list={['type-meta', role.specialIssue ? 'mt-0.5' : 'mt-1']}>
            {role.journal}
            {role.years ? ` · ${role.years}` : ''}
          </p>
        </div>
        <p>
          <a
            href={role.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-semibold text-primary no-underline hover:underline"
          >
            {role.linkLabel ?? 'Special issue collection'} →
          </a>
        </p>
      </li>
    ))
  }
</ul>
