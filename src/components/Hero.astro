---
import { person, siteTagline, summaryHtml } from '../data/cv';
import ContactBubbles from './ContactBubbles.astro';

const profileSrc = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}images/profile.jpg`;
---

<section
  id="about"
  class="relative w-full border-b border-border bg-page"
  aria-labelledby="hero-heading"
>
  <div
    class="relative mx-auto grid w-full max-w-[96rem] gap-7 px-5 pb-10 pt-8 sm:px-8 sm:pb-12 sm:pt-9 md:px-12 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-10 lg:px-16 lg:pb-14 lg:pt-10 xl:px-20 2xl:px-24"
  >
    <div class="min-w-0">
      <div class="flex items-center gap-2" aria-hidden="true">
        <span class="h-1.5 w-12 rounded-full bg-strip-1" />
        <span class="h-1.5 w-6 rounded-full bg-strip-2" />
      </div>
      <h1
        id="hero-heading"
        class="mt-4 max-w-[24ch] font-serif text-[2rem] font-semibold leading-[1.08] tracking-[-0.025em] text-ink sm:text-[2.3rem] lg:text-[2.65rem]"
      >
        {person.fullDisplayName}
      </h1>
      <p class="mt-2 max-w-[52ch] font-serif text-lg leading-snug text-secondary sm:text-xl">{siteTagline}</p>
      <div
        class="mt-5 max-w-[72ch] text-pretty text-base leading-relaxed text-ink/95 lg:max-w-none lg:text-lg"
        set:html={summaryHtml}
      />

      <div
        id="contact"
        class="mt-7 w-full scroll-mt-24 border-t border-border pt-5"
      >
        <p class="text-xs font-bold uppercase tracking-wider text-primary">Contact</p>
        <ContactBubbles className="mt-3" />
      </div>
    </div>

    <div class="mx-auto w-52 shrink-0 sm:w-60 lg:mx-0 lg:w-64 xl:w-72">
      <div class="overflow-hidden rounded-lg border border-border bg-surface">
        <img
          src={profileSrc}
          alt="April Jiawei Zhang 張家維"
          width="640"
          height="800"
          class="h-auto w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>
