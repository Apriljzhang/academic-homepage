---
import { person, siteTagline, summaryHtml } from '../data/cv';
import ContactBubbles from './ContactBubbles.astro';

const profileSrc = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}images/profile.jpg`;
---

<section
  id="about"
  class="relative w-full bg-page"
  aria-labelledby="hero-heading"
>
  <div
    class="relative mx-auto w-full max-w-[96rem] px-5 pb-10 pt-8 sm:px-8 sm:pb-12 sm:pt-9 md:px-12 lg:px-16 lg:pb-14 lg:pt-10 xl:px-20 2xl:px-24"
  >
    <div class="min-w-0">
      <div aria-hidden="true">
        <span class="block h-1.5 w-16 rounded-full bg-strip-1" />
      </div>
      <h1
        id="hero-heading"
        class="mt-4 max-w-[24ch] font-serif text-[2rem] font-semibold leading-[1.08] tracking-[-0.025em] text-ink sm:text-[2.3rem] lg:text-[2.65rem]"
      >
        {person.fullDisplayName}
      </h1>
      <p class="mt-2 max-w-[70ch] font-serif text-lg leading-snug text-secondary sm:text-xl lg:max-w-none lg:whitespace-nowrap">{siteTagline}</p>
    </div>

    <div class="mt-5 grid gap-7 lg:grid-cols-[minmax(0,1fr)_16rem] lg:items-start lg:gap-8 xl:grid-cols-[minmax(0,1fr)_18rem_15rem] xl:items-stretch 2xl:grid-cols-[minmax(0,1fr)_20rem_16rem]">
      <div class="min-w-0 xl:h-full">
        <div
          class="type-body !max-w-none text-pretty text-ink/95 xl:flex xl:h-full xl:flex-col xl:justify-between"
          set:html={summaryHtml}
        />
      </div>

      <div class="mx-auto w-52 shrink-0 sm:w-60 lg:mx-0 lg:w-full xl:h-full">
        <div class="h-full overflow-hidden rounded-lg border border-border bg-surface">
          <img
            src={profileSrc}
            alt="April Jiawei Zhang 張家維"
            width="640"
            height="800"
            class="h-auto w-full object-cover xl:h-full"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <div
        id="contact"
        class="w-full scroll-mt-24 border-t border-border pt-5 lg:col-span-2 xl:col-span-1 xl:h-full xl:border-l xl:border-t-0 xl:pl-5 xl:pt-0"
      >
        <p class="type-label text-primary xl:sr-only">Contact</p>
        <ContactBubbles className="mt-3 xl:mt-0 xl:h-full xl:justify-between" stackAtLarge />
      </div>
    </div>
  </div>
</section>
