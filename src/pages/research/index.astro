---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageShell from '../../components/PageShell.astro';
import SectionSubnav from '../../components/SectionSubnav.astro';
import MainWithAside from '../../components/MainWithAside.astro';
import ResearchSectionAside from '../../components/ResearchSectionAside.astro';
import ResearchMap from '../../components/ResearchMap.astro';
import { researchSubnav } from '../../data/sectionNav';
import { person } from '../../data/cv';
import { withBase } from '../../utils/paths';

const title = `Research · ${person.fullDisplayName}`;
const description = `Upcoming works, publications, and funded projects — ${person.fullDisplayName}.`;
---

<BaseLayout {title} {description}>
  <SiteHeader />
  <main id="main-content" class="min-h-[50vh] w-full bg-page">
    <PageShell accentBar>
      <h1 class="font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl lg:text-5xl">Research</h1>
      <MainWithAside asideLabel="Research menu" wide>
        <div>
          <SectionSubnav ariaLabel="Research section" items={researchSubnav} />
          <ResearchMap class="mt-8" />

          <ul class="mt-10 grid gap-4 md:grid-cols-2">
            <li class="rounded-xl border border-border bg-surface p-5">
              <a
                href={withBase('/research/themes')}
                class="font-serif text-lg font-semibold text-ink no-underline hover:text-primary"
              >
                Upcoming works →
              </a>
              <p class="mt-2 text-sm text-muted">Manuscripts in preparation across core research themes.</p>
            </li>
            <li class="rounded-xl border border-border bg-surface p-5">
              <a
                href={withBase('/research/publications')}
                class="font-serif text-lg font-semibold text-ink no-underline hover:text-primary"
              >
                Publications →
              </a>
              <p class="mt-2 text-sm text-muted">Selected journal articles, chapters, and other outputs.</p>
            </li>
            <li class="rounded-xl border border-border bg-surface p-5 md:col-span-2">
              <a
                href={withBase('/research/funding')}
                class="font-serif text-lg font-semibold text-ink no-underline hover:text-primary"
              >
                Funded projects →
              </a>
              <p class="mt-2 text-sm text-muted">Competitive grants and commissioned research.</p>
            </li>
          </ul>
        </div>
        <ResearchSectionAside slot="aside" />
      </MainWithAside>
    </PageShell>
  </main>
  <SiteFooter />
</BaseLayout>
