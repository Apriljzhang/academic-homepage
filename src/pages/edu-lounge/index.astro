---
import EduLoungeLayout from '../../layouts/EduLoungeLayout.astro';
import { withBase } from '../../utils/paths';
---

<EduLoungeLayout>
  <section class="edu-hero edu-home-hero" aria-labelledby="edu-title">
    <p class="edu-kicker">Edu Lounge Education Limited</p>
    <h1 id="edu-title" class="edu-slogan">Dare to <img src={withBase('/edu-lounge/slogan-do.png')} width="488" height="316" alt="DO" /></h1>
    <p class="edu-lede">
      Research, in conversation. Edu Lounge shares research-related posts on WeChat and Xiaohongshu, inviting open, thoughtful discussion with the ease of a conversation in a lounge.
    </p>
  </section>

  <nav class="edu-home-links" aria-label="Explore Edu Lounge">
    <a href={withBase('/edu-lounge/about')}>
      <span class="edu-home-link-title">About <span aria-hidden="true">↗</span></span>
      <span>Our purpose and the idea behind the lounge.</span>
    </a>
    <a href={withBase('/edu-lounge/work')}>
      <span class="edu-home-link-title">Our work <span aria-hidden="true">↗</span></span>
      <span>Research-related posts on WeChat and Xiaohongshu.</span>
    </a>
    <a href={withBase('/edu-lounge/products')}>
      <span class="edu-home-link-title">Products <span aria-hidden="true">↗</span></span>
      <span>Information about future offerings.</span>
    </a>
    <a href={withBase('/edu-lounge/contact')}>
      <span class="edu-home-link-title">Contact <span aria-hidden="true">↗</span></span>
      <span>Company details and ways to follow our work.</span>
    </a>
  </nav>
</EduLoungeLayout>
