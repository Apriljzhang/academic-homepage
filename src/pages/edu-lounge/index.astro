---
import EduLoungeLayout from '../../layouts/EduLoungeLayout.astro';
import { withBase } from '../../utils/paths';
---

<EduLoungeLayout
  title="Edu Lounge Education Limited"
  description="Edu Lounge Education Limited is an education company in Macao. View its registered activities."
>
  <article class="edu-company">
    <header class="edu-company-intro">
      <div class="edu-company-title">
        <h1 id="edu-title" class="edu-company-slogan">
          Dare to <img src={withBase('/edu-lounge/slogan-do.png')} width="1952" height="1264" alt="DO" />
        </h1>
        <p class="edu-company-summary">An education company in Macao.</p>
      </div>
    </header>

    <section class="edu-activities" aria-labelledby="activities-title">
      <h2 id="activities-title">What the company does</h2>
      <p class="edu-activities-copy">
        Edu Lounge provides education and training; undertakes educational and social science research; publishes newspapers, magazines, periodicals, books, booklets, music scores and other publications; and plans and produces exhibitions and other activities.
      </p>
    </section>
  </article>
</EduLoungeLayout>
