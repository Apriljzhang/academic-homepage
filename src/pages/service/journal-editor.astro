---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageShell from '../../components/PageShell.astro';
import SectionSubnav from '../../components/SectionSubnav.astro';
import MainWithAside from '../../components/MainWithAside.astro';
import ServiceSectionAside from '../../components/ServiceSectionAside.astro';
import EditorialRolesList from '../../components/EditorialRolesList.astro';
import { serviceSubnav } from '../../data/sectionNav';
import { person } from '../../data/cv';

const title = `Journal editor · ${person.fullDisplayName}`;
const description = `Guest editorship and journal editorial service — ${person.fullDisplayName}.`;
---

<BaseLayout {title} {description}>
  <SiteHeader />
  <main id="main-content" class="min-h-[50vh] w-full bg-page">
    <PageShell accentBar>
      <h1 class="font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl lg:text-5xl">Journal editor</h1>
      <MainWithAside asideLabel="Service menu">
        <div>
          <SectionSubnav ariaLabel="Service section" items={serviceSubnav} />

          <section class="mt-10 max-w-3xl space-y-4 text-pretty text-lg leading-relaxed text-ink/95 lg:text-xl">
            <p>
              I serve as guest editor for a special issue of <em>Language Testing in Asia</em>, linked to the AALA 2026
              conference theme on a humanistic approach to assessment, standards, innovation, and accountability.
            </p>
          </section>

          <EditorialRolesList />
        </div>
        <ServiceSectionAside slot="aside" />
      </MainWithAside>
    </PageShell>
  </main>
  <SiteFooter />
</BaseLayout>
