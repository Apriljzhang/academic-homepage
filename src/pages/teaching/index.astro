---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageShell from '../../components/PageShell.astro';
import SectionSubnav from '../../components/SectionSubnav.astro';
import MainWithAside from '../../components/MainWithAside.astro';
import TeachingSectionAside from '../../components/TeachingSectionAside.astro';
import TeachingOverviewCards from '../../components/TeachingOverviewCards.astro';
import { teachingSubnav } from '../../data/sectionNav';
import { person } from '../../data/cv';
import { withBase } from '../../utils/paths';

const title = `Teaching · ${person.fullDisplayName}`;
const description = `Teaching philosophy, experience, and supervision — ${person.fullDisplayName}.`;
---

<BaseLayout {title} {description}>
  <SiteHeader />
  <main id="main-content" class="min-h-[50vh] w-full bg-page">
    <PageShell accentBar>
      <h1 class="font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl lg:text-5xl">Teaching</h1>
      <MainWithAside asideLabel="Teaching menu" wide>
        <div>
          <SectionSubnav ariaLabel="Teaching section" items={teachingSubnav} />
          <TeachingOverviewCards />

          <ul class="mt-10 grid gap-4 md:grid-cols-2">
            <li class="rounded-xl border border-border bg-surface p-5">
              <a
                href={withBase('/teaching/approach')}
                class="type-card-title no-underline hover:text-primary"
              >
                CityU courses →
              </a>
              <p class="mt-2 text-sm text-muted">Master’s and doctoral courses taught at City University of Macau.</p>
            </li>
            <li class="rounded-xl border border-border bg-surface p-5">
              <a
                href={withBase('/teaching/supervision')}
                class="type-card-title no-underline hover:text-primary"
              >
                Supervision →
              </a>
              <p class="mt-2 text-sm text-muted">Master’s and doctoral supervision, with dissertation and thesis topics.</p>
            </li>
            <li class="rounded-xl border border-border bg-surface p-5 md:col-span-2">
              <a
                href={withBase('/teaching/training')}
                class="type-card-title no-underline hover:text-primary"
              >
                Training →
              </a>
              <p class="mt-2 text-sm text-muted">
                Interactive professional-development materials on formative assessment frameworks and GenAI.
              </p>
            </li>
          </ul>
        </div>
        <TeachingSectionAside slot="aside" />
      </MainWithAside>
    </PageShell>
  </main>
  <SiteFooter />
</BaseLayout>
