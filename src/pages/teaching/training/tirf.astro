---
import CourseSlideLayout from '../../../layouts/CourseSlideLayout.astro';
import LessonDeckChrome from '../../../components/lessons/LessonDeckChrome.astro';
import B from '../../../components/lessons/TirfText.astro';
import TirfClassroomCase from '../../../components/lessons/TirfClassroomCase.astro';
import TirfStrategyMatrix from '../../../components/lessons/TirfStrategyMatrix.astro';
import TirfFeedbackModel from '../../../components/lessons/TirfFeedbackModel.astro';
import TirfFramework from '../../../components/lessons/TirfFramework.astro';
import { workshopTitle, openingExample, agenda, prompts, feedbackPrompt, workedFeedback, workedPlan, worksheet, planningGroups } from '../../../data/tirfWorkshop';
import { frameworkBuildHtml, activityBuildHtml } from '../../../data/tirfActivityDesign';
import '../../../styles/tirf-workshop.css';
import '../../../styles/tirf-models.css';
const title = `${workshopTitle} · April Jiawei Zhang`;
const description = 'A practical workshop for language teachers: use Codex or WorkBuddy to design formative assessment activities for language classrooms, connecting evidence to feedback and action.';
const courseHref = '/teaching/training/';
const resources = '/teaching/training/tirf/resources/';
---
<CourseSlideLayout {title} {description} lessonDeck>
<section class="tirf-access" data-tirf-access aria-labelledby="tirf-access-title"><p>AI4ELE / TIRF · 24 October 2026</p><h1 id="tirf-access-title">{workshopTitle}</h1><p>April Jiawei Zhang · City University of Macau</p><form data-tirf-access-form><label for="tirf-access-code">Workshop access code / 工作坊進入碼</label><div><input id="tirf-access-code" inputmode="numeric" autocomplete="off" required aria-describedby="tirf-access-feedback" /><button type="submit">Open workshop / 進入工作坊</button></div><p id="tirf-access-feedback" role="status"></p></form><a href={courseHref}>Back to training / 返回培訓</a><noscript>Enable JavaScript / 請啟用JavaScript</noscript></section>
<div data-tirf-workshop hidden>
<LessonDeckChrome {courseHref} courseLabel="training materials" lessonTitle="Designing formative assessment with generative AI" />
<main class="deck tirf-deck" aria-label="Formative assessment workshop for language teachers">
<section class="slide is-active" data-title="Workshop purpose and route" data-title-zh="工作坊目的與流程" aria-hidden="false"><div class="slide-inner title-slide">
<header class="slide-header"><span class="eyebrow">AI4ELE / TIRF · BNBU, Zhuhai · 24 October 2026</span></header><div class="title-rule"></div>
<h1 class="cover-title"><B en="Designing formative assessment with generative AI" zh="用生成式AI設計形成性評估" /></h1>
<p class="lead"><B en="A practical workshop for language teachers and researchers beginning to work with classroom assessment." zh="為一線語言教師及初涉課堂評估研究的學者而設的實務工作坊。" /></p>
<ol class="workshop-outcomes"><li><B en="Understand how formative assessment helps teachers and students decide what to do next." zh="理解形成性評估如何幫助教師與學生決定下一步。" /></li><li><B en="Use the three frameworks to design, build and check a formative assessment activity for a language class with an AI agent." zh="依三個框架，運用AI代理設計、製作並檢查語言課堂中的形成性評估活動。" /></li></ol>
<p class="role-note"><B en="I will demonstrate in Codex. You will use WorkBuddy to build a formative assessment activity for your language class, check how its evidence informs the next teaching or learning step, and ask the agent to improve it." zh="我會用Codex示範；你會用WorkBuddy製作語言課堂的形成性評估活動，檢查證據如何支持教與學的下一步，再請代理改進。" /></p>
<p><B en="Dr. April Jiawei Zhang · School of Education, City University of Macau" zh="張家維博士 · 澳門城市大學教育學院" /></p>
<ol class="agenda">{agenda.map(([en,zh,index])=><li><button data-jump={index}><B {en} {zh} /></button></li>)}</ol>
</div></section>
<section class="slide" data-title="Our classroom case" data-title-zh="我們共同使用的課堂案例" aria-hidden="true"><div class="slide-inner">
<header class="slide-header"><span class="eyebrow"><B en="The classroom case used throughout this workshop" zh="全工作坊共同使用的課堂案例" /></span></header>
<h2><B en="Helping students support an opinion" zh="幫助學生用例子支持觀點" /></h2>
<TirfClassroomCase />
<p class="takeaway"><B en="As the teacher, you need to find out whether students can choose a relevant example and explain its connection. Their responses will guide your feedback and next teaching step." zh="作為教師，你要了解學生能否選擇相關例子並解釋聯繫，再依作答決定回饋及下一步教學。" /></p>
</div></section>
<section class="slide" data-title="What formative assessment means" data-title-zh="甚麼是形成性評估" aria-hidden="true"><div class="slide-inner">
<header class="slide-header"><span class="eyebrow"><B en="The core concept" zh="核心概念" /></span></header>
<h2><B en="Formative assessment / assessment for learning" zh="形成性評估／促進學習的評估" /></h2>
<div class="core-definition"><p><B en="Teachers and students use evidence of learning to decide what to do next to help students reach a learning target." zh="教師與學生運用學習證據，決定接下來怎樣教與學，以幫助學生達到學習目標。" /></p></div>
<p><B en="In our writing class, the target is to support an opinion with a relevant example and explain the connection. A correct choice alone leaves the student’s understanding uncertain." zh="在本寫作課堂中，目標是以相關例子支持觀點並解釋聯繫。只知道學生選對，仍未能確定他理解了甚麼。" /></p>
<div class="two"><article><h3><B en="If you only record the answer" zh="如果只記錄答案" /></h3><p><B en="“B.” — “Correct.”" zh="「B。」「答對了。」" /></p><p><B en="You know the student chose B. You still do not know why." zh="你知道學生選了B，但仍不知道理由。" /></p></article><article><h3><B en="If you also ask for the reason" zh="如果同時詢問理由" /></h3><p><B en="“B, because it is longer.”" zh="「B，因為它較長。」" /></p><p><B en="Now you can check whether the student is judging the example and explanation, or simply counting words." zh="你可進一步檢視學生在判斷例子與解釋，還是只看字數。" /></p></article></div>
<details><summary><B en="Discuss as teachers: what would you check or teach next?" zh="以教師身份討論：下一步要核對或教甚麼？" /></summary><p><B en="Compare two paragraphs of similar length: one with a relevant example and one with an unrelated example. Ask the student to explain the difference. If needed, model the connection, then let the student revise and try a new example." zh="比較兩段長度相近的文字：一段有相關例子，另一段有不相關例子。請學生解釋差別；有需要時示範如何建立聯繫，再讓學生修訂及試用新例子。" /></p><label for="opening-notice"><B en="Optional note: the next question or teaching step you would use" zh="可選備註：你會使用的下一條問題或教學步驟" /></label><textarea id="opening-notice" data-note="Opening observation" rows="2"></textarea></details>
<p class="takeaway"><B en="The formative part is what teachers or students do with the information. Asking a question or displaying a comment is only part of that process." zh="形成性的關鍵，在於教師或學生如何運用資訊。提問或顯示評語，只是過程的一部分。" /></p>
<p class="source-note"><a href="https://doi.org/10.1007/s11092-008-9068-5">Black &amp; Wiliam (2009)</a></p>
</div></section>
<section class="slide" data-title="Three frameworks for classroom design" data-title-zh="課堂設計的三個框架" aria-hidden="true"><div class="slide-inner">
<header class="slide-header"><span class="eyebrow"><B en="Connect each framework to the same classroom case" zh="將每個框架連結至同一課堂案例" /></span></header>
<h2><B en="Three frameworks for classroom design" zh="課堂設計的三個框架" /></h2>
<p><B en="Our students are learning to support an opinion with an example and an explanation. Use the three frameworks together to decide what the activity should do and how its evidence will guide teaching." zh="我們的學生正在學習以例子及解釋支持觀點。結合三個框架，決定活動要做到甚麼，以及如何用它產生的證據引導教學。" /></p>
<Fragment set:html={frameworkBuildHtml} />
<details class="framework-section" name="tirf-models"><summary><span class="model-number">1</span><span>Black &amp; Wiliam (2009)<small><B en="How will teachers, peers and students support learning?" zh="教師、同伴與學生如何支持學習？" /></small></span></summary><div class="model-content">
<p><B en="The framework brings together the learning target, students’ current understanding and how to move forward. Teachers, peers and students all have a role. Open a strategy’s classroom example to see how it works in our writing class and what you can ask AI to help prepare." zh="框架連結學習目標、學生目前的理解及如何前進。教師、同伴與學生各有角色。展開各策略的課堂例子，可查看本寫作課堂的做法，以及你可請AI協助準備的材料。" /></p>
<TirfStrategyMatrix />
</div></details>
<details class="framework-section" name="tirf-models"><summary><span class="model-number">2</span><span>Hattie &amp; Timperley (2007)<small><B en="What should the feedback focus on?" zh="回饋應聚焦甚麼？" /></small></span></summary><div class="model-content"><h3><B en="A model of feedback" zh="回饋模型" /></h3><p><B en="Use three questions to connect the target, current work and next step. Then choose the feedback level that helps this student. Task feedback concerns the work; process feedback concerns how to do it; self-regulation feedback helps students check and guide their own learning." zh="用三個問題連結目標、目前作品及下一步，再選擇有助這位學生的回饋層面。任務回饋針對作品，過程回饋針對完成方法，自我調節回饋則協助學生自查並引導自己的學習。" /></p><TirfFeedbackModel /><p class="takeaway"><B en="Use this model to design the activity’s hint cards. Each card connects the target, what needs attention and a next step. Choose the feedback focus that helps this student revise." zh="用此模型設計活動的提示卡，每張均連結目標、需要改進之處及下一步，再選擇能幫助這位學生修訂的回饋焦點。" /></p></div></details>
<details class="framework-section" name="tirf-models"><summary><span class="model-number">3</span><span>Gu (2021)<small><B en="How will evidence lead to feedback and action?" zh="證據如何帶來回饋及行動？" /></small></span></summary><div class="model-content"><h3><B en="Learning target, evidence, feedback and action" zh="學習目標、證據、回饋與行動" /></h3><p><B en="Use this framework to design the whole activity around the learning target. Plan what each response will reveal, how you will interpret it, and what students and the teacher will do next. In our case, a choice based on length calls for a follow-up comparison; an unexplained example calls for a hint and revision. Examine later work to see what students can do with less help." zh="用此框架依學習目標設計整體活動：每項作答會呈現甚麼、如何詮釋，以及學生與教師接下來做甚麼。本案例中，以長度選擇就需要再作比較；例子欠解釋就需要提示及修訂。稍後再檢視學生在較少協助下能做到甚麼。" /></p><TirfFramework /></div></details>
<p class="takeaway"><B en="AI can help prepare questions, examples, feedback and activities. The frameworks guide what to ask for, what to check and what teachers and students will do with the result." zh="AI可協助準備問題、例子、回饋及活動；框架則指導我們要求甚麼、核對甚麼，以及教師與學生如何運用結果。" /></p>
</div></section>
<section class="slide" data-title="Design hint cards with AI" data-title-zh="用AI設計提示卡" aria-hidden="true"><div class="slide-inner">
<header class="slide-header"><span class="eyebrow"><B en="Worked example · Hattie and Timperley" zh="完整示範：Hattie與Timperley" /></span></header>
<h2><B en="Design a hint card for this student" zh="為這位學生設計提示卡" /></h2>
<p class="role-note"><B en="Facilitator: demonstrate with Codex. Participants: use the same request in WorkBuddy. Prepare a hint card that helps the student act on the assessment evidence and revise." zh="主持人用Codex示範；參與教師在WorkBuddy使用同一指令。準備提示卡，幫助學生依據評估證據修訂。" /></p>
<p><B en="The student has given a specific example, but the connection is still vague." zh="學生提供了具體例子，但例子與觀點的聯繫仍不清晰。" /></p><blockquote class="student-draft" lang="en" data-classroom-text>{openingExample.draft}</blockquote>
<h3><B en="Ask AI for feedback options" zh="請AI提供回饋選項" /></h3><p><B en="Copy the request and compare the task, process and self-regulation options. For your chosen hint card, identify the target, what needs attention and the next step. These may work together across a short set of cards." zh="複製指令，比較任務、過程及自我調節選項。為選定的提示卡指出目標、需要改進之處及下一步，亦可用一小組卡片互相配合。" /></p>
<details class="prompt-block" open><summary><B en="The request to paste into Codex or WorkBuddy" zh="貼入Codex或WorkBuddy的指令" /></summary><pre data-language="en">{feedbackPrompt.en}</pre><pre data-language="zh" lang="zh-Hant" hidden>{feedbackPrompt.zh}</pre><button data-copy-feedback><B en="Copy feedback request" zh="複製回饋指令" /></button><p class="status" role="status"></p></details>
<details><summary><B en="Compare with these possible comments" zh="與以下可能的回饋比較" /></summary><p><B en="These examples show different feedback choices. AI wording may differ; judge it against the learning target and the student’s actual writing." zh="以下例子展示不同回饋選擇。AI措辭可能不同，請依學習目標及學生實際寫作作判斷。" /></p>{workedFeedback.map(f=><article class="feedback-example"><h3><B en={f.title} zh={f.titleZh} /></h3><blockquote lang="en" data-classroom-text>{f.comment}</blockquote><p data-language="zh" lang="zh-Hant" hidden>{f.commentZh}</p><p><B en={f.why} zh={f.whyZh} /></p></article>)}</details>
<p class="takeaway"><B en="Teacher decision: a process hint is a useful option here because the student needs a way to explain the connection. Give the student time to revise, then read the change." zh="教師決定：本例可選過程提示，因為學生需要構思聯繫的方法。讓學生有時間修訂，再閱讀改動。" /></p>
<label for="feedback-choice"><B en="Your choice as a teacher: which comment would you use or change, and why?" zh="你的教師選擇：會使用或修改哪則回饋？為甚麼？" /></label><textarea id="feedback-choice" data-note="Teacher choice of AI-assisted feedback" rows="3"></textarea>
</div></section>
<section class="slide" data-title="Build a formative assessment activity" data-title-zh="製作形成性評估活動" aria-hidden="true"><div class="slide-inner">
<header class="slide-header"><span class="eyebrow"><B en="Worked example · Bring the frameworks together" zh="完整示範：把三個框架結合" /></span></header>
<h2><B en="Build a formative assessment activity for the writing class" zh="為寫作課堂製作形成性評估活動" /></h2>
<p><B en="Ask the agent to build formative assessment for the writing case using HTML slides or activity screens. Black and Wiliam’s framework guides participation and features; Hattie and Timperley’s model guides the hints; Gu’s framework connects the responses to interpretation and action. " zh="請代理以HTML投影片或活動畫面，為寫作案例製作形成性評估活動。Black與Wiliam引導參與方式及功能，Hattie與Timperley引導提示，Gu則連結作答、詮釋與行動。" /></p>
<p class="takeaway"><B en="Assessment focus: can students choose a relevant example and explain its connection? Use their choices, reasons and revisions to decide the next question, support or extension." zh="評估焦點：學生能否選擇相關例子並解釋聯繫？運用選擇、理由及修訂，決定下一條問題、所需協助或延伸任務。" /></p>
<Fragment set:html={activityBuildHtml} />
<details><summary><B en="Teacher’s lesson sequence" zh="教師的課堂安排" /></summary><ol class="lesson-design">{workedPlan.map(p=><li><h3><B en={p.stage} zh={p.stageZh} /></h3><p><B en={p.design} zh={p.designZh} /></p><p class="framework-link"><B en={p.framework} zh={p.frameworkZh} /></p></li>)}</ol></details>
<p class="takeaway"><B en="Agent workflow: review the plan → create the HTML file → open and try it → repair a problem → try again. Give the agent the learning target, activity features and teacher decisions so it can build an activity that helps teachers and students decide what to do next." zh="代理工作流程：檢視計劃 → 製作HTML檔案 → 開啟並試用 → 修正問題 → 再次試用。提供學習目標、活動功能及教師決定，讓代理製作能幫助教師與學生決定下一步的活動。" /></p>
<div class="actions"><button data-copy-worked><B en="Copy this formative assessment plan" zh="複製這份形成性評估計劃" /></button><button class="secondary" data-jump="7"><B en="See how to make the materials" zh="查看如何製作材料" /></button></div><p class="status" data-worked-status role="status"></p>
</div></section>
<section class="slide" data-title="Design formative assessment for your class" data-title-zh="為自己的班級設計形成性評估" aria-hidden="true"><div class="slide-inner">
<header class="slide-header"><span class="eyebrow"><B en="Your turn · Use the same design steps" zh="你來設計：使用同一組步驟" /></span></header>
<h2><B en="Plan formative assessment for your language class" zh="為自己的語言課堂規劃形成性評估" /></h2>
<p class="role-note"><B en="In pairs, choose a language class and one learning target you need evidence about. Plan a formative assessment activity: what students will reveal, how you will interpret it, and what you and the students will do next. Use this plan in WorkBuddy on the next page." zh="兩人一組，選擇一個語言班級及一項需要蒐集證據的學習目標。規劃形成性評估活動：學生會呈現甚麼、你如何詮釋，以及你與學生接下來做甚麼。下一頁會在WorkBuddy使用這份計劃。" /></p>
<p><B en="Choose a format that makes the evidence useful: HTML slides with a choice-and-reason check, a reading task that asks students to mark evidence and explain an inference, or a dialogue decision task with a reason and a revised response. Plan how each response will guide feedback, support or an extension." zh="選擇能呈現有用證據的形式：設有選擇及理由題的HTML投影片、要求標記證據並解釋推論的閱讀任務，或要求說明理由及修訂作答的對話判斷任務。規劃如何依每項作答決定回饋、協助或延伸任務。" /></p>
{planningGroups.map((g,index)=><section class="planning-group"><h3><B en={g.title} zh={g.titleZh} /></h3><p class="framework-link"><B en={g.link} zh={g.linkZh} /></p><div class="worksheet">{worksheet.filter(w=>w.group===index).map(w=><label for={`brief-${w.id}`}><B en={w.label} zh={w.labelZh} /><textarea id={`brief-${w.id}`} data-brief={w.id} data-placeholder-en={w.help} data-placeholder-zh={w.helpZh} placeholder={w.help} rows="3"></textarea></label>)}</div></section>)}
<div class="actions"><button data-copy-brief><B en="Copy my formative assessment plan" zh="複製我的形成性評估計劃" /></button><button class="secondary" data-jump="7"><B en="Use my plan in WorkBuddy" zh="在WorkBuddy使用我的計劃" /></button></div><p class="status" data-brief-status role="status"></p>
</div></section>
<section class="slide" data-title="Make the materials in WorkBuddy" data-title-zh="在WorkBuddy製作材料" aria-hidden="true"><div class="slide-inner">
<header class="slide-header"><span class="eyebrow"><B en="Use your classroom plan · Facilitator demonstrates in Codex" zh="使用你的課堂計劃；主持人以Codex示範" /></span></header>
<h2><B en="Make the materials in WorkBuddy" zh="在WorkBuddy製作課堂材料" /></h2>
<ol class="build-instructions"><li><strong><B en="Choose a workshop folder and start a task" zh="選擇工作坊資料夾並開始任務" /></strong><p><B en="In WorkBuddy, choose a new empty folder for this activity. You will give it your plan and ask it to create the classroom materials there." zh="在WorkBuddy選擇一個新的空白資料夾，提供你的計劃，請它在這裏製作課堂材料。" /></p></li><li><strong><B en="Ask it to review your classroom plan" zh="請它檢視課堂計劃" /></strong><p><B en="Use request 1 below with your completed plan. Check that the learning target, student responses, feedback and action fit together. Update your plan here with the changes and feedback you choose before making the file." zh="把下方指令一及已完成的計劃貼入對話，核對學習目標、學生作答、回饋及行動能否互相配合，製作檔案前，將你接受的修改及選定的回饋更新到本頁的計劃表。" /></p></li><li><strong><B en="Ask the agent to build, preview and improve the assessment activity" zh="請代理製作、預覽並改進評估活動" /></strong><p><B en="Use request 2 with your reviewed plan and hint cards. Ask the agent to create index.html and teacher notes, open a preview with available tools, try the interactions and repair problems. Open the result yourself and check a student response from the first attempt through revision." zh="使用指令二，加上已檢視的計劃及提示卡。請代理製作index.html及教師備註，使用可用工具開啟預覽、試用互動並修正問題。你亦要自行開啟結果，檢查學生從初次作答到修訂的過程。" /></p></li></ol>
<div class="actions"><button class="secondary" data-jump="6"><B en="Update my plan after the AI review" zh="依AI檢視更新我的計劃" /></button></div><p class="role-note" data-plan-source></p>
{prompts.slice(0,2).map((p,i)=><details class="prompt-block"><summary>{i+1}. <B en={p.title} zh={p.titleZh} /></summary><pre data-language="en">{p.text}</pre><pre data-language="zh" lang="zh-Hant" hidden>{p.textZh}</pre><button data-copy-prompt={i}><B en="Copy request with my classroom plan" zh="複製指令及我的課堂計劃" /></button><p class="status" role="status"></p></details>)}
<p class="takeaway"><B en="The HTML activity supports formative assessment: students respond, use prepared hints, discuss and revise. Teacher notes connect those responses to a follow-up question, teaching support or an extension. Open writing is reviewed by the teacher." zh="HTML活動支持形成性評估：學生作答、運用預先準備的提示、討論及修訂。教師備註把作答連結至追問、教學協助或延伸任務，開放寫作由教師檢視。" /></p>
<details><summary><B en="If you cannot generate a file today" zh="如果今天無法生成檔案" /></summary><p><B en="Use your classroom plan to prepare the student instructions, a feedback comment and a follow-up task on paper. Review them with your partner using the same frameworks. You can build the page later." zh="依課堂計劃，在紙上準備學生指示、一則回饋及一項後續任務，再與同伴依同一組框架檢視；稍後仍可製作網頁。" /></p></details>
<p class="source-note"><B en="WorkBuddy interface labels may vary by version. " zh="WorkBuddy介面文字可能因版本而異。" /><a href="https://cloud.tencent.com/document/product/1831/134389"><B en="WorkBuddy guide" zh="WorkBuddy操作指引" /></a> · <a href="https://cloud.tencent.com/document/product/1831/134400"><B en="Files and preview" zh="檔案與預覽" /></a></p>
</div></section>
<section class="slide" data-title="Review the activity with the frameworks" data-title-zh="依框架檢視活動" aria-hidden="true"><div class="slide-inner">
<header class="slide-header"><span class="eyebrow"><B en="Try the design before using it with students" zh="給學生使用前先試做設計" /></span></header>
<h2><B en="Does the evidence lead to useful action?" zh="證據能否帶來有用的行動？" /></h2>
<p><B en="Swap with your partner. One tries the student activity; the other checks how the teacher will use the responses. If you made paper materials, use them in the same way." zh="與同伴交換，一人試做學生活動，另一人檢查教師會如何運用作答；若準備了紙本材料，也用同一方式試做。" /></p>
<p class="takeaway"><B en="Check the whole design: Black and Wiliam for participation and features; Hattie and Timperley for the hint cards; Gu for evidence, interpretation and what happens next." zh="檢查整體設計：依Black與Wiliam看參與及功能，依Hattie與Timperley看提示卡，依Gu看證據、詮釋及下一步。" /></p>
<div class="review-cases"><h3><B en="Try responses that lead to different teaching decisions" zh="試用需要不同教學決定的作答" /></h3><ul><li><B en="“B, because it is longer”: do the teacher notes suggest checking with equally long examples before drawing a conclusion?" zh="「B，因為較長」：教師備註有否建議先用長度相同的例子核對，再作判斷？" /></li><li><B en="A relevant example with a clear explanation: can the student move on to a new task?" zh="相關例子及清晰解釋：學生可否繼續做新任務？" /></li><li><B en="A relevant example with no explanation: does the feedback help the student add the connection?" zh="有相關例子但沒有解釋：回饋能否幫助學生補上聯繫？" /></li><li><B en="A blank response: does the activity ask the student to try, and can the teacher check what is making the task difficult?" zh="空白作答：活動會否要求學生先嘗試？教師能否了解困難在哪裏？" /></li></ul></div>
<ul class="checks">{[
 ['Students understand what they are learning and what to look for in their work.','學生明白要學甚麼，以及在作品中看甚麼。','Black & Wiliam: learning target','Black與Wiliam：學習目標'],
 ['Every student can show their thinking; the teacher has enough information to decide what to do next.','每位學生能呈現思考，教師有足夠資訊決定下一步。','Black & Wiliam: evidence · Gu: interpretation','Black與Wiliam：證據；Gu：詮釋'],
 ['Feedback points to the target, current work and a useful next step. It helps with the task, method or self-check.','回饋指向目標、目前作品及有用的下一步，幫助學生完成任務、改進方法或自查。','Hattie & Timperley: questions and levels','Hattie與Timperley：問題及層面'],
 ['A partner can help, and the writer can revise and explain a decision.','同伴能提供協助，作者能修訂並解釋決定。','Black & Wiliam: peers and ownership','Black與Wiliam：同伴與自主學習'],
 ['The teacher has a follow-up, and a later task checks what students can do with less help.','教師有後續教學，稍後的新任務能檢視學生在較少協助下的表現。','Gu: action and effect','Gu：行動與效果'],
 ['The activity works on keyboard and phone, preserves actual first and revised writing, and exports it correctly.','活動支援鍵盤及手機，保留實際初稿與修訂，並能正確匯出。','Usability of the classroom materials','課堂材料的可用性'],
 ].map(([en,zh,link,linkZh],i)=><li><label><input type="checkbox" data-check={en} data-check-zh={zh} /><span><B {en} {zh} /><small><B en={link} zh={linkZh} /></small></span></label></li>)}</ul>
<details class="prompt-block"><summary><B en="Ask WorkBuddy to help repair a problem you found" zh="請WorkBuddy協助修正你發現的問題" /></summary><pre data-language="en">{prompts[2].text}</pre><pre data-language="zh" lang="zh-Hant" hidden>{prompts[2].textZh}</pre><button data-copy-prompt="2"><B en="Copy review request with my plan" zh="複製檢視指令及我的計劃" /></button><p class="status" role="status"></p></details>
<label for="repair"><B en="Record one problem, the change you made, and what happened when you tried again" zh="記錄一項問題、你的修改，以及再次試做的結果" /></label><textarea id="repair" data-note="Targeted repair and recheck" rows="3" data-placeholder-en="Example: feedback appeared before any writing → changed the reveal button → a blank response now asks for an attempt." data-placeholder-zh="例如：未寫作已顯示回饋 → 修改顯示按鈕 → 現在空白作答會先要求嘗試。"></textarea>
</div></section>
<section class="slide" data-title="Your formative assessment plan and materials" data-title-zh="你的形成性評估計劃與材料" aria-hidden="true"><div class="slide-inner">
<header class="slide-header"><span class="eyebrow"><B en="Take the design into your classroom" zh="把設計帶回課堂" /></span></header>
<h2><B en="Your formative assessment plan and materials" zh="你的形成性評估計劃與材料" /></h2>
<p><B en="This is the plan you developed. Use it to check your materials before teaching. After the lesson, use students’ responses to decide what support or new task they need." zh="這是你剛才發展的計劃。教學前用它檢視材料；課後依學生作答，決定所需協助或新任務。" /></p>
<div data-plan-summary class="plan-summary" aria-live="polite"></div>
<p class="takeaway"><B en="Keep the connection visible: learning target → student response → interpretation → feedback → student/teacher action. Use the three frameworks to review the whole design." zh="保持連結清晰：學習目標 → 學生作答 → 詮釋 → 回饋 → 學生／教師行動。用三個框架檢視整體設計。" /></p>
<div class="actions"><button data-pdf-open><B en="Download my classroom plan and notes as PDF" zh="下載我的課堂計劃及備註PDF" /></button><button class="secondary" data-jump="6"><B en="Return to my plan" zh="返回我的計劃" /></button></div>
<p class="source-note"><B en="The PDF includes what you typed in this workshop, including any sample student writing. Download before refreshing or closing the page." zh="PDF包括你在本工作坊輸入的內容及模擬學生寫作。請在重新整理或關閉頁面前下載。" /></p>
