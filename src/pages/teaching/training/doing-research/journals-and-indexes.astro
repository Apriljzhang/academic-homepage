---
import CourseSlideLayout from '../../../../layouts/CourseSlideLayout.astro';
import { journalSlides } from '../../../../data/doingResearchJournals';
import { withBase } from '../../../../utils/paths';
import '../../../../styles/training-slides.css';

const title = 'Understanding Journals and Indexes · Doing Research';
const description = 'A bilingual HTML slide presentation on journal fit, indexing, metrics, quartiles and publication requirements.';
---

<CourseSlideLayout {title} {description}>
  <div class="training-presentation" data-training-deck>
    <header class="presentation-header">
      <a href={withBase('/teaching/training/doing-research')}>Doing Research · Topic 1</a>
      <div class="presentation-tools">
        <button type="button" data-deck-language aria-pressed="false">中文</button>
        <button type="button" data-deck-fullscreen>Full screen</button>
      </div>
    </header>
    <main class="presentation-stage" aria-label="Understanding Journals and Indexes presentation">
      {journalSlides.map((slide, index) => (
        <section class:list={['presentation-slide', slide.kind, { 'is-active': index === 0 }]} data-slide-title={slide.title} aria-label={`${index + 1}. ${slide.title}`} aria-hidden={index !== 0} inert={index !== 0}>
          <div class="presentation-inner">
            <p class="slide-eyebrow">Doing Research · {String(index + 1).padStart(2, '0')}</p>
            <div data-deck-panel="en"><h1 set:html={slide.en.heading} /><div class="slide-content" set:html={slide.en.body} /></div>
            <div data-deck-panel="zh" lang="zh-Hant" hidden><h1 set:html={slide.zh.heading} /><div class="slide-content" set:html={slide.zh.body} /></div>
          </div>
        </section>
      ))}
    </main>
    <footer class="presentation-controls">
      <div class="presentation-progress" aria-hidden="true"><span data-deck-progress></span></div>
      <button type="button" data-deck-prev aria-label="Previous slide">← Previous</button>
      <span class="slide-counter" aria-live="polite"><span data-deck-current>1</span> / {journalSlides.length}</span>
      <button type="button" data-deck-next aria-label="Next slide">Next →</button>
      <div class="presentation-secondary">
        <button type="button" data-deck-overview>Overview</button>
        <button type="button" data-deck-print>Print / PDF</button>
      </div>
    </footer>
    <dialog class="presentation-overview" aria-labelledby="overview-heading">
      <div class="overview-header"><h2 id="overview-heading">Slide overview</h2><button type="button" data-deck-close aria-label="Close slide overview">×</button></div>
      <ol>{journalSlides.map((slide, index) => <li><button type="button" data-deck-jump={index}><span>{String(index + 1).padStart(2, '0')}</span>{slide.title}</button></li>)}</ol>
    </dialog>
  </div>
  <script>
    import '../../../../scripts/trainingSlides';
  </script>
</CourseSlideLayout>
