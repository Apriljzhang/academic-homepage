---
import CourseSlideLayout from '../../../../layouts/CourseSlideLayout.astro';
import LessonDeckChrome from '../../../../components/lessons/LessonDeckChrome.astro';
import {submissionSlides} from '../../../../data/doingResearchSubmission';
import {withBase} from '../../../../utils/paths';
import '../../../../styles/doing-research-submission.css';
const title='Preparing a Journal Submission · Doing Research';
const description='A bilingual doctoral lesson on ORCID, writing clear abstracts, journal requirements and finders, authorship, reporting, AI disclosure, cover letters, highlights and submission files.';
const courseHref=withBase('/teaching/training/doing-research');
---
<CourseSlideLayout {title} {description} lessonDeck>
  <LessonDeckChrome {courseHref} lessonTitle="Preparing a journal submission" courseLabel="Doing Research" timer={false} />
  <main class="deck submission-deck" aria-label="Preparing a journal submission slide deck">
    {submissionSlides.map((slide,index)=><section id={slide.id} class:list={['slide',{'is-active':index===0}]} data-title={slide.title} data-title-zh={slide.titleZh} aria-hidden={index!==0} inert={index!==0}>
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">{slide.section}</span></header>
        {slide.cover&&<div class="title-rule"></div>}
        {(['en','zh'] as const).map(lang=><div data-language={lang} lang={lang==='zh'?'zh-Hant':'en-GB'} hidden={lang==='zh'}>
          {slide.cover?<h1>{lang==='zh'?slide.titleZh:slide.title}</h1>:<h2>{lang==='zh'?slide.titleZh:slide.title}</h2>}
          <div class="submission-content" set:html={lang==='zh'?slide.zh:slide.en}></div>
        </div>)}
      </div>
    </section>)}
  </main>
  <script>import '../../../../scripts/doingResearchSubmission';</script>
</CourseSlideLayout>
