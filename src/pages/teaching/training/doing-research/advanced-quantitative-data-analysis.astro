---
import CourseSlideLayout from '../../../../layouts/CourseSlideLayout.astro';
import LessonDeckChrome from '../../../../components/lessons/LessonDeckChrome.astro';
import QuantMethodCard from '../../../../components/lessons/QuantMethodCard.astro';
import { methods, families, jars, examples } from '../../../../data/doingResearchQuantitative';
import { withBase } from '../../../../utils/paths';
import '../../../../styles/dedc02-quantitative-analysis.css';
const title = 'Advanced Quantitative Data Analysis · Doing Research';
const description = 'A question-led doctoral lesson: select a quantitative method, follow worked calculations, interpret outputs and report with JARS–Quant. Includes regression, SEM, mediation, moderation, profiles, assessment, networks and longitudinal models.';
const courseHref = withBase('/teaching/training/doing-research');
const languages = ['en','zh'] as const;
const mById = new Map(methods.map(m => [m.id,m]));
const quizzes = [
 {q:'A regression coefficient is positive and p = .02. Which conclusion is warranted?',qZh:'迴歸係數為正，p=.02。哪個結論有根據？',options:['The predictor causes the outcome.','The estimated conditional association is positive; magnitude, uncertainty and design still matter.','The hypothesis has a 98% probability of being true.'],optionsZh:['預測變量造成結果。','估計的條件關聯為正；仍須考慮大小、不確定性及設計。','假設為真的機率是98%。'],answer:1,why:'The p-value does not establish causality or a probability for the hypothesis.',whyZh:'p值不能確立因果，也不是假設為真的機率。'},
 {q:'A two-wave CLPM has zero degrees of freedom and perfect global fit. What follows?',qZh:'兩波CLPM自由度為零，整體擬合完美。可作何推論？',options:['The causal model is proven.','The within-person mechanism is established.','Global fit cannot test a saturated specification; temporal association remains model-dependent.'],optionsZh:['因果模型已獲證明。','個體內機制已確立。','整體擬合不能檢驗飽和設定；時間關聯仍依賴模型。'],answer:2,why:'Saturation is a property of the specification, not evidence that its causal ordering is true.',whyZh:'飽和是模型設定的性質，不是因果排序為真的證據。'},
 {q:'A three-profile LPA has high entropy. How should you choose the profile count?',qZh:'三剖面LPA的entropy很高。應如何決定剖面數？',options:['Choose three from entropy alone.','Compare fit, replicated solutions, profile sizes, stability and interpretability; retain classification uncertainty.','Treat each profile as a permanent learner type.'],optionsZh:['只憑entropy選三個。','綜合擬合、解的重現、剖面大小、穩定性與可解釋性，保留分類不確定性。','把剖面視為固定學習者類型。'],answer:1,why:'Entropy describes separation within a solution. It is not a stand-alone enumeration criterion.',whyZh:'Entropy描述特定解中的分類分離程度，不能單獨決定剖面數。'},
 {q:'A network edge connects anxiety and engagement. What does an undirected edge show?',qZh:'網絡中焦慮與投入之間有一條無向邊。它顯示甚麼？',options:['A modelled conditional association.','Reciprocal causal influence.','The best target for an intervention.'],optionsZh:['模型化的條件關聯。','雙向因果影響。','最佳干預目標。'],answer:0,why:'A cross-sectional undirected network does not identify causal direction or intervention effects.',whyZh:'橫斷無向網絡不能辨識因果方向或干預效果。'},
];
const semChecks = [
 ['Specify measurement and structural models, identification, free/fixed parameters and directionality.','交代測量及結構模型、識別、自由／固定參數與方向理據。'],
 ['Describe indicators, scoring, ordinal/continuous treatment, estimator, missingness and dependence.','交代指標、計分、序位／連續處理、估計法、缺失及依賴。'],
 ['Report convergence, inadmissible solutions, global and local fit, and justified model comparisons.','報告收斂、不容許解、整體與局部擬合，以及有理據的模型比較。'],
 ['Report unstandardised and standardised estimates, SEs, intervals and the inferential method.','報告未標準化及標準化估計、標準誤、區間與推論方法。'],
 ['Disclose respecification and alternative/equivalent models; explain indirect and interaction effects.','披露重新設定、替代／等價模型，並解釋間接與交互作用效果。'],
];
---
<CourseSlideLayout {title} {description} lessonDeck>
<LessonDeckChrome {courseHref} lessonTitle="Advanced Quantitative Data Analysis" />
<main class="deck qm-deck" data-method-catalogue="advanced" aria-label="Advanced Quantitative Data Analysis slide deck">
<section class="slide is-active" data-title="Advanced Quantitative Data Analysis" aria-hidden="false"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Doing Research · Topic 2</span></header><div class="title-rule"></div>{languages.map(lang=><div data-language={lang} hidden={lang==='zh'} lang={lang==='zh'?'zh-Hant':'en'}><h1>{lang==='zh'?<>進階量化<br/>資料分析</>:<>Advanced Quantitative<br/>Data Analysis</>}</h1><p class="lead">{lang==='zh'?'我們想知道甚麼？需要哪些資料？哪種方法切合？輸出容許甚麼結論？':'What do we want to know? What data would answer it? Which method fits? What can the output support?'}</p></div>)}</div></section>
<section class="slide" data-title="Learning aims" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Learning aims</span></header>{languages.map(lang=><div data-language={lang} hidden={lang==='zh'} lang={lang==='zh'?'zh-Hant':'en'}><h2>{lang==='zh'?'學習目標':'Learning aims'}</h2><p class="lead">{lang==='zh'?'完成本課後，你應能：':'By the end of the lesson, you should be able to:'}</p><ol>{(lang==='zh'?['根據研究問題、結果變量類型及資料的依賴結構，選擇並論證合適的量化分析方法。','解釋關鍵計算，並解讀輸出中的估計值、尺度及不確定性。','區分關聯、預測、時間順序及有研究設計支持的因果主張。','運用JARS–Quant及適用的報告模組，清楚呈現分析與結果。']:['Select and justify quantitative methods based on the research question, outcome type and dependence structure of the data.','Explain key calculations and interpret estimates, scales and uncertainty in the outputs.','Distinguish association, prediction, temporal ordering and causal claims supported by the research design.','Report analyses and results clearly using JARS–Quant and relevant reporting modules.']).map(s=><li>{s}</li>)}</ol></div>)}</div></section>
<section class="slide" data-title="The expanded quantitative method map" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Map · Explore by research purpose</span></header>{languages.map(lang=><div data-language={lang} hidden={lang==='zh'} lang={lang==='zh'?'zh-Hant':'en'}><h2>{lang==='zh'?'擴充量化分析方法圖譜':'The expanded quantitative method map'}</h2><p>{lang==='zh'?'按研究問題組織方法。打開分支，再選一項方法返回互動選擇器。各分支可以重疊；估計與不確定性屬跨方法的決定。':'Methods are organised by their questions. Open a branch and choose a method to explore it in the selector. Branches can overlap; estimation and uncertainty are decisions across methods.'}</p><div class="qm-search"><label>{lang==='zh'?'搜尋方法':'Find a method'}<input type="search" data-map-search placeholder={lang==='zh'?'例如：剖面、mediation、Rasch':'Try profiles, mediation, Rasch'} /></label><p data-map-status role="status"></p></div><div class="qm-atlas">{families.map(f=><details data-map-family><summary>{lang==='zh'?f.zh:f.en} <span class="qm-caption">({methods.filter(m=>m.family===f.id).length})</span></summary><p>{lang==='zh'?f.promptZh:f.prompt}</p><ul>{methods.filter(m=>m.family===f.id).map(m=><li data-map-entry data-search={`${m.name} ${m.zh} ${m.question} ${m.translated.question}`}><button type="button" class="qm-plain" data-open-method={m.id}>{lang==='zh'?m.zh:m.name}</button></li>)}</ul></details>)}</div></div>)}</div></section>
<section class="slide" data-title="Select a method from the question and data" data-method-selector-slide aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Activity 1 · Question and data selector</span></header>{languages.map(lang=><div data-language={lang} hidden={lang==='zh'} lang={lang==='zh'?'zh-Hant':'en'}><h2>{lang==='zh'?'依問題與資料選擇方法':'Select a method from the question and data'}</h2><p>{lang==='zh'?'選擇研究目的，再選擇具體問題及觀察結構。候選方法會顯示其資料要求、計算、輸出解讀與限制。':'Choose a research purpose, then a specific question and observation structure. The candidate method reveals its data requirements, calculation, interpretation and limits.'}</p><div class="qm-picker" data-picker data-picker-language={lang}><label>{lang==='zh'?'1. 你主要想知道甚麼？':'1. What is your main research purpose?'}<select data-purpose><option value="">{lang==='zh'?'選擇研究目的……':'Select a research purpose…'}</option>{families.map(f=><option value={f.id}>{lang==='zh'?f.zh:f.en}</option>)}</select></label><label>{lang==='zh'?'2. 哪個問題最接近你的研究？':'2. Which question best matches your study?'}<select data-scenario disabled><option value="">{lang==='zh'?'先選擇研究目的……':'Choose a purpose first…'}</option></select></label><p class="qm-note" data-required hidden></p><fieldset><legend>{lang==='zh'?'3. 觀察值如何互相關聯？':'3. How are the observations related?'}</legend>{[['independent','Independent observations','獨立觀察'],['repeated','Repeated observations from the same people','同一人的重複觀察'],['clustered','Nested or crossed observations, such as pupils, classes, raters or items','巢套或交叉觀察，例如學生、班級、評分者或項目'],['unknown','Not yet established','尚未確定']].map(([id,en,zh])=><label><input type="radio" name={`structure-${lang}`} value={id} data-structure/>{lang==='zh'?zh:en}</label>)}</fieldset><button class="qm-primary" type="button" data-show-method disabled>{lang==='zh'?'顯示候選方法與計算':'Show candidate method and calculation'}</button><p data-picker-status role="status"></p></div><div class="qm-result" data-picker-result hidden><p class="qm-note" data-dependence-note hidden></p>{methods.map(m=><div data-candidate={m.id} hidden><QuantMethodCard method={m} language={lang} compact/></div>)}</div><p class="qm-print-note">{lang==='zh'?'列印會包括你目前選擇的方法。':'The selected method, if any, is included in the printout.'}</p></div>)}</div></section>
<section class="slide" data-title="JARS–Quant reporting checklist" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Reporting · JARS–Quant</span></header>{languages.map(lang=><div data-language={lang} hidden={lang==='zh'} lang={lang==='zh'?'zh-Hant':'en'}><h2>{lang==='zh'?'清楚交代量化分析與結果':'Make quantitative analysis and results transparent'}</h2><p>{lang==='zh'?'以JARS–Quant作量化分析的報告依據。以下是課堂用摘要，應對照完整表格及目標期刊要求。勾選代表已找到可查核的報告位置，並非模型已獲驗證。':'Use JARS–Quant to guide quantitative reporting. This classroom companion condenses reporting prompts; consult the complete table and target journal. A tick means you can locate the reported evidence, not that the analysis is valid.'}</p><p class="qm-source"><a href="https://apastyle.apa.org/jars/quant-table-1.pdf" target="_blank" rel="noopener noreferrer">APA JARS–Quant · Table 1</a></p><div class="qm-checks">{jars.map(j=><label><input type="checkbox" data-jars={j.id}/><span><strong>{lang==='zh'?j.zh:j.en}</strong><small>{lang==='zh'?j.detailZh:j.detail}</small></span></label>)}</div><p data-jars-status role="status"></p></div>)}</div></section>
<section class="slide" data-title="Method-specific reporting modules" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Reporting · Match the model</span></header>{languages.map(lang=><div data-language={lang} hidden={lang==='zh'} lang={lang==='zh'?'zh-Hant':'en'}><h2>{lang==='zh'?'按方法增加報告內容':'Add the reporting module your method needs'}</h2><details open><summary>SEM / CFA · <a href="https://apastyle.apa.org/jars/quant-table-7.pdf" target="_blank" rel="noopener noreferrer">JARS Table 7</a></summary><ul>{semChecks.map(([en,zh])=><li>{lang==='zh'?zh:en}</li>)}</ul></details><details><summary>{lang==='zh'?'貝葉斯估計':'Bayesian estimation'} · <a href="https://apastyle.apa.org/jars/quant-table-8.pdf" target="_blank" rel="noopener noreferrer">JARS Table 8</a></summary><p>{lang==='zh'?'交代模型、先驗與敏感度、後驗與可信區間、計算／收斂診斷及預測檢查；如比較模型，說明比較與先驗依賴。':'Report the model, priors and sensitivity, posteriors and credible intervals, computation/convergence and predictive checks; explain model comparisons and prior dependence.'}</p></details><details><summary>{lang==='zh'?'統合分析':'Meta-analysis'} · <a href="https://apastyle.apa.org/jars/quant-table-9.pdf" target="_blank" rel="noopener noreferrer">JARS Table 9</a></summary><p>{lang==='zh'?'交代搜尋、納入與編碼、效果量與依賴、異質性、調節分析，以及偏誤與敏感度。':'Report searching, eligibility and coding; effect sizes and dependence; heterogeneity, moderators, bias and sensitivity.'}</p></details><p class="qm-note">{lang==='zh'?'報告完整性與分析適切性是兩個判斷：清楚報告的模型仍可能不切合問題或設計。':'Reporting completeness and analytical validity are separate judgements: a fully described model may still be unsuitable for the question or design.'}</p></div>)}</div></section>
<section class="slide" data-title="Sources and lesson printout" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Sources and closing tools</span></header>{languages.map(lang=><div data-language={lang} hidden={lang==='zh'} lang={lang==='zh'?'zh-Hant':'en'}><h2>{lang==='zh'?'方法來源與課堂匯出':'Sources and lesson printout'}</h2><p>{lang==='zh'?'每個方法的例子連回文獻庫中的實際應用。計算使用另行指定的教學數值；不要把教學值當成原研究發現。':'Each method links to an application in the reading vault. Calculations use separately supplied teaching values; do not attribute those values to the empirical studies.'}</p><ul class="qm-reference-list"><li><a href="https://apastyle.apa.org/jars/quantitative" target="_blank" rel="noopener noreferrer">APA JARS–Quant: full reporting tables</a></li><li><a href="https://apastyle.apa.org/instructional-aids/numbers-statistics-guide.pdf" target="_blank" rel="noopener noreferrer">APA Numbers and Statistics Guide</a></li><li><a href="https://lavaan.ugent.be/tutorial/cfa.html" target="_blank" rel="noopener noreferrer">CFA: measurement-model reference</a> · <a href="https://lavaan.ugent.be/tutorial/sem.html" target="_blank" rel="noopener noreferrer">SEM reference</a> · <a href="https://lavaan.ugent.be/tutorial/mediation.html" target="_blank" rel="noopener noreferrer">Indirect-effect reference</a></li><li><a href="https://www.statmodel.com/HTML_UG/chapter7V8.htm" target="_blank" rel="noopener noreferrer">Mixture models: model definitions and estimation reference</a></li></ul><div class="qm-controls"><button type="button" class="qm-primary" data-print>{lang==='zh'?'列印／另存課堂PDF':'Print / save lesson PDF'}</button><button type="button" data-return-selector>{lang==='zh'?'返回方法選擇器':'Return to method selector'}</button></div><p class="qm-caption">{lang==='zh'?'列印包含英文課堂內容、目前選定的方法與已儲存回應。可在系統列印視窗選擇另存PDF；此工具不是另一項活動。':'The printout includes the English lesson, currently selected method and saved responses. Choose Save as PDF in the system print dialog. This closing tool is not an additional activity.'}</p><a href={courseHref}>{lang==='zh'?'Doing Research主題':'Doing Research topics'}</a></div>)}</div></section>
</main>
<script>import '../../../../scripts/dedc02QuantitativeAnalysis';</script>
</CourseSlideLayout>