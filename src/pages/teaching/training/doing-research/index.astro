---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
import PageShell from '../../../../components/PageShell.astro';
import { person } from '../../../../data/cv';
import { doingResearchTheme } from '../../../../data/training';
import { withBase } from '../../../../utils/paths';

const title = `${doingResearchTheme.title} · ${person.fullDisplayName}`;
const description = doingResearchTheme.description;
---

<BaseLayout {title} {description}>
  <SiteHeader />
  <main id="main-content" class="min-h-[50vh] w-full bg-page">
    <PageShell accentBar>
      <p class="type-label text-secondary">Research methods and publication practice</p>
      <h1 class="mt-2 font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl lg:text-5xl">Doing Research</h1>
      <p class="type-intro mt-4">{doingResearchTheme.description}</p>

      <a href={withBase('/teaching/training/doing-research/overview/')} class="research-overview group mt-8 grid max-w-4xl overflow-hidden rounded-lg border border-border bg-surface no-underline transition hover:border-secondary sm:grid-cols-[180px_1fr]">
        <img src={withBase('/teaching/training/doing-research/research-methods-preview.svg')} alt="" width="180" height="180" class="h-40 w-full object-contain bg-[#101c29] sm:h-full" />
        <div class="p-5 sm:p-6">
          <span class="text-sm font-semibold text-secondary">Overview</span>
          <h2 class="mt-1 text-xl font-semibold text-ink group-hover:text-secondary">Research methods in education</h2>
          <p class="mt-2 max-w-prose text-base text-ink">Explore how philosophical foundations connect to research approaches, methods, tools and analysis.</p>
          <span class="mt-3 inline-block text-sm font-semibold text-secondary">Explore the map</span>
        </div>
      </a>

      <section class="mt-8 max-w-4xl border-t border-border pt-6" aria-labelledby="topics-heading">
        <h2 id="topics-heading" class="type-label text-secondary">Topics</h2>
        <ol class="mt-4 grid gap-2 sm:grid-cols-2">
          {doingResearchTheme.sessions.map((session) => (
            <li>
              <a href={withBase(`/teaching/training/${doingResearchTheme.slug}/${session.slug}`)} class="group flex items-center justify-between gap-3 border-b border-border py-3 no-underline transition hover:text-secondary">
                <span class="text-base font-semibold text-ink group-hover:text-secondary">{session.number}. {session.title}</span>
                <span class="shrink-0 text-lg text-secondary" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <a href={withBase('/teaching/training')} class="mt-8 inline-flex text-sm font-semibold">← Back to Training</a>
    </PageShell>
  </main>
  <SiteFooter />
</BaseLayout>
