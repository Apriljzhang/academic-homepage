---
import CourseSlideLayout from '../../../../layouts/CourseSlideLayout.astro';
import LessonDeckChrome from '../../../../components/lessons/LessonDeckChrome.astro';
import { withBase } from '../../../../utils/paths';
import '../../../../styles/dedc02-research-ethics.css';

const title = 'Research Ethics and Integrity · DEDC02';
const description = 'A bilingual doctoral workshop on research ethics and integrity, with practical IRB application, consent, risk, confidentiality and data management examples.';
const courseHref = withBase('/teaching/courses/dedc02');

const principles = [
  { n: '01', en: 'Benefit and harm', zh: '益處與傷害', meaningEn: 'Seek benefits for people and society while reducing foreseeable risks and harms.', meaningZh: '爭取對個人及社會的益處，同時降低可預見的風險與傷害。' },
  { n: '02', en: 'Rights and dignity', zh: '權利與尊嚴', meaningEn: 'Respect the rights and dignity of individuals and groups affected by the study.', meaningZh: '尊重研究所影響的個人及群體的權利與尊嚴。' },
  { n: '03', en: 'Informed, voluntary participation', zh: '知情與自願參與', meaningEn: 'Where possible, people should choose freely on the basis of suitable information.', meaningZh: '在可行情況下，參與者應根據合適資訊自由作出決定。' },
  { n: '04', en: 'Integrity and transparency', zh: '誠信與透明', meaningEn: 'Carry out the study honestly and make its conduct and reporting transparent.', meaningZh: '誠實進行研究，並透明交代研究過程及報告。' },
  { n: '05', en: 'Responsibility and accountability', zh: '責任與問責', meaningEn: 'Make clear who is responsible for decisions, safeguards and responses.', meaningZh: '清楚界定誰負責決策、保障措施及事件應對。' },
  { n: '06', en: 'Independence and conflicts', zh: '獨立性與利益衝突', meaningEn: 'Protect research independence and disclose unavoidable conflicts.', meaningZh: '維護研究獨立性，並披露無法避免的利益衝突。' },
];

const applicationFields = [
  { en: 'Purpose and design', zh: '目的與設計', askEn: 'Why is this question worth asking, and why are these methods necessary?', askZh: '為何值得研究此問題？為何需要採用這些方法？' },
  { en: 'People and recruitment', zh: '參與者與招募', askEn: 'Who is approached, by whom, where, and with what power relationship?', askZh: '誰會被邀請？由誰、在何處邀請？涉及甚麼權力關係？' },
  { en: 'Procedures and instruments', zh: '程序與工具', askEn: 'What exactly will participants do, see, answer or allow access to?', askZh: '參與者具體會做、看、回答甚麼？研究者可查閱甚麼？' },
  { en: 'Consent and choice', zh: '同意與選擇', askEn: 'How are participation, recording and future use explained and decided?', askZh: '如何說明及決定參與、錄音錄影與日後使用？' },
  { en: 'Risk and response', zh: '風險與應對', askEn: 'What is foreseeable, how is it reduced, and who responds if it happens?', askZh: '哪些風險可預見？如何降低？若發生，誰會回應？' },
  { en: 'Data and outputs', zh: '資料與成果', askEn: 'What is collected, stored, accessed, retained, shared or destroyed?', askZh: '蒐集、儲存、存取、保存、分享或銷毀甚麼資料？' },
];

const lifecycle = [
  { n: '1', en: 'Collect', zh: '蒐集', qEn: 'What is the minimum data needed? Are identifiers necessary?', qZh: '最少需要甚麼資料？是否必須收集身份資料？' },
  { n: '2', en: 'Transfer', zh: '傳輸', qEn: 'How do files move from device or platform to approved storage?', qZh: '檔案如何由裝置或平台移至獲准儲存位置？' },
  { n: '3', en: 'Separate', zh: '分隔', qEn: 'Where is the identity key kept, and who can reach it?', qZh: '身份對照表存放何處？誰可接觸？' },
  { n: '4', en: 'Use', zh: '使用', qEn: 'Who has access, and can a tool or vendor see the raw data?', qZh: '誰有存取權？工具或供應商可否看見原始資料？' },
  { n: '5', en: 'Report', zh: '報告', qEn: 'Could quotes or small-group details reveal a person or school?', qZh: '引文或小群體細節會否暴露個人或學校？' },
  { n: '6', en: 'Retain / dispose', zh: '保存／銷毀', qEn: 'What period, location, owner and deletion route are justified?', qZh: '保存期限、地點、責任人及銷毀方法有何理據？' },
];

const reviewChecks = [
  { en: 'The application and attachments describe the same people, tasks and data.', zh: '申請表與附件對參與者、任務及資料的描述一致。' },
  { en: 'A person can decline or withdraw without a teacher or gatekeeper penalising them.', zh: '參與者可拒絕或退出，且不會受教師或守門人不利對待。' },
  { en: 'Each important risk has a prevention step, a response and a named owner.', zh: '每項重要風險均有預防措施、應對方法及負責人。' },
  { en: 'The consent text states what is recorded, who sees it and the limits to withdrawal.', zh: '同意文件說明紀錄內容、存取者及退出資料的限制。' },
  { en: 'The data plan names tools, locations, access, retention and disposal.', zh: '資料計劃列明工具、地點、權限、保存及銷毀。' },
  { en: 'Claims about anonymity, benefit and approval match what can actually be promised.', zh: '關於匿名、益處及批准的承諾符合實際情況。' },
];

const creditRoles = [
  ['Conceptualization', '研究構思'], ['Methodology', '研究方法'], ['Investigation', '研究執行'], ['Data curation', '資料整理'],
  ['Formal analysis', '正式分析'], ['Validation', '驗證'], ['Software', '軟件'], ['Visualization', '視覺化'],
  ['Resources', '資源'], ['Funding acquisition', '經費取得'], ['Project administration', '項目管理'], ['Supervision', '督導'],
  ['Writing – original draft', '初稿撰寫'], ['Writing – review & editing', '審閱與修訂'],
];
---

<CourseSlideLayout {title} {description} lessonDeck>
  <section class="pdf-cover" aria-hidden="true">
    <span class="eyebrow">DEDC02 · Advanced Research Method</span>
    <h1>Research Ethics<br />and Integrity</h1>
    <p>Consent · risk · confidentiality · data management · research integrity</p>
  </section>
  <LessonDeckChrome {courseHref} lessonTitle="Research Ethics and Integrity" />
  <main class="deck" aria-label="Research Ethics and Integrity slide deck">
    <section class="slide is-active" data-title="Research Ethics and Integrity" aria-hidden="false">
      <div class="slide-inner title-slide">
        <header class="slide-header"><span class="eyebrow">DEDC02 · Advanced Research Method</span></header>
        <div class="title-rule"></div>
        <div data-language="en">
          <h1>Research<br />Ethics and<br />Integrity</h1>
          <p class="lead">Follow one social science study from ethical design and IRB review through consent, risk, data and the integrity of its published record.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h1>研究倫理<br />與研究誠信</h1>
          <p class="lead">以一項社會科學研究貫穿倫理設計、IRB審查、知情同意、風險、資料管理及發表誠信。</p>
        </div>
      </div>
    </section>

    <section class="slide cloud-slide" data-title="Opening word cloud" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Opening activity · shared word cloud</span></header>
        <div data-language="en">
          <h2>What comes to mind when you hear “research ethics and integrity”?</h2>
          <p class="lead small">Add up to three general words or brief phrases from your own device, without names or personal details.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>聽到「研究倫理與研究誠信」，你會想到甚麼？</h2>
          <p class="lead small">用自己的裝置提交最多三個一般詞語或短語，避免姓名及個人資料。</p>
        </div>
        <div class="cloud-links" aria-label="Word cloud views">
          <a href="?cloud=student#slide-2" data-cloud-open="student"><span data-cloud-en="Students" data-cloud-zh="學生">Students</span><strong data-cloud-en="Add your words ↗" data-cloud-zh="提交詞語 ↗">Add your words ↗</strong></a>
          <a href="?cloud=instructor#slide-2" data-cloud-open="instructor"><span data-cloud-en="Instructor" data-cloud-zh="教師">Instructor</span><strong data-cloud-en="View the word cloud ↗" data-cloud-zh="查看詞雲 ↗">View the word cloud ↗</strong></a>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Learning aims" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Learning aims</span></header>
        <div data-language="en">
          <h2>You should be able to…</h2>
          <ol class="aims-list">
            <li><strong>Apply ethical principles</strong> to questions of autonomy, harm, dignity and independence in social science research.</li>
            <li><strong>Review an IRB package</strong> for consistency across recruitment, procedures, consent, risk and safeguards.</li>
            <li><strong>Explain meaningful consent</strong> and plan confidentiality and data management from collection through disposal.</li>
            <li><strong>Assign authorship and CRediT roles responsibly</strong> while managing conflicts of interest and dual roles.</li>
            <li><strong>Recognise threats to the research record</strong>, including fabrication, falsification, plagiarism and selective reporting.</li>
            <li><strong>Apply journal AI policies</strong> to disclosure, participant data protection and verification of AI-assisted work.</li>
          </ol>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>你應能……</h2>
          <ol class="aims-list">
            <li><strong>應用倫理原則</strong>，評估社會科學研究中的自主、傷害、尊嚴與獨立性問題。</li>
            <li><strong>審閱整套IRB材料</strong>，核對招募、研究程序、知情同意、風險及保障措施是否一致。</li>
            <li><strong>解釋有意義的知情同意</strong>，並規劃資料蒐集至銷毀過程中的保密及管理安排。</li>
            <li><strong>負責任地釐定作者署名與CRediT角色</strong>，並處理利益衝突與雙重角色。</li>
            <li><strong>辨識損害研究紀錄可信度的做法</strong>，包括捏造、篡改、剽竊及選擇性報告。</li>
            <li><strong>應用期刊AI政策</strong>，披露使用方式、保護參與者資料並核查AI輔助研究成果。</li>
          </ol>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Opening dilemma" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Opening dilemma · vote and discuss</span></header>
        <div data-language="en">
          <h2>A teacher invites their own students into a doctoral study.</h2>
          <p class="lead small">Fictional case: the study uses classroom writing, interviews and AI-platform logs from 16-year-old students. The invitation is about to go into the class chat.</p>
          <p class="prompt-label">Which first redesign best addresses the immediate pressure to participate?</p>
          <div class="choice-row" data-choice-group>
            <button type="button" data-choice="a" aria-pressed="false">A · Ask students to sign during class</button>
            <button type="button" data-choice="b" aria-pressed="false">B · Use an independent invitation route</button>
            <button type="button" data-choice="c" aria-pressed="false">C · Keep only the platform logs</button>
            <p data-choice-feedback role="status">Choose privately, then defend your choice with a partner.</p>
          </div>
          <details class="reveal"><summary>Compare the reasoning after discussion</summary><p><strong>B</strong> tackles the teacher–student power relationship most directly. The study still needs decisions about student assent, guardian permission, school access, recording, platform data and who learns who declined.</p></details>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>教師邀請自己任教的學生參與博士研究。</h2>
          <p class="lead small">虛構案例：研究使用16歲學生的課堂寫作、訪談及AI平台紀錄；邀請即將發送至班級群組。</p>
          <p class="prompt-label">哪項初步修改最能處理參與壓力？</p>
          <div class="choice-row" data-choice-group>
            <button type="button" data-choice="a" aria-pressed="false">A · 在課堂上請學生簽名</button>
            <button type="button" data-choice="b" aria-pressed="false">B · 由獨立渠道發出邀請</button>
            <button type="button" data-choice="c" aria-pressed="false">C · 只保留平台紀錄</button>
            <p data-choice-feedback role="status">先自行選擇，再向同伴解釋理由。</p>
          </div>
          <details class="reveal"><summary>討論後比較推理</summary><p><strong>B</strong> 最直接處理師生權力關係。研究仍須決定學生同意參與、監護人許可、學校准入、錄音錄影、平台資料，以及誰會知道哪些人拒絕參與等問題。</p></details>
        </div>
      </div>
    </section>

    <section class="slide principle-slide" data-title="ESRC principles for ethical research" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">ESRC / UKRI · framework for research ethics</span></header>
        <div data-language="en">
          <h2>Six principles for ethical social research</h2>
          <p class="source-context"><strong>Source:</strong> The UK Economic and Social Research Council’s <a href="https://www.ukri.org/councils/esrc/guidance-for-applicants/research-ethics-guidance/framework-for-research-ethics/our-core-principles/" target="_blank" rel="noopener noreferrer">Framework for Research Ethics ↗</a> guides researchers, organisations and ethics committees. It treats ethics as a responsibility from study design through publication and data reuse.</p>
          <div class="principle-grid">
            {principles.map((item) => <article><b>{item.n}</b><h3>{item.en}</h3><p>{item.meaningEn}</p></article>)}
          </div>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>社會科學研究的六項倫理原則</h2>
          <p class="source-context"><strong>來源：</strong>英國經濟與社會研究理事會（ESRC）的<a href="https://www.ukri.org/councils/esrc/guidance-for-applicants/research-ethics-guidance/framework-for-research-ethics/our-core-principles/" target="_blank" rel="noopener noreferrer">《研究倫理框架》↗</a>為研究者、機構及倫理審查委員會提供指引；倫理責任貫穿研究設計、發表及資料再用。</p>
          <div class="principle-grid">
            {principles.map((item) => <article><b>{item.n}</b><h3>{item.zh}</h3><p>{item.meaningZh}</p></article>)}
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Ethics and integrity across the project" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">ESRC / UKRI · ethics across the research lifecycle</span></header>
        <div data-language="en">
          <h2>Ethics continues after approval</h2>
          <p class="source-context"><strong>ESRC framework:</strong> Ethical reflection covers planning, fieldwork, dissemination, archiving, sharing and future use of data. Responsibility continues throughout these stages after approval.</p>
          <div class="comparison">
            <article><span>Before collection</span><h3>Design and review</h3><p>Specify recruitment, consent, instruments, foreseeable risks and data routes; obtain required permissions and ethics approval.</p></article>
            <article><span>During collection</span><h3>Notice and respond</h3><p>Revisit consent; watch for distress, pressure, unintended disclosure and changes to the approved procedure.</p></article>
            <article><span>After collection</span><h3>Protect and report</h3><p>Limit access, check quotations for identifiability, honour the data plan, report findings faithfully and credit contributors.</p></article>
          </div>
          <p class="takeaway">A course application draft is a reasoning exercise. Recruitment and human-participant data collection require formal ethics approval first.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>倫理責任貫穿研究全程</h2>
          <p class="source-context"><strong>ESRC框架：</strong>倫理判斷涵蓋規劃、田野工作、成果傳播、資料存檔、分享及日後使用。獲批後，這份責任仍持續貫穿各個階段。</p>
          <div class="comparison">
            <article><span>蒐集前</span><h3>設計與審查</h3><p>具體說明招募、同意、工具、可預見風險及資料流向；取得所需准許及倫理批准。</p></article>
            <article><span>蒐集中</span><h3>察覺與回應</h3><p>持續確認同意；留意不適、壓力、意外披露，以及對已獲批程序的變更。</p></article>
            <article><span>蒐集後</span><h3>保障與報告</h3><p>限制存取、檢查引文可識別性、遵守資料計劃、如實報告發現，並肯定貢獻者。</p></article>
          </div>
          <p class="takeaway">課堂申請草稿是倫理推理練習。招募或蒐集人類參與者資料前，須先取得正式倫理批准。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Case dossier" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Application anatomy</span></header>
        <div data-language="en">
          <h2>Read the case like an ethics reviewer.</h2>
          <div class="case-layout">
            <article class="case-file"><span>Fictional proposal</span><h3>AI writing feedback in secondary school</h3><ul><li>The teacher-researcher recruits their own class.</li><li>Student drafts, interviews and platform logs are combined.</li><li>Interview quotations may appear in a journal article.</li><li>The draft says: “Participation is voluntary and all data are anonymous.”</li></ul></article>
            <aside class="reviewer-prompts"><h3>Reviewer’s questions</h3><ul><li>Who invites students, and who learns who declined?</li><li>What information leaves the AI platform?</li><li>Could a quotation identify a student or the school?</li></ul><p>Which answer would most change the design? Discuss with a partner.</p></aside>
          </div>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>以倫理審查者角度閱讀案例。</h2>
          <div class="case-layout">
            <article class="case-file"><span>虛構研究方案</span><h3>中學AI寫作回饋</h3><ul><li>教師研究者招募自己任教的班級。</li><li>合併學生草稿、訪談及平台紀錄。</li><li>期刊論文可能使用訪談引文。</li><li>草稿寫道：「參與完全自願，所有資料均匿名。」</li></ul></article>
            <aside class="reviewer-prompts"><h3>審查者可能會問</h3><ul><li>誰邀請學生？誰會知道哪些人拒絕？</li><li>甚麼資料會離開AI平台？</li><li>引文能否識別學生或學校？</li></ul><p>哪一個答案最可能改變研究設計？與同伴討論。</p></aside>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="The IRB application package" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">CityU School of Education · ethics application</span></header>
        <div data-language="en">
          <h2>What goes into the ethics application?</h2>
          <p class="source-context"><strong>Local source:</strong> The <a href="https://soe.cityu.edu.mo/en/notice/393" target="_blank" rel="noopener noreferrer">CityU School of Education notice ↗</a> asks students for supervisor approval, an application form or statement, the proposal and research tools, including consent materials where relevant. Data collection starts only after approval.</p>
          <div class="package-grid">
            <article><span>Core</span><h3>Application and protocol</h3><p>Purpose, people, procedure, benefits, risks, safeguards and responsibilities.</p></article>
            <article><span>Participant-facing</span><h3>Recruitment and consent</h3><p>Invitation, information sheet, consent choices, assent or guardian materials where relevant.</p></article>
            <article><span>Method-facing</span><h3>Instruments and permissions</h3><p>Questionnaires, guides, observation plans, access letters and debriefing where relevant.</p></article>
            <article><span>Data-facing</span><h3>Data management</h3><p>Data-flow map, access roles, third-party services, retention and disposal.</p></article>
          </div>
          <p class="takeaway">Attach only what the proposed design actually needs. Every attachment should agree with the application.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>倫理申請需要哪些材料？</h2>
          <p class="source-context"><strong>本地來源：</strong><a href="https://soe.cityu.edu.mo/en/notice/393" target="_blank" rel="noopener noreferrer">澳門城市大學教育學院通知 ↗</a>要求導師批准、申請表或聲明、研究計劃及研究工具；相關時亦需附上知情同意材料。獲批准前不得開始蒐集資料。</p>
          <div class="package-grid">
            <article><span>核心</span><h3>申請表與方案</h3><p>目的、參與者、程序、益處、風險、保障及責任。</p></article>
            <article><span>面向參與者</span><h3>招募與同意</h3><p>邀請函、資料說明、同意選項；需要時加入兒童同意參與及監護人材料。</p></article>
            <article><span>面向方法</span><h3>工具與准許</h3><p>相關問卷、訪談指南、觀察方案、准入信及事後說明。</p></article>
            <article><span>面向資料</span><h3>資料管理</h3><p>資料流向圖、存取角色、第三方服務、保存與銷毀。</p></article>
          </div>
          <p class="takeaway">只附上研究設計真正需要的材料；每份附件都須與申請表一致。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Application form: six connected claims" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">CityU School of Education · read the actual form</span></header>
        <div data-language="en">
          <h2>Connect the form to the study documents</h2>
          <p class="source-context">The <a href="https://soe.cityu.edu.mo/en/notice/393" target="_blank" rel="noopener noreferrer">School’s current notice and application form ↗</a> set the local submission requirements. These six areas show how a reviewer can check whether the proposal, recruitment text, consent and data plan tell the same story.</p>
          <div class="field-grid">
            {applicationFields.map((field) => <details><summary>{field.en}</summary><p>{field.askEn}</p></details>)}
          </div>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>把申請表與研究文件連起來</h2>
          <p class="source-context"><a href="https://soe.cityu.edu.mo/en/notice/393" target="_blank" rel="noopener noreferrer">學院現行通知與申請表 ↗</a>訂明本地提交要求。以下六方面有助審查者核對研究計劃、招募文字、知情同意及資料計劃是否一致。</p>
          <div class="field-grid">
            {applicationFields.map((field) => <details><summary>{field.zh}</summary><p>{field.askZh}</p></details>)}
          </div>
