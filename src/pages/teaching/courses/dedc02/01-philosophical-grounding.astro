  .closing-line { margin-top: 1.4rem; color: var(--green); font: 600 clamp(1.2rem, 2.3vw, 1.8rem)/1.3 'Source Serif 4', serif; }
  .course-return { display: inline-flex; margin-top: 1rem; color: var(--green); font-weight: 700; }
  .deck-controls { position: fixed; left: 50%; bottom: max(.8rem, env(safe-area-inset-bottom)); z-index: 20; display: flex; align-items: center; gap: .25rem; transform: translateX(-50%); border: 1px solid var(--line); border-radius: 999px; padding: .3rem; background: rgba(255,255,255,.96); box-shadow: 0 .45rem 1.5rem rgba(21,60,43,.12); }
  .deck-controls button, .home-button { display: grid; min-width: 2.35rem; min-height: 2.35rem; place-items: center; border: 0; border-radius: 999px; padding: 0 .65rem; background: transparent; color: var(--green); font: 700 .86rem/1 'Source Sans 3', sans-serif; text-decoration: none; cursor: pointer; }
  .deck-controls button:hover, .home-button:hover { background: var(--green-soft); }
  .slide-count { min-width: 4.5rem !important; }
  .progress-track { position: absolute; right: .8rem; bottom: -.36rem; left: .8rem; height: 2px; overflow: hidden; background: #dcebe2; }
  .progress-track span { display: block; width: 5.88%; height: 100%; background: var(--green); transition: width 220ms ease; }
  .overview-dialog { width: min(780px, 92vw); max-height: 82vh; border: 1px solid var(--line); border-radius: .6rem; padding: 1.2rem; background: #fff; color: var(--green-dark); }
  .overview-dialog::backdrop { background: rgba(21,60,43,.35); }
  .overview-head { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
  .overview-head h2 { margin: 0 0 .7rem; font-size: 2rem; }
  .overview-head button { border: 0; background: transparent; color: var(--green); font-size: 2rem; cursor: pointer; }
  .overview-dialog ol { display: grid; grid-template-columns: repeat(2, 1fr); gap: .45rem; padding: 0; list-style-position: inside; }
  .overview-dialog li button { width: calc(100% - 2rem); border: 0; padding: .55rem; background: transparent; color: var(--green-dark); text-align: left; cursor: pointer; }
  .overview-dialog li.is-current { background: var(--green-soft); }
  .overview-dialog > p { color: var(--muted); font-size: .8rem; }
  @keyframes enter { from { opacity: 0; transform: translateX(10px); } to { opacity: 1; transform: none; } }
  @media (max-width: 800px) {
    .slide { padding: 1rem 1rem 5.5rem; }
    .slide-inner { min-height: auto; justify-content: flex-start; }
    .slide-header { margin-bottom: 1.1rem; }
    .chapter { display: none; }
    .chain, .four-grid, .three-grid, .process-line, .canvas-grid { grid-template-columns: repeat(2, 1fr); }
    .chain details::after { display: none; }
    .prompt-grid, .prompt-grid.small, .split-layout, .card-template, .do-dont { grid-template-columns: 1fr; }
    .visual-split { align-items: start; }
    .crop-tree, .crop-framework { height: 280px; }
    .misconception-grid, .orientation-grid, .feedback-stems, .exit-grid { grid-template-columns: 1fr; }
    .home-button, [data-fullscreen] { display: none; }
  }
  @media (max-width: 480px) {
    .four-grid, .three-grid, .process-line, .canvas-grid { grid-template-columns: 1fr; }
    .overview-dialog ol { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .slide.is-active { animation: none; } }
</style>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const currentLabel = document.querySelector<HTMLElement>('.slide-count span');
  const totalLabel = document.querySelector<HTMLElement>('[data-slide-total]');
  const progress = document.querySelector<HTMLElement>('.progress-track span');
  const overview = document.querySelector<HTMLDialogElement>('.overview-dialog');
  const overviewList = overview?.querySelector('ol');
  let current = 0;
  if (totalLabel) totalLabel.textContent = String(slides.length);

  function showSlide(index: number) {
    current = Math.max(0, Math.min(slides.length - 1, index));
    slides.forEach((slide, i) => {
      const active = i === current;
      slide.classList.toggle('is-active', active);
      slide.setAttribute('aria-hidden', String(!active));
    });
    if (currentLabel) currentLabel.textContent = String(current + 1);
    if (progress) progress.style.width = `${((current + 1) / slides.length) * 100}%`;
    overviewList?.querySelectorAll('li').forEach((li, i) => li.classList.toggle('is-current', i === current));
    history.replaceState(null, '', `#slide-${current + 1}`);
  }

  document.querySelectorAll<HTMLElement>('[data-nav]').forEach((button) => {
    button.addEventListener('click', () => showSlide(current + (button.dataset.nav === 'next' ? 1 : -1)));
  });

  document.querySelectorAll<HTMLButtonElement>('.translate-button').forEach((button) => {
    button.addEventListener('click', () => {
      const slide = button.closest('.slide');
      if (!slide) return;
      const toChinese = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(toChinese));
      button.textContent = toChinese ? 'English' : '中文';
      slide.querySelectorAll<HTMLElement>('[data-language="en"]').forEach((x) => x.hidden = toChinese);
      slide.querySelectorAll<HTMLElement>('[data-language="zh"]').forEach((x) => x.hidden = !toChinese);
    });
  });

  if (overviewList) {
    slides.forEach((slide, i) => {
      const item = document.createElement('li');
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = slide.dataset.title || `Slide ${i + 1}`;
      button.addEventListener('click', () => { showSlide(i); overview?.close(); });
      item.append(button);
      overviewList.append(item);
    });
  }
  document.querySelector('[data-overview]')?.addEventListener('click', () => overview?.showModal());
  document.querySelector('[data-close-overview]')?.addEventListener('click', () => overview?.close());
  document.querySelector('[data-fullscreen]')?.addEventListener('click', () => document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen());

  document.querySelectorAll<HTMLButtonElement>('.copy-button').forEach((button) => {
    button.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(button.dataset.copy || ''); button.textContent = 'Copied'; }
      catch { button.textContent = 'Select and copy'; }
      setTimeout(() => button.textContent = 'Copy prompt', 1400);
    });
  });

  document.querySelectorAll<HTMLElement>('.timer').forEach((timer) => {
    const initial = Number(timer.dataset.seconds || 0);
    let remaining = initial;
    let interval = 0;
    const output = timer.querySelector('output');
    const start = timer.querySelector<HTMLButtonElement>('[data-action="start"]');
    const paint = () => { if (output) output.textContent = `${String(Math.floor(remaining / 60)).padStart(2, '0')}:${String(remaining % 60).padStart(2, '0')}`; };
    start?.addEventListener('click', () => {
      if (interval) { window.clearInterval(interval); interval = 0; start.textContent = start.textContent === '暫停' ? '開始' : 'Start'; return; }
      start.textContent = start.textContent === '開始' ? '暫停' : 'Pause';
      interval = window.setInterval(() => { remaining = Math.max(0, remaining - 1); paint(); if (!remaining) { window.clearInterval(interval); interval = 0; start.textContent = 'Done'; } }, 1000);
    });
    timer.querySelector('[data-action="reset"]')?.addEventListener('click', () => { window.clearInterval(interval); interval = 0; remaining = initial; if (start) start.textContent = start.closest('[lang="zh-Hant"]') ? '開始' : 'Start'; paint(); });
  });

  document.querySelectorAll<HTMLTextAreaElement>('textarea[data-save]').forEach((field) => {
    const key = `dedc02-w1-${field.dataset.save}`;
    try { field.value = localStorage.getItem(key) || ''; } catch {}
    field.addEventListener('input', () => { try { localStorage.setItem(key, field.value); } catch {} });
  });

  document.addEventListener('keydown', (event) => {
    if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return;
    if (event.key === 'ArrowRight' || event.key === 'PageDown' || event.key === ' ') { event.preventDefault(); showSlide(current + 1); }
    if (event.key === 'ArrowLeft' || event.key === 'PageUp') { event.preventDefault(); showSlide(current - 1); }
    if (event.key === 'Home') showSlide(0);
    if (event.key === 'End') showSlide(slides.length - 1);
    if (event.key.toLowerCase() === 'o') overview?.showModal();
    if (event.key.toLowerCase() === 'f') document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen();
  });

  let touchX = 0;
  document.addEventListener('touchstart', (event) => { touchX = event.changedTouches[0]?.clientX || 0; }, { passive: true });
  document.addEventListener('touchend', (event) => { const dx = (event.changedTouches[0]?.clientX || 0) - touchX; if (Math.abs(dx) > 70) showSlide(current + (dx < 0 ? 1 : -1)); }, { passive: true });

  const initialHash = Number(location.hash.replace('#slide-', ''));
  showSlide(Number.isFinite(initialHash) && initialHash > 0 ? initialHash - 1 : 0);
</script>
