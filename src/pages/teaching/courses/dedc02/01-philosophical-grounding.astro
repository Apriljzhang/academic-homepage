---
import CourseSlideLayout from '../../../../layouts/CourseSlideLayout.astro';
import { withBase } from '../../../../utils/paths';

const title = '1. Philosophical Grounding · DEDC02';
const description = 'An interactive lesson on the philosophical foundations of educational research.';
const courseHref = withBase('/teaching/courses/dedc02');
const treeSrc = withBase('/teaching/courses/dedc02/assets/methodology-tree.png');
const thinkingMapSrc = withBase('/teaching/courses/dedc02/assets/research-design-thinking-map.png');

const outcomes = [
  ['Explain ontology, epistemology, axiology, methodology and methods in accessible language.', '以清晰易懂的語言解釋本體論、知識論、價值論、方法論與研究方法。'],
  ['Distinguish methodology from methods.', '區分方法論與研究方法。'],
  ['Explain how philosophical assumptions influence questions, designs, evidence and claims.', '解釋哲學假設如何影響研究問題、設計、證據與主張。'],
  ['Compare different ways of investigating the same educational problem.', '比較研究同一教育問題的不同方式。'],
];

const layers = [
  ['Research problem', 'What needs to be understood?', '研究問題', '需要理解甚麼？'],
  ['Ontology', 'What is the nature of reality?', '本體論', '現實的本質是甚麼？'],
  ['Epistemology', 'What can be known, and how?', '知識論', '甚麼可以被認識？如何認識？'],
  ['Axiology', 'Whose values and interests matter?', '價值論', '誰的價值與利益重要？'],
  ['Methodology', 'What logic guides the inquiry?', '方法論', '甚麼整體邏輯引導研究？'],
  ['Methods', 'What procedures produce evidence?', '研究方法', '甚麼程序產生證據？'],
  ['Claims', 'What can the evidence support?', '研究主張', '證據能合理支持甚麼？'],
];

const exitQuestions = [
  ['ontology', 'Ontology concerns…', '本體論關注……'],
  ['epistemology', 'Epistemology concerns…', '知識論關注……'],
  ['axiology', 'Axiology matters because…', '價值論重要，因為……'],
  ['methodology', 'Methodology differs from methods because…', '方法論與研究方法不同，因為……'],
  ['assumption', 'One assumption influencing my research is…', '影響我研究的一項假設是……'],
  ['alignment', 'The weakest alignment in my research plan may be…', '我的研究計劃中最弱的一致性可能是……'],
];
---

<CourseSlideLayout {title} {description}>
  <div class="slide-tools" aria-label="Slide tools">
    <button type="button" class="translate-button" data-translate-current aria-pressed="false">中文</button>
    <div class="global-timer" aria-label="Presentation timer" data-timer-ding>
      <input type="number" min="1" max="999" inputmode="numeric" placeholder="min" aria-label="Timer minutes" data-timer-minutes />
      <button type="button" data-timer-start>Start</button>
      <output data-timer-output hidden>00:00</output>
      <button type="button" data-timer-reset aria-label="Reset timer">↺</button>
    </div>
  </div>

  <main class="deck" aria-label="Philosophical Grounding slide deck">
    <section class="slide is-active title-slide" data-title="Orientation · Philosophical Grounding" aria-hidden="false">
      <div class="slide-inner">
        <p class="eyebrow">DEDC02 · Advanced Research Method · Orientation</p>
        <div class="short-rule"></div>
        <h1 data-en="Philosophical Grounding" data-zh="研究的哲學基礎">Philosophical Grounding</h1>
        <p class="lead" data-en="How assumptions about reality, knowledge and values shape research decisions." data-zh="關於現實、知識與價值的假設，如何形塑研究決策。">How assumptions about reality, knowledge and values shape research decisions.</p>
      </div>
    </section>

    <section class="slide" data-title="Orientation · Learning outcomes" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow">Orientation</p>
        <h2 data-en="By the end, you can…" data-zh="完成本課後，你能夠……">By the end, you can…</h2>
        <ol class="outcome-list">
          {outcomes.map(([en, zh], index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><p data-en={en} data-zh={zh}>{en}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="slide" data-title="Instruction · The research chain" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow">Instruction</p>
        <h2 data-en="Research decisions form a chain" data-zh="研究決策構成一條鏈">Research decisions form a chain</h2>
        <p class="lead small" data-en="Open each term. A defensible study explains how one decision leads to the next." data-zh="點開每個術語。可辯護的研究會解釋一項決策如何連接下一項。">Open each term. A defensible study explains how one decision leads to the next.</p>
        <div class="layer-list">
          {layers.map(([enTitle, enText, zhTitle, zhText], index) => (
            <details>
              <summary><span>{index + 1}</span><b data-en={enTitle} data-zh={zhTitle}>{enTitle}</b></summary>
              <p data-en={enText} data-zh={zhText}>{enText}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="slide" data-title="How-to · From observation to research" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow">How-to</p>
        <h2 data-en="Turn an observation into research" data-zh="把觀察轉化為研究">Turn an observation into research</h2>
        <div class="problem-strip" data-en="Starting observation: Ten students were absent from yesterday’s research methods class." data-zh="起始觀察：昨天的研究方法課有十名學生缺席。">Starting observation: Ten students were absent from yesterday’s research methods class.</div>
        <ol class="steps research-steps">
          <li data-en="Notice: An attendance record is an observation." data-zh="留意：出席紀錄是一項觀察。">Notice: An attendance record is an observation.</li>
          <li data-en="Ask why it matters: Is this unusual, consequential or worth understanding?" data-zh="追問其重要性：這是否不尋常、有影響，或值得理解？">Ask why it matters: Is this unusual, consequential or worth understanding?</li>
          <li data-en="Name what is unknown: We do not know why students were absent or whether this is a pattern." data-zh="說明未知之處：我們尚未知道學生為何缺席，或這是否一種規律。">Name what is unknown: We do not know why students were absent or whether this is a pattern.</li>
          <li data-en="State a research problem: There is insufficient understanding of factors associated with absence from this class." data-zh="提出研究問題：我們對與此課堂缺席相關的因素仍缺乏理解。">State a research problem: There is insufficient understanding of factors associated with absence from this class.</li>
          <li data-en="Set a purpose and questions: Explore factors influencing attendance and whether absence is recurrent." data-zh="確定目的與問題：探究影響出席的因素，以及缺席是否反覆出現。">Set a purpose and questions: Explore factors influencing attendance and whether absence is recurrent.</li>
        </ol>
        <p class="instruction" data-en="A research problem identifies a gap in understanding. It does not assume a cause or prescribe a solution." data-zh="研究問題指出理解上的缺口；它不預設原因，也不預先指定解決方案。">A research problem identifies a gap in understanding. It does not assume a cause or prescribe a solution.</p>
      </div>
    </section>

    <section class="slide" data-title="Activity · Question the problem" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow">Activity</p>
        <h2 data-en="Before we define terms, ask better questions" data-zh="先提出更好的問題，再定義術語">Before we define terms, ask better questions</h2>
        <div class="problem-strip" data-en="Is this an observation, a practical problem, or already a research problem? What else would we need to know?" data-zh="這是一項觀察、實際問題，還是已經是一個研究問題？我們還需要知道甚麼？">Is this an observation, a practical problem, or already a research problem? What else would we need to know?</div>
        <div class="three-explanations">
          <article>
            <h3 data-en="Ontology" data-zh="本體論">Ontology</h3>
            <p data-en="What exactly is the phenomenon: ten individual absences, a class-level pattern, or different forms of absence?" data-zh="究竟在研究甚麼現象：十名學生各自缺席、全班層面的規律，還是不同形式的缺席？">What exactly is the phenomenon: ten individual absences, a class-level pattern, or different forms of absence?</p>
          </article>
          <article>
            <h3 data-en="Epistemology" data-zh="知識論">Epistemology</h3>
            <p data-en="How could we know about it beyond the attendance record? Whose account should count?" data-zh="除了出席紀錄，我們如何了解這個現象？誰的敘述應被重視？">How could we know about it beyond the attendance record? Whose account should count?</p>
          </article>
          <article>
            <h3 data-en="Axiology" data-zh="價值論">Axiology</h3>
            <p data-en="What responsibilities do we have when asking students why they were absent? Could the inquiry blame or expose them?" data-zh="詢問學生缺席原因時，我們有甚麼責任？研究會否令他們受到責備或暴露？">What responsibilities do we have when asking students why they were absent? Could the inquiry blame or expose them?</p>
          </article>
          <article>
            <h3 data-en="Methodology" data-zh="方法論">Methodology</h3>
            <p data-en="If we want to understand experiences rather than measure frequency, what overall approach to inquiry would fit?" data-zh="若要理解經驗而非測量頻率，哪種整體研究取向較合適？">If we want to understand experiences rather than measure frequency, what overall approach to inquiry would fit?</p>
          </article>
          <article>
            <h3 data-en="Methods" data-zh="研究方法">Methods</h3>
            <p data-en="What could we actually do: examine records, use an anonymous questionnaire, conduct interviews, or combine these?" data-zh="我們實際可以怎樣做：檢視紀錄、使用匿名問卷、進行訪談，還是結合不同方法？">What could we actually do: examine records, use an anonymous questionnaire, conduct interviews, or combine these?</p>
          </article>
        </div>
        <p class="instruction" data-en="Do not solve the problem yet. First decide what each question is asking about." data-zh="暫時不要解決問題；先判斷每條問題在追問甚麼。">Do not solve the problem yet. First decide what each question is asking about.</p>
      </div>
    </section>

    <section class="slide" data-title="Example · One problem, different studies" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow">Example</p>
        <div class="problem-strip" data-en="Research problem: Ten students were absent from yesterday’s research methods class." data-zh="研究問題：昨天的研究方法課有十名學生缺席。">Research problem: Ten students were absent from yesterday’s research methods class.</div>
        <h2 data-en="The same event can become different studies" data-zh="同一事件可以形成不同研究">The same event can become different studies</h2>
        <div class="study-list">
          <div><b data-en="Measure behaviour" data-zh="測量行為">Measure behaviour</b><p data-en="Which factors predict student absence?" data-zh="哪些因素能預測學生缺席？">Which factors predict student absence?</p></div>
          <div><b data-en="Interpret meaning" data-zh="詮釋意義">Interpret meaning</b><p data-en="How do students understand and explain absence?" data-zh="學生如何理解和解釋缺席？">How do students understand and explain absence?</p></div>
          <div><b data-en="Critique policy" data-zh="批判政策">Critique policy</b><p data-en="Whom do attendance rules privilege or disadvantage?" data-zh="出席規定偏向或不利於哪些人？">Whom do attendance rules privilege or disadvantage?</p></div>
          <div><b data-en="Improve practice" data-zh="改善實踐">Improve practice</b><p data-en="Which feasible response works, for whom and under what conditions?" data-zh="哪些可行回應對誰有效，並在甚麼條件下有效？">Which feasible response works, for whom and under what conditions?</p></div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Instruction · Philosophical layers" aria-hidden="true">
      <div class="slide-inner split-simple">
        <div>
          <p class="eyebrow">Instruction</p>
          <h2 data-en="Roots, stance, strategy and tools" data-zh="根基、立場、策略與工具">Roots, stance, strategy and tools</h2>
          <dl class="plain-definitions">
            <div><dt data-en="Ontology" data-zh="本體論">Ontology</dt><dd data-en="How we understand reality." data-zh="我們如何理解現實。">How we understand reality.</dd></div>
            <div><dt data-en="Epistemology" data-zh="知識論">Epistemology</dt><dd data-en="How we can investigate and know it." data-zh="我們如何研究並認識現實。">How we can investigate and know it.</dd></div>
            <div><dt data-en="Axiology" data-zh="價值論">Axiology</dt><dd data-en="How values and responsibilities shape inquiry." data-zh="價值與責任如何形塑研究。">How values and responsibilities shape inquiry.</dd></div>
            <div><dt data-en="Methodology" data-zh="方法論">Methodology</dt><dd data-en="The overall logic of the inquiry." data-zh="探究的整體邏輯。">The overall logic of the inquiry.</dd></div>
            <div><dt data-en="Methods" data-zh="研究方法">Methods</dt><dd data-en="The procedures used to collect and analyse data." data-zh="收集與分析資料的具體程序。">The procedures used to collect and analyse data.</dd></div>
          </dl>
        </div>
        <figure class="tree-illustration"><img src={treeSrc} alt="Tree illustration of ontology, epistemology, methodology and methods" /></figure>
      </div>
    </section>

    <section class="slide" data-title="Activity · Ontological positions" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow">Activity</p>
        <h2 data-en="What do you think is real?" data-zh="你認為甚麼是真實的？">What do you think is real?</h2>
        <p class="note position-note" data-en="Choose the response that is currently closest to your view. There are no correct answers." data-zh="選擇目前最接近你觀點的回應；沒有正確答案。">Choose the response that is currently closest to your view. There are no correct answers.</p>
        <div class="position-quiz" data-position-quiz="ontology">
          <fieldset data-position-question="ontology-1">
            <legend data-en="When ten students are absent, what should a researcher treat as most real?" data-zh="當十名學生缺席時，研究者應把甚麼視為最真實？">When ten students are absent, what should a researcher treat as most real?</legend>
            <button type="button" class="position-choice" data-position-choice="realism" data-en="The observable absence pattern exists regardless of how individuals interpret it." data-zh="可觀察的缺席規律存在，不受個人如何詮釋所影響。">The observable absence pattern exists regardless of how individuals interpret it.</button>
            <button type="button" class="position-choice" data-position-choice="relativism" data-en="Absence has different realities because it means different things to different people." data-zh="缺席具有不同現實，因為它對不同的人有不同意義。">Absence has different realities because it means different things to different people.</button>
            <button type="button" class="position-choice" data-position-choice="criticalRealism" data-en="The absences are observable, but they may arise from deeper and differently layered conditions." data-zh="缺席可以被觀察，但可能源自更深層且不同層次的條件。">The absences are observable, but they may arise from deeper and differently layered conditions.</button>
          </fieldset>
          <fieldset data-position-question="ontology-2">
            <legend data-en="Which statement about student motivation feels closest to your view?" data-zh="關於學生動機，哪項陳述最接近你的觀點？">Which statement about student motivation feels closest to your view?</legend>
            <button type="button" class="position-choice" data-position-choice="realism" data-en="It is a real characteristic that can be measured, even imperfectly." data-zh="它是一種真實特質，即使不完美，也可以被測量。">It is a real characteristic that can be measured, even imperfectly.</button>
            <button type="button" class="position-choice" data-position-choice="relativism" data-en="It is experienced differently and shaped through culture, history and relationships." data-zh="它被不同地經驗，並由文化、經歷與關係形塑。">It is experienced differently and shaped through culture, history and relationships.</button>
            <button type="button" class="position-choice" data-position-choice="criticalRealism" data-en="It is experienced differently, yet real mechanisms and contexts may shape those experiences." data-zh="它可被不同地經驗，但真實機制與情境可能形塑這些經驗。">It is experienced differently, yet real mechanisms and contexts may shape those experiences.</button>
          </fieldset>
          <fieldset data-position-question="ontology-3">
            <legend data-en="Which statement is closest to your current view of reality?" data-zh="哪項陳述最接近你目前對現實的觀點？">Which statement is closest to your current view of reality?</legend>
            <button type="button" class="position-choice" data-position-choice="realism" data-en="Reality exists independently of what people think about it." data-zh="現實獨立於人們如何思考它而存在。">Reality exists independently of what people think about it.</button>
            <button type="button" class="position-choice" data-position-choice="relativism" data-en="Reality is multiple and shaped through people’s experiences and interpretations." data-zh="現實是多重的，並透過人們的經驗與詮釋而形塑。">Reality is multiple and shaped through people’s experiences and interpretations.</button>
            <button type="button" class="position-choice" data-position-choice="criticalRealism" data-en="Reality is real but layered; what we observe may not reveal all that produces it." data-zh="現實是真實但分層的；我們所觀察到的未必揭示產生它的一切。">Reality is real but layered; what we observe may not reveal all that produces it.</button>
          </fieldset>
        </div>
        <div class="position-result" data-position-result="ontology" aria-live="polite"></div>
        <button class="reset-position" type="button" data-position-reset="ontology" data-en="Reset choices" data-zh="重設選擇">Reset choices</button>
      </div>
    </section>

    <section class="slide" data-title="Activity · Epistemological positions" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow">Activity</p>
        <h2 data-en="What should count as knowledge?" data-zh="甚麼應算作知識？">What should count as knowledge?</h2>
        <p class="note position-note" data-en="Choose the response that is currently closest to your view. There are no correct answers." data-zh="選擇目前最接近你觀點的回應；沒有正確答案。">Choose the response that is currently closest to your view. There are no correct answers.</p>
        <div class="position-quiz" data-position-quiz="epistemology">
          <fieldset data-position-question="epistemology-1">
            <legend data-en="What would most convince you that you understand the absences?" data-zh="甚麼最能說服你：你已理解這些缺席？">What would most convince you that you understand the absences?</legend>
            <button type="button" class="position-choice" data-position-choice="objectivist" data-en="Reliable attendance records, repeated measurement and patterns in the data." data-zh="可靠的出席紀錄、重複測量與資料中的規律。">Reliable attendance records, repeated measurement and patterns in the data.</button>
            <button type="button" class="position-choice" data-position-choice="subjectivist" data-en="Students’ accounts of their experiences, reasons and decisions in context." data-zh="學生在情境中對其經驗、理由與決定的敘述。">Students’ accounts of their experiences, reasons and decisions in context.</button>
            <button type="button" class="position-choice" data-position-choice="pragmatist" data-en="Evidence that helps the class decide what response is useful in this context." data-zh="有助於班級在此情境中決定何種回應有用的證據。">Evidence that helps the class decide what response is useful in this context.</button>
          </fieldset>
          <fieldset data-position-question="epistemology-2">
            <legend data-en="If an attendance record and a student’s account disagree, what would you do first?" data-zh="若出席紀錄與學生敘述不一致，你會先怎樣做？">If an attendance record and a student’s account disagree, what would you do first?</legend>
            <button type="button" class="position-choice" data-position-choice="objectivist" data-en="Check how each source was measured, recorded and tested for error or bias." data-zh="檢查每項資料如何被測量、記錄，以及是否存在誤差或偏差。">Check how each source was measured, recorded and tested for error or bias.</button>
            <button type="button" class="position-choice" data-position-choice="subjectivist" data-en="Explore how the two accounts were interpreted and constructed in their different contexts." data-zh="探究兩種敘述如何在不同情境中被詮釋與建構。">Explore how the two accounts were interpreted and constructed in their different contexts.</button>
            <button type="button" class="position-choice" data-position-choice="pragmatist" data-en="Consider which combination of evidence best helps address the practical problem." data-zh="考慮哪種證據組合最有助於處理實際問題。">Consider which combination of evidence best helps address the practical problem.</button>
          </fieldset>
          <fieldset data-position-question="epistemology-3">
            <legend data-en="Which statement is closest to your current view of knowledge?" data-zh="哪項陳述最接近你目前對知識的觀點？">Which statement is closest to your current view of knowledge?</legend>
            <button type="button" class="position-choice" data-position-choice="objectivist" data-en="Knowledge is discovered through systematic observation, measurement and testing." data-zh="知識透過系統性的觀察、測量與檢驗而被發現。">Knowledge is discovered through systematic observation, measurement and testing.</button>
            <button type="button" class="position-choice" data-position-choice="subjectivist" data-en="Knowledge is constructed through experience, interpretation and social interaction." data-zh="知識透過經驗、詮釋與社會互動而建構。">Knowledge is constructed through experience, interpretation and social interaction.</button>
            <button type="button" class="position-choice" data-position-choice="pragmatist" data-en="Knowledge is provisional and should be judged partly by its usefulness in context." data-zh="知識是暫時的，並應部分按它在情境中的有用性來判斷。">Knowledge is provisional and should be judged partly by its usefulness in context.</button>
          </fieldset>
        </div>
        <div class="position-result" data-position-result="epistemology" aria-live="polite"></div>
        <button class="reset-position" type="button" data-position-reset="epistemology" data-en="Reset choices" data-zh="重設選擇">Reset choices</button>
      </div>
    </section>

    <section class="slide" data-title="Activity · Methodological positions" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow">Activity</p>
        <h2 data-en="How would you design the inquiry?" data-zh="你會如何設計這項探究？">How would you design the inquiry?</h2>
        <p class="note position-note" data-en="Methodology is the overall strategy that links assumptions about reality, knowledge and values to methods. Choose what you would currently do; there are no correct answers." data-zh="方法論是把對現實、知識與價值的假設連接到研究方法的整體策略。選擇你目前會採取的做法；沒有正確答案。">Methodology is the overall strategy that links assumptions about reality, knowledge and values to methods. Choose what you would currently do; there are no correct answers.</p>
        <div class="position-quiz" data-position-quiz="methodology">
          <fieldset data-position-question="methodology-1">
            <legend data-en="What would you most want this study of student absence to achieve?" data-zh="你最希望這項學生缺席研究達成甚麼？">What would you most want this study of student absence to achieve?</legend>
            <button type="button" class="position-choice" data-position-choice="positivist" data-en="Identify measurable factors associated with absence and test how strongly they predict it." data-zh="找出與缺席相關的可測量因素，並檢驗它們的預測程度。">Identify measurable factors associated with absence and test how strongly they predict it.</button>
            <button type="button" class="position-choice" data-position-choice="interpretive" data-en="Understand how students make sense of attendance and absence in their own situations." data-zh="理解學生如何在自己的情境中理解出席與缺席。">Understand how students make sense of attendance and absence in their own situations.</button>
            <button type="button" class="position-choice" data-position-choice="pragmaticCritical" data-en="Explain the conditions shaping absence and identify a useful response for this setting." data-zh="解釋形塑缺席的條件，並找出適合此情境的有用回應。">Explain the conditions shaping absence and identify a useful response for this setting.</button>
          </fieldset>
          <fieldset data-position-question="methodology-2">
            <legend data-en="Which overall design feels most appropriate?" data-zh="哪種整體設計最合適？">Which overall design feels most appropriate?</legend>
            <button type="button" class="position-choice" data-position-choice="positivist" data-en="A survey, experiment or statistical study that compares measurable variables." data-zh="以問卷、實驗或統計研究比較可測量變項。">A survey, experiment or statistical study that compares measurable variables.</button>
            <button type="button" class="position-choice" data-position-choice="interpretive" data-en="A case study, ethnography or interview study that develops contextual understanding." data-zh="以個案研究、民族誌或訪談研究發展情境化理解。">A case study, ethnography or interview study that develops contextual understanding.</button>
            <button type="button" class="position-choice" data-position-choice="pragmaticCritical" data-en="A mixed or layered design that brings together patterns, accounts and practical action." data-zh="以混合或分層設計結合規律、敘述與實際行動。">A mixed or layered design that brings together patterns, accounts and practical action.</button>
          </fieldset>
          <fieldset data-position-question="methodology-3">
            <legend data-en="When different forms of evidence point in different directions, what would you do?" data-zh="當不同形式的證據指向不同方向時，你會怎樣做？">When different forms of evidence point in different directions, what would you do?</legend>
            <button type="button" class="position-choice" data-position-choice="positivist" data-en="Improve measurement and test rival explanations before making a cautious general claim." data-zh="改進測量並檢驗競爭性解釋，才提出審慎的一般性主張。">Improve measurement and test rival explanations before making a cautious general claim.</button>
            <button type="button" class="position-choice" data-position-choice="interpretive" data-en="Return to participants’ meanings and the context in which each account was produced." data-zh="回到參與者的意義，以及每種敘述產生的情境。">Return to participants’ meanings and the context in which each account was produced.</button>
            <button type="button" class="position-choice" data-position-choice="pragmaticCritical" data-en="Integrate the evidence to identify possible mechanisms and a response worth trying." data-zh="整合證據以辨識可能的機制，以及值得嘗試的回應。">Integrate the evidence to identify possible mechanisms and a response worth trying.</button>
          </fieldset>
        </div>
        <div class="position-result" data-position-result="methodology" aria-live="polite"></div>
        <button class="reset-position" type="button" data-position-reset="methodology" data-en="Reset choices" data-zh="重設選擇">Reset choices</button>
      </div>
    </section>

    <section class="slide" data-title="Activity · Map research paradigms" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow">Activity</p>
        <h2 data-en="Where might these paradigms sit?" data-zh="這些典範可能位於哪裡？">Where might these paradigms sit?</h2>
        <ol class="activity-steps">
          <li><b data-en="1. Ask AI" data-zh="1. 問 AI">1. Ask AI</b><span data-en="Ask an AI assistant for a concise explanation of each paradigm’s view of reality and knowledge. Compare its answer with your notes; do not treat its first answer as final." data-zh="請 AI 助手簡要說明每個典範如何看待現實與知識。把它的回應與你的筆記比較；不要把第一個答案當作定論。">Ask an AI assistant for a concise explanation of each paradigm’s view of reality and knowledge. Compare its answer with your notes; do not treat its first answer as final.</span></li>
          <li><b data-en="2. Map your understanding" data-zh="2. 繪製你的理解">2. Map your understanding</b><span data-en="Drag each paradigm anywhere on the map — including directly onto the horizontal or vertical axis when that fits your understanding. Drop near an axis to snap it into place. Positions are approximate, not fixed boxes." data-zh="把每個典範拖到地圖上的任何位置——如果符合你的理解，也可以直接放在水平或垂直軸上。在軸線附近放開便會自動對齊。位置只是大致取向，並非固定分類。">Drag each paradigm anywhere on the map — including directly onto the horizontal or vertical axis when that fits your understanding. Drop near an axis to snap it into place. Positions are approximate, not fixed boxes.</span></li>
        </ol>
        <div class="paradigm-activity" data-paradigm-activity>
          <div class="student-map-panel">
            <div class="paradigm-workspace">
              <div class="paradigm-bank" data-paradigm-bank aria-label="Paradigms to place">
                <p data-en="Drag from here" data-zh="從這裡拖曳">Drag from here</p>
                <button type="button" class="paradigm-card" data-paradigm-card="positivism" data-en="Positivism" data-zh="實證主義">Positivism</button>
                <button type="button" class="paradigm-card" data-paradigm-card="postpositivism" data-en="Post-Positivism" data-zh="後實證主義">Post-Positivism</button>
                <button type="button" class="paradigm-card" data-paradigm-card="constructivism" data-en="Constructivism" data-zh="建構主義">Constructivism</button>
                <button type="button" class="paradigm-card" data-paradigm-card="social-constructionism" data-en="Social Constructionism" data-zh="社會建構主義">Social Constructionism</button>
                <button type="button" class="paradigm-card" data-paradigm-card="interpretivism" data-en="Interpretivism" data-zh="解釋主義">Interpretivism</button>
                <button type="button" class="paradigm-card" data-paradigm-card="pragmatism" data-en="Pragmatism" data-zh="實用主義">Pragmatism</button>
                <button type="button" class="paradigm-card" data-paradigm-card="critical-realism" data-en="Critical Realism" data-zh="批判現實主義">Critical Realism</button>
              </div>
              <div class="quadrant-stage">
                <div class="quadrant-axis axis-top"><strong data-en="Epistemology" data-zh="知識論">Epistemology</strong><span data-en="Objectivist" data-zh="客觀主義">Objectivist</span></div>
                <div class="quadrant-axis axis-bottom"><strong data-en="Epistemology" data-zh="知識論">Epistemology</strong><span data-en="Interpretivist / Subjectivist" data-zh="解釋主義／主觀主義">Interpretivist / Subjectivist</span></div>
                <div class="quadrant-axis axis-left"><strong data-en="Ontology" data-zh="本體論">Ontology</strong><span data-en="Relativist" data-zh="相對主義">Relativist</span></div>
                <div class="quadrant-axis axis-right"><strong data-en="Ontology" data-zh="本體論">Ontology</strong><span data-en="Realist" data-zh="現實主義">Realist</span></div>
                <div class="coordinate-plane" data-paradigm-plane aria-label="Free-position ontology and epistemology map"></div>
              </div>
            </div>
            <p class="paradigm-status" data-paradigm-status aria-live="polite"></p>
            <div class="paradigm-actions">
              <button type="button" class="primary-button" data-paradigm-reference disabled data-en="Reveal reference placement" data-zh="顯示參考位置">Reveal reference placement</button>
              <button type="button" class="reset-position" data-paradigm-reset data-en="Reset map" data-zh="重設地圖">Reset map</button>
            </div>
          </div>
          <div class="reference-map-panel" hidden>
            <p class="reference-note" data-en="Reference placement — a teaching simplification. Paradigms are internally diverse and may sit differently in particular studies." data-zh="參考位置——這是教學上的簡化。不同典範內部本身多樣，在特定研究中也可能位於不同位置。">Reference placement — a teaching simplification. Paradigms are internally diverse and may sit differently in particular studies.</p>
            <div class="quadrant-stage reference-stage">
              <div class="quadrant-axis axis-top"><strong data-en="Epistemology" data-zh="知識論">Epistemology</strong><span data-en="Positivist / Objectivist" data-zh="實證主義／客觀主義">Positivist / Objectivist</span></div>
              <div class="quadrant-axis axis-bottom"><strong data-en="Epistemology" data-zh="知識論">Epistemology</strong><span data-en="Interpretivist / Subjectivist" data-zh="解釋主義／主觀主義">Interpretivist / Subjectivist</span></div>
              <div class="quadrant-axis axis-left"><strong data-en="Ontology" data-zh="本體論">Ontology</strong><span data-en="Relativist" data-zh="相對主義">Relativist</span></div>
              <div class="quadrant-axis axis-right"><strong data-en="Ontology" data-zh="本體論">Ontology</strong><span data-en="Realist" data-zh="現實主義">Realist</span></div>
              <div class="reference-quadrant-map" aria-label="Reference placement of research paradigms">
                <span class="reference-paradigm ref-positivism" data-en="Positivism" data-zh="實證主義">Positivism</span>
                <span class="reference-paradigm ref-critical-realism" data-en="Critical Realism" data-zh="批判現實主義">Critical Realism</span>
                <span class="reference-paradigm ref-postpositivism" data-en="Post-Positivism" data-zh="後實證主義">Post-Positivism</span>
                <span class="reference-paradigm ref-pragmatism" data-en="Pragmatism" data-zh="實用主義">Pragmatism</span>
                <span class="reference-paradigm ref-social-constructionism" data-en="Social Constructionism" data-zh="社會建構主義">Social Constructionism</span>
                <span class="reference-paradigm ref-constructivism" data-en="Constructivism" data-zh="建構主義">Constructivism</span>
                <span class="reference-paradigm ref-interpretivism" data-en="Interpretivism" data-zh="解釋主義">Interpretivism</span>
              </div>
            </div>
            <button type="button" class="reset-position" data-paradigm-back data-en="Return to my map" data-zh="返回我的地圖">Return to my map</button>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Example · Paradigms in research" aria-hidden="true">
      <div class="slide-inner paradigm-video-slide">
        <p class="eyebrow">Example</p>
        <h2 data-en="Ontology, epistemology, and research paradigms" data-zh="本體論、知識論與研究典範">Ontology, epistemology, and research paradigms</h2>
        <p class="lead small" data-en="Use this short video to revisit the connections you just mapped. As you watch, ask: which claims about reality and knowledge does each paradigm make?" data-zh="用這段短片重溫剛才繪製的連繫。觀看時請追問：每一個典範對現實與知識作出了甚麼主張？">Use this short video to revisit the connections you just mapped. As you watch, ask: which claims about reality and knowledge does each paradigm make?</p>
