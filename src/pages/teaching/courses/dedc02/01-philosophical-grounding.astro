---
import CourseSlideLayout from '../../../../layouts/CourseSlideLayout.astro';
import { withBase } from '../../../../utils/paths';

const title = '1. Philosophical Grounding · DEDC02';
const description = 'An interactive lesson on the philosophical foundations of educational research.';
const courseHref = withBase('/teaching/courses/dedc02');
const treeSrc = withBase('/teaching/courses/dedc02/assets/methodology-tree.png');

const outcomes = [
  ['Explain ontology, epistemology, axiology, methodology and methods in accessible language.', '以清晰易懂的語言解釋本體論、知識論、價值論、方法論與研究方法。'],
  ['Distinguish methodology from methods.', '區分方法論與研究方法。'],
  ['Explain how philosophical assumptions influence questions, designs, evidence and claims.', '解釋哲學假設如何影響研究問題、設計、證據與主張。'],
  ['Compare different ways of investigating the same educational problem.', '比較研究同一教育問題的不同方式。'],
];

const layers = [
  ['Research problem', 'What needs to be understood?', '研究問題', '需要理解甚麼？'],
  ['Ontology', 'What is the nature of reality?', '本體論', '現實的本質是甚麼？'],
  ['Epistemology', 'What can be known, and how?', '知識論', '甚麼可以被認識？如何認識？'],
  ['Axiology', 'Whose values and interests matter?', '價值論', '誰的價值與利益重要？'],
  ['Methodology', 'What logic guides the inquiry?', '方法論', '甚麼整體邏輯引導研究？'],
  ['Methods', 'What procedures produce evidence?', '研究方法', '甚麼程序產生證據？'],
  ['Claims', 'What can the evidence support?', '研究主張', '證據能合理支持甚麼？'],
];

const positions = [
  ['Positivism', 'A single reality can be observed and measured. Research seeks patterns, causes and general laws.', '實證主義', '現實是單一、可觀察和測量的；研究尋找規律、原因與一般法則。'],
  ['Postpositivism', 'A real world exists, but our knowledge is always fallible. Claims remain probabilistic and open to revision.', '後實證主義', '真實世界存在，但人的知識總有局限；研究主張是概率性的，並可被修正。'],
  ['Interpretivism / constructivism', 'People construct meanings through experience and interaction. Multiple, situated realities are expected.', '詮釋主義／建構主義', '人們透過經驗與互動建構意義，因此可能存在多重且情境化的現實。'],
  ['Critical / transformative', 'Knowledge and power are connected. Research examines inequality and may seek social or institutional change.', '批判／轉化取向', '知識與權力互相關連；研究檢視不平等，並可能追求社會或制度改變。'],
  ['Pragmatism', 'The research problem and practical consequences guide the inquiry. Different forms of evidence may be combined.', '實用主義', '研究問題與實際後果引導探究；可結合不同形式的證據。'],
];

const exitQuestions = [
  ['ontology', 'Ontology concerns…', '本體論關注……'],
  ['epistemology', 'Epistemology concerns…', '知識論關注……'],
  ['axiology', 'Axiology matters because…', '價值論重要，因為……'],
  ['methodology', 'Methodology differs from methods because…', '方法論與研究方法不同，因為……'],
  ['assumption', 'One assumption influencing my research is…', '影響我研究的一項假設是……'],
  ['alignment', 'The weakest alignment in my research plan may be…', '我的研究計劃中最弱的一致性可能是……'],
];
---

<CourseSlideLayout {title} {description}>
  <div class="slide-tools" aria-label="Slide tools">
    <button type="button" class="translate-button" data-translate-current aria-pressed="false">中文</button>
    <div class="global-timer" aria-label="Presentation timer">
      <input type="number" min="1" max="999" inputmode="numeric" placeholder="min" aria-label="Timer minutes" data-timer-minutes />
      <button type="button" data-timer-start>Start</button>
      <output data-timer-output hidden>00:00</output>
      <button type="button" data-timer-reset aria-label="Reset timer">↺</button>
    </div>
  </div>

  <main class="deck" aria-label="Philosophical Grounding slide deck">
    <section class="slide is-active title-slide" data-title="Philosophical Grounding" aria-hidden="false">
      <div class="slide-inner">
        <p class="eyebrow">DEDC02 · Advanced Research Method</p>
        <div class="short-rule"></div>
        <h1 data-en="Philosophical Grounding" data-zh="研究的哲學基礎">Philosophical Grounding</h1>
        <p class="lead" data-en="How assumptions about reality, knowledge and values shape research decisions." data-zh="關於現實、知識與價值的假設，如何形塑研究決策。">How assumptions about reality, knowledge and values shape research decisions.</p>
      </div>
    </section>

    <section class="slide" data-title="Learning outcomes" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow" data-en="Learning outcomes" data-zh="學習成果">Learning outcomes</p>
        <h2 data-en="By the end, you can…" data-zh="完成本課後，你能夠……">By the end, you can…</h2>
        <ol class="outcome-list">
          {outcomes.map(([en, zh], index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><p data-en={en} data-zh={zh}>{en}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="slide" data-title="The research chain" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow" data-en="A simple map" data-zh="簡明地圖">A simple map</p>
        <h2 data-en="Research decisions form a chain" data-zh="研究決策構成一條鏈">Research decisions form a chain</h2>
        <p class="lead small" data-en="Open each term. A defensible study explains how one decision leads to the next." data-zh="點開每個術語。可辯護的研究會解釋一項決策如何連接下一項。">Open each term. A defensible study explains how one decision leads to the next.</p>
        <div class="layer-list">
          {layers.map(([enTitle, enText, zhTitle, zhText], index) => (
            <details>
              <summary><span>{index + 1}</span><b data-en={enTitle} data-zh={zhTitle}>{enTitle}</b></summary>
              <p data-en={enText} data-zh={zhText}>{enText}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="slide" data-title="From observation to research" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow" data-en="From observation to research" data-zh="從觀察到研究">From observation to research</p>
        <h2 data-en="Turn an observation into research" data-zh="把觀察轉化為研究">Turn an observation into research</h2>
        <div class="problem-strip" data-en="Starting observation: Ten students were absent from yesterday’s research methods class." data-zh="起始觀察：昨天的研究方法課有十名學生缺席。">Starting observation: Ten students were absent from yesterday’s research methods class.</div>
        <ol class="steps research-steps">
          <li data-en="Notice: An attendance record is an observation." data-zh="留意：出席紀錄是一項觀察。">Notice: An attendance record is an observation.</li>
          <li data-en="Ask why it matters: Is this unusual, consequential or worth understanding?" data-zh="追問其重要性：這是否不尋常、有影響，或值得理解？">Ask why it matters: Is this unusual, consequential or worth understanding?</li>
          <li data-en="Name what is unknown: We do not know why students were absent or whether this is a pattern." data-zh="說明未知之處：我們尚未知道學生為何缺席，或這是否一種規律。">Name what is unknown: We do not know why students were absent or whether this is a pattern.</li>
          <li data-en="State a research problem: There is insufficient understanding of factors associated with absence from this class." data-zh="提出研究問題：我們對與此課堂缺席相關的因素仍缺乏理解。">State a research problem: There is insufficient understanding of factors associated with absence from this class.</li>
          <li data-en="Set a purpose and questions: Explore factors influencing attendance and whether absence is recurrent." data-zh="確定目的與問題：探究影響出席的因素，以及缺席是否反覆出現。">Set a purpose and questions: Explore factors influencing attendance and whether absence is recurrent.</li>
        </ol>
        <p class="instruction" data-en="A research problem identifies a gap in understanding. It does not assume a cause or prescribe a solution." data-zh="研究問題指出理解上的缺口；它不預設原因，也不預先指定解決方案。">A research problem identifies a gap in understanding. It does not assume a cause or prescribe a solution.</p>
      </div>
    </section>

    <section class="slide" data-title="Question the problem" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow" data-en="Concept inquiry" data-zh="概念探究">Concept inquiry</p>
        <h2 data-en="Before we define terms, ask better questions" data-zh="先提出更好的問題，再定義術語">Before we define terms, ask better questions</h2>
        <div class="problem-strip" data-en="Is this an observation, a practical problem, or already a research problem? What else would we need to know?" data-zh="這是一項觀察、實際問題，還是已經是一個研究問題？我們還需要知道甚麼？">Is this an observation, a practical problem, or already a research problem? What else would we need to know?</div>
        <div class="three-explanations">
          <article>
            <h3 data-en="Ontology" data-zh="本體論">Ontology</h3>
            <p data-en="What exactly is the phenomenon: ten individual absences, a class-level pattern, or different forms of absence?" data-zh="究竟在研究甚麼現象：十名學生各自缺席、全班層面的規律，還是不同形式的缺席？">What exactly is the phenomenon: ten individual absences, a class-level pattern, or different forms of absence?</p>
          </article>
          <article>
            <h3 data-en="Epistemology" data-zh="知識論">Epistemology</h3>
            <p data-en="How could we know about it beyond the attendance record? Whose account should count?" data-zh="除了出席紀錄，我們如何了解這個現象？誰的敘述應被重視？">How could we know about it beyond the attendance record? Whose account should count?</p>
          </article>
          <article>
            <h3 data-en="Axiology" data-zh="價值論">Axiology</h3>
            <p data-en="What responsibilities do we have when asking students why they were absent? Could the inquiry blame or expose them?" data-zh="詢問學生缺席原因時，我們有甚麼責任？研究會否令他們受到責備或暴露？">What responsibilities do we have when asking students why they were absent? Could the inquiry blame or expose them?</p>
          </article>
          <article>
            <h3 data-en="Methodology" data-zh="方法論">Methodology</h3>
            <p data-en="If we want to understand experiences rather than measure frequency, what overall approach to inquiry would fit?" data-zh="若要理解經驗而非測量頻率，哪種整體研究取向較合適？">If we want to understand experiences rather than measure frequency, what overall approach to inquiry would fit?</p>
          </article>
          <article>
            <h3 data-en="Methods" data-zh="研究方法">Methods</h3>
            <p data-en="What could we actually do: examine records, use an anonymous questionnaire, conduct interviews, or combine these?" data-zh="我們實際可以怎樣做：檢視紀錄、使用匿名問卷、進行訪談，還是結合不同方法？">What could we actually do: examine records, use an anonymous questionnaire, conduct interviews, or combine these?</p>
          </article>
        </div>
        <p class="instruction" data-en="Do not solve the problem yet. First decide what each question is asking about." data-zh="暫時不要解決問題；先判斷每條問題在追問甚麼。">Do not solve the problem yet. First decide what each question is asking about.</p>
      </div>
    </section>

    <section class="slide" data-title="Philosophical layers" aria-hidden="true">
      <div class="slide-inner split-simple">
        <div>
          <p class="eyebrow" data-en="Illustration" data-zh="插圖">Illustration</p>
          <h2 data-en="Roots, stance, strategy and tools" data-zh="根基、立場、策略與工具">Roots, stance, strategy and tools</h2>
          <dl class="plain-definitions">
            <div><dt data-en="Ontology" data-zh="本體論">Ontology</dt><dd data-en="How we understand reality." data-zh="我們如何理解現實。">How we understand reality.</dd></div>
            <div><dt data-en="Epistemology" data-zh="知識論">Epistemology</dt><dd data-en="How we can investigate and know it." data-zh="我們如何研究並認識現實。">How we can investigate and know it.</dd></div>
            <div><dt data-en="Axiology" data-zh="價值論">Axiology</dt><dd data-en="How values and responsibilities shape inquiry." data-zh="價值與責任如何形塑研究。">How values and responsibilities shape inquiry.</dd></div>
            <div><dt data-en="Methodology" data-zh="方法論">Methodology</dt><dd data-en="The overall logic of the inquiry." data-zh="探究的整體邏輯。">The overall logic of the inquiry.</dd></div>
            <div><dt data-en="Methods" data-zh="研究方法">Methods</dt><dd data-en="The procedures used to collect and analyse data." data-zh="收集與分析資料的具體程序。">The procedures used to collect and analyse data.</dd></div>
          </dl>
        </div>
        <figure class="tree-illustration"><img src={treeSrc} alt="Tree illustration of ontology, epistemology, methodology and methods" /></figure>
      </div>
    </section>

    <section class="slide" data-title="Can research be value-free?" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow" data-en="Values continuum" data-zh="價值連續線">Values continuum</p>
        <div class="problem-strip" data-en="Research problem: Ten students were absent from yesterday’s research methods class." data-zh="研究問題：昨天的研究方法課有十名學生缺席。">Research problem: Ten students were absent from yesterday’s research methods class.</div>
        <h2 data-en="Good research should be completely objective and value-free." data-zh="好的研究應完全客觀，並且不受價值影響。">Good research should be completely objective and value-free.</h2>
        <div class="continuum">
          <label><span data-en="Strongly disagree" data-zh="非常不同意">Strongly disagree</span><span data-en="Strongly agree" data-zh="非常同意">Strongly agree</span></label>
          <input type="range" min="0" max="100" value="50" aria-label="Position on values continuum" />
        </div>
        <div class="question-list compact">
          <p data-en="Who decided that absence is a problem?" data-zh="誰決定缺席是一個問題？">Who decided that absence is a problem?</p>
          <p data-en="Whose interests would the study serve?" data-zh="研究會服務誰的利益？">Whose interests would the study serve?</p>
          <p data-en="Could the researcher’s position affect interpretation?" data-zh="研究者的位置會影響詮釋嗎？">Could the researcher’s position affect interpretation?</p>
          <p data-en="Is attempting neutrality itself a value position?" data-zh="嘗試保持中立本身也是一種價值立場嗎？">Is attempting neutrality itself a value position?</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Axiology throughout research" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow" data-en="Beyond ethical approval" data-zh="超越倫理審批">Beyond ethical approval</p>
        <div class="problem-strip" data-en="Research problem: Ten students were absent from yesterday’s research methods class." data-zh="研究問題：昨天的研究方法課有十名學生缺席。">Research problem: Ten students were absent from yesterday’s research methods class.</div>
        <h2 data-en="Axiology runs through the whole study" data-zh="價值論貫穿整項研究">Axiology runs through the whole study</h2>
        <div class="plain-row">
          <div><b data-en="Priorities" data-zh="優先次序">Priorities</b><span data-en="What deserves study?" data-zh="甚麼值得研究？">What deserves study?</span></div>
          <div><b data-en="Position" data-zh="研究者位置">Position</b><span data-en="How am I implicated?" data-zh="我如何牽涉其中？">How am I implicated?</span></div>
          <div><b data-en="Power" data-zh="權力">Power</b><span data-en="Whose voice counts?" data-zh="誰的聲音被重視？">Whose voice counts?</span></div>
          <div><b data-en="Consequences" data-zh="後果">Consequences</b><span data-en="Who benefits or loses?" data-zh="誰受益或受損？">Who benefits or loses?</span></div>
        </div>
        <p class="instruction" data-en="Values can be made transparent and examined. They cannot simply be switched off." data-zh="價值可以被透明呈現與檢視，卻不能被簡單關掉。">Values can be made transparent and examined. They cannot simply be switched off.</p>
      </div>
    </section>

    <section class="slide" data-title="One problem, different studies" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow" data-en="Connecting assumptions and questions" data-zh="連接假設與問題">Connecting assumptions and questions</p>
        <div class="problem-strip" data-en="Research problem: Ten students were absent from yesterday’s research methods class." data-zh="研究問題：昨天的研究方法課有十名學生缺席。">Research problem: Ten students were absent from yesterday’s research methods class.</div>
        <h2 data-en="The same event can become different studies" data-zh="同一事件可以形成不同研究">The same event can become different studies</h2>
        <div class="study-list">
          <div><b data-en="Measure behaviour" data-zh="測量行為">Measure behaviour</b><p data-en="Which factors predict student absence?" data-zh="哪些因素能預測學生缺席？">Which factors predict student absence?</p></div>
          <div><b data-en="Interpret meaning" data-zh="詮釋意義">Interpret meaning</b><p data-en="How do students understand and explain absence?" data-zh="學生如何理解和解釋缺席？">How do students understand and explain absence?</p></div>
          <div><b data-en="Critique policy" data-zh="批判政策">Critique policy</b><p data-en="Whom do attendance rules privilege or disadvantage?" data-zh="出席規定偏向或不利於哪些人？">Whom do attendance rules privilege or disadvantage?</p></div>
          <div><b data-en="Improve practice" data-zh="改善實踐">Improve practice</b><p data-en="Which feasible response works, for whom and under what conditions?" data-zh="哪些可行回應對誰有效，並在甚麼條件下有效？">Which feasible response works, for whom and under what conditions?</p></div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Research positions" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow" data-en="Research positions" data-zh="研究立場">Research positions</p>
        <h2 data-en="Five ways of seeing and knowing" data-zh="五種理解現實與知識的方式">Five ways of seeing and knowing</h2>
        <div class="position-list">
          {positions.map(([enTitle, enText, zhTitle, zhText], index) => (
            <details>
              <summary><span>{String(index + 1).padStart(2, '0')}</span><b data-en={enTitle} data-zh={zhTitle}>{enTitle}</b></summary>
              <p data-en={enText} data-zh={zhText}>{enText}</p>
            </details>
          ))}
        </div>
        <p class="note" data-en="These labels simplify complex and contested traditions. Use them as starting points, not boxes." data-zh="這些標籤簡化了複雜且具爭議的傳統；應把它們視為起點，而不是固定框架。">These labels simplify complex and contested traditions. Use them as starting points, not boxes.</p>
      </div>
    </section>

    <section class="slide" data-title="AI position lab" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow" data-en="AI-supported position lab" data-zh="AI 輔助研究立場實驗室">AI-supported position lab</p>
        <div class="problem-strip" data-en="Research problem: Ten students were absent from yesterday’s research methods class." data-zh="研究問題：昨天的研究方法課有十名學生缺席。">Research problem: Ten students were absent from yesterday’s research methods class.</div>
        <h2 data-en="Investigate one position, then challenge AI" data-zh="探究一種立場，然後挑戰 AI">Investigate one position, then challenge AI</h2>
        <ol class="steps short">
          <li data-en="Choose or receive one research position." data-zh="選擇或獲分配一種研究立場。">Choose or receive one research position.</li>
          <li data-en="Use the prompt. Record the AI tool and your exact prompt." data-zh="使用提示詞，並記錄 AI 工具與完整提示詞。">Use the prompt. Record the AI tool and your exact prompt.</li>
          <li data-en="Verify the two sources and identify one weak or contested claim." data-zh="核實兩項來源，並找出一項薄弱或具爭議的主張。">Verify the two sources and identify one weak or contested claim.</li>
          <li data-en="Rewrite the absence question from that position and explain the assumptions behind it." data-zh="從該立場重寫缺席問題，並解釋背後假設。">Rewrite the absence question from that position and explain the assumptions behind it.</li>
        </ol>
        <div class="prompt-box">
          <p data-en="Act as a cautious educational research tutor. Explain [POSITION] through: (1) ontology, (2) epistemology, (3) axiology, (4) suitable methodology, and (5) defensible claims. Apply it to: ‘Ten students were absent from yesterday’s research methods class.’ Propose one research question, suitable methods, one likely limitation and two real scholarly sources with DOI or stable links. Mark contested points and do not invent references." data-zh="請以審慎的教育研究導師身份，從以下方面解釋［研究立場］：(1) 本體論、(2) 知識論、(3) 價值論、(4) 合適的方法論、(5) 可辯護的主張。把它應用於「昨天的研究方法課有十名學生缺席」，提出一條研究問題、合適方法、一項可能限制，以及兩項附 DOI 或穩定連結的真實學術來源。標明具爭議之處，切勿虛構文獻。">Act as a cautious educational research tutor. Explain [POSITION] through: (1) ontology, (2) epistemology, (3) axiology, (4) suitable methodology, and (5) defensible claims. Apply it to: ‘Ten students were absent from yesterday’s research methods class.’ Propose one research question, suitable methods, one likely limitation and two real scholarly sources with DOI or stable links. Mark contested points and do not invent references.</p>
          <button type="button" class="copy-button" data-copy-prompt data-en="Copy prompt" data-zh="複製提示詞">Copy prompt</button>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Misconception check" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow" data-en="Misconception check" data-zh="誤解檢查">Misconception check</p>
        <h2 data-en="Methods do not announce a position" data-zh="研究方法本身不會宣告研究立場">Methods do not announce a position</h2>
        <div class="misconceptions">
          <details><summary data-en="Interviews automatically make a study constructivist." data-zh="訪談會令研究自動成為建構主義研究。">Interviews automatically make a study constructivist.</summary><p data-en="No. The same method can serve different methodological logics." data-zh="不會。同一方法可服務不同的方法論邏輯。">No. The same method can serve different methodological logics.</p></details>
          <details><summary data-en="Statistics automatically make a study positivist." data-zh="統計會令研究自動成為實證主義研究。">Statistics automatically make a study positivist.</summary><p data-en="No. Examine the assumptions, purpose and intended claim." data-zh="不會。應檢視假設、目的與預期主張。">No. Examine the assumptions, purpose and intended claim.</p></details>
          <details><summary data-en="A questionnaire is a methodology." data-zh="問卷是一種方法論。">A questionnaire is a methodology.</summary><p data-en="No. A questionnaire is a specific method." data-zh="不是。問卷是一種具體研究方法。">No. A questionnaire is a specific method.</p></details>
          <details><summary data-en="Mixed methods automatically means pragmatism." data-zh="混合方法必然等於實用主義。">Mixed methods automatically means pragmatism.</summary><p data-en="No. Combining methods does not establish the philosophical position." data-zh="不是。結合方法本身不能確立哲學立場。">No. Combining methods does not establish the philosophical position.</p></details>
          <details><summary data-en="Axiology means only research ethics." data-zh="價值論只等於研究倫理。">Axiology means only research ethics.</summary><p data-en="Too narrow. It also includes priorities, power and researcher position." data-zh="過於狹窄。它亦涵蓋優先次序、權力與研究者位置。">Too narrow. It also includes priorities, power and researcher position.</p></details>
          <details><summary data-en="Methodology is another word for methods." data-zh="方法論只是研究方法的另一種說法。">Methodology is another word for methods.</summary><p data-en="No. Methodology is the overall strategy and logic of inquiry." data-zh="不是。方法論是探究的整體策略與邏輯。">No. Methodology is the overall strategy and logic of inquiry.</p></details>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Design studio instructions" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow" data-en="Design studio" data-zh="研究設計工作室">Design studio</p>
        <div class="problem-strip" data-en="Research problem: Why do some university students regularly miss scheduled classes?" data-zh="研究問題：為甚麼部分大學生經常缺席既定課堂？">Research problem: Why do some university students regularly miss scheduled classes?</div>
        <h2 data-en="Design one coherent study" data-zh="設計一項連貫研究">Design one coherent study</h2>
        <ol class="steps">
          <li data-en="Each group takes one position: positivist, postpositivist, interpretive/constructivist, critical/transformative, or pragmatist." data-zh="每組採用一種立場：實證主義、後實證主義、詮釋／建構主義、批判／轉化取向或實用主義。">Each group takes one position: positivist, postpositivist, interpretive/constructivist, critical/transformative, or pragmatist.</li>
          <li data-en="Write one research question that follows from that position." data-zh="寫出一條符合該立場的研究問題。">Write one research question that follows from that position.</li>
          <li data-en="State the ontological, epistemological and axiological assumptions behind the question." data-zh="說明問題背後的本體論、知識論與價值論假設。">State the ontological, epistemological and axiological assumptions behind the question.</li>
          <li data-en="Choose a methodology and methods that can produce relevant evidence." data-zh="選擇能產生相關證據的方法論與研究方法。">Choose a methodology and methods that can produce relevant evidence.</li>
          <li data-en="State the claim the evidence could support—and what it could not support." data-zh="說明證據可以支持與不能支持的主張。">State the claim the evidence could support—and what it could not support.</li>
          <li data-en="Prepare to defend the alignment between every decision." data-zh="準備為各項決策之間的一致性作出答辯。">Prepare to defend the alignment between every decision.</li>
        </ol>
      </div>
    </section>

    <section class="slide" data-title="Question starters by position" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow" data-en="Question starters" data-zh="研究問題起點">Question starters</p>
        <div class="problem-strip" data-en="Research problem: Why do some university students regularly miss scheduled classes?" data-zh="研究問題：為甚麼部分大學生經常缺席既定課堂？">Research problem: Why do some university students regularly miss scheduled classes?</div>
        <h2 data-en="Use the position to reshape the question" data-zh="運用研究立場重塑問題">Use the position to reshape the question</h2>
        <div class="question-starters">
          <div><b data-en="Positivist" data-zh="實證主義">Positivist</b><p data-en="What observable factors cause student absence?" data-zh="哪些可觀察因素導致學生缺席？">What observable factors cause student absence?</p></div>
          <div><b data-en="Postpositivist" data-zh="後實證主義">Postpositivist</b><p data-en="Which factors predict absence, and how confidently?" data-zh="哪些因素能預測缺席？可信程度如何？">Which factors predict absence, and how confidently?</p></div>
          <div><b data-en="Interpretive / constructivist" data-zh="詮釋／建構主義">Interpretive / constructivist</b><p data-en="How do students understand their decisions to miss class?" data-zh="學生如何理解自己的缺席決定？">How do students understand their decisions to miss class?</p></div>
          <div><b data-en="Critical / transformative" data-zh="批判／轉化取向">Critical / transformative</b><p data-en="How do attendance policies advantage or disadvantage different students?" data-zh="出席政策如何使不同學生受益或受損？">How do attendance policies advantage or disadvantage different students?</p></div>
          <div><b data-en="Pragmatist" data-zh="實用主義">Pragmatist</b><p data-en="Which feasible response improves attendance, for whom and under what conditions?" data-zh="哪些可行回應能改善出席？對誰有效？在甚麼條件下有效？">Which feasible response improves attendance, for whom and under what conditions?</p></div>
        </div>
        <p class="instruction" data-en="Do not copy a starter unchanged. Revise it so the assumptions and intended claim are clear." data-zh="不要直接照抄。請修訂問題，使其假設與預期主張清晰可見。">Do not copy a starter unchanged. Revise it so the assumptions and intended claim are clear.</p>
      </div>
    </section>

    <section class="slide" data-title="Alignment canvas" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow" data-en="Research Design Alignment Canvas" data-zh="研究設計一致性畫布">Research Design Alignment Canvas</p>
        <div class="problem-strip" data-en="Research problem: Why do some university students regularly miss scheduled classes?" data-zh="研究問題：為甚麼部分大學生經常缺席既定課堂？">Research problem: Why do some university students regularly miss scheduled classes?</div>
        <h2 data-en="Make every connection visible" data-zh="讓每個連繫清晰可見">Make every connection visible</h2>
        <div class="canvas-list">
          <div><b data-en="Purpose" data-zh="目的">Purpose</b><span data-en="What should the study accomplish?" data-zh="研究要達成甚麼？">What should the study accomplish?</span></div>
          <div><b data-en="Research question" data-zh="研究問題">Research question</b><span data-en="What exactly will be asked?" data-zh="研究具體要問甚麼？">What exactly will be asked?</span></div>
          <div><b data-en="Ontology" data-zh="本體論">Ontology</b><span data-en="What is assumed about reality?" data-zh="對現實有甚麼假設？">What is assumed about reality?</span></div>
          <div><b data-en="Epistemology" data-zh="知識論">Epistemology</b><span data-en="What counts as knowledge?" data-zh="甚麼算知識？">What counts as knowledge?</span></div>
          <div><b data-en="Axiology" data-zh="價值論">Axiology</b><span data-en="Which values and positions matter?" data-zh="哪些價值與位置重要？">Which values and positions matter?</span></div>
          <div><b data-en="Methodology" data-zh="方法論">Methodology</b><span data-en="What overall strategy fits?" data-zh="哪種整體策略合適？">What overall strategy fits?</span></div>
          <div><b data-en="Methods" data-zh="研究方法">Methods</b><span data-en="What procedures will be used?" data-zh="將使用甚麼程序？">What procedures will be used?</span></div>
          <div><b data-en="Evidence" data-zh="證據">Evidence</b><span data-en="What evidence will the methods produce?" data-zh="方法將產生甚麼證據？">What evidence will the methods produce?</span></div>
          <div><b data-en="Intended claim" data-zh="預期主張">Intended claim</b><span data-en="What can the evidence reasonably support?" data-zh="證據能合理支持甚麼？">What can the evidence reasonably support?</span></div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Exit ticket" aria-hidden="true">
      <div class="slide-inner exit-slide">
        <div class="exit-head">
          <div><p class="eyebrow" data-en="Exit ticket" data-zh="離堂小結">Exit ticket</p><h2 data-en="What is clearer now?" data-zh="現在有甚麼更清晰？">What is clearer now?</h2></div>
          <div class="view-switch" role="tablist"><button type="button" class="is-active" data-exit-view="student" data-en="Student form" data-zh="學生表格">Student form</button><button type="button" data-exit-view="teacher" data-en="Teacher dashboard" data-zh="教師儀表板">Teacher dashboard</button></div>
        </div>

        <section data-exit-panel="student">
          <form class="exit-form" data-exit-form>
            <div class="identity-row">
              <label><span data-en="Nickname or preferred name" data-zh="暱稱或慣用名字">Nickname or preferred name</span><input name="preferredName" maxlength="60" required autocomplete="nickname" /></label>
              <label><span data-en="Class code" data-zh="班級代碼">Class code</span><input name="classCode" maxlength="40" required autocapitalize="characters" /></label>
            </div>
            <div class="exit-grid">
              {exitQuestions.map(([name, en, zh]) => (
                <label><span data-en={en} data-zh={zh}>{en}</span><textarea name={name} data-save={name} rows="2"></textarea></label>
              ))}
            </div>
            <div class="form-actions"><button type="submit" class="primary-button" data-en="Submit exit ticket" data-zh="提交離堂小結">Submit exit ticket</button><p data-exit-status aria-live="polite" data-en="Your preferred name and responses will be shared with the teacher. No email address or student ID is collected." data-zh="你的慣用名字與回答將與教師分享；不會收集電郵地址或學號。">Your preferred name and responses will be shared with the teacher. No email address or student ID is collected.</p></div>
          </form>
        </section>

        <section data-exit-panel="teacher" hidden>
          <div class="dashboard-controls">
            <label><span data-en="Class code" data-zh="班級代碼">Class code</span><input data-dashboard-class-code maxlength="40" /></label>
            <label><span data-en="Teacher access code" data-zh="教師存取碼">Teacher access code</span><input type="password" data-dashboard-access-code autocomplete="current-password" /></label>
            <button type="button" class="primary-button" data-load-responses data-en="Load responses" data-zh="載入回答">Load responses</button>
            <button type="button" data-export-csv disabled data-en="Download CSV" data-zh="下載 CSV">Download CSV</button>
          </div>
          <div class="dashboard-summary"><strong data-response-count>0</strong><span data-en="responses" data-zh="份回答">responses</span><button type="button" data-refresh-responses hidden data-en="Refresh" data-zh="重新整理">Refresh</button></div>
          <p class="dashboard-status" data-dashboard-status aria-live="polite" data-en="Enter the class code and your private teacher access code." data-zh="輸入班級代碼與私人教師存取碼。">Enter the class code and your private teacher access code.</p>
          <div class="response-list" data-response-list></div>
        </section>
      </div>
    </section>

    <section class="slide thank-you-slide" data-title="Thank you" aria-hidden="true">
      <div class="slide-inner">
        <p class="eyebrow">DEDC02 · Advanced Research Method</p>
        <div class="short-rule"></div>
        <h1 data-en="Thank you" data-zh="謝謝">Thank you</h1>
        <p class="lead" data-en="Make the assumptions behind every research decision visible." data-zh="讓每項研究決策背後的假設清晰可見。">Make the assumptions behind every research decision visible.</p>
        <a class="course-return" href={courseHref} data-en="Return to course materials →" data-zh="返回課程資料 →">Return to course materials →</a>
      </div>
    </section>
  </main>

  <nav class="deck-controls" aria-label="Slide controls">
    <a class="home-button" href={courseHref} aria-label="Back to DEDC02 course materials">DEDC02</a>
    <button type="button" data-nav="previous" aria-label="Previous slide">←</button>
    <button class="slide-count" type="button" data-overview aria-label="Open slide overview"><span data-current-slide>1</span> / <span data-slide-total>19</span></button>
    <button type="button" data-nav="next" aria-label="Next slide">→</button>
    <button type="button" data-fullscreen aria-label="Enter full screen">⛶</button>
    <span class="progress-track" aria-hidden="true"><span></span></span>
  </nav>

  <dialog class="overview-dialog" aria-labelledby="overview-title">
    <div><h2 id="overview-title">Slides</h2><button type="button" data-close-overview aria-label="Close overview">×</button></div>
    <ol></ol>
  </dialog>
</CourseSlideLayout>

<style>
  :root { --green: #17643f; --dark: #123d2a; --soft: #edf6f0; --line: #a9cbb7; --muted: #567264; }
  * { box-sizing: border-box; }
  .deck { position: relative; height: 100dvh; background: #fff; }
  .slide { position: absolute; inset: 0; display: none; overflow-y: auto; padding: clamp(4.4rem, 8vh, 6rem) clamp(1rem, 5vw, 5rem) 5.5rem; background: #fff; }
  .slide.is-active { display: block; }
  .slide-inner { width: min(1120px, 100%); min-height: calc(100dvh - 10rem); margin: 0 auto; display: flex; flex-direction: column; justify-content: center; }
  .eyebrow { margin: 0 0 .8rem; color: var(--green); font-size: .78rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h1, h2 { margin: 0 0 1.2rem; color: var(--dark); font-family: 'Source Serif 4', Georgia, serif; font-weight: 600; letter-spacing: -.035em; }
  h1 { max-width: 15ch; font-size: clamp(3.8rem, 10vw, 8rem); line-height: .9; }
  h2 { max-width: 26ch; font-size: clamp(2.1rem, 5vw, 4.1rem); line-height: 1; }
  p { margin-top: 0; }
  .lead { max-width: 60ch; color: var(--muted); font-size: clamp(1.1rem, 2vw, 1.45rem); line-height: 1.5; }
  .lead.small { font-size: 1.05rem; }
  .short-rule { width: 4rem; height: .35rem; margin-bottom: 2rem; border-radius: 2rem; background: var(--green); }
  .slide-tools { position: fixed; right: 1rem; top: 1rem; z-index: 30; display: flex; align-items: center; gap: .45rem; }
  .translate-button, .global-timer { border: 1px solid var(--line); border-radius: 999px; background: rgba(255,255,255,.97); box-shadow: 0 .25rem 1rem rgba(18,61,42,.08); }
  .translate-button { min-height: 2.3rem; padding: .4rem .75rem; color: var(--green); font-weight: 700; cursor: pointer; }
  .translate-button[aria-pressed="true"] { background: var(--green); color: #fff; }
  .global-timer { display: flex; align-items: center; gap: .2rem; padding: .22rem; }
  .global-timer input { width: 3.4rem; min-height: 1.9rem; border: 0; padding: .2rem; color: var(--dark); text-align: center; }
  .global-timer button { min-height: 1.9rem; border: 0; border-radius: 999px; padding: .3rem .55rem; background: transparent; color: var(--green); font-weight: 700; cursor: pointer; }
  .global-timer button:hover { background: var(--soft); }
  .global-timer output { min-width: 4rem; color: var(--green); font-weight: 700; text-align: center; }
  .outcome-list { display: grid; grid-template-columns: 1fr 1fr; gap: 0 2rem; margin: 0; padding: 0; list-style: none; }
  .outcome-list li { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: .75rem; align-items: start; padding: .75rem 0; border-bottom: 1px solid #dcebe2; }
  .outcome-list li > span { color: var(--green); font-weight: 700; }
  .outcome-list p { margin: 0; color: var(--dark); font-size: 1.05rem; line-height: 1.45; }
  .layer-list { display: grid; grid-template-columns: repeat(4, 1fr); gap: .55rem; }
  .layer-list details, .position-list details, .misconceptions details { border: 1px solid var(--line); border-radius: .35rem; }
  summary { cursor: pointer; }
  .layer-list summary, .position-list summary { display: flex; gap: .6rem; padding: .75rem; color: var(--dark); list-style: none; }
  .layer-list summary span, .position-list summary span { color: var(--green); font-size: .75rem; font-weight: 700; }
  .layer-list details p, .position-list details p { margin: 0; padding: .75rem; border-top: 1px solid var(--line); background: var(--soft); color: var(--muted); line-height: 1.4; }
  .problem-strip { margin-bottom: 1.2rem; padding: .7rem .9rem; border-left: .3rem solid var(--green); background: var(--soft); color: var(--dark); font-weight: 600; }
  .question-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; }
  .question-list p { margin: 0; padding: .8rem; border: 1px solid var(--line); border-radius: .35rem; color: var(--dark); }
  .question-list.compact { grid-template-columns: repeat(4, 1fr); }
  .instruction { margin: 1rem 0 0; padding: .75rem .9rem; border-left: .3rem solid var(--green); background: var(--soft); color: var(--dark); }
  .three-explanations { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; }
  .three-explanations article { padding: 1rem; border: 1px solid var(--line); border-radius: .35rem; }
  .three-explanations h3 { margin: 0 0 .5rem; color: var(--green); }
  .three-explanations p { margin: 0; color: var(--muted); line-height: 1.45; }
  .split-simple { display: grid; grid-template-columns: 1.15fr .85fr; gap: 3rem; align-items: center; }
  .plain-definitions { margin: 0; }
  .plain-definitions div { display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; padding: .6rem 0; border-bottom: 1px solid #dcebe2; }
  .plain-definitions dt { color: var(--green); font-weight: 700; }
  .plain-definitions dd { margin: 0; color: var(--muted); }
  .tree-illustration { margin: 0; text-align: center; }
  .tree-illustration img { max-width: min(100%, 350px); max-height: 62vh; object-fit: contain; }
  .steps { margin: 0; padding: 0; counter-reset: step; display: grid; grid-template-columns: 1fr 1fr; gap: .55rem 1.2rem; list-style: none; }
  .steps li { counter-increment: step; display: grid; grid-template-columns: 1.8rem 1fr; gap: .5rem; color: var(--dark); line-height: 1.4; }
  .steps li::before { content: counter(step); display: grid; width: 1.55rem; height: 1.55rem; place-items: center; border-radius: 50%; background: var(--green); color: #fff; font-size: .75rem; font-weight: 700; }
  .steps.short { margin-bottom: .9rem; }
  .prompt-box { position: relative; margin-top: 1rem; padding: 1rem 8.5rem 1rem 1rem; border: 1px solid var(--line); border-radius: .4rem; background: #fff; }
  .prompt-box p { margin: 0; color: var(--muted); font: .92rem/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .copy-button { position: absolute; right: .7rem; top: .7rem; border: 1px solid var(--green); border-radius: .3rem; padding: .45rem .65rem; background: var(--green); color: #fff; font-weight: 700; cursor: pointer; }
  .simple-checklist { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem 2rem; margin: 0; padding: 0; list-style: none; }
  .simple-checklist li { padding: .7rem 0 .7rem 1.6rem; border-bottom: 1px solid #dcebe2; color: var(--dark); }
  .simple-checklist li::before { content: '✓'; float: left; margin-left: -1.6rem; color: var(--green); font-weight: 700; }
  .continuum { max-width: 900px; padding: 1rem; border: 1px solid var(--line); border-radius: .35rem; }
  .continuum label { display: flex; justify-content: space-between; color: var(--green); font-weight: 700; }
  .continuum input { width: 100%; accent-color: var(--green); }
  .plain-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: .6rem; }
  .plain-row div { display: flex; min-height: 7rem; flex-direction: column; justify-content: flex-end; padding: .8rem; border-top: .25rem solid var(--green); background: var(--soft); }
  .plain-row b { color: var(--dark); }
  .plain-row span { color: var(--muted); font-size: .9rem; }
  .study-list { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
  .study-list div { padding: .8rem; border: 1px solid var(--line); border-radius: .35rem; }
  .study-list b { color: var(--green); }
  .study-list p { margin: .35rem 0 0; color: var(--dark); }
  .position-list { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }
  .position-list details:last-child { grid-column: 1 / -1; }
  .note { margin: .8rem 0 0; color: var(--muted); font-size: .85rem; }
  .misconceptions { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }
  .misconceptions summary { padding: .75rem; color: var(--dark); font-weight: 600; }
  .misconceptions p { margin: 0; padding: .7rem; border-top: 1px solid var(--line); background: var(--soft); color: var(--muted); }
  .question-starters { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }
  .question-starters div { padding: .7rem; border-bottom: 1px solid var(--line); }
  .question-starters div:last-child { grid-column: 1 / -1; }
  .question-starters b { color: var(--green); }
  .question-starters p { margin: .25rem 0 0; color: var(--dark); }
  .canvas-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: .55rem; }
  .canvas-list div { min-height: 5.5rem; padding: .7rem; border: 1px solid var(--line); border-radius: .3rem; }
  .canvas-list b { display: block; margin-bottom: .35rem; color: var(--green); }
  .canvas-list span { color: var(--muted); font-size: .9rem; }
  .exit-slide { justify-content: flex-start; }
  .exit-head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .exit-head h2 { margin-bottom: .8rem; }
  .view-switch { display: flex; margin-bottom: .8rem; border: 1px solid var(--line); border-radius: 999px; padding: .2rem; }
  .view-switch button { min-height: 2rem; border: 0; border-radius: 999px; padding: .35rem .7rem; background: transparent; color: var(--green); font-weight: 700; cursor: pointer; }
  .view-switch button.is-active { background: var(--green); color: #fff; }
