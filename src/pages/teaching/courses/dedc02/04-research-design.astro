<script is:inline>
  const initialiseDesignFamilyMaps = () => {
    document.querySelectorAll('[data-design-family-map]').forEach((map) => {
      if (map.dataset.familyMapReady === 'true') return;
      map.dataset.familyMapReady = 'true';

      const buttons = Array.from(map.querySelectorAll('[data-family-select]'));
      const branches = Array.from(map.querySelectorAll('[data-family-branch]'));
      const prompts = Array.from(map.querySelectorAll('[data-family-prompt]'));

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const targetId = button.dataset.familySelect;
          const wasSelected = button.getAttribute('aria-pressed') === 'true';

          buttons.forEach((item) => item.setAttribute('aria-pressed', 'false'));
          branches.forEach((branch) => { branch.hidden = true; });

          if (wasSelected) {
            prompts.forEach((prompt) => { prompt.hidden = false; });
            return;
          }

          button.setAttribute('aria-pressed', 'true');
          const target = map.querySelector(`#${targetId}`);
          if (target) target.hidden = false;
          prompts.forEach((prompt) => { prompt.hidden = true; });
        });
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialiseDesignFamilyMaps, { once: true });
  } else {
    initialiseDesignFamilyMaps();
  }
</script>

