---
import CourseSlideLayout from '../../../../layouts/CourseSlideLayout.astro';
import { withBase } from '../../../../utils/paths';
import '../../../../styles/dedc02-literature-review.css';

const title = '4. Research Design & Alignment · DEDC02';
const description = 'An interactive lesson on frameworks, research design, sampling, validity, trustworthiness and methodological alignment.';
const courseHref = withBase('/teaching/courses/dedc02');
const probabilitySamplingVisual = withBase('/teaching/courses/dedc02/assets/sampling-probability-methods.png');
const nonProbabilitySamplingVisual = withBase('/teaching/courses/dedc02/assets/sampling-non-probability-methods.png');
const qualityTerms = [
  {
    id: 'quant-reliability', family: 'quant', labelEn: 'Reliability', labelZh: '信度',
    mapEn: 'internal consistency · stability/test-retest · inter-rater/equivalent forms · measurement error',
    mapZh: '內部一致性 · 穩定性／重測 · 評分者間／等值形式 · 測量誤差',
    indicatorEn: 'Scores or ratings remain sufficiently consistent under the conditions in which they will be interpreted.',
    indicatorZh: '分數或評分在預定詮釋條件下保持足夠一致。',
    issueEn: 'Random error, instrument drift, unstable administration or disagreement among raters.',
    issueZh: '隨機誤差、工具漂移、施測不穩定或評分者之間不一致。',
    strategiesEn: ['Standardise administration and scoring', 'Train and calibrate observers or raters', 'Estimate the relevant evidence: omega/alpha, test-retest, inter-rater agreement or measurement error'],
    strategiesZh: ['標準化施測與評分程序', '培訓及校準觀察者或評分者', '按用途估計相關證據：omega／alpha、重測信度、評分者間一致性或測量誤差']
  },
  {
    id: 'quant-construct', family: 'quant', labelEn: 'Construct validity', labelZh: '構念效度',
    mapEn: 'content/face · structural · convergent/discriminant · criterion: concurrent/predictive',
    mapZh: '內容／表面 · 結構 · 聚合／區辨 · 效標：同時／預測',
    indicatorEn: 'The content, structure and relationships of scores accord with the intended construct and use.',
    indicatorZh: '分數的內容、結構及關係符合預定構念與用途。',
    issueEn: 'Construct under-representation, irrelevant variance, method effects or an ill-fitting score structure.',
    issueZh: '構念代表不足、無關變異、方法效應或分數結構不相符。',
    strategiesEn: ['Map items and indicators to theory', 'Use expert and participant review, piloting or cognitive interviews', 'Test structural, convergent, discriminant and criterion-related evidence'],
    strategiesZh: ['把題項與指標對應至理論', '採用專家及參與者審查、先導測試或認知訪談', '檢驗結構、聚合、區辨及效標關聯證據']
  },
  {
    id: 'quant-internal', family: 'quant', labelEn: 'Internal validity', labelZh: '內部效度',
    mapEn: 'causal warrant · confounding · selection · history/maturation · contamination',
    mapZh: '因果理據 · 混淆 · 選擇 · 歷史／成熟 · 污染',
    indicatorEn: 'The observed difference can plausibly be attributed to the proposed cause rather than a rival explanation.',
    indicatorZh: '觀察到的差異可合理歸因於所提出的原因，而非其他競爭性解釋。',
    issueEn: 'Confounding, selection bias, history, maturation, differential attrition or treatment contamination.',
    issueZh: '混淆、選擇偏誤、歷史、成熟、差異流失或處理污染。',
    strategiesEn: ['Randomise when the claim and context permit', 'Use defensible comparison, baseline and timing structures', 'Standardise procedures, blind where feasible and run sensitivity checks'],
    strategiesZh: ['在主張與情境容許時採用隨機化', '採用具理據的比較、基線及時間結構', '標準化程序，在可行情況下設盲並進行敏感度檢查']
  },
  {
    id: 'quant-external', family: 'quant', labelEn: 'External validity', labelZh: '外部效度',
    mapEn: 'population · setting · time · treatment · outcome boundaries',
    mapZh: '群體 · 場域 · 時間 · 處理 · 結果邊界',
    indicatorEn: 'The sample, setting and conditions make the intended scope of generalisation defensible and explicit.',
    indicatorZh: '樣本、場域及條件使預定推廣範圍具有理據並清晰可見。',
    issueEn: 'A narrow or selected sample, context-specific effects, or claims that travel beyond the evidence.',
    issueZh: '樣本狹窄或受選擇、效果依賴情境，或主張超越證據邊界。',
    strategiesEn: ['Align sampling with the target population', 'Describe context and inclusion boundaries', 'Replicate across settings and examine heterogeneity before extending claims'],
    strategiesZh: ['使抽樣對齊目標群體', '描述情境及納入邊界', '在不同場域重複研究並檢視異質性後才延伸主張']
  },
  {
    id: 'quant-statistical', family: 'quant', labelEn: 'Statistical conclusion validity', labelZh: '統計結論效度',
    mapEn: 'power · precision · model assumptions · multiplicity · missingness',
    mapZh: '功效 · 精確度 · 模型假設 · 多重檢驗 · 缺失資料',
    indicatorEn: 'Estimates are sufficiently precise and the analysis supports the stated statistical inference.',
    indicatorZh: '估計具有足夠精確度，而分析能支持所述統計推論。',
    issueEn: 'Low power, model misspecification, assumption violations, multiple testing or biased missing data.',
    issueZh: '功效不足、模型錯設、違反假設、多重檢驗或具偏誤的缺失資料。',
    strategiesEn: ['Plan power or precision before collection', 'Check assumptions and model fit', 'Report effect sizes and intervals; pre-plan missing-data and multiplicity decisions'],
    strategiesZh: ['在蒐集資料前規劃功效或精確度', '檢查假設與模型配適', '報告效果量與區間，並預先規劃缺失資料及多重檢驗決策']
  },
  {
    id: 'qual-credibility', family: 'qual', labelEn: 'Credibility', labelZh: '可信性',
    mapEn: 'evidence–interpretation fit · engagement · participant meanings',
    mapZh: '證據－詮釋配合 · 投入 · 參與者意義',
    indicatorEn: 'Interpretations are well grounded in relevant evidence and offer a plausible account of participants’ meanings or the phenomenon.',
    indicatorZh: '詮釋充分植根於相關證據，並對參與者意義或研究現象提出可信解釋。',
    issueEn: 'Shallow engagement, leading data collection, unsupported themes or selective attention to confirming material.',
    issueZh: '投入不足、引導式資料蒐集、主題缺乏支持，或只關注確認既有觀點的材料。',
    strategiesEn: ['Sustain engagement appropriate to the design', 'Use triangulation only where sources or perspectives genuinely complement one another', 'Treat participant feedback as further evidence; pursue negative cases and peer debriefing'],
    strategiesZh: ['按研究設計保持合適而充分的投入', '只在資料來源或觀點真正互補時採用三角互證', '把參與者回饋視為新增證據，並追查負面個案及進行同儕檢視']
  },
  {
    id: 'qual-dependability', family: 'qual', labelEn: 'Dependability', labelZh: '依賴性',
    mapEn: 'coherent process · documented change · audit trail',
    mapZh: '過程連貫 · 變更有記錄 · 審查軌跡',
    indicatorEn: 'The research process is logical, traceable and documented well enough to understand how decisions developed.',
    indicatorZh: '研究過程合乎邏輯、可追溯，並有足夠記錄說明決策如何發展。',
    issueEn: 'Unrecorded changes, inconsistent interviewing or coding, and decisions that cannot be reconstructed.',
    issueZh: '變更未被記錄、訪談或編碼不一致，以及無法重建的決策。',
    strategiesEn: ['Maintain an audit trail and decision log', 'Use protocols, analytic memos and versioned coding structures', 'Use code-recode or stepwise peer review when compatible with the analytic approach'],
    strategiesZh: ['保存審查軌跡及決策日誌', '採用研究程序、分析備忘錄及版本化編碼結構', '在符合分析取向時採用重新編碼或分階段同儕檢視']
  },
  {
    id: 'qual-confirmability', family: 'qual', labelEn: 'Confirmability', labelZh: '可確認性',
    mapEn: 'traceability to evidence · neutrality through reflexive accountability',
    mapZh: '可追溯至證據 · 透過反思責任維持中立',
    indicatorEn: 'Readers can trace interpretations to evidence and see how researcher assumptions were examined.',
    indicatorZh: '讀者能把詮釋追溯至證據，並看出研究者如何檢視自身假設。',
    issueEn: 'Cherry-picking, undocumented interpretive leaps or unchecked researcher preferences.',
    issueZh: '選擇性取材、詮釋跳躍沒有記錄，或研究者偏好未經檢視。',
    strategiesEn: ['Link claims to excerpts, cases and analytic records', 'Keep reflexive journals and positionality records', 'Invite audit or peer challenge of interpretations'],
    strategiesZh: ['把主張連結至摘錄、個案及分析記錄', '保存反思日誌及位置性記錄', '邀請審查或同儕挑戰研究詮釋']
  },
  {
    id: 'qual-transferability', family: 'qual', labelEn: 'Transferability', labelZh: '可轉移性',
    mapEn: 'thick context · purposeful variation · boundary conditions',
    mapZh: '厚實情境 · 目的性差異 · 邊界條件',
    indicatorEn: 'Context and case characteristics are described well enough for readers to judge relevance elsewhere.',
    indicatorZh: '情境與個案特徵描述充分，讓讀者判斷研究在其他地方的相關性。',
    issueEn: 'Thin contextual description, hidden sampling logic or universal claims from situated accounts.',
    issueZh: '情境描述薄弱、抽樣邏輯隱藏，或由特定情境敘述作出普遍主張。',
    strategiesEn: ['Provide thick description of setting, participants and conditions', 'Explain purposeful sampling and variation sought', 'State boundary conditions and invite case-to-case comparison'],
    strategiesZh: ['厚實描述場域、參與者及條件', '說明目的抽樣及所尋求的差異', '列明邊界條件，讓讀者進行個案間比較']
  },
  {
    id: 'qual-reflexivity', family: 'qual', labelEn: 'Reflexivity & authenticity', labelZh: '反思性與真實性',
    mapEn: 'positionality · relationships · power · diverse voices',
    mapZh: '位置性 · 關係 · 權力 · 多元聲音',
    indicatorEn: 'Researcher position, relationships and influence are visible, while differing perspectives are represented fairly.',
    indicatorZh: '研究者的位置、關係及影響清晰可見，而不同觀點得到公平呈現。',
    issueEn: 'Role blindness, unequal power, a dominant single voice or representation detached from participants’ contexts.',
    issueZh: '忽略自身角色、權力不平等、單一聲音主導，或呈現脫離參與者情境。',
    strategiesEn: ['Write a situated positionality account', 'Document relationships and reflexive decisions throughout the study', 'Seek discordant and less-heard perspectives; examine how representation was produced'],
    strategiesZh: ['撰寫具情境的位置性說明', '持續記錄研究關係及反思決策', '尋找不一致及較少被聽見的觀點，並檢視研究呈現如何形成']
  },
  {
    id: 'qual-challenge', family: 'qual', labelEn: 'Challenge', labelZh: '挑戰',
    mapEn: 'negative cases · rival interpretations · tensions',
    mapZh: '負面個案 · 競爭性詮釋 · 張力',
    indicatorEn: 'The analysis actively tests its developing account against contradictions and plausible alternatives.',
    indicatorZh: '分析主動以矛盾證據及合理替代解釋檢驗逐步形成的說法。',
    issueEn: 'Premature closure, confirmation bias or smoothing away contradictions and minority cases.',
    issueZh: '過早定論、確認偏誤，或把矛盾及少數個案抹平。',
    strategiesEn: ['Search systematically for deviant or negative cases', 'Develop and compare rival explanations', 'Use peer debriefing or alternative coding to pressure-test the account'],
    strategiesZh: ['有系統地尋找偏離或負面個案', '發展並比較競爭性解釋', '透過同儕檢視或替代編碼測試研究解釋']
  },
  {
    id: 'qual-transparency', family: 'qual', labelEn: 'Transparency & analyzability', labelZh: '透明度與可分析性',
    mapEn: 'collection → processing → interpretation → reporting',
    mapZh: '蒐集 → 處理 → 詮釋 → 報告',
    indicatorEn: 'Readers can follow how evidence moved from collection through processing and analysis into the reported claims.',
    indicatorZh: '讀者能追蹤證據如何由蒐集、處理與分析轉化為報告中的主張。',
    issueEn: 'Black-box coding, selective reporting, undocumented procedural changes or an unclear evidence-to-claim chain.',
    issueZh: '黑箱式編碼、選擇性報告、程序變更沒有記錄，或證據至主張的連結不清。',
    strategiesEn: ['Describe collection and analytic procedures with reasons', 'Record changes, code development and interpretation steps', 'Use evidence displays or excerpts and report limitations transparently'],
    strategiesZh: ['說明資料蒐集及分析程序與理由', '記錄變更、編碼發展及詮釋步驟', '採用證據展示或摘錄，並透明報告限制']
  }
];
const quantitativeQualityTerms = qualityTerms.filter((term) => term.family === 'quant');
const qualitativeQualityTerms = qualityTerms.filter((term) => term.family === 'qual');
---

<CourseSlideLayout {title} {description}>
  <section class="pdf-cover" aria-hidden="true">
    <span class="eyebrow">DEDC02 · Advanced Research Method</span>
    <h1>Research Design<br />&amp; Alignment</h1>
    <div class="pdf-message-block">
      <h2>Personal message</h2>
      <p data-pdf-message-print></p>
    </div>
  </section>

  <div class="top-tools" aria-label="Language and timer controls">
    <button class="translate-button" type="button" aria-pressed="false" data-global-translate>中文</button>
    <div class="compact-timer" aria-label="Activity timer">
      <input type="number" min="0.1" step="0.5" inputmode="decimal" placeholder="Timer" aria-label="Timer duration" data-timer-minutes />
      <output data-timer-output hidden aria-live="polite">00:00</output>
      <button type="button" data-timer-start>Start</button>
      <button type="button" data-timer-reset aria-label="Reset timer">↻</button>
    </div>
  </div>

  <main class="deck" aria-label="Research Design and Alignment slide deck">
    <section class="slide is-active" data-title="Research Design & Alignment" aria-hidden="false">
      <div class="slide-inner title-slide">
        <header class="slide-header"><span class="eyebrow">DEDC02 · Advanced Research Method</span></header>
        <div class="title-rule"></div>
        <div data-language="en">
          <h1>Research Design<br />&amp; Alignment</h1>
          <p class="lead">Conceptual and theoretical frameworks, design families, sampling, validity, trustworthiness and the logic connecting them.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h1>研究設計<br />與對齊</h1>
          <p class="lead">概念與理論框架、研究設計類型、抽樣、效度、可信度，以及連結這些元素的邏輯。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Learning aims" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Where we are going</span></header>
        <div data-language="en">
          <h2>By the end, you can…</h2>
          <ol class="number-list">
            <li><span><strong>Distinguish</strong> a theoretical framework from a conceptual framework.</span></li>
            <li><span><strong>Select</strong> a design family that fits the question and intended claim.</span></li>
            <li><span><strong>Justify</strong> an initial sampling strategy.</span></li>
            <li><span><strong>Plan</strong> suitable validity or trustworthiness safeguards.</span></li>
            <li><span><strong>Audit</strong> the alignment of a proposed study.</span></li>
          </ol>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>完成本課後，你可以⋯⋯</h2>
          <ol class="number-list">
            <li><span><strong>區分</strong>理論框架與概念框架。</span></li>
            <li><span><strong>選擇</strong>符合研究問題與預期主張的設計類型。</span></li>
            <li><span><strong>論證</strong>初步抽樣策略。</span></li>
            <li><span><strong>規劃</strong>合適的效度或可信度保障。</span></li>
            <li><span><strong>審視</strong>擬議研究的方法論對齊。</span></li>
          </ol>
        </div>
      </div>
    </section>

    <section class="slide" data-title="From gap to design" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Bridge from Week 3</span></header>
        <div data-language="en">
          <h2>A gap does not choose the method</h2>
          <div class="path-line design-chain">
            <span>Problem</span><b>→</b><span>Framework</span><b>→</b><span>Question</span><b>→</b><span>Claim</span>
          </div>
          <p class="takeaway">The design begins when you decide what evidence would make the intended answer defensible.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>研究缺口不會自動決定方法</h2>
          <div class="path-line design-chain">
            <span>研究課題</span><b>→</b><span>框架</span><b>→</b><span>研究問題</span><b>→</b><span>主張</span>
          </div>
          <p class="takeaway">當你開始判斷需要甚麼證據，才能使預期答案站得住腳，研究設計便開始了。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="What theory does" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Frameworks</span></header>
        <div data-language="en">
          <h2>Theory gives the study an explanatory lens</h2>
          <div class="grid-4">
            <article class="panel accent"><h3>Select</h3><p>Identifies concepts and processes worth attending to.</p></article>
            <article class="panel accent"><h3>Relate</h3><p>Proposes how concepts or conditions connect.</p></article>
            <article class="panel accent"><h3>Explain</h3><p>Offers a reason why an observed pattern may occur.</p></article>
            <article class="panel accent"><h3>Bound</h3><p>Makes assumptions and limits visible.</p></article>
          </div>
          <p class="takeaway">A theory is more than a named citation. It must do identifiable work in the study.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>理論為研究提供解釋視角</h2>
          <div class="grid-4">
            <article class="panel accent"><h3>選取</h3><p>指出值得關注的概念與過程。</p></article>
            <article class="panel accent"><h3>連結</h3><p>提出概念或條件之間可能如何關聯。</p></article>
            <article class="panel accent"><h3>解釋</h3><p>說明為何可能出現某種觀察模式。</p></article>
            <article class="panel accent"><h3>界定</h3><p>使假設與限制變得可見。</p></article>
          </div>
          <p class="takeaway">理論不只是文獻中的一個名稱；它必須在研究中發揮可辨識的作用。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Theoretical and conceptual frameworks" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">The central distinction</span></header>
        <div data-language="en">
          <h2>One study, two levels of framework</h2>
          <div class="framework-study-source">
            <p><strong>Li (2025)</strong> · 206 secondary EFL learners · one argumentative L2 writing task · structural equation modelling</p>
            <div class="framework-study-links" aria-label="Study links">
              <a href="https://pressto.amu.edu.pl/index.php/ssllt/article/download/43371/38183/111749" target="_blank" rel="noreferrer">Download PDF <span aria-hidden="true">↓</span></a>
            </div>
          </div>
          <div class="framework-workbench">
            <article class="framework-panel theory-panel">
              <div class="framework-panel-head">
                <span class="framework-role">Explains why</span>
                <h3>Theoretical framework</h3>
                <p>Control–Value Theory supplies the general explanatory chain.</p>
              </div>
              <ol class="theory-chain" aria-label="Control-Value Theory chain reconstructed from the study">
                <li><strong>Distal antecedents</strong><span>Personal factors · task environment</span></li>
                <li><strong>Proximal appraisals</strong><span>Perceived control · value</span></li>
                <li><strong>Achievement emotions</strong><span>Feelings arising around achievement</span></li>
                <li><strong>Achievement outcomes</strong><span>Performance and learning</span></li>
              </ol>
              <p class="framework-caption">Theory-level reconstruction from Li’s discussion of Control–Value Theory.</p>
            </article>

            <article class="framework-panel concept-panel">
              <div class="framework-panel-head">
                <span class="framework-role">Specifies what</span>
                <h3>Conceptual framework</h3>
                <p>The study selects task-level constructs and proposes testable paths.</p>
              </div>
              <div class="concept-model" aria-label="Li's conceptual framework: task control, intrinsic task value and extrinsic task value predict task emotions; task emotions predict L2 writing task performance; task control and extrinsic task value also have direct paths to performance">
                <div class="appraisal-stack">
                  <span>Task control</span>
                  <span>Intrinsic task value</span>
                  <span>Extrinsic task value</span>
                </div>
                <b class="concept-arrow" aria-hidden="true">→</b>
                <div class="concept-node emotion-node"><strong>Task emotions</strong><span>Enjoyment · Anxiety · Boredom</span></div>
                <b class="concept-arrow" aria-hidden="true">→</b>
                <div class="concept-node performance-node"><strong>L2 writing task performance</strong><span>Language · Content · Organisation</span></div>
              </div>
              <p class="direct-paths"><span>Task control</span><span>Extrinsic task value</span><b aria-hidden="true">→</b><strong>direct paths to performance</strong></p>
              <p class="framework-caption">Adapted from the paper’s Figure 2; arrows represent hypothesised relationships, not causal findings.</p>
            </article>
          </div>
          <p class="takeaway framework-takeaway"><strong>The distinction:</strong> the theory supplies the explanatory logic; the conceptual framework operationalises that logic for this study.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>同一項研究，兩個框架層次</h2>
          <div class="framework-study-source">
            <p><strong>Li（2025）</strong>· 206 名中學 EFL 學習者 · 一項 L2 議論文寫作任務 · 結構方程模型</p>
            <div class="framework-study-links" aria-label="研究連結">
              <a href="https://pressto.amu.edu.pl/index.php/ssllt/article/download/43371/38183/111749" target="_blank" rel="noreferrer">下載 PDF <span aria-hidden="true">↓</span></a>
            </div>
          </div>
          <div class="framework-workbench">
            <article class="framework-panel theory-panel">
              <div class="framework-panel-head">
                <span class="framework-role">解釋「為甚麼」</span>
                <h3>理論框架</h3>
                <p>控制—價值理論提供一般性的解釋鏈。</p>
              </div>
              <ol class="theory-chain" aria-label="根據研究重構的控制—價值理論鏈">
                <li><strong>遠端前因</strong><span>個人因素 · 任務環境</span></li>
                <li><strong>近端評估</strong><span>知覺控制 · 價值</span></li>
                <li><strong>成就情緒</strong><span>圍繞成就活動產生的感受</span></li>
                <li><strong>成就結果</strong><span>表現與學習</span></li>
              </ol>
              <p class="framework-caption">根據 Li 對控制—價值理論的討論重構理論層次。</p>
            </article>

            <article class="framework-panel concept-panel">
              <div class="framework-panel-head">
                <span class="framework-role">具體說明「研究甚麼」</span>
                <h3>概念框架</h3>
                <p>研究選取任務層次構念，並提出可檢驗的路徑。</p>
              </div>
              <div class="concept-model" aria-label="Li 的概念框架：任務控制、任務內在價值與任務外在價值預測任務情緒；任務情緒預測第二語言寫作任務表現；任務控制與任務外在價值亦直接連結表現">
                <div class="appraisal-stack">
                  <span>任務控制</span>
                  <span>任務內在價值</span>
                  <span>任務外在價值</span>
                </div>
                <b class="concept-arrow" aria-hidden="true">→</b>
                <div class="concept-node emotion-node"><strong>任務情緒</strong><span>愉悅 · 焦慮 · 無聊</span></div>
                <b class="concept-arrow" aria-hidden="true">→</b>
                <div class="concept-node performance-node"><strong>L2 寫作任務表現</strong><span>語言 · 內容 · 組織</span></div>
              </div>
              <p class="direct-paths"><span>任務控制</span><span>任務外在價值</span><b aria-hidden="true">→</b><strong>直接連結任務表現</strong></p>
              <p class="framework-caption">改編自論文圖 2；箭咀代表假設關係，而非因果研究結果。</p>
            </article>
          </div>
          <p class="takeaway framework-takeaway"><strong>兩者之別：</strong>理論提供解釋邏輯；概念框架把該邏輯操作化為本研究要檢驗的關係。</p>
        </div>
      </div>
    </section>

