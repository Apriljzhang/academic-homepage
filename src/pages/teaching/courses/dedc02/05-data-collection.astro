---
import CourseSlideLayout from '../../../../layouts/CourseSlideLayout.astro';
import { withBase } from '../../../../utils/paths';
import '../../../../styles/dedc02-data-collection.css';

const title = '5. Data Collection Evidence Lab · DEDC02';
const description = 'An inquiry-led DEDC02 lesson on instruments, data collection procedures and evidence-based protocol design.';
const courseHref = withBase('/teaching/courses/dedc02');

const fieldGuide = [
  { id: 'participants', icon: '◉', en: 'Participants / cases', zh: '參與者／個案', promptEn: 'Who or what supplied the data? Why these cases? Who is absent?', promptZh: '誰或甚麼提供資料？為何是這些個案？誰沒有被包括？' },
  { id: 'access', icon: '↗', en: 'Access & recruitment', zh: '接觸與招募', promptEn: 'How did the researcher reach people or materials? Who controlled access?', promptZh: '研究者如何接觸人員或材料？誰控制接觸途徑？' },
  { id: 'source', icon: '⌁', en: 'Data source', zh: '資料來源', promptEn: 'What was collected? What evidence can this source provide? Which questions call for another source?', promptZh: '蒐集了甚麼？這種來源能提供甚麼證據？哪些問題需要另一來源？' },
  { id: 'instrument', icon: '✦', en: 'Instrument / protocol', zh: '研究工具／程序表', promptEn: 'What questions, prompts, categories or record were actually used?', promptZh: '實際使用了哪些問題、提示、分類或紀錄？' },
  { id: 'quality', icon: '◎', en: 'Question quality', zh: '問題品質', promptEn: 'What does a question assume? Which answers might it invite or block?', promptZh: '問題預設了甚麼？它可能邀請或阻礙哪些回答？' },
  { id: 'pilot', icon: '↺', en: 'Pilot & refinement', zh: '先導與修訂', promptEn: 'Was the tool tried, translated, checked or revised before use?', promptZh: '工具在使用前有否試用、翻譯、檢查或修訂？' },
  { id: 'procedure', icon: '→', en: 'Procedure', zh: '蒐集程序', promptEn: 'What happened first, next and last? Where, when and by whom?', promptZh: '首先、接著、最後發生甚麼？在哪裏、何時、由誰進行？' },
  { id: 'recording', icon: '▣', en: 'Recording', zh: '紀錄與文件化', promptEn: 'How were responses, observations or documents captured and organised?', promptZh: '回答、觀察或文件如何被記錄和整理？' },
  { id: 'ethics', icon: '◇', en: 'Participant care', zh: '參與者保障', promptEn: 'How were consent, withdrawal, discomfort, privacy and power handled?', promptZh: '如何處理同意、退出、不適、私隱與權力關係？' },
  { id: 'role', icon: '◌', en: 'Researcher role', zh: '研究者角色', promptEn: 'What influence did the researcher or setting have on the data?', promptZh: '研究者或場域對資料有甚麼影響？' },
  { id: 'management', icon: '□', en: 'Data management', zh: '資料管理', promptEn: 'Who can access the data, where will it be stored, and what happens afterwards?', promptZh: '誰可接觸資料、資料儲存在哪裏、之後如何處理？' },
];
---

<CourseSlideLayout {title} {description}>
  <div class="top-tools" aria-label="Language and timer controls">
    <button class="translate-button" type="button" aria-pressed="false" data-global-translate>中文</button>
    <div class="compact-timer" aria-label="Activity timer">
      <input type="number" min="0.1" step="0.5" inputmode="decimal" placeholder="Timer" aria-label="Timer duration" data-timer-minutes />
      <output data-timer-output hidden aria-live="polite">00:00</output>
      <button type="button" data-timer-start>Start</button>
      <button type="button" data-timer-reset aria-label="Reset timer">↻</button>
    </div>
  </div>

  <main class="deck" aria-label="Data Collection Evidence Lab slide deck">
    <section class="slide is-active" data-title="Data Collection Evidence Lab" aria-hidden="false">
      <div class="slide-inner title-slide">
        <header class="slide-header"><span class="eyebrow">DEDC02 · Advanced Research Method</span></header>
        <div class="title-rule"></div>
        <div data-language="en">
          <h1>Data<br />Collection<br />Evidence Lab</h1>
          <p class="lead">Trace how a study moved from its question to defensible evidence - then build an accountable procedure for your own project.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h1>資料蒐集<br />證據實驗室</h1>
          <p class="lead">追蹤研究如何由問題走向可論證的證據，並為自己的研究建立具責任的蒐集程序。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Today’s evidence work" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">The work of the lesson</span></header>
        <div data-language="en">
          <h2>Investigate how procedures generate evidence.</h2>
          <ol class="number-list">
            <li><span>Extract the data-collection trail from previous PhD theses.</span></li>
            <li><span>Use prompts to examine instruments and question quality.</span></li>
            <li><span>Test what a stated procedure permits a researcher to claim.</span></li>
            <li><span>Build and peer-audit a concise protocol for your manuscript project.</span></li>
          </ol>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>探究程序如何產生證據。</h2>
          <ol class="number-list">
            <li><span>從歷屆博士論文抽取資料蒐集的證據軌跡。</span></li>
            <li><span>運用提示檢視研究工具及問題品質。</span></li>
            <li><span>檢驗既定程序讓研究者可以作出甚麼主張。</span></li>
            <li><span>為文稿項目建立精簡方案，並進行同儕審視。</span></li>
          </ol>
        </div>
      </div>
    </section>

    <section class="slide" data-title="The first question" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Opening inquiry</span></header>
        <div data-language="en">
          <h2>What would make you believe this claim?</h2>
          <div class="claim-wall">
            <article class="claim-card"><q>Participants’ experiences show that the programme changed their learning.</q><p>This may be a reasonable claim. The question is whether the collection account makes it defensible.</p></article>
            <aside class="question-burst"><span>What evidence trail would you need to see?</span></aside>
          </div>
          <p class="instruction"><strong>With a partner:</strong> name three details you would look for before accepting the claim.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>甚麼會令你相信這個主張？</h2>
          <div class="claim-wall">
            <article class="claim-card"><q>參與者的經驗顯示，該計劃改變了他們的學習。</q><p>這可能是合理主張；問題是資料蒐集的說明是否令它站得住腳。</p></article>
            <aside class="question-burst"><span>你需要看見怎樣的證據軌跡？</span></aside>
          </div>
          <p class="instruction"><strong>與同伴討論：</strong>在接受此主張前，你會尋找哪三項細節？</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="From question to claim" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Visualising the evidence trail</span></header>
        <div data-language="en">
          <h2>Data collection is the bridge between question and claim.</h2>
          <div class="trail" aria-label="Research question to claim evidence trail">
            <span>Research<br />question</span><b>→</b><span>Needed<br />evidence</span><b>→</b><span>Data<br />source</span><b>→</b><span>Instrument<br />or protocol</span><b>→</b><span>Procedure</span><b>→</b><span>Defensible<br />claim</span>
          </div>
          <p class="takeaway">A procedure makes visible how evidence was generated and what its boundaries are.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>資料蒐集是研究問題與主張之間的橋樑。</h2>
          <div class="trail" aria-label="研究問題至主張的證據軌跡">
            <span>研究<br />問題</span><b>→</b><span>所需<br />證據</span><b>→</b><span>資料<br />來源</span><b>→</b><span>研究工具<br />或程序表</span><b>→</b><span>蒐集程序</span><b>→</b><span>可論證的<br />主張</span>
          </div>
          <p class="takeaway">程序應清楚顯示證據如何產生，以及其邊界。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Data-Collection Field Guide" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Field guide for inquiry</span></header>
        <div data-language="en">
          <h2>Eleven places to look in a method chapter.</h2>
          <div class="field-guide">
            {fieldGuide.map((item) => <article class="panel"><span class="eyebrow">{item.icon}</span><h3>{item.en}</h3><p>Locate the stated decision and record its evidence.</p></article>)}
          </div>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>方法章節中值得尋找的十一項內容。</h2>
          <div class="field-guide">
            {fieldGuide.map((item) => <article class="panel"><span class="eyebrow">{item.icon}</span><h3>{item.zh}</h3><p>找出已說明的決策並記錄證據。</p></article>)}
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Use the field guide" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Explore by asking</span></header>
        <div class="field-guide-explorer" data-guide-explorer>
          <div data-language="en">
            <h2>Choose an item. Let the prompt guide your reading.</h2>
            <div class="field-guide">
              {fieldGuide.map((item) => <button class="guide-card" type="button" data-guide-item={item.id} aria-pressed="false"><span class="guide-icon">{item.icon}</span><strong>{item.en}</strong><small>Ask a better question</small></button>)}
            </div>
            {fieldGuide.map((item) => <p class="guide-prompt" data-guide-prompt={item.id} hidden>{item.promptEn}</p>)}
          </div>
          <div data-language="zh" hidden lang="zh-Hant">
            <h2>選擇一項，讓提示引導你的閱讀。</h2>
            <div class="field-guide">
              {fieldGuide.map((item) => <button class="guide-card" type="button" data-guide-item={item.id} aria-pressed="false"><span class="guide-icon">{item.icon}</span><strong>{item.zh}</strong><small>提出更好的問題</small></button>)}
            </div>
            {fieldGuide.map((item) => <p class="guide-prompt" data-guide-prompt={item.id} hidden>{item.promptZh}</p>)}
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Thesis Evidence Hunt" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Inquiry material</span></header>
        <div data-language="en">
          <h2>Read a thesis as an evidence dossier.</h2>
          <div class="thesis-dossier">
            <div class="thesis-stack">
              <article class="thesis-page"><span>01</span><div><h3>Abstract &amp; questions</h3><p>What kind of answer is being sought?</p></div></article>
              <article class="thesis-page"><span>02</span><div><h3>Participants &amp; setting</h3><p>Who or what is eligible to provide evidence?</p></div></article>
              <article class="thesis-page"><span>03</span><div><h3>Data collection</h3><p>What does the thesis say actually happened?</p></div></article>
              <article class="thesis-page"><span>04</span><div><h3>Appendix &amp; ethics</h3><p>What documents make the procedure inspectable?</p></div></article>
            </div>
            <div class="dossier-board">
              <article><h3>Find</h3><p>Underline the direct evidence for one Field Guide item.</p></article>
              <article><h3>Cite</h3><p>Record the page number. A claim needs a traceable source.</p></article>
              <article><h3>Question</h3><p>Write one point that is unclear, missing or over-claimed.</p></article>
              <article><h3>Transfer</h3><p>Decide whether the same issue exists in your own project.</p></article>
            </div>
          </div>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>把博士論文當成一份證據檔案閱讀。</h2>
          <div class="thesis-dossier">
            <div class="thesis-stack">
              <article class="thesis-page"><span>01</span><div><h3>摘要及問題</h3><p>研究想尋求哪類答案？</p></div></article>
              <article class="thesis-page"><span>02</span><div><h3>參與者及場域</h3><p>誰或甚麼有資格提供證據？</p></div></article>
              <article class="thesis-page"><span>03</span><div><h3>資料蒐集</h3><p>論文說明實際發生了甚麼？</p></div></article>
              <article class="thesis-page"><span>04</span><div><h3>附錄及倫理</h3><p>哪些文件令程序可以被檢視？</p></div></article>
            </div>
            <div class="dossier-board">
              <article><h3>尋找</h3><p>為《指南》一項內容畫出直接證據。</p></article>
              <article><h3>標示</h3><p>記錄頁碼；主張需要可追溯的來源。</p></article>
              <article><h3>提問</h3><p>寫下一項不清楚、遺漏或過度主張之處。</p></article>
              <article><h3>轉移</h3><p>判斷自己的項目是否也有同一問題。</p></article>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Evidence Dossier" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Student record</span></header>
        <div data-language="en">
          <h2>Complete the dossier with page evidence.</h2>
          <div class="grid-3">
            <article class="panel soft"><h3>What is claimed?</h3><p>Copy the research question or stated aim. Avoid paraphrasing it too soon.</p></article>
            <article class="panel soft"><h3>What generated evidence?</h3><p>Identify the person, event, artefact or response that supplied the data.</p></article>
            <article class="panel soft"><h3>What remains unknown?</h3><p>Frame an author query: “How did you decide…?” or “What happened if…?”</p></article>
          </div>
          <p class="instruction">Your group reconstructs the chain a reader needs to evaluate.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>以頁面證據完成這份檔案。</h2>
          <div class="grid-3">
            <article class="panel soft"><h3>主張是甚麼？</h3><p>準確抄下研究問題或目標，並暫時保留原有措辭。</p></article>
            <article class="panel soft"><h3>甚麼產生證據？</h3><p>指出提供資料的人、事件、材料或回答。</p></article>
            <article class="panel soft"><h3>還有甚麼未知？</h3><p>把它改寫成作者查詢：「你如何決定⋯⋯？」或「如果⋯⋯會怎樣？」</p></article>
          </div>
          <p class="instruction">小組重建讀者需要用來評估的證據鏈。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Data sources" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Compare what a source makes possible</span></header>
        <div data-language="en">
          <h2>Sources leave different traces.</h2>
          <div class="source-gallery">
            <article class="source-card"><span class="source-icon">◉</span><h3>Interview</h3><p>What accounts, meanings or examples can a participant articulate?</p></article>
            <article class="source-card"><span class="source-icon">◫</span><h3>Observation</h3><p>What is visible in action, interaction, setting and sequence?</p></article>
            <article class="source-card"><span class="source-icon">▤</span><h3>Questionnaire</h3><p>What response pattern can the instrument capture across people or occasions?</p></article>
            <article class="source-card"><span class="source-icon">▣</span><h3>Document / artefact</h3><p>What trace already exists, and whose perspective does it represent?</p></article>
          </div>
          <p class="takeaway">Ask of every source: <strong>What can it show? Which questions require another source?</strong></p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>不同來源留下不同證據痕跡。</h2>
          <div class="source-gallery">
            <article class="source-card"><span class="source-icon">◉</span><h3>訪談</h3><p>參與者可以清楚表達哪些敘述、意義或例子？</p></article>
            <article class="source-card"><span class="source-icon">◫</span><h3>觀察</h3><p>行動、互動、場域及順序中有哪些可見內容？</p></article>
            <article class="source-card"><span class="source-icon">▤</span><h3>問卷</h3><p>工具能夠捕捉不同人士或時段的哪類回答模式？</p></article>
            <article class="source-card"><span class="source-icon">▣</span><h3>文件／材料</h3><p>已有甚麼痕跡？它代表誰的觀點？</p></article>
          </div>
          <p class="takeaway">每項來源都要問：<strong>它能顯示甚麼？哪些問題需要另一來源？</strong></p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Instrument Forensics" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Read the actual tool</span></header>
        <div data-language="en">
          <h2>Examine the item, response format, recording frame and revision history.</h2>
          <div class="instrument-table">
            <article><span class="instrument-symbol">?</span><h3>Question / prompt</h3><p>What words invite a response, and what concepts do they bring into the room?</p></article>
            <article><span class="instrument-symbol">☷</span><h3>Response format</h3><p>What may the participant say, select, describe, rank or demonstrate?</p></article>
            <article><span class="instrument-symbol">⌗</span><h3>Recording frame</h3><p>What is kept: audio, field notes, ratings, documents, screenshots or logs?</p></article>
            <article><span class="instrument-symbol">↺</span><h3>Revision history</h3><p>What was piloted, translated, adapted or changed - and why?</p></article>
          </div>
          <p class="instruction">Open a thesis appendix. Find one actual item. Trace it back to a research question and forward to the evidence it could yield.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>檢視題項、回答形式、紀錄框架及修訂歷史。</h2>
          <div class="instrument-table">
            <article><span class="instrument-symbol">?</span><h3>問題／提示</h3><p>哪些文字邀請回答？它們把哪些概念帶入對話？</p></article>
            <article><span class="instrument-symbol">☷</span><h3>回答形式</h3><p>參與者可以說、選擇、描述、排序或展示甚麼？</p></article>
            <article><span class="instrument-symbol">⌗</span><h3>紀錄框架</h3><p>保留了甚麼：錄音、田野筆記、評分、文件、截圖或紀錄？</p></article>
            <article><span class="instrument-symbol">↺</span><h3>修訂歷史</h3><p>哪些部分曾先導、翻譯、改編或修改，為甚麼？</p></article>
          </div>
          <p class="instruction">打開論文附錄，找出一條實際題項；由它回溯至研究問題，再前推至它可能產生的證據。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Question Clinic" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Question-quality inquiry</span></header>
        <div data-language="en">
          <h2>Interrogate the question before judging it.</h2>
          <div class="clinic-layout" data-question-clinic>
            <blockquote class="clinic-question" data-clinic-question>“Isn’t it clear that online learning is less effective than face-to-face instruction?”</blockquote>
            <div class="clinic-lenses">
              <button type="button" data-clinic-lens="assumption" aria-pressed="false">① What assumption does it carry?</button>
              <button type="button" data-clinic-lens="response" aria-pressed="false">② What kind of answer could it generate?</button>
              <button type="button" data-clinic-lens="repair" aria-pressed="false">③ How might you repair it?</button>
              <p class="clinic-panel" data-clinic-panel="assumption" hidden>It assumes that one mode is less effective and invites the participant to accept that comparison before speaking.</p>
              <p class="clinic-panel" data-clinic-panel="response" hidden>It may produce agreement, resistance or a general opinion. A follow-up can invite an account of a particular learning experience.</p>
              <p class="clinic-panel" data-clinic-panel="repair" hidden>Try: “How, if at all, have your learning experiences differed across online and face-to-face settings?” Then ask for an example.</p>
              <button class="small-button" type="button" data-clinic-reset>Reset lenses</button>
            </div>
          </div>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>在判斷問題前，先審視它。</h2>
          <div class="clinic-layout" data-question-clinic>
            <blockquote class="clinic-question" data-clinic-question>「難道網上學習不明顯比面授學習成效較低嗎？」</blockquote>
            <div class="clinic-lenses">
              <button type="button" data-clinic-lens="assumption" aria-pressed="false">① 它帶有甚麼預設？</button>
              <button type="button" data-clinic-lens="response" aria-pressed="false">② 它可能產生哪類回答？</button>
              <button type="button" data-clinic-lens="repair" aria-pressed="false">③ 可以如何修訂？</button>
              <p class="clinic-panel" data-clinic-panel="assumption" hidden>它預設其中一種方式成效較低，並在參與者發言前邀請其接受這個比較。</p>
              <p class="clinic-panel" data-clinic-panel="response" hidden>它或會帶來同意、抗拒或概括意見；再運用追問邀請特定學習經驗的敘述。</p>
              <p class="clinic-panel" data-clinic-panel="repair" hidden>可改為：「在網上與面授情境中，你的學習經驗有何不同（如有）？」然後請對方舉例。</p>
              <button class="small-button" type="button" data-clinic-reset>重設提示鏡</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="From question to probe" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Instrument redesign</span></header>
        <div data-language="en">
          <h2>A better question needs a thoughtful next move.</h2>
          <div class="grid-3">
            <article class="panel soft"><h3>Invite an account</h3><p>“Can you describe a recent occasion when…?”</p></article>
            <article class="panel soft"><h3>Ask for an example</h3><p>“What happened then? Could you walk me through it?”</p></article>
            <article class="panel soft"><h3>Check your reading</h3><p>“I heard you say… Have I understood that correctly?”</p></article>
          </div>
          <p class="takeaway">Use the old question bank as a clinic: diagnose the assumption, anticipated evidence and possible repair.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>較好的問題，需要有心思的下一步。</h2>
          <div class="grid-3">
            <article class="panel soft"><h3>邀請敘述</h3><p>「你可否描述最近一次⋯⋯的經歷？」</p></article>
            <article class="panel soft"><h3>請求例子</h3><p>「之後發生甚麼？你可否帶我逐步了解？」</p></article>
            <article class="panel soft"><h3>核對理解</h3><p>「我聽到你說⋯⋯，我的理解正確嗎？」</p></article>
          </div>
          <p class="takeaway">把舊題庫當成診所：診斷預設、預期證據及可能修訂。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Procedure Reconstruction" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Make decisions visible</span></header>
        <div data-language="en">
          <h2>Reconstruct the procedure from the evidence available.</h2>
          <div class="procedure-builder" data-procedure-builder>
            <div>
              <div class="procedure-card-bank">
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">Access &amp; gatekeeper</button>
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">Recruitment invitation</button>
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">Consent &amp; withdrawal</button>
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">Instrument / version</button>
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">Setting &amp; researcher role</button>
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">Recording &amp; handling</button>
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">Change / contingency</button>
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">Secure storage</button>
              </div>
              <button class="small-button" type="button" data-procedure-reset>Clear the board</button>
            </div>
            <aside class="timeline-board"><h3>Procedure decisions selected</h3><p>Choose what the thesis must explain. Then debate its order and rationale.</p><div class="procedure-timeline" data-procedure-timeline></div><p class="activity-status" data-procedure-status></p></aside>
          </div>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>根據已有證據重建程序。</h2>
          <div class="procedure-builder" data-procedure-builder>
            <div>
              <div class="procedure-card-bank">
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">接觸及守門人</button>
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">招募邀請</button>
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">同意及退出</button>
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">工具／版本</button>
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">場域及研究者角色</button>
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">紀錄及處理</button>
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">改變／應變</button>
                <button class="procedure-card" type="button" data-procedure-card aria-pressed="false">安全儲存</button>
              </div>
              <button class="small-button" type="button" data-procedure-reset>清除畫板</button>
            </div>
            <aside class="timeline-board"><h3>已選取的程序決策</h3><p>選擇論文必須說明的事項，再討論其先後與理由。</p><div class="procedure-timeline" data-procedure-timeline></div><p class="activity-status" data-procedure-status></p></aside>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Procedure red flags" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Procedure stress test</span></header>
        <div data-language="en">
          <h2>Where could the evidence trail break?</h2>
          <div class="grid-4">
            <article class="panel"><h3>Access fails</h3><p>Who could refuse entry, delay permission or shape who can participate?</p></article>
            <article class="panel"><h3>Tool misfires</h3><p>Which wording, translation, setting or format could alter the evidence?</p></article>
            <article class="panel"><h3>Participant care matters</h3><p>What discomfort, unequal power or privacy concern needs a route of response?</p></article>
            <article class="panel"><h3>Data becomes unsafe</h3><p>Where could recordings, identifiers or access permissions create a risk?</p></article>
          </div>
          <p class="instruction">Choose one risk in the thesis. What was the stated safeguard? If none is visible, what would you ask the author?</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>證據軌跡可能在哪裏中斷？</h2>
          <div class="grid-4">
            <article class="panel"><h3>接觸失敗</h3><p>誰可能拒絕接觸、延遲允許，或影響誰可以參與？</p></article>
            <article class="panel"><h3>工具失準</h3><p>哪些措辭、翻譯、場域或形式可能改變證據？</p></article>
            <article class="panel"><h3>參與者保障</h3><p>哪些不適、權力不平等或私隱問題需要回應途徑？</p></article>
            <article class="panel"><h3>資料不安全</h3><p>錄音、識別資料或存取權限可能在哪裏造成風險？</p></article>
          </div>
          <p class="instruction">在論文中選擇一項風險。已說明的保障措施是甚麼？如未能找到，你會怎樣問作者？</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Methods Reviewer #2" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Evidence-based critique</span></header>
        <div data-language="en">
          <h2>Formulate a precise reviewer query.</h2>
          <div class="warrant-court">
            <article class="court-side"><h3>Locate</h3><p>Point to the exact thesis page and quoted procedure detail.</p></article>
            <article class="court-centre"><span class="court-symbol">?</span><h3>What does the stated procedure allow the reader to conclude?</h3></article>
            <article class="court-side"><h3>Query</h3><p>Ask for the missing decision, boundary, reason or safeguard.</p></article>
          </div>
          <p class="takeaway">Useful reviewer language: <em>“Please clarify how…”, “The procedure appears to…; how did you address…?”, “What evidence supports…?”</em></p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>形成一條精確的審稿查詢。</h2>
          <div class="warrant-court">
            <article class="court-side"><h3>定位</h3><p>指出確切論文頁碼及相關程序細節。</p></article>
            <article class="court-centre"><span class="court-symbol">?</span><h3>既定程序讓讀者可以作出甚麼結論？</h3></article>
            <article class="court-side"><h3>查詢</h3><p>詢問遺漏的決策、邊界、理由或保障措施。</p></article>
          </div>
          <p class="takeaway">有用的審稿語言：<em>「請說明如何⋯⋯」、「程序似乎⋯⋯；你如何處理⋯⋯？」、「甚麼證據支持⋯⋯？」</em></p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="What the source can support" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Claim boundary</span></header>
        <div data-language="en">
          <h2>Specify the scope and boundary of the evidence.</h2>
          <div class="grid-3">
            <article class="panel soft"><h3>The evidence supports…</h3><p>Write the narrowest conclusion that follows directly from the procedure and source.</p></article>
            <article class="panel soft"><h3>Questions requiring further evidence…</h3><p>Name a question that requires another source, another design choice or cautious language.</p></article>
            <article class="panel soft"><h3>The author should make visible…</h3><p>Identify one decision that would let readers evaluate the boundary fairly.</p></article>
          </div>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>清楚說明證據的範圍及邊界。</h2>
          <div class="grid-3">
            <article class="panel soft"><h3>證據支持⋯⋯</h3><p>寫下可由程序及來源直接推出的最窄結論。</p></article>
            <article class="panel soft"><h3>需要進一步證據的問題⋯⋯</h3><p>指出需要另一來源、設計決策或審慎語言的問題。</p></article>
            <article class="panel soft"><h3>作者應清楚說明⋯⋯</h3><p>找出一項有助讀者公平評估邊界的決策。</p></article>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Your Evidence-to-Procedure Canvas" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Transfer to your manuscript project</span></header>
        <div data-language="en">
          <h2>Build the smallest defensible collection plan.</h2>
          <div class="canvas-flow"><span>Research<br />question</span><b>→</b><span>Needed<br />evidence</span><b>→</b><span>Source &amp;<br />instrument</span><b>→</b><span>Procedure &amp;<br />safeguard</span><b>→</b><span>Bounded<br />claim</span></div>
          <p class="takeaway">Develop one evidence route and make it visible enough for a peer to question, improve and later attach to an ethics application.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>建立精簡、可論證的蒐集方案。</h2>
          <div class="canvas-flow"><span>研究<br />問題</span><b>→</b><span>所需<br />證據</span><b>→</b><span>來源及<br />工具</span><b>→</b><span>程序及<br />保障</span><b>→</b><span>有邊界的<br />主張</span></div>
          <p class="takeaway">建立一條證據路徑，並清楚呈現，讓同儕可以提問、改進，並在日後附入倫理申請。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Canvas: evidence and tool" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Personal canvas · saved in this browser</span></header>
        <div data-language="en">
          <h2>Specify the evidence and tool.</h2>
          <div class="writing-grid">
            <label>Research question<textarea data-save="question" placeholder="What exactly do you need to understand, describe, compare or explain?"></textarea></label>
            <label>Needed evidence<textarea data-save="evidence" placeholder="What would count as a credible answer to this question?"></textarea></label>
            <label>Data source<textarea data-save="source" placeholder="Who, what, event or artefact could provide that evidence?"></textarea></label>
            <label>Instrument / protocol<textarea data-save="instrument" placeholder="What exact questions, prompts, categories or records are needed?"></textarea></label>
          </div>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>具體說明證據及工具。</h2>
          <div class="writing-grid">
            <label>研究問題<textarea data-save="question" placeholder="你需要理解、描述、比較或解釋甚麼？"></textarea></label>
            <label>所需證據<textarea data-save="evidence" placeholder="甚麼可以構成這條問題的可信答案？"></textarea></label>
            <label>資料來源<textarea data-save="source" placeholder="誰、甚麼、哪個事件或材料可以提供該證據？"></textarea></label>
            <label>工具／程序表<textarea data-save="instrument" placeholder="需要哪些確切問題、提示、分類或紀錄？"></textarea></label>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Canvas: procedure and care" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Personal canvas · saved in this browser</span></header>
        <div data-language="en">
          <h2>Specify the procedure and its safeguards.</h2>
          <div class="writing-grid">
            <label>Procedure sequence<textarea data-save="procedure" placeholder="How will access, invitation, consent, collection, recording and storage unfold?"></textarea></label>
            <label>Participant care &amp; ethics<textarea data-save="care" placeholder="What needs protection? What happens if someone declines, withdraws or becomes uncomfortable?"></textarea></label>
            <label>Quality / researcher-role decision<textarea data-save="quality" placeholder="What will you make visible so readers can judge how the evidence was produced?"></textarea></label>
            <label>Claim boundary &amp; contingency<textarea data-save="boundary" placeholder="Which claim boundary remains with this source? What is your plan if access or collection changes?"></textarea></label>
          </div>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>具體說明程序及保障措施。</h2>
          <div class="writing-grid">
            <label>程序順序<textarea data-save="procedure" placeholder="接觸、邀請、同意、蒐集、紀錄及儲存將如何展開？"></textarea></label>
            <label>參與者保障及倫理<textarea data-save="care" placeholder="需要保障甚麼？如有人拒絕、退出或感到不適，會怎樣處理？"></textarea></label>
            <label>品質／研究者角色決策<textarea data-save="quality" placeholder="你會清楚呈現甚麼，讓讀者能判斷證據如何產生？"></textarea></label>
            <label>主張邊界及應變<textarea data-save="boundary" placeholder="此來源仍有哪些主張邊界？如接觸或蒐集改變，計劃是甚麼？"></textarea></label>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Peer audit" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Make a peer’s questions useful</span></header>
        <div data-language="en">
          <h2>Can another group trace your evidence route?</h2>
          <div class="audit-layout" data-audit-checklist>
            <div class="audit-choice-grid">
              <button class="audit-choice" type="button" data-audit-choice aria-pressed="false">The research question and needed evidence are explicit.</button>
              <button class="audit-choice" type="button" data-audit-choice aria-pressed="false">The source is fit for that evidence, with a stated boundary.</button>
              <button class="audit-choice" type="button" data-audit-choice aria-pressed="false">The instrument is concrete enough to inspect.</button>
              <button class="audit-choice" type="button" data-audit-choice aria-pressed="false">The collection sequence has an accountable logic.</button>
              <button class="audit-choice" type="button" data-audit-choice aria-pressed="false">Participant care and data protection are visible.</button>
              <button class="audit-choice" type="button" data-audit-choice aria-pressed="false">A risk or change has a response plan.</button>
            </div>
            <aside><p class="audit-callout">For every unmarked item, write one precise peer question that names the missing decision.</p><p class="activity-status" data-audit-status></p></aside>
          </div>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>另一組能追蹤你的證據路徑嗎？</h2>
          <div class="audit-layout" data-audit-checklist>
            <div class="audit-choice-grid">
              <button class="audit-choice" type="button" data-audit-choice aria-pressed="false">研究問題及所需證據已清楚說明。</button>
              <button class="audit-choice" type="button" data-audit-choice aria-pressed="false">來源適合所需證據，並已說明邊界。</button>
              <button class="audit-choice" type="button" data-audit-choice aria-pressed="false">工具足夠具體，可以被檢視。</button>
              <button class="audit-choice" type="button" data-audit-choice aria-pressed="false">蒐集順序具有可說明的邏輯。</button>
              <button class="audit-choice" type="button" data-audit-choice aria-pressed="false">參與者保障及資料保護清晰可見。</button>
              <button class="audit-choice" type="button" data-audit-choice aria-pressed="false">一項風險或改變已有回應方案。</button>
            </div>
            <aside><p class="audit-callout">每一項未標示內容都要寫一條精確同儕提問，指出遺漏的決策。</p><p class="activity-status" data-audit-status></p></aside>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="IRB handoff" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Preparation for ethical review</span></header>
        <div data-language="en">
          <h2>Turn your canvas into an accountable preparation pack.</h2>
          <div class="irb-pack">
            <article><span>▤</span><h3>Protocol</h3><p>Your purpose, participants, procedure, foreseeable risks and decision logic.</p></article>
            <article><span>✦</span><h3>Instrument</h3><p>The actual interview guide, questionnaire, observation form or document-selection rule.</p></article>
            <article><span>◇</span><h3>Recruitment &amp; consent</h3><p>What people receive before deciding whether to participate.</p></article>
            <article><span>□</span><h3>Data plan</h3><p>Identifiers, storage, access, retention and destruction decisions.</p></article>
          </div>
          <p class="takeaway">A protocol prepares the study for review. Begin human-participant data collection after the required approval.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>把你的畫布轉化為具責任的準備包。</h2>
          <div class="irb-pack">
            <article><span>▤</span><h3>研究方案</h3><p>研究目的、參與者、程序、可預見風險及決策邏輯。</p></article>
            <article><span>✦</span><h3>研究工具</h3><p>實際的訪談指南、問卷、觀察表或文件選取規則。</p></article>
            <article><span>◇</span><h3>招募及同意</h3><p>參與者決定是否參與前會收到的資料。</p></article>
            <article><span>□</span><h3>資料計劃</h3><p>識別資料、儲存、存取、保存及銷毀的決策。</p></article>
          </div>
          <p class="takeaway">研究方案為倫理審查作準備；取得所需批准後才可開始蒐集人類參與者資料。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Leave with a better question" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Exit reflection</span></header>
        <div data-language="en">
          <div class="closing-figure">
            <div><h2>Leave with one decision, one risk and one question.</h2><p class="lead small">A good method section makes the decisions, safeguards and limits of evidence available for scrutiny.</p><div class="grid-3"><article class="panel soft"><h3>Decision</h3><p>What will you now specify in your collection plan?</p></article><article class="panel soft"><h3>Risk</h3><p>What needs a safeguard, alternative or author query?</p></article><article class="panel soft"><h3>Question</h3><p>What will you ask your peer, supervisor or future participant?</p></article></div></div>
            <aside class="closing-stamp"><div><strong>Trace the<br />evidence.</strong><span>Trace the procedure.</span></div></aside>
          </div>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <div class="closing-figure">
            <div><h2>帶走一項決策、一項風險及一條問題。</h2><p class="lead small">好的方法章節會讓讀者檢視證據的決策、保障及限制。</p><div class="grid-3"><article class="panel soft"><h3>決策</h3><p>你現在會在蒐集計劃中具體說明甚麼？</p></article><article class="panel soft"><h3>風險</h3><p>甚麼需要保障、替代方案或作者查詢？</p></article><article class="panel soft"><h3>問題</h3><p>你會問同儕、導師或未來參與者甚麼？</p></article></div></div>
            <aside class="closing-stamp"><div><strong>追蹤<br />證據。</strong><span>追蹤程序。</span></div></aside>
          </div>
        </div>
      </div>
    </section>
  </main>

