const description = 'An inquiry-led DEDC02 lesson on instruments, data collection procedures and evidence-based protocol design.';
const courseHref = withBase('/teaching/courses/dedc02');

const instrumentOptions = [
  { value: 'scale', en: 'Questionnaire / scale', zh: '問卷／量表' },
  { value: 'interview', en: 'Semi-structured interview', zh: '半結構式訪談' },
  { value: 'focus-group', en: 'Focus-group protocol', zh: '焦點小組程序' },
  { value: 'observation', en: 'Observation protocol', zh: '觀察程序' },
  { value: 'performance', en: 'Performance + rubric', zh: '表現任務＋規準' },
  { value: 'documents', en: 'Document / record review', zh: '文件／紀錄查閱' },
  { value: 'fieldnotes', en: 'Field-note record', zh: '田野筆記紀錄' },
  { value: 'digital', en: 'Digital event logs', zh: '數碼事件記錄' },
  { value: 'sensor', en: 'Sensor protocol', zh: '感測程序' },
