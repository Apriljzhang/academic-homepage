    noteEn: 'Rahman et al. paper: what the authors report about the focus-group instrument',
    noteZh: 'Rahman 等人論文：作者如何介紹焦點小組工具',
    pdf: withBase('/papers/dedc02/data-collection/rahman-et-al-2021-sba.pdf'),
    record: 'https://doi.org/10.1186/s40468-021-00136-3',
    licence: 'CC BY 4.0',
  },
