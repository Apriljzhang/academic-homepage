    noteZh: 'Zhai 及 Aryadoust 論文：作者如何介紹感測工具',
    pdf: withBase('/papers/dedc02/data-collection/zhai-aryadoust-2022-sensors.pdf'),
    record: 'https://doi.org/10.3389/fpsyg.2022.930075',
    licence: 'CC BY 4.0',
  },
];

