const evidencePapers = evidenceStudies.filter((study) => study.id !== 'rahman-documents');

const fieldGuide = [
  { id: 'participants', icon: '◉', en: 'Participants / cases', zh: '參與者／個案', promptEn: 'Who or what supplied the data? Why these cases? Who is absent?', promptZh: '誰或甚麼提供資料？為何是這些個案？誰沒有被包括？', whyEn: 'This sets the boundary of whose experiences or records support the findings.', whyZh: '這界定了研究結果建基於哪些人的經驗或紀錄。' },
  { id: 'access', icon: '↗', en: 'Access & recruitment', zh: '接觸與招募', promptEn: 'How did the researcher reach people or materials? Who controlled access?', promptZh: '研究者如何接觸人員或材料？誰控制接觸途徑？', whyEn: 'Access and recruitment shape who can participate and which perspectives are missing.', whyZh: '接觸與招募方式影響誰能參與，以及哪些觀點被遺漏。' },
  { id: 'source', icon: '⌁', en: 'Data source', zh: '資料來源', promptEn: 'What was collected? What evidence can this source provide? Which questions call for another source?', promptZh: '蒐集了甚麼？這種來源能提供甚麼證據？哪些問題需要另一來源？', whyEn: 'Readers can judge whether each source answers the research question and where its limits lie.', whyZh: '讀者可判斷每種來源能否回答研究問題，以及其限制。' },
  { id: 'instrument', icon: '✦', en: 'Instrument / protocol', zh: '研究工具／程序表', promptEn: 'What questions, prompts, categories or record were actually used?', promptZh: '實際使用了哪些問題、提示、分類或紀錄？', whyEn: 'The actual tool shows how evidence was elicited, observed or selected.', whyZh: '實際工具顯示證據如何被引出、觀察或選取。' },
  { id: 'quality', icon: '◎', en: 'Question quality', zh: '問題品質', promptEn: 'What does a question assume? Which answers might it invite or block?', promptZh: '問題預設了甚麼？它可能邀請或阻礙哪些回答？', whyEn: 'Wording can guide, confuse or restrict responses and therefore affect interpretation.', whyZh: '措辭可能引導、混淆或限制回答，從而影響詮釋。' },
  { id: 'pilot', icon: '↺', en: 'Pilot & refinement', zh: '先導與修訂', promptEn: 'Was the tool tried, translated, checked or revised before use?', promptZh: '工具在使用前有否試用、翻譯、檢查或修訂？', whyEn: 'These checks reveal problems before full collection and explain changes to the tool.', whyZh: '這些檢查可在正式蒐集前找出問題，並交代工具的改動。' },
  { id: 'procedure', icon: '→', en: 'Procedure', zh: '蒐集程序', promptEn: 'What happened first, next and last? Where, when and by whom?', promptZh: '首先、接著、最後發生甚麼？在哪裏、何時、由誰進行？', whyEn: 'Sequence, setting and personnel affect what data can be produced and compared.', whyZh: '順序、場域及執行者影響可產生和比較的資料。' },
  { id: 'recording', icon: '▣', en: 'Recording', zh: '紀錄與文件化', promptEn: 'How were responses, observations or documents captured and organised?', promptZh: '回答、觀察或文件如何被記錄和整理？', whyEn: 'The record links the original event or material to what was later analysed.', whyZh: '紀錄把原始事件或材料連結至其後的分析。' },
  { id: 'ethics', icon: '◇', en: 'Participant care', zh: '參與者保障', promptEn: 'How were consent, withdrawal, discomfort, privacy and power handled?', promptZh: '如何處理同意、退出、不適、私隱與權力關係？', whyEn: 'These decisions protect participants and clarify the conditions under which data were obtained.', whyZh: '這些決策保障參與者，並交代資料在甚麼條件下取得。' },
  { id: 'role', icon: '◌', en: 'Researcher role', zh: '研究者角色', promptEn: 'What influence did the researcher or setting have on the data?', promptZh: '研究者或場域對資料有甚麼影響？', whyEn: 'The researcher’s position and interactions may shape access, responses and interpretation.', whyZh: '研究者的位置與互動可能影響接觸、回答及詮釋。' },
  { id: 'management', icon: '□', en: 'Data management', zh: '資料管理', promptEn: 'Who can access the data, where will it be stored, and what happens afterwards?', promptZh: '誰可接觸資料、資料儲存在哪裏、之後如何處理？', whyEn: 'A clear plan protects confidentiality and preserves an accountable evidence record.', whyZh: '清晰的計劃保障私隱，並保留可問責的證據紀錄。' },
];

const questionnaireContents = [
  { id: 'opening', en: 'Purpose, time and participation rights', zh: '目的、所需時間與參與權利', answer: 'form', whyEn: 'An opening or linked information sheet helps participants decide whether to take part, including privacy and withdrawal information.', whyZh: '問卷開首或連結的資訊說明有助參與者決定是否參與，包括私隱及退出安排。' },
  { id: 'instructions', en: 'Clear instructions and reference periods', zh: '清晰指示及作答時段', answer: 'form', whyEn: 'Respondents need to know how to answer and which period each question concerns.', whyZh: '受訪者需要知道如何作答，以及每題所指的時段。' },
  { id: 'items', en: 'Topic groups, items and answer choices', zh: '主題分組、題項及答案選項', answer: 'form', whyEn: 'These are the questions and response routes that produce evidence for the study.', whyZh: '這些問題及作答途徑為研究產生證據。' },
  { id: 'background', en: 'Background questions relevant to the study', zh: '與研究相關的背景問題', answer: 'form', whyEn: 'Ask only for context needed to interpret findings or describe respondents.', whyZh: '只詢問詮釋結果或描述受訪者所需的背景資料。' },
  { id: 'routing', en: 'Skip directions, closing and contact details', zh: '跳題指示、結語及聯絡方式', answer: 'form', whyEn: 'Routing keeps questions relevant; a closing tells respondents how to seek clarification.', whyZh: '跳題令問題保持相關；結語讓受訪者知道如何查詢。' },
  { id: 'development', en: 'Item sources, adaptation and pilot log', zh: '題項來源、改編與先導紀錄', answer: 'record', whyEn: 'The researcher documents these decisions in the methods account or supporting materials.', whyZh: '研究者在方法說明或補充材料中記錄這些決策。' },
  { id: 'analysis', en: 'Coding, scoring and missing-data rules', zh: '編碼、計分及缺失資料規則', answer: 'record', whyEn: 'These rules guide analysis; respondents see only the instructions needed to answer.', whyZh: '這些規則指導分析；受訪者只需看到作答所需的指示。' },
  { id: 'excess', en: 'Every personal detail that might be useful later', zh: '日後可能有用的所有個人資料', answer: 'omit', whyEn: 'Unnecessary personal questions add burden and privacy risk without answering the research question.', whyZh: '不必要的個人問題增加負擔及私隱風險，卻無助回答研究問題。' },
];

const questionnaireItemTypes = [
  { id: 'binary', icon: '◐', en: 'Yes / no', zh: '是／否', exampleEn: 'Did you attend a peer-feedback session this term? Yes / No.', exampleZh: '本學期你有否參加同儕回饋活動？有／沒有。', useEn: 'A genuine two-way event or eligibility check.', useZh: '真正只有兩種情況的事件或篩選問題。', cautionEn: 'Do not force a two-way answer when degree or uncertainty matters.', cautionZh: '若程度或不確定性重要，避免強迫二選一。' },
  { id: 'choice', icon: '☷', en: 'Single / multiple choice', zh: '單選／多選', exampleEn: 'Which feedback sources did you use? Select all: teacher, peer, AI tool, other, none (alone).', exampleZh: '你使用過哪些回饋來源？可選多項：教師、同儕、人工智能工具、其他、沒有（單獨選）。', useEn: 'Known categories that respondents can recognise.', useZh: '受訪者能辨認的已知類別。', cautionEn: 'Say whether one or several answers are allowed; check that choices are complete and distinct.', cautionZh: '說明可選一項或多項，並檢查選項是否完整及清晰區分。' },
  { id: 'rating', icon: '▥', en: 'Rating / frequency', zh: '評分／頻率', exampleEn: 'In the past four weeks, how often did you revisit written feedback? Never · Once · 2–3 times · Weekly or more.', exampleZh: '過去四週你多常重看書面回饋？從不／一次／兩至三次／每週或以上。', useEn: 'The degree, intensity or frequency of one response.', useZh: '一項回答的程度、強度或頻率。', cautionEn: 'Label the anchors and timeframe. One rating item is not automatically a validated scale.', cautionZh: '標示選項及時段；單一評分題不會自動成為已驗證量表。' },
  { id: 'ranking', icon: '↕', en: 'Ranking', zh: '排序', exampleEn: 'Rank your top three supports for revising an essay: teacher feedback, peer feedback, exemplars, revision time.', exampleZh: '請從教師回饋、同儕回饋、範例及修訂時間中，排列對修改文章最有幫助的三項。', useEn: 'Relative priorities among a short, comparable list.', useZh: '在少量可比較選項之間識別相對優先次序。', cautionEn: 'Ranking shows order, not the size of the gaps between choices.', cautionZh: '排序只顯示先後，不能顯示選項間差距的大小。' },
  { id: 'numeric', icon: '#', en: 'Number / count', zh: '數值／次數', exampleEn: 'How many peer-feedback sessions did you attend this term? ___ sessions.', exampleZh: '本學期你參加了多少次同儕回饋活動？___ 次。', useEn: 'An exact count or amount the respondent can reasonably recall.', useZh: '受訪者能合理回憶的確切次數或數量。', cautionEn: 'State the unit and period; consider whether exact recall is realistic.', cautionZh: '說明單位與時段，並考慮能否準確回憶。' },
  { id: 'open', icon: '✎', en: 'Open response', zh: '開放式回答', exampleEn: 'What helped you use feedback in your last assignment?', exampleZh: '在上一次作業中，甚麼幫助你運用回饋？', useEn: 'Reasons, examples or experiences that fixed choices may miss.', useZh: '固定選項可能遺漏的原因、例子或經驗。', cautionEn: 'Allow room to answer and plan how text responses will be analysed.', cautionZh: '提供足夠作答空間，並規劃如何分析文字回答。' },
  { id: 'constant', icon: '∑', en: 'Constant sum', zh: '固定總分分配', exampleEn: 'Distribute 10 points across teacher, peer and self-review to show their contribution to your last revision.', exampleZh: '把 10 分分配予教師、同儕及自我檢視，表示它們對你上次修訂的貢獻。', useEn: 'Relative weight when respondents can make a meaningful trade-off.', useZh: '受訪者能作出有意義取捨時，比較各選項的相對比重。', cautionEn: 'The points must add to the stated total; this task can be demanding.', cautionZh: '分數必須合計至指定總分；這種作答較費心力。' },
];
---

<CourseSlideLayout {title} {description}>
  <section class="pdf-cover" aria-hidden="true">
    <span class="eyebrow">DEDC02 · Advanced Research Method</span>
    <h1>Data Collection<br />Decisions</h1>
    <div class="pdf-message-block">
      <h2>Personal message</h2>
      <p data-pdf-message-print></p>
    </div>
  </section>

  <section class="pdf-response-summary" aria-hidden="true">
    <span class="eyebrow">DEDC02 · My evidence notes</span>
    <h1>Instrument-reading responses</h1>
    <p>These are the notes saved from this browser when the PDF was created.</p>
    <div data-pdf-response-summary></div>
  </section>

  <div class="top-tools" aria-label="Language and timer controls">
    <button class="translate-button" type="button" aria-pressed="false" data-global-translate>中文</button>
    <div class="compact-timer" aria-label="Activity timer">
      <input type="number" min="0.1" step="0.5" inputmode="decimal" placeholder="Timer" aria-label="Timer duration" data-timer-minutes />
      <output data-timer-output hidden aria-live="polite">00:00</output>
      <button type="button" data-timer-start>Start</button>
      <button type="button" data-timer-reset aria-label="Reset timer">↻</button>
    </div>
  </div>

  <main class="deck" aria-label="Data Collection Decisions slide deck">
    <section class="slide is-active" data-title="Data Collection Decisions" aria-hidden="false">
      <div class="slide-inner title-slide">
        <header class="slide-header"><span class="eyebrow">DEDC02 · Advanced Research Method</span></header>
        <div class="title-rule"></div>
        <div data-language="en">
          <h1>Data<br />Collection<br />Decisions</h1>
          <p class="lead">Trace how a study moved from its question to defensible evidence - then build an accountable procedure for your own project.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h1>資料蒐集<br />研究決策</h1>
          <p class="lead">追蹤研究如何由問題走向可論證的證據，並為自己的研究建立具責任的蒐集程序。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Today’s evidence work" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">The work of the lesson</span></header>
        <div data-language="en">
          <h2>Choose and document instruments that generate defensible evidence.</h2>
          <ol class="number-list">
            <li><span>Match a research question to the kind of evidence it needs.</span></li>
            <li><span>Compare questionnaire and interview as representative quantitative and qualitative instruments.</span></li>
            <li><span>Specify what an instrument and collection procedure need to report.</span></li>
            <li><span>Compare candidate instruments and prepare an accountable collection plan.</span></li>
          </ol>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>選擇並記錄能產生可論證證據的工具。</h2>
          <ol class="number-list">
            <li><span>把研究問題配對至所需證據類型。</span></li>
            <li><span>比較問卷與訪談，作為量化與質性工具的代表例子。</span></li>
            <li><span>具體說明工具及蒐集程序需要報告的內容。</span></li>
            <li><span>比較可用工具，並建立可說明、可問責的蒐集方案。</span></li>
          </ol>
        </div>
      </div>
    </section>

    <section class="slide" data-title="The first question" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Opening inquiry</span></header>
        <div data-language="en">
          <h2>What would make you believe this claim?</h2>
          <div class="claim-wall">
            <article class="claim-card"><q>Participants’ experiences show that the programme changed their learning.</q><p>This may be a reasonable claim. The question is whether the collection account makes it defensible.</p></article>
            <aside class="question-burst"><span>What evidence trail would you need to see?</span></aside>
          </div>
          <p class="instruction"><strong>With a partner:</strong> name three details you would look for before accepting the claim.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>甚麼會令你相信這個主張？</h2>
          <div class="claim-wall">
            <article class="claim-card"><q>參與者的經驗顯示，該計劃改變了他們的學習。</q><p>這可能是合理主張；問題是資料蒐集的說明是否令它站得住腳。</p></article>
            <aside class="question-burst"><span>你需要看見怎樣的證據軌跡？</span></aside>
          </div>
          <p class="instruction"><strong>與同伴討論：</strong>在接受此主張前，你會尋找哪三項細節？</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="From question to claim" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Visualising the evidence trail</span></header>
        <div data-language="en">
          <h2>Data collection is the bridge between question and claim.</h2>
          <div class="trail" aria-label="Research question to claim evidence trail">
            <span>Research<br />question</span><b>→</b><span>Needed<br />evidence</span><b>→</b><span>Data<br />source</span><b>→</b><span>Instrument<br />or protocol</span><b>→</b><span>Procedure</span><b>→</b><span>Defensible<br />claim</span>
          </div>
          <p class="takeaway">A procedure makes visible how evidence was generated and what its boundaries are.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>資料蒐集是研究問題與主張之間的橋樑。</h2>
          <div class="trail" aria-label="研究問題至主張的證據軌跡">
            <span>研究<br />問題</span><b>→</b><span>所需<br />證據</span><b>→</b><span>資料<br />來源</span><b>→</b><span>研究工具<br />或程序表</span><b>→</b><span>蒐集程序</span><b>→</b><span>可論證的<br />主張</span>
          </div>
          <p class="takeaway">程序應清楚顯示證據如何產生，以及其邊界。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="What to report about data collection" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Inquiry question</span></header>
        <div data-language="en">
          <h2>What should be included—and why?</h2>
          <div class="field-guide">
            {fieldGuide.map((item) => <button class="guide-card" type="button" data-guide-flip aria-pressed="false">
              <span class="guide-card-inner">
                <span class="guide-card-face guide-card-front" data-guide-front>
                  <span class="guide-icon" aria-hidden="true">{item.icon}</span><strong>{item.en}</strong><small>Click to explore →</small>
                </span>
                <span class="guide-card-face guide-card-back" data-guide-back aria-hidden="true">
                  <strong>{item.en}</strong><span class="guide-back-label">What to include</span><span>{item.promptEn}</span><span class="guide-back-label">Why it matters</span><span>{item.whyEn}</span>
                </span>
              </span>
            </button>)}
          </div>
          <p class="takeaway">Select a card to reveal its guiding question and reason for inclusion. Use all eleven elements as a reporting checklist.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>應包括甚麼？為甚麼？</h2>
          <div class="field-guide">
            {fieldGuide.map((item) => <button class="guide-card" type="button" data-guide-flip aria-pressed="false">
              <span class="guide-card-inner">
                <span class="guide-card-face guide-card-front" data-guide-front>
                  <span class="guide-icon" aria-hidden="true">{item.icon}</span><strong>{item.zh}</strong><small>點選查看 →</small>
                </span>
                <span class="guide-card-face guide-card-back" data-guide-back aria-hidden="true">
                  <strong>{item.zh}</strong><span class="guide-back-label">應包括甚麼</span><span>{item.promptZh}</span><span class="guide-back-label">為何重要</span><span>{item.whyZh}</span>
                </span>
              </span>
            </button>)}
          </div>
          <p class="takeaway">點選卡片查看引導問題及納入原因，並以這十一項內容作為報告檢查表。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Choose a data-collection instrument" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Instrument choice</span></header>
        <div data-language="en">
          <h2>Match the instrument to the evidence your question needs.</h2>
          <div class="instrument-choice-map" aria-label="Research question to data-collection instrument map">
            <article><span class="choice-number">01</span><h3>How widespread? How do groups differ?</h3><p><strong>Evidence:</strong> structured responses across people, settings or occasions.</p><b>Questionnaire</b><small>Representative quantitative example</small></article>
            <article><span class="choice-number">02</span><h3>How is an experience understood or navigated?</h3><p><strong>Evidence:</strong> accounts, meanings, examples and explanations.</p><b>Semi-structured interview</b><small>Representative qualitative example</small></article>
            <article><span class="choice-number">03</span><h3>What happens in practice? What trace remains?</h3><p><strong>Evidence:</strong> observed action, interaction, documents or artefacts.</p><b>Observation / document protocol</b><small>Useful companion instruments</small></article>
          </div>
          <p class="takeaway">Choose the evidence first. The instrument is the practical tool that creates, captures or selects that evidence.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>把工具配對至研究問題所需的證據。</h2>
          <div class="instrument-choice-map" aria-label="由研究問題至資料蒐集工具的地圖">
            <article><span class="choice-number">01</span><h3>情況有多普遍？群體有何差異？</h3><p><strong>證據：</strong>跨人士、場域或時段的結構化回答。</p><b>問卷</b><small>具代表性的量化例子</small></article>
            <article><span class="choice-number">02</span><h3>人如何理解或經歷某種現象？</h3><p><strong>證據：</strong>敘述、意義、例子及解釋。</p><b>半結構式訪談</b><small>具代表性的質性例子</small></article>
            <article><span class="choice-number">03</span><h3>實務中發生甚麼？留下甚麼痕跡？</h3><p><strong>證據：</strong>觀察到的行動、互動、文件或材料。</p><b>觀察／文件程序表</b><small>有用的補充工具</small></article>
          </div>
          <p class="takeaway">先選擇證據。工具是產生、捕捉或選取該證據的實際方法。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Questionnaire: design and report" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Quantitative worked example</span></header>
        <div data-language="en">
          <h2>Build a questionnaire from construct to usable data.</h2>
          <p class="instruction"><strong>Ask AI:</strong> In research methods, what do <em>survey</em>, <em>questionnaire</em> and <em>scale</em> mean? How are they related, how do they differ, and when should each term be used? Give one example that distinguishes a survey study, a questionnaire instrument and a multi-item scale.</p>
          <div class="instrument-chain" aria-label="Questionnaire design chain">
            <article><span>01</span><h3>Construct</h3><p>Define the concept and the population or setting.</p></article><b>→</b>
            <article><span>02</span><h3>Items</h3><p>Draft or adapt prompts that represent the construct.</p></article><b>→</b>
            <article><span>03</span><h3>Response format</h3><p>Choose options, anchors, scale range and timeframe.</p></article><b>→</b>
            <article><span>04</span><h3>Administration</h3><p>Specify mode, invitation, setting and collection window.</p></article><b>→</b>
            <article><span>05</span><h3>Dataset</h3><p>Plan coding, scoring, missing-data decisions and storage.</p></article>
          </div>
          <div class="reporting-strip"><strong>Report:</strong><span>instrument source or development</span><span>items and response anchors</span><span>adaptation, translation or pilot</span><span>administration and response pattern</span><span>scoring and data handling</span></div>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>由構念建立可用的問卷資料。</h2>
          <p class="instruction"><strong>向 AI 提問：</strong>在研究方法中，<em>調查</em>、<em>問卷</em>及<em>量表</em>分別指甚麼？它們如何相關、有何差異，以及甚麼時候應使用哪一個術語？請用一個例子區分調查研究、問卷工具及多題量表。</p>
          <div class="instrument-chain" aria-label="問卷設計鏈">
            <article><span>01</span><h3>構念</h3><p>界定概念及目標群體或場域。</p></article><b>→</b>
            <article><span>02</span><h3>題項</h3><p>草擬或調整能代表構念的提示。</p></article><b>→</b>
            <article><span>03</span><h3>回答形式</h3><p>選擇選項、標籤、量表範圍及時間框架。</p></article><b>→</b>
            <article><span>04</span><h3>施測</h3><p>說明方式、邀請、場域及蒐集期間。</p></article><b>→</b>
            <article><span>05</span><h3>資料集</h3><p>規劃編碼、計分、缺失資料決策及儲存。</p></article>
          </div>
          <div class="reporting-strip"><strong>報告：</strong><span>工具來源或發展過程</span><span>題項及回答標籤</span><span>調整、翻譯或先導</span><span>施測及回答情況</span><span>計分及資料處理</span></div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="What belongs in a questionnaire?" aria-hidden="true">
      <div class="slide-inner questionnaire-teaching-slide">
        <header class="slide-header"><span class="eyebrow">Questionnaire design · decide before revealing</span></header>
        <div data-language="en">
          <h2>What should respondents see?</h2>
          <p class="intro-line">Place each element in the respondent-facing questionnaire or linked information, the researcher’s design record, or neither. Decide on all eight before checking.</p>
          <div class="qsort-activity" data-qsort-activity>
            <div class="qsort-grid">
              {questionnaireContents.map((item) => <article class="qsort-card" data-qsort-card data-answer={item.answer}>
                <h3>{item.en}</h3>
                <div class="qsort-options" role="group" aria-label={`Place ${item.en}`}>
                  <button type="button" data-qsort-choice="form" aria-pressed="false">Questionnaire</button>
                  <button type="button" data-qsort-choice="record" aria-pressed="false">Design record</button>
                  <button type="button" data-qsort-choice="omit" aria-pressed="false">Leave out</button>
                </div>
                <p class="qsort-feedback" data-qsort-feedback hidden><strong>{item.answer === 'form' ? 'Questionnaire' : item.answer === 'record' ? 'Design record' : 'Leave out'}:</strong> {item.whyEn}</p>
              </article>)}
            </div>
            <div class="qsort-actions"><button type="button" data-qsort-check>Check placements</button><button type="button" data-qsort-reset>Start again</button><span data-qsort-status role="status" aria-live="polite">Make your choices first.</span></div>
          </div>
          <p class="source-note">Cohen et al. (2018), ch. 24, pp. 471–504.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>受訪者應看到甚麼？</h2>
          <p class="intro-line">把每項內容歸入受訪者看到的問卷或相關資訊、研究者的設計紀錄，或兩者都不需要。完成八項判斷後再檢查。</p>
          <div class="qsort-activity" data-qsort-activity>
            <div class="qsort-grid">
              {questionnaireContents.map((item) => <article class="qsort-card" data-qsort-card data-answer={item.answer}>
                <h3>{item.zh}</h3>
                <div class="qsort-options" role="group" aria-label={`為${item.zh}選擇位置`}>
                  <button type="button" data-qsort-choice="form" aria-pressed="false">問卷</button>
                  <button type="button" data-qsort-choice="record" aria-pressed="false">設計紀錄</button>
                  <button type="button" data-qsort-choice="omit" aria-pressed="false">不加入</button>
                </div>
                <p class="qsort-feedback" data-qsort-feedback hidden><strong>{item.answer === 'form' ? '問卷' : item.answer === 'record' ? '設計紀錄' : '不加入'}：</strong>{item.whyZh}</p>
              </article>)}
            </div>
            <div class="qsort-actions"><button type="button" data-qsort-check>檢查分類</button><button type="button" data-qsort-reset>重新開始</button><span data-qsort-status role="status" aria-live="polite">先作出選擇。</span></div>
          </div>
          <p class="source-note">Cohen 等（2018），第 24 章，頁 471–504。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Choose a questionnaire item type" aria-hidden="true">
      <div class="slide-inner questionnaire-teaching-slide">
        <header class="slide-header"><span class="eyebrow">Questionnaire design · item types</span></header>
        <div data-language="en">
          <h2>Choose the answer an item needs.</h2>
          <p class="intro-line">An item may ask for a fact, behaviour, perception or explanation. Select a response format to inspect an example, its purpose and one caution.</p>
          <div data-qtype-picker>
            <div class="qtype-options">
              {questionnaireItemTypes.map((item) => <button type="button" data-qtype-option={item.id} aria-expanded="false" aria-controls={`qtype-en-${item.id}`}><span aria-hidden="true">{item.icon}</span>{item.en}</button>)}
            </div>
            <div class="qtype-panels">
              {questionnaireItemTypes.map((item) => <article class="qtype-panel" id={`qtype-en-${item.id}`} data-qtype-panel={item.id} hidden>
                <h3>{item.en}</h3><p><strong>Example</strong>{item.exampleEn}</p><p><strong>Use when</strong>{item.useEn}</p><p><strong>Check</strong>{item.cautionEn}</p>
              </article>)}
            </div>
          </div>
          <p class="takeaway"><strong>Two more design decisions:</strong> a matrix arranges several items with shared response options; a filter or skip question routes respondents past items that do not apply.</p>
          <p class="source-note">Cohen et al. (2018), ch. 24, pp. 475–488.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>按所需回答選擇題型。</h2>
          <p class="intro-line">題項可詢問事實、行為、看法或解釋。點選回答形式，查看例子、適用情況及一項注意事項。</p>
          <div data-qtype-picker>
            <div class="qtype-options">
              {questionnaireItemTypes.map((item) => <button type="button" data-qtype-option={item.id} aria-expanded="false" aria-controls={`qtype-zh-${item.id}`}><span aria-hidden="true">{item.icon}</span>{item.zh}</button>)}
            </div>
            <div class="qtype-panels">
              {questionnaireItemTypes.map((item) => <article class="qtype-panel" id={`qtype-zh-${item.id}`} data-qtype-panel={item.id} hidden>
                <h3>{item.zh}</h3><p><strong>例子</strong>{item.exampleZh}</p><p><strong>適用於</strong>{item.useZh}</p><p><strong>檢查</strong>{item.cautionZh}</p>
              </article>)}
            </div>
          </div>
          <p class="takeaway"><strong>另外兩項設計決策：</strong>矩陣把採用相同回答選項的題項排在一起；篩選或跳題指示讓受訪者略過不適用的問題。</p>
          <p class="source-note">Cohen 等（2018），第 24 章，頁 475–488。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Interview: choose the format" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Interview inquiry before question writing</span></header>
        <div data-language="en">
          <h2>Which interview arrangement fits the evidence you need?</h2>
          <p class="instruction"><strong>Ask AI:</strong> Compare structured, semi-structured and unstructured interviews, then compare individual interviews, dyads and focus groups. For each option, explain the kinds of research questions and interactional evidence it suits, the interviewer skill it requires, and one ethical or reporting issue to anticipate.</p>
          <div class="grid-4">
            <article class="panel soft"><h3>Structure</h3><p>Structured · semi-structured · unstructured</p></article>
            <article class="panel soft"><h3>Configuration</h3><p>Individual · dyad · focus group</p></article>
            <article class="panel soft"><h3>Mode</h3><p>In person · phone · video · walking or elicitation interview</p></article>
            <article class="panel soft"><h3>Record</h3><p>Audio · video · field notes · transcript · translation decisions</p></article>
          </div>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>哪種訪談安排最配合你需要的證據？</h2>
          <p class="instruction"><strong>向 AI 提問：</strong>比較結構式、半結構式及非結構式訪談，再比較個別訪談、雙人訪談及焦點小組。請說明每種選擇適合哪類研究問題及互動證據、需要甚麼訪談技巧，以及一項需要預先處理的倫理或報告問題。</p>
          <div class="grid-4">
            <article class="panel soft"><h3>結構程度</h3><p>結構式 · 半結構式 · 非結構式</p></article>
            <article class="panel soft"><h3>參與配置</h3><p>個別 · 雙人 · 焦點小組</p></article>
            <article class="panel soft"><h3>進行方式</h3><p>面談 · 電話 · 視像 · 步行或引導材料訪談</p></article>
            <article class="panel soft"><h3>紀錄</h3><p>錄音 · 錄影 · 田野筆記 · 謄寫 · 翻譯決策</p></article>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Interview: design and report" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">From research question to interview guide</span></header>
        <div data-language="en">
          <h2>How does a topic become an interview guide?</h2>
          <p class="intro-line">Map each topic to the evidence the participant can describe first-hand. Prepare main questions and possible probes; leave room for an unexpected account.</p>
          <div class="instrument-chain" aria-label="Interview design chain">
            <article><span>01</span><h3>Evidence aim</h3><p>What can this participant tell you about the research question from experience?</p></article><b>→</b>
            <article><span>02</span><h3>Topic route</h3><p>Open with a broad, low-pressure invitation; move towards specific events and meanings.</p></article><b>→</b>
            <article><span>03</span><h3>Questions &amp; probes</h3><p>Write a main question for each topic; prepare optional detail, elaboration and clarification probes.</p></article><b>→</b>
            <article><span>04</span><h3>Pilot the guide</h3><p>Check wording, recall, order, duration and sensitive topics with someone like your participants.</p></article><b>→</b>
            <article><span>05</span><h3>Record the encounter</h3><p>Plan consent, recording, field notes, transcription choices and a reflexive memo.</p></article>
          </div>
          <div class="reporting-strip"><strong>Report:</strong><span>participant selection and setting</span><span>format, duration and mode</span><span>guide origin, pilot and revisions</span><span>interviewer role and relationship</span><span>recording, transcription and translation</span></div>
          <p class="source-note">Cohen, Manion, &amp; Morrison, <em>Research Methods in Education</em> (8th ed., 2018), Chapter 25, pp. 512–523.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>如何把研究主題轉化為訪談指南？</h2>
          <p class="intro-line">先把每個主題連結至參與者能親身描述的證據。預備主問題及可選的追問，同時保留意外敘述的空間。</p>
          <div class="instrument-chain" aria-label="訪談設計鏈">
            <article><span>01</span><h3>證據目標</h3><p>這位參與者能根據親身經驗，提供哪些與研究問題有關的敘述？</p></article><b>→</b>
            <article><span>02</span><h3>主題路徑</h3><p>以寬廣、低壓力的邀請開場，再逐步走向具體事件及意義。</p></article><b>→</b>
            <article><span>03</span><h3>問題及追問</h3><p>每個主題寫一項主問題；預備可選的細節、延伸及釐清追問。</p></article><b>→</b>
            <article><span>04</span><h3>先導指南</h3><p>與類似參與者檢查措辭、回憶要求、順序、時長及敏感主題。</p></article><b>→</b>
            <article><span>05</span><h3>記錄訪談</h3><p>規劃同意、錄音、田野筆記、謄寫決策及反思備忘。</p></article>
          </div>
          <div class="reporting-strip"><strong>報告：</strong><span>參與者選取及場域</span><span>形式、時長及方式</span><span>指南來源、先導及修訂</span><span>訪談者角色及關係</span><span>錄音、謄寫及翻譯</span></div>
          <p class="source-note">Cohen、Manion 與 Morrison，《Research Methods in Education》（第 8 版，2018），第 25 章，頁 512–523。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Review an interview question" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Interview design check</span></header>
        <div data-language="en">
          <h2>Diagnose the question and draft a neutral alternative.</h2>
          <div class="clinic-layout" data-question-clinic>
            <blockquote class="clinic-question" data-clinic-question>“Online learning is less effective than face-to-face instruction. How far do you agree?”</blockquote>
            <div class="clinic-lenses">
              <button type="button" data-clinic-lens="assumption" aria-pressed="false">① What assumption does it carry?</button>
              <button type="button" data-clinic-lens="response" aria-pressed="false">② What kind of answer could it generate?</button>
              <button type="button" data-clinic-lens="repair" aria-pressed="false">③ How might you repair it?</button>
              <p class="clinic-panel" data-clinic-panel="assumption" hidden>It assumes that one mode is less effective and invites the participant to accept that comparison before speaking.</p>
              <p class="clinic-panel" data-clinic-panel="response" hidden>It may produce agreement, resistance or a general opinion. A follow-up can invite an account of a particular learning experience.</p>
              <p class="clinic-panel" data-clinic-panel="repair" hidden>Try: “How, if at all, have your learning experiences differed across online and face-to-face settings?” Then ask for an example.</p>
              <button class="small-button" type="button" data-clinic-reset>Reset lenses</button>
            </div>
          </div>
          <p class="source-note">Cohen, Manion, &amp; Morrison (2018), pp. 513–515; DEDC02 W7 interview-tips handout.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>診斷問題並草擬中性的替代說法。</h2>
          <div class="clinic-layout" data-question-clinic>
            <blockquote class="clinic-question" data-clinic-question>「網上學習比面授學習成效較低。你在多大程度上同意？」</blockquote>
            <div class="clinic-lenses">
              <button type="button" data-clinic-lens="assumption" aria-pressed="false">① 它帶有甚麼預設？</button>
              <button type="button" data-clinic-lens="response" aria-pressed="false">② 它可能產生哪類回答？</button>
              <button type="button" data-clinic-lens="repair" aria-pressed="false">③ 可以如何修訂？</button>
              <p class="clinic-panel" data-clinic-panel="assumption" hidden>它預設其中一種方式成效較低，並在參與者發言前邀請其接受這個比較。</p>
              <p class="clinic-panel" data-clinic-panel="response" hidden>它或會帶來同意、抗拒或概括意見；再運用追問邀請特定學習經驗的敘述。</p>
              <p class="clinic-panel" data-clinic-panel="repair" hidden>可改為：「在網上與面授情境中，你的學習經驗有何不同（如有）？」然後請對方舉例。</p>
              <button class="small-button" type="button" data-clinic-reset>重設提示鏡</button>
            </div>
          </div>
          <p class="source-note">Cohen、Manion 與 Morrison（2018），頁 513–515；DEDC02 第 7 週訪談提示講義。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Interview questions: spot the traps" aria-hidden="true">
      <div class="slide-inner interview-practice-slide">
        <header class="slide-header"><span class="eyebrow">Question-writing practice</span></header>
        <div data-language="en">
          <h2>Which question would you repair first?</h2>
          <p class="intro-line">Read each draft aloud. Name the risk before opening the card to compare a possible revision.</p>
          <div class="interview-trap-grid">
            <details class="interview-trap"><summary><span>Two questions at once</span>“What did you think of the new policy, and how did it change your teaching?”</summary><div><strong>Risk</strong><p>The participant may answer only one part.</p><strong>Try</strong><p>“Can you describe a recent lesson under the new policy?” Then ask separately what, if anything, changed.</p></div></details>
            <details class="interview-trap"><summary><span>A benefit is assumed</span>“How did the mentoring programme improve your teaching?”</summary><div><strong>Risk</strong><p>The wording presumes improvement before hearing the participant's account.</p><strong>Try</strong><p>“Tell me about your experience of the mentoring programme. What effect, if any, did it have on your teaching?”</p></div></details>
            <details class="interview-trap"><summary><span>A yes/no shortcut</span>“Did you find the feedback useful?”</summary><div><strong>Risk</strong><p>Yes/no can establish a fact, but this version gives little evidence about the experience.</p><strong>Try</strong><p>“Think of your most recent assignment. What feedback, if any, did you use? What happened next?”</p></div></details>
            <details class="interview-trap"><summary><span>Jargon without an event</span>“How did your metacognitive regulation evolve?”</summary><div><strong>Risk</strong><p>The term may be unfamiliar, and “evolve” leaves the time and situation unclear.</p><strong>Try</strong><p>“Think of a recent time you got stuck while studying. What did you do next?”</p></div></details>
          </div>
          <p class="takeaway">Check every draft for one idea, neutral language, an answerable time frame and room for a participant's own words. Place sensitive questions later and allow a skip.</p>
          <p class="source-note">Cohen, Manion, &amp; Morrison (2018), pp. 513–515; DEDC02 W7 interview-tips handout.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>你會先修改哪一道訪談問題？</h2>
          <p class="intro-line">把每道草稿讀出來。先指出風險，再打開卡片比較可能的修訂方式。</p>
          <div class="interview-trap-grid">
            <details class="interview-trap"><summary><span>一次問兩件事</span>「你怎樣看新政策？它又怎樣改變了你的教學？」</summary><div><strong>風險</strong><p>參與者可能只回答其中一部分。</p><strong>可以這樣問</strong><p>「你可否描述最近一節在新政策下進行的課？」之後再問有沒有改變，以及改變了甚麼。</p></div></details>
            <details class="interview-trap"><summary><span>預設有好處</span>「導師計劃怎樣改善了你的教學？」</summary><div><strong>風險</strong><p>提問在聆聽經驗之前，已預設教學得到改善。</p><strong>可以這樣問</strong><p>「談談你參與導師計劃的經驗。它對你的教學有甚麼影響（如有）？」</p></div></details>
            <details class="interview-trap"><summary><span>是／否捷徑</span>「你覺得回饋有用嗎？」</summary><div><strong>風險</strong><p>是／否可用於核實事實，但此題難以帶出經驗細節。</p><strong>可以這樣問</strong><p>「想想你最近一份作業。你用了哪些回饋（如有）？之後發生甚麼？」</p></div></details>
            <details class="interview-trap"><summary><span>術語缺少情境</span>「你的後設認知調節如何演變？」</summary><div><strong>風險</strong><p>術語可能陌生，「演變」亦沒有界定時段或情境。</p><strong>可以這樣問</strong><p>「想想最近一次學習遇到困難的時候。你接着做了甚麼？」</p></div></details>
          </div>
          <p class="takeaway">逐題檢查：一項意思、中性語言、可回答的時段，以及讓參與者用自己的說法回答。敏感問題可放在較後，並容許跳過。</p>
          <p class="source-note">Cohen、Manion 與 Morrison（2018），頁 513–515；DEDC02 第 7 週訪談提示講義。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Interview guide: opening and probes" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Interview guide moves</span></header>
        <div data-language="en">
          <h2>Move from an opening invitation to a fuller account.</h2>
          <div class="grid-4">
            <article class="panel soft"><h3>Open broadly</h3><p>“Can you describe a recent occasion when…?”</p></article>
            <article class="panel soft"><h3>Probe for detail</h3><p>“What happened next? Could you walk me through it?”</p></article>
            <article class="panel soft"><h3>Invite elaboration</h3><p>“What made that important to you?”</p></article>
            <article class="panel soft"><h3>Clarify and check</h3><p>“When you say ‘support’, what does that mean here? Have I understood you?”</p></article>
          </div>
          <p class="takeaway">Let the participant finish, use pauses deliberately and avoid excessive probing. Close by asking whether there is anything they wish to add. Report the guide structure and consequential changes.</p>
          <p class="source-note">Cohen, Manion, &amp; Morrison (2018), pp. 513–514, 520–523; DEDC02 W7 interview-tips handout.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>由開場邀請發展至更完整的敘述。</h2>
          <div class="grid-4">
            <article class="panel soft"><h3>寬廣開場</h3><p>「你可否描述最近一次⋯⋯的經歷？」</p></article>
            <article class="panel soft"><h3>追問細節</h3><p>「之後發生甚麼？你可否帶我逐步了解？」</p></article>
            <article class="panel soft"><h3>邀請延伸</h3><p>「為甚麼這件事對你重要？」</p></article>
            <article class="panel soft"><h3>釐清及核對</h3><p>「你說的『支援』在這裏是甚麼意思？我理解正確嗎？」</p></article>
          </div>
          <p class="takeaway">讓參與者說完，適當運用停頓，避免過度追問。結束前詢問對方還有甚麼想補充；報告指南結構及重要調整。</p>
          <p class="source-note">Cohen、Manion 與 Morrison（2018），頁 513–514、520–523；DEDC02 第 7 週訪談提示講義。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Interview conduct: listen without steering" aria-hidden="true">
      <div class="slide-inner interview-practice-slide">
        <header class="slide-header"><span class="eyebrow">During the interview</span></header>
        <div data-language="en">
          <h2>How do you keep the account in the participant's hands?</h2>
          <p class="intro-line">Choose your response to each moment, then open the card. Notice how a small interviewer move can change what is said next.</p>
          <div class="interview-trap-grid">
            <details class="interview-trap"><summary><span>They pause</span>Do you fill the silence with a suggested answer?</summary><div><strong>Try</strong><p>Allow thinking time. If needed, offer a neutral prompt such as “Take your time” or “Would you like to say more?”</p></div></details>
            <details class="interview-trap"><summary><span>You disagree</span>Do you correct, praise or advise the participant?</summary><div><strong>Try</strong><p>Listen without signalling approval or disapproval. Ask for an example or check what they mean in their own terms.</p></div></details>
            <details class="interview-trap"><summary><span>They seem uncomfortable</span>Do you press for an answer to keep the guide on track?</summary><div><strong>Try</strong><p>Remind them they may skip the question or stop. Move on or rephrase without pressure, especially around sensitive experiences.</p></div></details>
            <details class="interview-trap"><summary><span>You want to record</span>Is an audio file automatically the fullest account?</summary><div><strong>Try</strong><p>Explain the purpose and obtain permission. Consider field notes on setting and pauses, and state what transcription will preserve or omit.</p></div></details>
          </div>
          <p class="source-note">Cohen, Manion, &amp; Morrison (2018), pp. 519–524; DEDC02 W7 interview-tips handout.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>如何讓敘述繼續由參與者主導？</h2>
          <p class="intro-line">先想想你會如何回應各種情況，再打開卡片。留意訪談者的小動作如何改變接下來的回答。</p>
          <div class="interview-trap-grid">
            <details class="interview-trap"><summary><span>對方停頓</span>你會用暗示性的答案填補沉默嗎？</summary><div><strong>可以這樣做</strong><p>留出思考時間；需要時可中性地說「慢慢想」或「你想再說多一些嗎？」</p></div></details>
            <details class="interview-trap"><summary><span>你不同意</span>你會糾正、稱讚或給參與者建議嗎？</summary><div><strong>可以這樣做</strong><p>聆聽時避免顯示贊同或不贊同。請對方舉例，或用對方的語言核對意思。</p></div></details>
            <details class="interview-trap"><summary><span>對方感到不安</span>你會為了完成指南而堅持要答案嗎？</summary><div><strong>可以這樣做</strong><p>提醒對方可以跳過問題或停止訪談。尤其面對敏感經歷時，可不施壓地轉題或重新措辭。</p></div></details>
            <details class="interview-trap"><summary><span>你想錄音</span>音檔是否必然記下最完整的敘述？</summary><div><strong>可以這樣做</strong><p>解釋目的並取得許可。考慮以田野筆記記錄場景和停頓，並說明謄寫會保留或省略甚麼。</p></div></details>
          </div>
          <p class="source-note">Cohen、Manion 與 Morrison（2018），頁 519–524；DEDC02 第 7 週訪談提示講義。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Match vault studies to their instruments" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Research instruments in published studies</span></header>
        <div data-language="en">
          <h2>Read the Methods extract, then identify the instruments.</h2>
          <div class="instrument-lab-steps">
            <article><span>1</span><h3>Read the extract</h3><p>Each paper has its own page with an exact passage from its Methods section and a full citation.</p></article>
            <article><span>2</span><h3>Identify the instruments</h3><p>Select every relevant instrument named in the passage. A correct choice unlocks that paper’s PDF.</p></article>
            <article><span>3</span><h3>Complete the reporting questions</h3><p>Use the extract and full paper to fill the blanks. If a detail is absent, write “not reported”.</p></article>
          </div>
          <p class="takeaway">Your answers save in this browser and appear in the response section of your personal PDF.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>先閱讀方法節引文，再辨認研究工具。</h2>
          <div class="instrument-lab-steps">
            <article><span>1</span><h3>閱讀引文</h3><p>每篇論文各有一頁，列出完整引文及方法節的原文摘錄。</p></article>
            <article><span>2</span><h3>辨認研究工具</h3><p>選出摘錄提及的所有相關工具。答對後可下載該論文的 PDF。</p></article>
            <article><span>3</span><h3>回答報告問題</h3><p>根據摘錄及全文填寫空格。若沒有報告某項細節，請寫「未報告」。</p></article>
          </div>
          <p class="takeaway">你的答案會儲存在此瀏覽器，並加入個人 PDF 的回應部分。</p>
        </div>
      </div>
    </section>

    {evidencePapers.map((study, paperIndex) => {
      const detail = evidencePaperDetails[study.id as keyof typeof evidencePaperDetails];
      return (
      <section class="slide" data-title={`Instrument reading: ${study.citation}`} aria-hidden="true">
        <div class="slide-inner evidence-lab-slide">
          <header class="slide-header"><span class="eyebrow">Paper and instrument · {paperIndex + 1} / {evidencePapers.length}</span></header>
          <div data-language="en">
            <h2>{study.title}</h2>
            <p class="evidence-citation">{detail.reference}</p>
            <div class="evidence-paper-layout" data-evidence-card data-answer={detail.answers.join(',')} data-match-id={study.id}>
              <div class="evidence-reading">
                <div class="evidence-extract"><strong>Methods wording · […] marks an omission</strong><blockquote lang="en">“{detail.excerpt}”</blockquote><cite>{detail.page}</cite></div>
                <fieldset class="evidence-choice"><legend>1. Which instruments are described in this extract? Select all that apply.</legend><div class="evidence-choice-grid">
                  {instrumentOptions.map((option) => <label><input type="checkbox" value={option.value} data-evidence-choice />{option.en}</label>)}
                </div></fieldset>
                <div class="evidence-match-row"><button type="button" data-evidence-check>Check choice</button><a href={study.pdf} download data-evidence-download hidden>Download full paper ↓</a><a href={study.record} target="_blank" rel="noreferrer" data-evidence-record hidden>Publication record ↗</a></div>
                <p class="evidence-status" data-evidence-status role="status" aria-live="polite">Choose the instruments, then check.</p>
                <small class="evidence-licence">PDF: {study.licence}</small>
              </div>
              <div class="evidence-writing"><h3>Find the reporting details</h3><p>Use the extract first; after unlocking the PDF, check the full Methods section. Write “not reported” when a detail is absent.</p>
                {detail.questions.map((question, questionIndex) => <label class="evidence-question"><span>{questionIndex + 2}. {question.en}</span><textarea rows="2" maxlength="900" data-save={`instrument-${study.id}-${question.id}`} data-response-label={`${study.citation}: ${question.en}`} placeholder="Type what the paper reports, with a page cue…"></textarea></label>)}
                <details class="evidence-previous-notes"><summary>Earlier notes (if any)</summary><textarea rows="2" maxlength="1800" data-save={`instrument-${study.id}`} data-response-label={study.noteEn}></textarea>{study.id === 'rahman-focus-group' && <textarea rows="2" maxlength="1800" data-save="instrument-rahman-documents" data-response-label="Rahman et al. paper: earlier notes on documents"></textarea>}</details>
              </div>
            </div>
          </div>
          <div data-language="zh" hidden lang="zh-Hant">
            <h2>{study.title}</h2>
            <p class="evidence-citation">{detail.reference}</p>
            <div class="evidence-paper-layout" data-evidence-card data-answer={detail.answers.join(',')} data-match-id={study.id}>
              <div class="evidence-reading">
                <div class="evidence-extract"><strong>方法節原文摘錄 · […] 表示省略</strong><blockquote lang="en">“{detail.excerpt}”</blockquote><cite>{detail.page}</cite></div>
                <fieldset class="evidence-choice"><legend>1. 摘錄描述了哪些研究工具？選出所有適用答案。</legend><div class="evidence-choice-grid">
                  {instrumentOptions.map((option) => <label><input type="checkbox" value={option.value} data-evidence-choice />{option.zh}</label>)}
                </div></fieldset>
                <div class="evidence-match-row"><button type="button" data-evidence-check>檢查選擇</button><a href={study.pdf} download data-evidence-download hidden>下載論文全文 ↓</a><a href={study.record} target="_blank" rel="noreferrer" data-evidence-record hidden>出版紀錄 ↗</a></div>
                <p class="evidence-status" data-evidence-status role="status" aria-live="polite">先選擇工具，再檢查。</p>
                <small class="evidence-licence">PDF：{study.licence}</small>
              </div>
              <div class="evidence-writing"><h3>找出工具報告細節</h3><p>先閱讀摘錄；解鎖 PDF 後再查閱完整方法節。若某細節缺失，請寫「未報告」。</p>
                {detail.questions.map((question, questionIndex) => <label class="evidence-question"><span>{questionIndex + 2}. {question.zh}</span><textarea rows="2" maxlength="900" data-save={`instrument-${study.id}-${question.id}`} data-response-label={`${study.citation}：${question.zh}`} placeholder="寫下論文報告的內容及頁碼⋯⋯"></textarea></label>)}
                <details class="evidence-previous-notes"><summary>先前的筆記（如有）</summary><textarea rows="2" maxlength="1800" data-save={`instrument-${study.id}`} data-response-label={study.noteZh}></textarea>{study.id === 'rahman-focus-group' && <textarea rows="2" maxlength="1800" data-save="instrument-rahman-documents" data-response-label="Rahman 等人論文：先前的文件筆記"></textarea>}</details>
              </div>
            </div>
          </div>
        </div>
      </section>
    );})}

    <section class="slide" data-title="The wider field of educational instruments" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Educational instruments · wider field</span></header>
        <div data-language="en">
          <h2>The examples open onto a wider instrument landscape.</h2>
          <div class="design-check-grid" aria-label="Wider field of educational instruments">
            <article><span>ELICITED</span><h3>Self-report and talk</h3><p>Questionnaire · scale · diary · experience sampling · interview · focus group</p></article>
            <article><span>OBSERVED</span><h3>Action and interaction</h3><p>Observation schedule · field notes · interaction code · audio/video protocol</p></article>
            <article><span>PERFORMED</span><h3>Assessment and process</h3><p>Test · performance task · rubric · portfolio · think-aloud · stimulated recall</p></article>
            <article><span>RECORDED</span><h3>Documents and administration</h3><p>Selection rule and extraction form for policy, curriculum, student work, attendance or grades</p></article>
            <article><span>GENERATED</span><h3>Digital and relational traces</h3><p>LMS log · clickstream · discussion export · sociometric roster · network matrix</p></article>
            <article><span>PARTICIPATORY + SENSOR</span><h3>Visual, embodied and environmental traces</h3><p>Photo elicitation · mapping prompt · participant media · eye tracking · wearable or physiological sensor</p></article>
          </div>
          <p class="takeaway">A study may use several instruments. Name each concrete tool and show the distinct evidence function it serves.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>這些例子通向更廣闊的工具版圖。</h2>
          <div class="design-check-grid" aria-label="更廣闊的教育研究工具版圖">
            <article><span>引出</span><h3>自陳及對話</h3><p>問卷 · 量表 · 日誌 · 經驗抽樣 · 訪談 · 焦點小組</p></article>
            <article><span>觀察</span><h3>行動及互動</h3><p>觀察表 · 田野筆記 · 互動編碼 · 錄音／錄影程序</p></article>
            <article><span>表現</span><h3>評量及歷程</h3><p>測驗 · 表現任務 · 評分規準 · 作品集 · 有聲思考 · 刺激回憶</p></article>
            <article><span>紀錄</span><h3>文件及行政資料</h3><p>用於政策、課程、學生作品、出席或成績的選取規則及擷取表</p></article>
            <article><span>生成</span><h3>數碼及關係痕跡</h3><p>LMS 記錄 · 點擊流 · 討論匯出 · 社會關係名冊 · 網絡矩陣</p></article>
            <article><span>參與式＋感測</span><h3>視覺、身體及環境痕跡</h3><p>相片引談 · 地圖提示 · 參與者媒體 · 眼動追蹤 · 穿戴式或生理感測器</p></article>
          </div>
          <p class="takeaway">一項研究可以使用多種工具；請逐一列明具體工具，並說明各自獨特的證據功能。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Explore educational instruments with AI" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">AI inquiry · compare before choosing</span></header>
        <div data-language="en">
          <h2>Ask what each instrument makes possible—and what it leaves out.</h2>
          <div class="grid-4">
            <article class="panel"><h3>Define it</h3><p>“Is this a data source, collection method, instrument or protocol? Define the distinction and name the concrete tool.”</p></article>
            <article class="panel"><h3>Match it</h3><p>“Which educational research questions, participants and settings fit this instrument? What form of evidence would it generate?”</p></article>
            <article class="panel"><h3>Stress-test it</h3><p>“What might this instrument miss, distort or burden? What validity, trustworthiness, accessibility and ethics issues need attention?”</p></article>
            <article class="panel"><h3>Compare it</h3><p>“Compare three plausible instruments for the same question. When would each be preferable, and what combination could provide complementary evidence?”</p></article>
          </div>
          <p class="instruction"><strong>Your turn:</strong> Give AI one research question from your project and ask it to propose three instruments. Verify every definition, challenge the ranking, and write your own evidence-based choice.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>追問每種工具能帶來甚麼，又會遺漏甚麼。</h2>
          <div class="grid-4">
            <article class="panel"><h3>界定</h3><p>「這是資料來源、蒐集方法、工具還是程序？請界定差異，並列明具體工具。」</p></article>
            <article class="panel"><h3>配對</h3><p>「哪類教育研究問題、參與者及場域適合這項工具？它會產生哪種證據？」</p></article>
            <article class="panel"><h3>壓力測試</h3><p>「這項工具可能遺漏、扭曲或增加甚麼負擔？需處理哪些效度、可信性、可及性及倫理問題？」</p></article>
            <article class="panel"><h3>比較</h3><p>「就同一問題比較三項可行工具。甚麼情況下各自較合適？哪種組合可提供互補證據？」</p></article>
          </div>
          <p class="instruction"><strong>輪到你：</strong>向 AI 提供你項目中的一條研究問題，要求提出三項工具。核實每個定義、質疑排序，並寫下你自己的循證選擇。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Collection procedure: make the sequence visible" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Procedure reporting</span></header>
        <div data-language="en">
          <h2>Show how participants and data move through the study.</h2>
          <div class="procedure-flow" aria-label="Data collection procedure sequence">
            <article><span>01</span><h3>Access &amp; eligibility</h3><p>Who can be approached, and under which criteria?</p></article><b>→</b>
            <article><span>02</span><h3>Invitation &amp; consent</h3><p>What do people receive before deciding?</p></article><b>→</b>
            <article><span>03</span><h3>Collection encounter</h3><p>Where, how and by whom is the questionnaire or interview conducted?</p></article><b>→</b>
            <article><span>04</span><h3>Record &amp; quality check</h3><p>How are responses captured, checked and connected to context?</p></article><b>→</b>
            <article><span>05</span><h3>De-identify &amp; store</h3><p>How are identifiers, access and retention managed?</p></article><b>→</b>
            <article><span>06</span><h3>Decision log</h3><p>Which changes, refusals or contingencies are documented?</p></article>
          </div>
          <p class="takeaway">Report each step with the people involved, setting, mode, record and any change.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>清楚呈現參與者及資料如何在研究中流動。</h2>
          <div class="procedure-flow" aria-label="資料蒐集程序順序">
            <article><span>01</span><h3>接觸及資格</h3><p>可接觸誰？以哪些準則決定資格？</p></article><b>→</b>
            <article><span>02</span><h3>邀請及同意</h3><p>參與者決定前會收到甚麼？</p></article><b>→</b>
            <article><span>03</span><h3>蒐集互動</h3><p>問卷或訪談在哪裏、如何及由誰進行？</p></article><b>→</b>
            <article><span>04</span><h3>紀錄及品質檢查</h3><p>回答如何被捕捉、檢查及連結至情境？</p></article><b>→</b>
            <article><span>05</span><h3>去識別及儲存</h3><p>如何處理識別資料、存取權及保存期？</p></article><b>→</b>
            <article><span>06</span><h3>決策紀錄</h3><p>如何記錄改變、拒絕或應變安排？</p></article>
          </div>
          <p class="takeaway">報告每一步涉及的人員、場域、方式、紀錄及任何改變。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Procedure red flags" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Risks in the collection procedure</span></header>
        <div data-language="en">
          <h2>Where could the evidence trail break?</h2>
          <div class="grid-4">
            <article class="panel"><h3>Access fails</h3><p>Who could refuse entry, delay permission or shape who can participate?</p></article>
            <article class="panel"><h3>Tool misfires</h3><p>Which wording, translation, setting or format could alter the evidence?</p></article>
            <article class="panel"><h3>Participant care matters</h3><p>What discomfort, unequal power or privacy concern needs a route of response?</p></article>
            <article class="panel"><h3>Data becomes unsafe</h3><p>Where could recordings, identifiers or access permissions create a risk?</p></article>
          </div>
          <p class="instruction">Choose one risk in the thesis. What was the stated safeguard? If none is visible, what would you ask the author?</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>證據軌跡可能在哪裏中斷？</h2>
          <div class="grid-4">
            <article class="panel"><h3>接觸失敗</h3><p>誰可能拒絕接觸、延遲允許，或影響誰可以參與？</p></article>
            <article class="panel"><h3>工具失準</h3><p>哪些措辭、翻譯、場域或形式可能改變證據？</p></article>
            <article class="panel"><h3>參與者保障</h3><p>哪些不適、權力不平等或私隱問題需要回應途徑？</p></article>
            <article class="panel"><h3>資料不安全</h3><p>錄音、識別資料或存取權限可能在哪裏造成風險？</p></article>
          </div>
          <p class="instruction">在論文中選擇一項風險。已說明的保障措施是甚麼？如未能找到，你會怎樣問作者？</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Prepare for ethical review" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Preparation for ethical review</span></header>
        <div data-language="en">
          <h2>Prepare the documents needed for ethical review.</h2>
          <div class="irb-pack">
            <article><span>▤</span><h3>Protocol</h3><p>Your purpose, participants, procedure, foreseeable risks and decision logic.</p></article>
            <article><span>✦</span><h3>Instrument</h3><p>The actual interview guide, questionnaire, observation form or document-selection rule.</p></article>
            <article><span>◇</span><h3>Recruitment &amp; consent</h3><p>What people receive before deciding whether to participate.</p></article>
            <article><span>□</span><h3>Data plan</h3><p>Identifiers, storage, access, retention and destruction decisions.</p></article>
          </div>
          <p class="takeaway">A protocol prepares the study for review. Begin human-participant data collection after the required approval.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>把你的蒐集決策轉化為具責任的準備包。</h2>
          <div class="irb-pack">
            <article><span>▤</span><h3>研究方案</h3><p>研究目的、參與者、程序、可預見風險及決策邏輯。</p></article>
            <article><span>✦</span><h3>研究工具</h3><p>實際的訪談指南、問卷、觀察表或文件選取規則。</p></article>
            <article><span>◇</span><h3>招募及同意</h3><p>參與者決定是否參與前會收到的資料。</p></article>
            <article><span>□</span><h3>資料計劃</h3><p>識別資料、儲存、存取、保存及銷毀的決策。</p></article>
          </div>
          <p class="takeaway">研究方案為倫理審查作準備；取得所需批准後才可開始蒐集人類參與者資料。</p>
        </div>
