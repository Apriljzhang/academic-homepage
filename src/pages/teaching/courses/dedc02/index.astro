---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
import PageShell from '../../../../components/PageShell.astro';
import { person } from '../../../../data/cv';
import { withBase } from '../../../../utils/paths';

const title = `DEDC02 · ${person.fullDisplayName}`;
const description = 'Interactive materials for DEDC02 Advanced Research Method at City University of Macau.';
const week1Href = withBase('/teaching/courses/dedc02/01-philosophical-grounding');
const week2Href = withBase('/teaching/courses/dedc02/02-research-questions');
const week3Href = withBase('/teaching/courses/dedc02/03-literature-review');
const week4Href = withBase('/teaching/courses/dedc02/04-research-design');
const week5Href = withBase('/teaching/courses/dedc02/05-data-collection');
const week6Href = withBase('/teaching/courses/dedc02/06-research-ethics');
const week7Href = withBase('/teaching/courses/dedc02/07-qualitative-analysis');
---

<BaseLayout {title} {description}>
  <SiteHeader />
  <main id="main-content" class="min-h-[50vh] w-full bg-page">
    <PageShell accentBar>
      <p class="type-label text-secondary">Doctoral course · DEDC02</p>
      <h1 class="mt-2 font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl lg:text-5xl">
        Advanced Research Method
      </h1>
      <p class="type-intro mt-4">
        Interactive lesson materials on research design, evidence, ethics and defensible claims.
      </p>

      <div class="mt-8 max-w-4xl border-t border-border pt-6">
        <h2 class="type-label text-secondary">Course materials</h2>
        <ol class="mt-4 grid gap-2 sm:grid-cols-2">
          <li>
            <a
              href={week1Href}
              class="group flex min-h-20 items-center justify-between gap-3 rounded-lg border border-border bg-white px-4 py-3 no-underline transition hover:border-secondary hover:bg-main-faint"
            >
              <span class="flex min-w-0 items-center gap-3">
                <span class="block text-base font-semibold text-ink group-hover:text-secondary">
                  1. Philosophical Grounding
                </span>
              </span>
              <span class="shrink-0 text-lg text-secondary" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a
              href={week2Href}
              class="group flex min-h-20 items-center justify-between gap-3 rounded-lg border border-border bg-white px-4 py-3 no-underline transition hover:border-secondary hover:bg-main-faint"
            >
              <span class="flex min-w-0 items-center gap-3">
                <span class="block text-base font-semibold text-ink group-hover:text-secondary">
                  2. Research Questions
                </span>
              </span>
              <span class="shrink-0 text-lg text-secondary" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a
              href={week3Href}
              class="group flex min-h-20 items-center justify-between gap-3 rounded-lg border border-border bg-white px-4 py-3 no-underline transition hover:border-secondary hover:bg-main-faint"
            >
              <span class="flex min-w-0 items-center gap-3">
                <span class="block text-base font-semibold text-ink group-hover:text-secondary">
                  3. Literature Review
                </span>
              </span>
              <span class="shrink-0 text-lg text-secondary" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a
              href={week4Href}
              class="group flex min-h-20 items-center justify-between gap-3 rounded-lg border border-border bg-white px-4 py-3 no-underline transition hover:border-secondary hover:bg-main-faint"
            >
              <span class="flex min-w-0 items-center gap-3">
                <span class="block text-base font-semibold text-ink group-hover:text-secondary">
                  4. Research Design &amp; Alignment
                </span>
              </span>
              <span class="shrink-0 text-lg text-secondary" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a
              href={week5Href}
              class="group flex min-h-20 items-center justify-between gap-3 rounded-lg border border-border bg-white px-4 py-3 no-underline transition hover:border-secondary hover:bg-main-faint"
            >
              <span class="flex min-w-0 items-center gap-3">
                <span class="block text-base font-semibold text-ink group-hover:text-secondary">
                  5. Data Collection Decisions
                </span>
              </span>
              <span class="shrink-0 text-lg text-secondary" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a
              href={week6Href}
              class="group flex min-h-20 items-center justify-between gap-3 rounded-lg border border-border bg-white px-4 py-3 no-underline transition hover:border-secondary hover:bg-main-faint"
            >
              <span class="flex min-w-0 items-center gap-3">
                <span class="block text-base font-semibold text-ink group-hover:text-secondary">
                  6. Research Ethics and Integrity
                </span>
              </span>
              <span class="shrink-0 text-lg text-secondary" aria-hidden="true">→</span>
            </a>
          </li>
          <li>
            <a
              href={week7Href}
              class="group flex min-h-20 items-center justify-between gap-3 rounded-lg border border-border bg-white px-4 py-3 no-underline transition hover:border-secondary hover:bg-main-faint"
            >
              <span class="flex min-w-0 items-center gap-3">
                <span class="block text-base font-semibold text-ink group-hover:text-secondary">
                  7. Qualitative Data Analysis and Reporting
                </span>
              </span>
              <span class="shrink-0 text-lg text-secondary" aria-hidden="true">→</span>
            </a>
          </li>
        </ol>
        <p class="mt-5 text-sm text-muted">Further lesson decks will be added here as the course develops.</p>
      </div>

      <a href={withBase('/teaching/approach')} class="mt-8 inline-flex text-sm font-semibold">
        ← Back to CityU courses
      </a>
    </PageShell>
  </main>
  <SiteFooter />
</BaseLayout>
