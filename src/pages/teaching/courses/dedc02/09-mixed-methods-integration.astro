---
import CourseSlideLayout from '../../../../layouts/CourseSlideLayout.astro';
import LessonDeckChrome from '../../../../components/lessons/LessonDeckChrome.astro';
import '../../../../styles/dedc02-mixed-methods.css';
import { withBase } from '../../../../utils/paths';
const title='Mixed Methods Integration and Reporting · DEDC02';
const description='Follow an EFL feedback study from a research problem through mixed methods design, integration, reporting, and appraisal.';
import { mixedMethodsSlides as slides } from '../../../../data/dedc02MixedMethodsLesson';
const courseHref = withBase('/teaching/courses/dedc02');
const lessonPdf = withBase('/teaching/courses/dedc02/mixed-methods-integration-and-reporting.pdf');
const renderBody = (body: string) => body.replaceAll('__LESSON_PDF__', lessonPdf);
---
<CourseSlideLayout {title} {description} lessonDeck>
<LessonDeckChrome {courseHref} lessonTitle="Mixed Methods Integration and Reporting" />
<main class="deck mm-deck" aria-label="Mixed Methods Integration and Reporting slide deck">
{slides.map((s,i)=><section class:list={['slide',{'is-active':i===0}]} id={`slide-${i+1}`} data-title={s.title.replaceAll('<br>',' ')} data-slide-key={s.key} data-language="en" aria-hidden={i!==0}><div class="slide-inner">
<header class="slide-header"><span class="eyebrow">DEDC02 · {s.section}</span></header>
{i===0&&<div class="title-rule"></div>}
<div class="en" data-language="en">{i===0?<h1 set:html={s.title}/>:<h2 set:html={s.title}/>}<Fragment set:html={renderBody(s.body)}/></div>
<div class="zh" data-language="zh" lang="zh-Hant" hidden>{i===0?<h1 set:html={s.zh}/>:<h2 set:html={s.zh}/>}<Fragment set:html={renderBody(s.bodyzh)}/></div>
{i!==0&&<p class="source-note" set:html={s.source}/>}
</div></section>)}
</main>
<script>import '../../../../scripts/dedc02MixedMethods';</script>
</CourseSlideLayout>
