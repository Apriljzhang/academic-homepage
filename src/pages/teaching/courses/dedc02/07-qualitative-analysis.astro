---
import CourseSlideLayout from '../../../../layouts/CourseSlideLayout.astro';
import LessonDeckChrome from '../../../../components/lessons/LessonDeckChrome.astro';
import QualitativeWorkingText from '../../../../components/lessons/QualitativeWorkingText.astro';
import { analyticTerms as terms, termMatches } from '../../../../data/dedc02AnalyticTerms';
import QualitativeCodingSlides from '../../../../components/lessons/QualitativeCodingSlides.astro';
import QualitativeMethodExplorer from '../../../../components/lessons/QualitativeMethodExplorer.astro';
import { withBase } from '../../../../utils/paths';
import '../../../../styles/dedc02-qualitative-analysis.css';

const title = 'Qualitative Data Analysis and Reporting · DEDC02';
const description = 'An interactive bilingual doctoral lesson on codes, categories, topics, themes, inductive, deductive and abductive coding, a remote-work example, qualitative analysis methods and evidence-based reporting.';
const courseHref = withBase('/teaching/courses/dedc02');


const scenarios = [
  {
    "id": "policy-positioning",
    "en": "How do teachers use hedges, pronouns and turn-taking in feedback meetings to present expertise and negotiate agreement?",
    "zh": "教師在回饋會議中如何透過緩和語、代詞及輪次安排，展現專業並協商共識？",
    "answer": "discourse",
    "why": "Discourse analysis examines how language choices accomplish social actions in their interactional context.",
    "whyZh": "話語分析檢視語言選擇如何在互動語境中完成社會行動。"
  },
  {
    "id": "critical-policy",
    "en": "How does admission-policy language legitimise unequal access for migrant pupils? Connect textual choices to institutional inequality.",
    "zh": "收生政策的語言如何合理化移居學生的不平等入學機會？把文本選擇與制度不平等連繫。",
    "answer": "critical",
    "why": "A critical approach within discourse analysis explicitly connects textual choices to power and institutional inequality.",
    "whyZh": "話語分析中的批判取向明確把文本選擇與權力及制度不平等連繫。"
  },
  {
    "id": "assessment-process",
    "en": "How do new teachers learn to negotiate assessment expectations? Use iterative interviews, comparisons and theoretically guided sampling to build a process theory.",
    "zh": "新教師如何學會協商評核期望？透過反覆訪談、比較及理論抽樣，建立解釋過程的理論。",
    "answer": "grounded",
    "why": "Grounded theory develops relationships between categories into an explanatory theory; ongoing analysis guides what data to seek next.",
    "whyZh": "紮根理論把類別之間的關係發展為解釋性理論；持續分析會引導下一步收集哪些資料。"
  },
  {
    "id": "career-story",
    "en": "How does a teacher tell the story of moving from industry into teaching? Preserve the sequence, turning points and narrative voice.",
    "zh": "一位教師如何講述由業界轉入教職的故事？保留次序、轉折與敘事聲音。",
    "answer": "narrative",
    "why": "Narrative analysis examines how a story is organised and told over time. Isolating quotations into topics could lose its sequence and plot.",
    "whyZh": "敘事分析檢視故事如何隨時間被組織及講述；將引文分割成話題可能使次序與情節流失。"
  },
  {
    "id": "confidence-meanings",
    "en": "What shared meanings underpin teachers’ confidence in giving feedback? Interpret patterns across interviews around central organising ideas.",
    "zh": "哪些共同意義構成教師給予回饋時的信心？以核心概念詮釋訪談中的跨個案模式。",
    "answer": "thematic",
    "why": "Thematic analysis develops patterns of shared meaning around central organising ideas. A theme explains a pattern through a central organising idea.",
    "whyZh": "主題分析圍繞核心概念發展共同意義模式；主題以核心概念解釋模式。"
  },
  {
    "id": "feedback-categories",
    "en": "What kinds of feedback do teachers describe in 30 interviews? Define categories for feedback purposes and apply clear inclusion rules.",
    "zh": "30份教師訪談描述哪些回饋類型？按回饋目的界定類別，應用清楚的納入規則。",
    "answer": "content",
    "why": "Content analysis builds and applies a category system to classify meaningful material, preserving definitions and context.",
    "whyZh": "內容分析建立並應用類別系統，分類有意義的資料，同時保留定義及語境。"
  }
];

const matchingMethods = [
  {
    "value": "narrative",
    "en": "Narrative analysis",
    "zh": "敘事分析"
  },
  {
    "value": "grounded",
    "en": "Grounded theory analysis",
    "zh": "紮根理論分析"
  },
  {
    "value": "content",
    "en": "Content analysis",
    "zh": "內容分析"
  },
  {
    "value": "discourse",
    "en": "Discourse analysis",
    "zh": "話語分析"
  },
  {
    "value": "critical",
    "en": "Critical discourse analysis",
    "zh": "批判話語分析"
  },
  {
    "value": "thematic",
    "en": "Thematic analysis",
    "zh": "主題分析"
  }
];


---

<CourseSlideLayout {title} {description} lessonDeck>
  <LessonDeckChrome {courseHref} lessonTitle="Qualitative Data Analysis and Reporting" />
  <main class="deck qa-deck" aria-label="Qualitative Data Analysis and Reporting slide deck">
    <section class="slide is-active" data-title="Qualitative Data Analysis and Reporting" aria-hidden="false"><div class="slide-inner title-slide"><header class="slide-header"><span class="eyebrow">DEDC02 · Topic 7 · Advanced Research Method</span></header><div class="title-rule"></div><div data-language="en"><h1>Qualitative<br />Data Analysis<br />and Reporting</h1><p class="lead">What are we looking at? What can we claim? How do we show the path from data to interpretation?</p></div><div data-language="zh" hidden lang="zh-Hant"><h1>質性資料<br />分析與報告</h1><p class="lead">我們在看甚麼？能提出甚麼主張？如何展示從資料到詮釋的路徑？</p></div></div></section>


    <section class="slide" data-title="Learning aims" aria-hidden="true"><div class="slide-inner">
      <header class="slide-header"><span class="eyebrow">Learning aims</span></header>
      <div data-language="en"><h2>Learning aims</h2><p>By the end of this lesson, you should be able to:</p>
        <ol class="qa-steps">
          <li><b>01</b><span>Distinguish an excerpt, code, category, topic and theme, and explain how they relate.</span></li>
          <li><b>02</b><span>Compare inductive, deductive and abductive reasoning in qualitative analysis.</span></li>
          <li><b>03</b><span>Explain thematic analysis and its varieties, and compare them with content, narrative, discourse, critical discourse and grounded theory analysis.</span></li>
          <li><b>04</b><span>Select an analysis method suited to a research question and justify your choice.</span></li>
          <li><b>05</b><span>Code interview extracts, develop an interpretation supported by evidence and describe the analytic process.</span></li>
        </ol>
      </div>
      <div data-language="zh" hidden lang="zh-Hant"><h2>學習目標</h2><p>完成本課後，你應能：</p>
        <ol class="qa-steps">
          <li><b>01</b><span>區分資料片段、代碼、類別、話題與主題，並解釋它們之間的關係。</span></li>
          <li><b>02</b><span>比較質性分析中的歸納、演繹與溯因推理。</span></li>
          <li><b>03</b><span>解釋主題分析及其不同取向，並與內容分析、敘事分析、論述分析、批判論述分析及紮根理論分析作比較。</span></li>
          <li><b>04</b><span>選擇切合研究問題的分析方法，並論證選擇的理由。</span></li>
          <li><b>05</b><span>為訪談片段編碼，形成有證據支持的詮釋，並說明分析過程。</span></li>
        </ol>
      </div>
    </div></section>

    <section class="slide" data-title="Five analytic terms" aria-hidden="true"><div class="slide-inner">
      <header class="slide-header"><span class="eyebrow">Working text · trace the analytic terms</span></header>
      {(['en','zh'] as const).map((language) => <div data-language={language} hidden={language === 'zh'} lang={language === 'zh' ? 'zh-Hant' : 'en'}>
        <h2>{language === 'zh' ? '五個作用不同的術語' : 'Five terms that do different work'}</h2>
        <QualitativeWorkingText {language} />
        <p>{language === 'zh' ? '先讀T1–T3，再打開各卡片。每個例子都來自這份文本；比較原話、分析標籤與詮釋的作用。' : 'Read T1–T3, then open the cards. Every example comes from this text. Compare the roles of original words, analytic labels and interpretations.'}</p>
        <div class="qa-term-grid">{terms.map((term) => <details><summary>{language === 'zh' ? term.zh : term.en}</summary><p>{language === 'zh' ? term.definitionZh : term.definition}</p><p><strong>{language === 'zh' ? '文本例子：' : 'Text example: '}</strong>{language === 'zh' ? term.exampleZh : term.example}</p><small>{language === 'zh' ? term.traceZh : term.trace}</small></details>)}</div>
        <p class="qa-teacher">{language === 'zh' ? '「支援來源」把哪些代碼組在一起？暫定主題對T1與T2提出甚麼詮釋？T3如何幫助界定其適用範圍？' : 'Which codes are grouped under “Sources of support”? What does the provisional theme interpret in T1 and T2? How does T3 help define its scope?'}</p>
      </div>)}
    </div></section>

    <section class="slide" data-title="Term matching" aria-hidden="true"><div class="slide-inner">
      <header class="slide-header"><span class="eyebrow">Activity 1 · match examples from the working text</span></header>
      {(['en','zh'] as const).map((language) => <div data-language={language} hidden={language === 'zh'} lang={language === 'zh' ? 'zh-Hant' : 'en'}>
        <h2>{language === 'zh' ? '配對各項分析角色' : 'Match the analytic role'}</h2>
        <details class="qa-reveal" open><summary>{language === 'zh' ? '重讀共同練習文本T1–T3' : 'Revisit the shared working text T1–T3'}</summary><QualitativeWorkingText {language} /></details>
        <p>{language === 'zh' ? '各項均取自上一頁的文本分析。判斷它們在本例中的角色；檢查答案，再指出原文中支持你判斷的位置。' : 'Each item comes from the analysis of the same text on the previous page. Match its role in this example, check your choices and identify the supporting words in the accounts.'}</p>
        <div class="qa-match" data-qa-match>
          {termMatches.map((term) => <label>{language === 'zh' ? term.exampleZh : term.example}<select data-answer={term.id}><option value="">{language === 'zh' ? '選擇……' : 'Choose…'}</option>{terms.map((choice) => <option value={choice.id}>{language === 'zh' ? choice.zh : choice.en}</option>)}</select></label>)}
          <button type="button" data-check>{language === 'zh' ? '檢查配對' : 'Check matches'}</button><p role="status" data-result></p>
        </div>
        <details class="qa-reveal"><summary>{language === 'zh' ? '把各項配對追溯至文本' : 'Trace the matches to the text'}</summary>{termMatches.map((term) => <p><strong>{language === 'zh' ? term.zh : term.en}: </strong>{language === 'zh' ? term.traceZh : term.trace}</p>)}</details>
        <p class="qa-teacher">{language === 'zh' ? '哪些項目保留原話？哪些是分析者建立的？若加入更多訪談，你會如何檢視這個暫定主題？' : 'Which item preserves original wording? Which items were constructed by the analyst? How would you examine the provisional theme with more interviews?'}</p>
      </div>)}
    </div></section>

    <section class="slide" data-title="Topic versus theme" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Activity 3 · claim check</span></header><div data-language="en"><h2>A topic names the area. A theme says something about it.</h2><div class="qa-compare"><article><small>Topic heading</small><h3>Teacher training</h3><p>Tells us what the material concerns.</p></article><article><small>Candidate interpretive theme</small><h3>Confidence depends on usable guidance, whether formal or peer-led.</h3><p>Connects T1–T3 around a central idea while leaving room for different routes.</p></article></div><div class="qa-quiz" data-qa-quiz data-answer="b"><p>Which further evidence would most strengthen the candidate theme?</p><button type="button" data-choice="a">The number of times “training” appears</button><button type="button" data-choice="b">More accounts showing how guidance was used and when it was insufficient</button><button type="button" data-choice="c">A quotation from T1 repeated three times</button><p role="status" data-feedback hidden></p></div><details class="qa-reveal qa-good-theme" open><summary>What makes a good theme?</summary><p>A good theme is data-relevant, clearly defined, meaningful, consistent, and actionable. It captures patterns supported by multiple examples, maintains distinct boundaries from other themes, and reveals insight beyond surface observations.</p></details></div><div data-language="zh" hidden lang="zh-Hant"><h2>話題指出領域；主題提出對該領域的理解。</h2><div class="qa-compare"><article><small>話題標題</small><h3>教師培訓</h3><p>說明資料談及甚麼。</p></article><article><small>候選詮釋主題</small><h3>無論來自正式培訓或同儕，有用的指引都可能建立信心。</h3><p>以一個核心概念連繫T1至T3，同時容納不同途徑。</p></article></div><div class="qa-quiz" data-qa-quiz data-answer="b"><p>哪類補充證據最能加強這個候選主題？</p><button type="button" data-choice="a">「培訓」一詞出現的次數</button><button type="button" data-choice="b">更多關於如何使用指引及何時不足的敘述</button><button type="button" data-choice="c">把T1的同一引文重複三次</button><p role="status" data-feedback hidden></p></div><details class="qa-reveal qa-good-theme" open><summary>好的主題應具備甚麼？</summary><p>好的主題應與資料相關、界定清楚、有意義、內部一致，並能引導行動。它捕捉由多個例子支持的模式，與其他主題維持清楚界限，並揭示超越表面觀察的洞見。</p></details></div></div></section>

    <QualitativeCodingSlides part="approaches" />

    <section class="slide" data-title="Analytic trail" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Evidence trail</span></header><div data-language="en"><h2>Keep each inference inspectable</h2><div class="qa-trail"><span>Source excerpt<br /><b>T1, T2, T3</b></span><span>Meaningful segments<br /><b>What is happening?</b></span><span>Initial codes<br /><b>Short labels</b></span><span>Categories or patterns<br /><b>Compare cases</b></span><span>Candidate theme / account<br /><b>What does it mean?</b></span><span>Finding<br /><b>Claim + evidence + limits</b></span></div><p class="qa-note">Use this evidence trail to connect your interpretations to the data. Adapt the analytic steps to your chosen method. Reflexive thematic analysis is recursive; grounded theory analysis, narrative analysis and discourse analysis make different analytic moves.</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>讓每一步推論可供檢視</h2><div class="qa-trail"><span>來源片段<br /><b>T1、T2、T3</b></span><span>有意義的片段<br /><b>正在發生甚麼？</b></span><span>初始代碼<br /><b>簡短標籤</b></span><span>類別或模式<br /><b>比較個案</b></span><span>候選主題／敘述<br /><b>它有甚麼意義？</b></span><span>研究發現<br /><b>主張＋證據＋界限</b></span></div><p class="qa-note">運用這條證據鏈，把你的詮釋與資料連繫起來，並按所選方法調整分析步驟。反思性主題分析會反覆往返；紮根理論分析、敘事分析及話語分析的分析步驟亦各有不同。</p></div></div></section>


    <section class="slide" data-title="Explore qualitative analysis methods" aria-hidden="true"><div class="slide-inner">
      <header class="slide-header"><span class="eyebrow">Method map · question → discuss → distinguish</span></header>
      <div data-language="en"><h2>Explore qualitative analysis methods</h2><p>Choose a method. Use the basic questions to understand its purpose, procedure and findings, with AI if helpful. Then reveal the core features to check your understanding. Compare what each method attends to, how it analyses the material and what it produces.</p><QualitativeMethodExplorer language="en" /></div>
      <div data-language="zh" hidden lang="zh-Hant"><h2>探索質性資料分析方法</h2><p>選擇一種方法，以基本問題認識方法的目的、程序及成果；可用AI協助學習，之後揭示核心特徵，檢查理解。比較各方法的關注點、分析步驟及成果。</p><QualitativeMethodExplorer language="zh" /></div>
    </div></section>

    <section class="slide" data-title="Method selection clinic" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Activity 4 · match → explain → compare</span></header>
        <div data-language="en">
          <h2>Which method fits the question?</h2>
          <p>Match the six questions to the six methods. Use each method once. Explain why the method fits the question before checking your answers.</p>
          <div class="qa-scenarios" data-qa-scenarios>
            {scenarios.map((scenario, index) => <label data-scenario-id={scenario.id}>
              <b data-case-number>Case {index + 1}</b><span>{scenario.en}</span>
              <select data-answer={scenario.answer} data-why={scenario.why}>
                <option value="">Choose a method…</option>
                {matchingMethods.map((option) => <option value={option.value}>{option.en}</option>)}
              </select><small data-case-feedback></small>
            </label>)}
          </div>
          <div class="qa-scenario-actions"><button class="qa-action" type="button" data-check-scenarios="en">Check and explain</button></div>
          <p data-scenario-result role="status"></p>
          <p class="qa-teacher">Choose one question and explain why the selected method fits its intended finding. Rewrite the question so that a different method would fit better.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>哪種方法與研究問題相配？</h2>
          <p>為六個研究問題配對六種方法，每種方法使用一次。檢查答案前，先解釋該方法為何切合研究問題。</p>
          <div class="qa-scenarios" data-qa-scenarios>
            {scenarios.map((scenario, index) => <label data-scenario-id={scenario.id}>
              <b data-case-number>情境 {index + 1}</b><span>{scenario.zh}</span>
              <select data-answer={scenario.answer} data-why={scenario.whyZh}>
                <option value="">選擇方法……</option>
                {matchingMethods.map((option) => <option value={option.value}>{option.zh}</option>)}
              </select><small data-case-feedback></small>
            </label>)}
          </div>
          <div class="qa-scenario-actions"><button class="qa-action" type="button" data-check-scenarios="zh">檢查並解釋</button></div>
          <p data-scenario-result role="status"></p>
          <p class="qa-teacher">選一個研究問題，說明所選方法為何切合其預期成果。改寫該問題，使另一種方法更合適。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Same data, different lenses" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Activity 5 · switch lenses</span></header><div data-language="en"><h2>Three readings of one excerpt</h2><p>Read T1 again. Select a lens and predict what the analyst would look for.</p><blockquote><strong>T1</strong> · “The workshop showed the buttons, but I did not try it until Mei sat beside me and showed me her class example.”</blockquote><div class="qa-lenses" data-qa-lenses><div role="group" aria-label="Analysis lens"><button type="button" data-lens="thematic" aria-pressed="true">Thematic</button><button type="button" data-lens="content" aria-pressed="false">Content</button><button type="button" data-lens="discourse" aria-pressed="false">Discourse</button></div><p data-lens-output role="status">How does peer demonstration contribute to confidence across T1–T3?</p></div><p class="qa-teacher">Which lens best fits the original research question? What new question would make another lens preferable?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>同一片段的三種讀法</h2><p>再讀T1。選擇分析視角，先預測分析者會關注甚麼。</p><blockquote><strong>T1</strong> · 「工作坊示範了按鈕，但直到美坐在我旁邊，用她班上的例子教我，我才真正試用。」</blockquote><div class="qa-lenses" data-qa-lenses><div role="group" aria-label="分析視角"><button type="button" data-lens="thematic" aria-pressed="true">主題分析</button><button type="button" data-lens="content" aria-pressed="false">內容分析</button><button type="button" data-lens="discourse" aria-pressed="false">話語分析</button></div><p data-lens-output role="status">在T1至T3之中，同儕示範如何促成信心？</p></div><p class="qa-teacher">哪種視角最適合原來的研究問題？改成甚麼問題後，另一種視角會更合適？</p></div></div></section>

    <QualitativeCodingSlides part="practice" />

    <section class="slide" data-title="Reporting an analysis" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Reporting · method before findings</span></header><div data-language="en"><h2>Make your analytic process transparent</h2><ol class="qa-steps"><li><b>1</b><span>Name the analytic approach and why it fits the question and data.</span></li><li><b>2</b><span>Describe the data, unit of analysis, analysts and their relevant positioning.</span></li><li><b>3</b><span>Explain the actual steps: coding or another procedure, comparison, revisions and exceptions.</span></li><li><b>4</b><span>Report how each finding is grounded in excerpts, context and a bounded claim.</span></li></ol><p class="qa-note">Use the target journal’s instructions. APA JARS–Qual is a useful reporting prompt across qualitative traditions, not a replacement for method-specific reasoning.</p><p class="qa-source"><a href="https://apastyle.apa.org/jars" target="_blank" rel="noopener noreferrer">APA JARS–Qual ↗</a></p></div><div data-language="zh" hidden lang="zh-Hant"><h2>清楚交代你的分析過程</h2><ol class="qa-steps"><li><b>1</b><span>說明分析方法及其與問題和資料的契合理由。</span></li><li><b>2</b><span>交代資料、分析單位、分析者及相關研究者定位。</span></li><li><b>3</b><span>解釋實際步驟：編碼或其他程序、比較、修訂及例外情況。</span></li><li><b>4</b><span>以片段、語境及有界限的主張支持每項發現。</span></li></ol><p class="qa-note">遵循目標期刊要求。APA JARS–Qual可作報告提示，但不能代替各方法所需的分析推理。</p><p class="qa-source"><a href="https://apastyle.apa.org/jars" target="_blank" rel="noopener noreferrer">APA JARS–Qual ↗</a></p></div></div></section>


