---
import CourseSlideLayout from '../../../../layouts/CourseSlideLayout.astro';
import LessonDeckChrome from '../../../../components/lessons/LessonDeckChrome.astro';
import { withBase } from '../../../../utils/paths';
import '../../../../styles/dedc02-qualitative-analysis.css';

const title = 'Qualitative Data Analysis and Reporting · DEDC02';
const description = 'An interactive bilingual doctoral lesson on codes, categories, topics, themes, seven qualitative analysis approaches, and evidence-based reporting.';
const courseHref = withBase('/teaching/courses/dedc02');

const terms = [
  { en: 'Data excerpt', zh: '資料片段', definition: 'The participant’s or document’s words selected for analysis; keep their context and source ID.', definitionZh: '從參與者或文件選出的原文；保留其語境及來源編號。', example: '“I asked a colleague before using it.”', exampleZh: '「我在使用之前先請教同事。」' },
  { en: 'Code', zh: '代碼', definition: 'A concise analytic label attached to a meaningful segment.', definitionZh: '賦予有意義資料片段的簡短分析標籤。', example: 'Seeking peer reassurance', exampleZh: '尋求同儕確認' },
  { en: 'Category', zh: '類別', definition: 'A grouping of related codes; useful for organising material, but not automatically a theme.', definitionZh: '將相關代碼組合起來；有助整理資料，但不會自動成為主題。', example: 'Sources of support', exampleZh: '支援來源' },
  { en: 'Topic', zh: '話題', definition: 'What the material is about; often a useful heading, but it may only summarise a subject.', definitionZh: '資料談及甚麼；可作標題，但可能只概括議題。', example: 'Teacher training', exampleZh: '教師培訓' },
  { en: 'Theme', zh: '主題', definition: 'In interpretive thematic analysis, a patterned meaning organised around a central idea that answers the research question.', definitionZh: '在詮釋性主題分析中，由核心概念統整、能回答研究問題的意義模式。', example: 'Confidence grew through informal peer help when formal training fell short.', exampleZh: '正式培訓不足時，非正式同儕協助促成了信心。' },
];

const methods = [
  { name: 'Thematic analysis', zh: '主題分析', question: 'How do teachers make sense of AI feedback?', questionZh: '教師如何理解AI回饋？', attention: 'Patterns of shared meaning across the dataset', attentionZh: '整組資料中的共同意義模式', output: 'A reasoned account of themes', outputZh: '有理據支持的主題敘述', move: 'Compare codes, develop and review a central organising idea.', moveZh: '比較代碼，發展並檢視主題的核心概念。', source: 'Braun & Clarke (2006; 2023)', url: 'https://doi.org/10.1191/1478088706qp063oa' },
  { name: 'Qualitative content analysis', zh: '質性內容分析', question: 'What kinds of feedback occur in school policy?', questionZh: '學校政策出現哪些回饋類型？', attention: 'Meaningful content classified into categories', attentionZh: '將有意義的內容歸入類別', output: 'A category system with contextual interpretation', outputZh: '附有語境詮釋的類別系統', move: 'Choose conventional, directed or summative logic and explain the coding scheme.', moveZh: '選擇常規、定向或總結式取向，並解釋編碼方案。', source: 'Hsieh & Shannon (2005)', url: 'https://doi.org/10.1177/1049732305276687' },
  { name: 'Framework analysis', zh: '框架分析', question: 'How do barriers and supports differ across schools?', questionZh: '不同學校的障礙與支援有何差異？', attention: 'Issues across cases while retaining each case’s context', attentionZh: '跨個案比較議題，同時保留各個案語境', output: 'A case × issue matrix and interpretation', outputZh: '個案 × 議題矩陣及其詮釋', move: 'Code, refine an analytic framework, chart summaries, compare within and across rows.', moveZh: '編碼、修訂分析框架、填寫摘要，並在個案內及個案間比較。', source: 'Gale et al. (2013)', url: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC3848812/' },
  { name: 'Grounded theory', zh: '紮根理論', question: 'How does a new teaching practice become established?', questionZh: '新的教學實踐如何逐步確立？', attention: 'Actions, processes and relationships through iterative comparison', attentionZh: '經反覆比較探究行動、過程與關係', output: 'An explanatory process model or theory', outputZh: '解釋過程的模型或理論', move: 'Compare incidents, write memos and pursue theoretically useful data.', moveZh: '比較事件、撰寫備忘錄，並尋找對理論發展有用的資料。', source: 'Charmaz (2024, 3rd ed.)', url: 'https://www.sagepub.com/shop/buy-a-book/constructing-grounded-theory-3-255601' },
  { name: 'Narrative analysis', zh: '敘事分析', question: 'How does a career-change teacher tell their transition story?', questionZh: '轉職教師如何講述自己的轉變故事？', attention: 'Sequence, turning points, voice and the telling of a story', attentionZh: '故事的次序、轉折、聲音與講述方式', output: 'A contextualised interpretation of one or more narratives', outputZh: '對一個或多個敘事的語境化詮釋', move: 'Keep the story intact; inspect how it is organised and told.', moveZh: '保留故事整體，檢視其結構與講述方式。', source: 'Riessman, Narrative Methods', url: 'https://www.sagepub.com/shop/buy-a-book/narrative-methods-for-the-human-sciences-1-226139' },
  { name: 'Discourse analysis', zh: '話語分析', question: 'How does a policy construct “responsible AI use”?', questionZh: '政策如何建構「負責任使用AI」？', attention: 'Language in context and what it does socially', attentionZh: '語境中的語言及其社會作用', output: 'An account of meanings, identities or power made through language', outputZh: '分析語言如何建構意義、身份或權力', move: 'Study wording, positioning, omissions and context rather than only topics.', moveZh: '檢視措辭、角色定位、省略及語境，而不只歸納話題。', source: 'Gee (2025, 5th ed.)', url: 'https://www.routledge.com/Introducing-Discourse-Analysis-From-Grammar-to-Society-1st-Edition/Gee/p/book/9781032880389' },
  { name: 'Interpretative phenomenological analysis', zh: '詮釋現象學分析', question: 'How does a novice teacher experience a critical incident?', questionZh: '新任教師如何經驗一次關鍵課堂事件？', attention: 'How individuals make sense of significant lived experience', attentionZh: '個人如何理解重要的親身經驗', output: 'Detailed case-sensitive experiential interpretation', outputZh: '重視個案細節的經驗詮釋', move: 'Analyse each case closely before seeking connections across cases.', moveZh: '先細緻分析各個案，再尋找個案之間的連繫。', source: 'Smith, Flowers & Larkin (2022)', url: 'https://us2.sagepub.com/en-us/nam/node/1565837' },
];

const scenarios = [
  { en: 'A researcher wants to compare implementation barriers reported by teachers at five schools.', zh: '研究者希望比較五所學校教師報告的推行障礙。', answer: 'framework', why: 'A case-by-issue matrix makes within-school and across-school comparison visible.', whyZh: '個案 × 議題矩陣能呈現校內及跨校比較。' },
  { en: 'A researcher asks how a teacher tells the story of leaving industry for the classroom.', zh: '研究者想了解教師如何講述自己由業界轉入課堂的故事。', answer: 'narrative', why: 'The sequence and telling of a whole story are central.', whyZh: '整個故事的次序與講述方式是分析重點。' },
  { en: 'A researcher studies how policy language positions teachers as monitors of students’ AI use.', zh: '研究者探究政策語言如何將教師定位為學生使用AI的監察者。', answer: 'discourse', why: 'The question concerns what language constructs and does.', whyZh: '問題關注語言如何建構角色及發揮作用。' },
];
---

<CourseSlideLayout {title} {description} lessonDeck>
  <LessonDeckChrome {courseHref} lessonTitle="Qualitative Data Analysis and Reporting" />
  <main class="deck qa-deck" aria-label="Qualitative Data Analysis and Reporting slide deck">
    <section class="slide is-active" data-title="Qualitative Data Analysis and Reporting" aria-hidden="false"><div class="slide-inner title-slide"><header class="slide-header"><span class="eyebrow">DEDC02 · Topic 7 · Advanced Research Method</span></header><div class="title-rule"></div><div data-language="en"><h1>Qualitative<br />Data Analysis<br />and Reporting</h1><p class="lead">What are we looking at? What can we claim? How do we show the path from data to interpretation?</p></div><div data-language="zh" hidden lang="zh-Hant"><h1>質性資料<br />分析與報告</h1><p class="lead">我們在看甚麼？能提出甚麼主張？如何展示從資料到詮釋的路徑？</p></div></div></section>

    <section class="slide" data-title="Opening vote" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Opening · 10 minutes · HTML vote → teacher discussion</span></header><div data-language="en"><h2>What would you call this?</h2><blockquote>“I did not trust the new feedback tool until a colleague showed me how she used it with her own class.”</blockquote><p>Choose the strongest label for <em>the whole excerpt</em>. Then explain what your choice captures and misses.</p><div class="qa-quiz" data-qa-quiz data-answer="code"><button type="button" data-choice="topic">Teacher training</button><button type="button" data-choice="code">Peer modelling builds trust</button><button type="button" data-choice="theme">Technology is good</button><p role="status" data-feedback hidden></p></div><p class="qa-teacher"><strong>Teacher asks:</strong> Which words in the excerpt warrant your label? Would the label still work for another teacher’s account?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>你會如何命名這段資料？</h2><blockquote>「直到同事示範她如何在自己的班級使用新回饋工具，我才開始信任它。」</blockquote><p>為<em>整段資料</em>選擇最合適的標籤，再說明它抓住甚麼、遺漏甚麼。</p><div class="qa-quiz" data-qa-quiz data-answer="code"><button type="button" data-choice="topic">教師培訓</button><button type="button" data-choice="code">同儕示範建立信任</button><button type="button" data-choice="theme">科技很好</button><p role="status" data-feedback hidden></p></div><p class="qa-teacher"><strong>教師提問：</strong>片段中的哪些字句支持你的標籤？另一位教師的敘述也適用嗎？</p></div></div></section>

    <section class="slide" data-title="Learning route" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Learning route · 165 minutes · no break</span></header><div data-language="en"><h2>Five moves through today’s lesson</h2><ol class="qa-steps"><li><b>01</b><span>Name the analytic unit: excerpt, code, category, topic, theme.</span></li><li><b>02</b><span>Make and challenge interpretations using the same short dataset.</span></li><li><b>03</b><span>Compare seven qualitative analysis approaches by question and output.</span></li><li><b>04</b><span>Choose an approach for a research scenario and defend the fit.</span></li><li><b>05</b><span>Write a claim supported by evidence and report the analytic route.</span></li></ol></div><div data-language="zh" hidden lang="zh-Hant"><h2>本課的五個步驟</h2><ol class="qa-steps"><li><b>01</b><span>辨識分析單位：片段、代碼、類別、話題與主題。</span></li><li><b>02</b><span>以同一組短資料建立並檢驗詮釋。</span></li><li><b>03</b><span>按研究問題及成果比較七種質性分析方法。</span></li><li><b>04</b><span>為研究情境選擇方法並論證其適切性。</span></li><li><b>05</b><span>撰寫有證據支持的主張，交代分析路徑。</span></li></ol></div></div></section>

    <section class="slide" data-title="Five analytic terms" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Concept cards · click to compare</span></header><div data-language="en"><h2>Five terms that do different work</h2><p>Open the cards in any order. Which one is closest to the participant’s words? Which one makes the largest interpretive claim?</p><div class="qa-term-grid">{terms.map((term) => <details><summary>{term.en}</summary><p>{term.definition}</p><small>Example: {term.example}</small></details>)}</div><p class="qa-teacher"><strong>Teacher asks:</strong> Why might “teacher training” be a topic while “peer modelling builds trust” is a code?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>五個作用不同的術語</h2><p>以任何次序打開卡片。哪一項最接近參與者的原話？哪一項提出較大的詮釋主張？</p><div class="qa-term-grid">{terms.map((term) => <details><summary>{term.zh}</summary><p>{term.definitionZh}</p><small>例子：{term.exampleZh}</small></details>)}</div><p class="qa-teacher"><strong>教師提問：</strong>為何「教師培訓」可能只是話題，而「同儕示範建立信任」是一個代碼？</p></div></div></section>

    <section class="slide" data-title="Term matching" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Activity 1 · 12 minutes · HTML check → peer explanation</span></header><div data-language="en"><h2>Match the analytic role</h2><p>Choose the role of each example. Check your choices, then compare one disputed answer with a partner.</p><div class="qa-match" data-qa-match><label>“Training”<select data-answer="topic"><option value="">Choose…</option><option value="code">Code</option><option value="category">Category</option><option value="topic">Topic</option><option value="theme">Theme</option></select></label><label>“Seeking informal help”<select data-answer="code"><option value="">Choose…</option><option value="code">Code</option><option value="category">Category</option><option value="topic">Topic</option><option value="theme">Theme</option></select></label><label>“Sources of support”<select data-answer="category"><option value="">Choose…</option><option value="code">Code</option><option value="category">Category</option><option value="topic">Topic</option><option value="theme">Theme</option></select></label><label>“Teachers’ confidence depended on informal peer validation when official guidance was thin”<select data-answer="theme"><option value="">Choose…</option><option value="code">Code</option><option value="category">Category</option><option value="topic">Topic</option><option value="theme">Theme</option></select></label><button type="button" data-check>Check matches</button><p role="status" data-result></p></div><p class="qa-teacher"><strong>Teacher asks:</strong> Could the last sentence be defended from one quotation alone?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>配對各項分析角色</h2><p>判斷每個例子的角色。檢查答案，再與同伴討論一個有爭議的選擇。</p><div class="qa-match" data-qa-match><label>「培訓」<select data-answer="topic"><option value="">選擇……</option><option value="code">代碼</option><option value="category">類別</option><option value="topic">話題</option><option value="theme">主題</option></select></label><label>「尋求非正式協助」<select data-answer="code"><option value="">選擇……</option><option value="code">代碼</option><option value="category">類別</option><option value="topic">話題</option><option value="theme">主題</option></select></label><label>「支援來源」<select data-answer="category"><option value="">選擇……</option><option value="code">代碼</option><option value="category">類別</option><option value="topic">話題</option><option value="theme">主題</option></select></label><label>「正式指引不足時，教師的信心取決於非正式同儕確認」<select data-answer="theme"><option value="">選擇……</option><option value="code">代碼</option><option value="category">類別</option><option value="topic">話題</option><option value="theme">主題</option></select></label><button type="button" data-check>檢查配對</button><p role="status" data-result></p></div><p class="qa-teacher"><strong>教師提問：</strong>最後一句能否只靠一段引文支持？</p></div></div></section>

    <section class="slide" data-title="One dataset" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Shared fictional dataset · source IDs preserved</span></header><div data-language="en"><h2>Three teachers, one question</h2><p class="qa-question"><strong>Question:</strong> How do teachers build confidence when trying a new feedback tool?</p><div class="qa-excerpts"><article><b>T1</b><p>“The workshop showed the buttons, but I did not try it until Mei sat beside me and showed me her class example.”</p></article><article><b>T2</b><p>“I watched the recording twice. I still asked a colleague whether my feedback sounded right.”</p></article><article><b>T3</b><p>“The training gave me a usable routine. I tried it that afternoon and adjusted it after students responded.”</p></article></div><p class="qa-teacher"><strong>Teacher asks:</strong> What is similar? What differs? Which account challenges an easy claim that peer support is always necessary?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>三位教師，一個問題</h2><p class="qa-question"><strong>問題：</strong>教師在嘗試新的回饋工具時如何建立信心？</p><div class="qa-excerpts"><article><b>T1</b><p>「工作坊示範了按鈕，但直到美坐在我旁邊，用她班上的例子教我，我才真正試用。」</p></article><article><b>T2</b><p>「我看了兩次錄影，仍然問同事我的回饋是否恰當。」</p></article><article><b>T3</b><p>「培訓給了我可用的步驟。我當天下午就試用，並根據學生的反應作出調整。」</p></article></div><p class="qa-teacher"><strong>教師提問：</strong>哪些地方相似？哪些不同？哪一個敘述挑戰了「一定需要同儕支援」的簡單說法？</p></div></div></section>

    <section class="slide" data-title="Code the segments" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Activity 2 · 15 minutes · choose and justify</span></header><div data-language="en"><h2>Which code earns its place?</h2><p>For T1’s “Mei sat beside me and showed me her class example”, choose a code that stays close to the action yet contributes to the question.</p><div class="qa-quiz" data-qa-quiz data-answer="code"><button type="button" data-choice="topic">Technology</button><button type="button" data-choice="code">Learning through peer modelling</button><button type="button" data-choice="theme">Teachers always need colleagues</button><p role="status" data-feedback hidden></p></div><label class="qa-write">Write another possible code and explain the difference.<textarea data-save="alternate-code" rows="3" placeholder="My code…"></textarea></label><p class="qa-teacher"><strong>Teacher asks:</strong> What would you code in T2? Should T3 receive the same code? Why?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>哪個代碼最有根據？</h2><p>對T1的「美坐在我旁邊，用她班上的例子教我」，選擇貼近行動、又有助回答問題的代碼。</p><div class="qa-quiz" data-qa-quiz data-answer="code"><button type="button" data-choice="topic">科技</button><button type="button" data-choice="code">透過同儕示範學習</button><button type="button" data-choice="theme">教師總是需要同事</button><p role="status" data-feedback hidden></p></div><label class="qa-write">寫出另一個可行代碼，解釋其差別。<textarea data-save="alternate-code-zh" rows="3" placeholder="我的代碼……"></textarea></label><p class="qa-teacher"><strong>教師提問：</strong>你會如何編碼T2？T3應否使用同一個代碼？為甚麼？</p></div></div></section>

    <section class="slide" data-title="Topic versus theme" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Activity 3 · 12 minutes · claim check</span></header><div data-language="en"><h2>A topic names the area. A theme says something about it.</h2><div class="qa-compare"><article><small>Topic heading</small><h3>Teacher training</h3><p>Tells us what the material concerns.</p></article><article><small>Candidate interpretive theme</small><h3>Confidence depends on usable guidance, whether formal or peer-led.</h3><p>Connects T1–T3 around a central idea while leaving room for different routes.</p></article></div><div class="qa-quiz" data-qa-quiz data-answer="b"><p>Which further evidence would most strengthen the candidate theme?</p><button type="button" data-choice="a">The number of times “training” appears</button><button type="button" data-choice="b">More accounts showing how guidance was used and when it was insufficient</button><button type="button" data-choice="c">A quotation from T1 repeated three times</button><p role="status" data-feedback hidden></p></div><p class="qa-teacher"><strong>Teacher asks:</strong> Does the claim overreach? How would T3 change your wording?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>話題指出領域；主題提出對該領域的理解。</h2><div class="qa-compare"><article><small>話題標題</small><h3>教師培訓</h3><p>說明資料談及甚麼。</p></article><article><small>候選詮釋主題</small><h3>無論來自正式培訓或同儕，有用的指引都可能建立信心。</h3><p>以一個核心概念連繫T1至T3，同時容納不同途徑。</p></article></div><div class="qa-quiz" data-qa-quiz data-answer="b"><p>哪類補充證據最能加強這個候選主題？</p><button type="button" data-choice="a">「培訓」一詞出現的次數</button><button type="button" data-choice="b">更多關於如何使用指引及何時不足的敘述</button><button type="button" data-choice="c">把T1的同一引文重複三次</button><p role="status" data-feedback hidden></p></div><p class="qa-teacher"><strong>教師提問：</strong>這項主張有否超出證據？T3會如何改變你的措辭？</p></div></div></section>

    <section class="slide" data-title="Analytic trail" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Evidence trail · 10 minutes</span></header><div data-language="en"><h2>Keep each inference inspectable</h2><div class="qa-trail"><span>Source excerpt<br /><b>T1, T2, T3</b></span><span>Meaningful segments<br /><b>What is happening?</b></span><span>Initial codes<br /><b>Short labels</b></span><span>Categories or patterns<br /><b>Compare cases</b></span><span>Candidate theme / account<br /><b>What does it mean?</b></span><span>Finding<br /><b>Claim + evidence + limits</b></span></div><p class="qa-note">This is a teaching map, not one compulsory sequence for every qualitative method. Reflexive thematic analysis is recursive; grounded theory, narrative analysis, discourse analysis and IPA make different analytic moves.</p><p class="qa-teacher"><strong>Teacher asks:</strong> At which arrow is the researcher making the strongest interpretive decision?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>讓每一步推論可供檢視</h2><div class="qa-trail"><span>來源片段<br /><b>T1、T2、T3</b></span><span>有意義的片段<br /><b>正在發生甚麼？</b></span><span>初始代碼<br /><b>簡短標籤</b></span><span>類別或模式<br /><b>比較個案</b></span><span>候選主題／敘述<br /><b>它有甚麼意義？</b></span><span>研究發現<br /><b>主張＋證據＋界限</b></span></div><p class="qa-note">這是教學用圖，並非所有質性方法必須遵循的單一路徑。反思性主題分析會反覆往返；紮根理論、敘事分析、話語分析及IPA的分析步驟亦各有不同。</p><p class="qa-teacher"><strong>教師提問：</strong>在哪一個箭頭，研究者作出最重要的詮釋決定？</p></div></div></section>

    <section class="slide" data-title="Coding, displays and software" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">From the course reading · compare three supports</span></header><div data-language="en"><h2>What helps the researcher think?</h2><div class="qa-method"><article><small>Saldaña (2021)</small><h3>Coding as a heuristic</h3><p>Codes can be revised and grouped into categories. Ask whether a proposed “theme” is only a topic heading.</p></article><article><small>Miles, Huberman &amp; Saldaña (2014)</small><h3>Display the data</h3><p>Matrices and networks make comparisons and exceptions visible; conclusions still need checking.</p></article><article><small>Lewins &amp; Silver (2007); Mortelmans (2024)</small><h3>Use software purposefully</h3><p>CAQDAS/NVivo can organise, retrieve and display material. The researcher chooses units, labels and interpretations.</p></article></div><p class="qa-teacher"><strong>Teacher asks:</strong> If software returns every excerpt coded “support”, what analytic question must you still answer?</p><p class="qa-source">Course PDFs: <em>The Coding Manual</em>, ch. 1; <em>Qualitative Data Analysis</em>, chs. 4–5, 11; <em>Using Software in Qualitative Research</em>, chs. 1, 5–6; <em>Doing Qualitative Data Analysis with NVivo</em>.</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>甚麼能幫助研究者思考？</h2><div class="qa-method"><article><small>Saldaña（2021）</small><h3>以編碼探索</h3><p>代碼可以修訂並組成類別。檢查所謂「主題」是否只是話題標題。</p></article><article><small>Miles、Huberman與Saldaña（2014）</small><h3>展示資料</h3><p>矩陣與網絡可呈現比較和例外；結論仍須檢驗。</p></article><article><small>Lewins與Silver（2007）；Mortelmans（2024）</small><h3>有目的地使用軟件</h3><p>CAQDAS/NVivo能整理、檢索及展示資料；分析單位、標籤和詮釋由研究者決定。</p></article></div><p class="qa-teacher"><strong>教師提問：</strong>若軟件找出所有標為「支援」的片段，你仍須回答甚麼分析問題？</p><p class="qa-source">課程PDF：《The Coding Manual》第1章；《Qualitative Data Analysis》第4–5、11章；《Using Software in Qualitative Research》第1、5–6章；《Doing Qualitative Data Analysis with NVivo》。</p></div></div></section>

    <section class="slide" data-title="Choose an analytic aim" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Method atlas · start with the intended answer</span></header><div data-language="en"><h2>Which kind of answer do you need?</h2><div class="qa-aim-grid"><article><b>Describe content</b><p>What kinds of messages or practices appear?</p><small>Content analysis</small></article><article><b>Interpret patterns</b><p>What shared meanings organise accounts?</p><small>Thematic or framework analysis</small></article><article><b>Explain a process</b><p>How does something develop through action?</p><small>Grounded theory</small></article><article><b>Study stories or language</b><p>How is experience narrated or a position constructed?</p><small>Narrative, discourse or IPA</small></article></div><p class="qa-teacher"><strong>Teacher asks:</strong> What data would each question require? Which choice would change your interview or document selection?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>你需要哪一類答案？</h2><div class="qa-aim-grid"><article><b>描述內容</b><p>出現哪些訊息或做法？</p><small>內容分析</small></article><article><b>詮釋模式</b><p>哪些共同意義統整敘述？</p><small>主題分析或框架分析</small></article><article><b>解釋過程</b><p>某現象如何透過行動逐步發展？</p><small>紮根理論</small></article><article><b>分析故事或語言</b><p>經驗如何被講述？角色如何被建構？</p><small>敘事分析、話語分析或IPA</small></article></div><p class="qa-teacher"><strong>教師提問：</strong>各問題需要哪些資料？哪項選擇會改變訪談或文件的選取？</p></div></div></section>

    {methods.map((method, index) => <section class="slide" data-title={method.name} aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Method {index + 1} of 7 · compare the question and output</span></header><div data-language="en"><h2>{method.name}</h2><div class="qa-method"><article><small>Research question</small><p>{method.question}</p></article><article><small>Analytic attention</small><p>{method.attention}</p></article><article><small>Likely output</small><p>{method.output}</p></article></div><p class="qa-move"><strong>First move:</strong> {method.move}</p><p class="qa-teacher"><strong>Teacher asks:</strong> What would this approach reveal in the three-teacher dataset? What would it leave less visible?</p><p class="qa-source">Method source: <a href={method.url} target="_blank" rel="noopener noreferrer">{method.source} ↗</a></p></div><div data-language="zh" hidden lang="zh-Hant"><h2>{method.zh}</h2><div class="qa-method"><article><small>研究問題</small><p>{method.questionZh}</p></article><article><small>分析重點</small><p>{method.attentionZh}</p></article><article><small>可能成果</small><p>{method.outputZh}</p></article></div><p class="qa-move"><strong>第一步：</strong>{method.moveZh}</p><p class="qa-teacher"><strong>教師提問：</strong>這種方法能從三位教師的資料中看到甚麼？又有甚麼較難看到？</p><p class="qa-source">方法來源：<a href={method.url} target="_blank" rel="noopener noreferrer">{method.source} ↗</a></p></div></div></section>)}

    <section class="slide" data-title="What is framework analysis?" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Framework analysis · teacher–student walk-through</span></header><div data-language="en"><h2>What is framework analysis?</h2><p>It is a systematic way to compare <strong>issues across cases</strong> while keeping each case visible. Researchers build and revise an analytic framework, then summarise relevant material in a matrix whose rows are cases and columns are issues.</p><ol class="qa-steps"><li><b>1</b><span>Become familiar with transcripts; code a sample.</span></li><li><b>2</b><span>Develop and apply an analytic framework. It may combine research priorities with issues emerging from the data.</span></li><li><b>3</b><span>Chart concise, source-linked summaries in the matrix; compare within and across cases and return to full accounts.</span></li></ol><p class="qa-teacher"><strong>Teacher asks:</strong> What might disappear if we copy only isolated quotations into cells? How could a new issue change the framework?</p><p class="qa-source"><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC3848812/" target="_blank" rel="noopener noreferrer">Gale et al. (2013), the Framework Method ↗</a></p></div><div data-language="zh" hidden lang="zh-Hant"><h2>甚麼是框架分析？</h2><p>它有系統地比較<strong>不同個案的議題</strong>，同時保留各個案的脈絡。研究者建立及修訂分析框架，再把相關資料摘要填入矩陣：行是個案，列是議題。</p><ol class="qa-steps"><li><b>1</b><span>熟悉逐字稿，先為部分資料編碼。</span></li><li><b>2</b><span>建立並應用分析框架；可結合研究關注與資料中浮現的議題。</span></li><li><b>3</b><span>在矩陣記錄附來源的精簡摘要，進行個案內與個案間比較，並回看完整敘述。</span></li></ol><p class="qa-teacher"><strong>教師提問：</strong>若只把零散引文放進格子，哪些語境可能流失？新議題如何改變框架？</p><p class="qa-source"><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC3848812/" target="_blank" rel="noopener noreferrer">Gale等（2013），框架方法 ↗</a></p></div></div></section>

    <section class="slide" data-title="Framework matrix" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Framework analysis · 12 minutes · chart and compare</span></header><div data-language="en"><h2>A matrix keeps cases and issues together</h2><p>This simplified matrix summarises our fictional teacher accounts; each cell still needs a link to its transcript.</p><div class="qa-table-wrap"><table><thead><tr><th>Case</th><th>Formal guidance</th><th>Peer support</th><th>First use</th></tr></thead><tbody><tr><th>T1</th><td>Button demonstration only</td><td>Colleague showed a class example</td><td>After peer demonstration</td></tr><tr><th>T2</th><td>Recording watched twice</td><td>Colleague checked feedback</td><td>After seeking reassurance</td></tr><tr><th>T3</th><td>Usable routine from training</td><td>Not mentioned</td><td>Same afternoon; adjusted after student response</td></tr></tbody></table></div><details class="qa-reveal"><summary>What can you infer across and within cases?</summary><p>T1 and T2 used peer support, but in different ways. T3 offers a contrasting route through usable formal guidance. The matrix supports comparison; interpretation still requires returning to the full accounts.</p></details><p class="qa-teacher"><strong>Teacher asks:</strong> Which column risks losing the story behind a cell? How would you keep a source reference?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>矩陣同時保留個案與議題</h2><p>這個簡化矩陣概括了虛構教師資料；每格仍須連結至原始逐字稿。</p><div class="qa-table-wrap"><table><thead><tr><th>個案</th><th>正式指引</th><th>同儕支援</th><th>首次使用</th></tr></thead><tbody><tr><th>T1</th><td>只示範按鈕</td><td>同事展示班級例子</td><td>同儕示範之後</td></tr><tr><th>T2</th><td>看了兩次錄影</td><td>同事核對回饋</td><td>尋求確認之後</td></tr><tr><th>T3</th><td>培訓提供可用步驟</td><td>未提及</td><td>當天下午；按學生反應調整</td></tr></tbody></table></div><details class="qa-reveal"><summary>能從個案內及個案間推論甚麼？</summary><p>T1與T2都使用同儕支援，但方式不同。T3展示了由有用的正式指引建立信心的另一條路徑。矩陣有助比較；詮釋仍須回到完整敘述。</p></details><p class="qa-teacher"><strong>教師提問：</strong>哪一欄最容易失去格子背後的故事？如何保存來源參照？</p></div></div></section>

    <section class="slide" data-title="Method selection clinic" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Activity 4 · 25 minutes · HTML check → teacher defence</span></header><div data-language="en"><h2>Which method fits the question?</h2><div class="qa-scenarios" data-qa-scenarios>{scenarios.map((scenario, index) => <label><b>Case {index + 1}</b><span>{scenario.en}</span><select data-answer={scenario.answer} data-why={scenario.why}><option value="">Choose a method…</option><option value="thematic">Thematic analysis</option><option value="content">Content analysis</option><option value="framework">Framework analysis</option><option value="grounded">Grounded theory</option><option value="narrative">Narrative analysis</option><option value="discourse">Discourse analysis</option><option value="ipa">IPA</option></select><small data-case-feedback></small></label>)}</div><button class="qa-action" type="button" data-check-scenarios="en">Check and explain</button><p class="qa-teacher"><strong>Teacher asks:</strong> Which alternative could also be defensible if the research question were rewritten? State the new question.</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>哪種方法與研究問題相配？</h2><div class="qa-scenarios" data-qa-scenarios>{scenarios.map((scenario, index) => <label><b>情境 {index + 1}</b><span>{scenario.zh}</span><select data-answer={scenario.answer} data-why={scenario.whyZh}><option value="">選擇方法……</option><option value="thematic">主題分析</option><option value="content">內容分析</option><option value="framework">框架分析</option><option value="grounded">紮根理論</option><option value="narrative">敘事分析</option><option value="discourse">話語分析</option><option value="ipa">IPA</option></select><small data-case-feedback></small></label>)}</div><button class="qa-action" type="button" data-check-scenarios="zh">檢查並解釋</button><p class="qa-teacher"><strong>教師提問：</strong>若改寫研究問題，哪個其他方法也可能合理？請說出新問題。</p></div></div></section>

    <section class="slide" data-title="Same data, different lenses" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Activity 5 · 15 minutes · switch lenses</span></header><div data-language="en"><h2>Three readings of one excerpt</h2><p>Return to T1. Select a lens and predict what the analyst would look for before revealing the prompt.</p><div class="qa-lenses" data-qa-lenses><div role="group" aria-label="Analysis lens"><button type="button" data-lens="thematic" aria-pressed="true">Thematic</button><button type="button" data-lens="content" aria-pressed="false">Content</button><button type="button" data-lens="discourse" aria-pressed="false">Discourse</button></div><p data-lens-output role="status">How does peer demonstration contribute to confidence across T1–T3?</p></div><p class="qa-teacher"><strong>Teacher asks:</strong> Which lens best fits the original research question? What new question would make another lens preferable?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>同一片段的三種讀法</h2><p>回到T1。選擇分析視角，在提示出現前先預測分析者會關注甚麼。</p><div class="qa-lenses" data-qa-lenses><div role="group" aria-label="分析視角"><button type="button" data-lens="thematic" aria-pressed="true">主題分析</button><button type="button" data-lens="content" aria-pressed="false">內容分析</button><button type="button" data-lens="discourse" aria-pressed="false">話語分析</button></div><p data-lens-output role="status">在T1至T3之中，同儕示範如何促成信心？</p></div><p class="qa-teacher"><strong>教師提問：</strong>哪種視角最適合原來的研究問題？改成甚麼問題後，另一種視角會更合適？</p></div></div></section>

    <section class="slide" data-title="Reporting an analysis" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Reporting · 10 minutes · method before findings</span></header><div data-language="en"><h2>Give the reader the route, not just the method name</h2><ol class="qa-steps"><li><b>1</b><span>Name the analytic approach and why it fits the question and data.</span></li><li><b>2</b><span>Describe the data, unit of analysis, analysts and their relevant positioning.</span></li><li><b>3</b><span>Explain the actual steps: coding or another procedure, comparison, revisions and exceptions.</span></li><li><b>4</b><span>Report how each finding is grounded in excerpts, context and a bounded claim.</span></li></ol><p class="qa-note">Use the target journal’s instructions. APA JARS–Qual is a useful reporting prompt across qualitative traditions, not a replacement for method-specific reasoning.</p><p class="qa-source"><a href="https://apastyle.apa.org/jars" target="_blank" rel="noopener noreferrer">APA JARS–Qual ↗</a></p></div><div data-language="zh" hidden lang="zh-Hant"><h2>向讀者展示路徑，而不只報出方法名稱</h2><ol class="qa-steps"><li><b>1</b><span>說明分析方法及其與問題和資料的契合理由。</span></li><li><b>2</b><span>交代資料、分析單位、分析者及相關研究者定位。</span></li><li><b>3</b><span>解釋實際步驟：編碼或其他程序、比較、修訂及例外情況。</span></li><li><b>4</b><span>以片段、語境及有界限的主張支持每項發現。</span></li></ol><p class="qa-note">遵循目標期刊要求。APA JARS–Qual可作報告提示，但不能代替各方法所需的分析推理。</p><p class="qa-source"><a href="https://apastyle.apa.org/jars" target="_blank" rel="noopener noreferrer">APA JARS–Qual ↗</a></p></div></div></section>

    <section class="slide" data-title="Findings paragraph clinic" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Activity 6 · 15 minutes · write → compare → revise</span></header><div data-language="en"><h2>Write a finding the evidence can carry</h2><p>Use T1–T3. Write 2–3 sentences: a bounded claim, an excerpt with its source ID, and your interpretation. Include T3’s different route.</p><label class="qa-write">Your draft<textarea data-save="finding" rows="6" placeholder="Across the three accounts…"></textarea></label><details class="qa-reveal"><summary>Compare a possible answer after writing</summary><p>Teachers described different routes to initial confidence. T1 began using the tool after a colleague demonstrated it with a class example, while T3 used a routine from formal training and adapted it after student feedback. These accounts suggest that usable guidance mattered, although it came through different sources.</p></details><p class="qa-teacher"><strong>Teacher asks:</strong> Where does the paragraph move from description to interpretation? Which word would you soften if the dataset contained only these three accounts?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>撰寫證據足以支持的發現</h2><p>使用T1至T3。寫2至3句：有界限的主張、附來源編號的片段，以及你的詮釋。納入T3的不同路徑。</p><label class="qa-write">你的草稿<textarea data-save="finding-zh" rows="6" placeholder="在三位教師的敘述中……"></textarea></label><details class="qa-reveal"><summary>完成後比較一個可能答案</summary><p>教師以不同途徑建立初步信心。T1在同事以班級例子示範後才開始使用工具；T3則運用正式培訓所得的步驟，並按學生回饋調整。這些敘述顯示，有用的指引可能十分重要，但來源可以不同。</p></details><p class="qa-teacher"><strong>教師提問：</strong>段落何時由描述進入詮釋？如果只有三段資料，哪個用詞應更審慎？</p></div></div></section>

    <section class="slide" data-title="Sources and close" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Exit · 5 minutes · further reading</span></header><div data-language="en"><h2>Carry one distinction into your next analysis</h2><p class="lead small">A code labels a segment. A category groups codes. A topic names an area. An interpretive theme explains a pattern of meaning in relation to a question.</p><p class="qa-teacher"><strong>Teacher asks:</strong> Name one method, the question it answers, and the form its finding would take.</p><div class="qa-source-grid"><a href="https://doi.org/10.1191/1478088706qp063oa" target="_blank" rel="noopener noreferrer">Braun &amp; Clarke · thematic analysis ↗</a><a href="https://doi.org/10.1177/1049732305276687" target="_blank" rel="noopener noreferrer">Hsieh &amp; Shannon · content analysis ↗</a><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC3848812/" target="_blank" rel="noopener noreferrer">Gale et al. · framework method ↗</a><a href="https://apastyle.apa.org/jars" target="_blank" rel="noopener noreferrer">APA JARS–Qual · reporting ↗</a></div><a class="qa-return" href={courseHref}>Back to DEDC02 course materials →</a></div><div data-language="zh" hidden lang="zh-Hant"><h2>帶走一個清楚的區分</h2><p class="lead small">代碼標記片段；類別組合代碼；話題指出領域；詮釋性主題則回應研究問題，解釋意義模式。</p><p class="qa-teacher"><strong>教師提問：</strong>說出一種方法、它能回答的問題，以及可能形成的研究發現。</p><div class="qa-source-grid"><a href="https://doi.org/10.1191/1478088706qp063oa" target="_blank" rel="noopener noreferrer">Braun與Clarke · 主題分析 ↗</a><a href="https://doi.org/10.1177/1049732305276687" target="_blank" rel="noopener noreferrer">Hsieh與Shannon · 內容分析 ↗</a><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC3848812/" target="_blank" rel="noopener noreferrer">Gale等 · 框架分析 ↗</a><a href="https://apastyle.apa.org/jars" target="_blank" rel="noopener noreferrer">APA JARS–Qual · 報告 ↗</a></div><a class="qa-return" href={courseHref}>返回DEDC02課程材料 →</a></div></div></section>
