---
import CourseSlideLayout from '../../../../layouts/CourseSlideLayout.astro';
import LessonDeckChrome from '../../../../components/lessons/LessonDeckChrome.astro';
import QualitativeMethodExplorer from '../../../../components/lessons/QualitativeMethodExplorer.astro';
import { withBase } from '../../../../utils/paths';
import '../../../../styles/dedc02-qualitative-analysis.css';

const title = 'Qualitative Data Analysis and Reporting · DEDC02';
const description = 'An interactive bilingual doctoral lesson on codes, categories, topics, themes, eight qualitative analysis approaches and thematic-analysis varieties, and evidence-based reporting.';
const courseHref = withBase('/teaching/courses/dedc02');

const terms = [
  { en: 'Data excerpt', zh: '資料片段', definition: 'The participant’s or document’s words selected for analysis; keep their context and source ID.', definitionZh: '從參與者或文件選出的原文；保留其語境及來源編號。', example: '“I asked a colleague before using it.”', exampleZh: '「我在使用之前先請教同事。」' },
  { en: 'Code', zh: '代碼', definition: 'A concise analytic label attached to a meaningful segment.', definitionZh: '賦予有意義資料片段的簡短分析標籤。', example: 'Seeking peer reassurance', exampleZh: '尋求同儕確認' },
  { en: 'Category', zh: '類別', definition: 'A grouping of related codes; useful for organising material, but not automatically a theme.', definitionZh: '將相關代碼組合起來；有助整理資料，但不會自動成為主題。', example: 'Sources of support', exampleZh: '支援來源' },
  { en: 'Topic', zh: '話題', definition: 'What the material is about; often a useful heading, but it may only summarise a subject.', definitionZh: '資料談及甚麼；可作標題，但可能只概括議題。', example: 'Teacher training', exampleZh: '教師培訓' },
  { en: 'Theme', zh: '主題', definition: 'In interpretive thematic analysis, a patterned meaning organised around a central idea that answers the research question.', definitionZh: '在詮釋性主題分析中，由核心概念統整、能回答研究問題的意義模式。', example: 'Confidence grew through informal peer help when formal training fell short.', exampleZh: '正式培訓不足時，非正式同儕協助促成了信心。' },
];

const scenarios = [
  {"id": "policy-positioning", "en": "How does AI policy wording position teachers as monitors and students as potential rule-breakers?", "zh": "AI政策的措辭如何將教師定位為監察者，並將學生定位為可能違規的人？", "answer": "discourse", "why": "The aim is to examine how language constructs roles and power relations; listing policy topics would miss this work.", "whyZh": "目的是分析語言如何建構角色與權力關係；只列出政策話題會忽略這種作用。"},
  {"id": "observed-experience", "en": "How do six novice teachers make sense of being observed for the first time? Examine each lived experience closely before comparing cases.", "zh": "六位新任教師如何理解第一次被觀課的經驗？先細緻分析每人的親身經驗，再比較個案。", "answer": "ipa", "why": "IPA attends to each person’s meaning-making in a significant lived experience, retaining individual differences before cross-case comparison.", "whyZh": "IPA關注每人如何理解重要的親身經驗；跨個案比較之前，先保留個體差異。"},
  {"id": "policy-categories", "en": "What kinds of AI use are permitted, discouraged or prohibited in 40 school policies? Develop and apply a category system.", "zh": "40份學校政策容許、不鼓勵或禁止哪些AI使用方式？建立並應用類別系統。", "answer": "content", "why": "Content analysis classifies meaningful content systematically. The intended output is a category system with clear definitions and examples.", "whyZh": "內容分析有系統地分類有意義的內容；預期成果是附有明確定義及例子的類別系統。"},
  {"id": "assessment-process", "en": "How do new teachers learn to negotiate assessment expectations? Use iterative interviews, comparisons and theoretically guided sampling to build a process theory.", "zh": "新教師如何學會協商評核期望？透過反覆訪談、比較及理論抽樣，建立解釋過程的理論。", "answer": "grounded", "why": "Grounded theory develops relationships between categories into an explanatory theory; ongoing analysis guides what data to seek next.", "whyZh": "紮根理論把類別之間的關係發展為解釋性理論；持續分析會引導下一步收集哪些資料。"},
  {"id": "confidence-meanings", "en": "What shared meanings underpin teachers’ confidence in giving feedback? Interpret patterns across interviews around central organising ideas.", "zh": "哪些共同意義構成教師給予回饋時的信心？以核心概念詮釋訪談中的跨個案模式。", "answer": "thematic", "why": "Thematic analysis develops patterns of shared meaning around central organising ideas. A theme explains a pattern through a central organising idea.", "whyZh": "主題分析圍繞核心概念發展共同意義模式；主題以核心概念解釋模式。"},
  {"id": "school-comparison", "en": "How do barriers and supports differ across five schools? Chart source-linked summaries in a school-by-issue matrix and compare within and across schools.", "zh": "五所學校的障礙與支援有何差異？將附來源的摘要填入學校 × 議題矩陣，再作校內及跨校比較。", "answer": "framework", "why": "Framework analysis uses a case-by-issue matrix to support systematic comparisons while retaining each case’s context.", "whyZh": "框架分析運用個案 × 議題矩陣作有系統的比較，同時保留各個案的脈絡。"},
  {"id": "career-story", "en": "How does a teacher tell the story of moving from industry into teaching? Preserve the sequence, turning points and narrative voice.", "zh": "一位教師如何講述由業界轉入教職的故事？保留次序、轉折與敘事聲音。", "answer": "narrative", "why": "Narrative analysis examines how a story is organised and told over time. Isolating quotations into topics could lose its sequence and plot.", "whyZh": "敘事分析檢視故事如何隨時間被組織及講述；將引文分割成話題可能使次序與情節流失。"},
  {"id": "belonging-meanings", "en": "How is belonging understood across migrant teachers’ accounts? Develop themes connecting acceptance, recognition and everyday exclusion.", "zh": "移居教師的敘述如何理解歸屬感？發展連繫接納、認同與日常排斥的主題。", "answer": "thematic", "why": "The aim is to interpret shared meanings across accounts. Thematic analysis can connect these meanings without requiring a new process theory.", "whyZh": "目的是詮釋不同敘述的共同意義；主題分析可連繫這些意義，無須以建立新的過程理論為目標。"},
  {"id": "critical-policy", "en": "How does admission-policy language legitimise unequal access for migrant pupils? Connect textual choices to institutional inequality.", "zh": "收生政策的語言如何合理化移居學生的不平等入學機會？把文本選擇與制度不平等連繫。", "answer": "critical", "why": "Critical discourse analysis makes power and inequality an explicit focus, linking textual evidence to institutional relations.", "whyZh": "批判話語分析明確聚焦權力與不平等，把文本證據與制度關係連繫。"},
  {"id": "returning-story", "en": "How do two teachers narrate returning to work after a career break? Analyse each story’s chronology, turning points and self-presentation.", "zh": "兩位教師如何講述中斷職涯後重返工作的經歷？分析每個故事的時間次序、轉折及自我呈現。", "answer": "narrative", "why": "The unit of attention is the whole narrated journey and its telling. Studying personal experience alone does not automatically make an analysis IPA.", "whyZh": "分析重點是完整的敘事歷程及其講述方式；研究個人經驗並不會自動成為IPA。"},
];

const matchingMethods = [
  {"value": "narrative", "en": "Narrative analysis", "zh": "敘事分析"},
  {"value": "grounded", "en": "Grounded theory", "zh": "紮根理論"},
  {"value": "content", "en": "Qualitative content analysis", "zh": "質性內容分析"},
  {"value": "ipa", "en": "Interpretative phenomenological analysis (IPA)", "zh": "詮釋現象學分析（IPA）"},
  {"value": "framework", "en": "Framework analysis", "zh": "框架分析"},
  {"value": "critical", "en": "Critical discourse analysis", "zh": "批判話語分析"},
  {"value": "discourse", "en": "Discourse analysis", "zh": "話語分析"},
  {"value": "thematic", "en": "Thematic analysis", "zh": "主題分析"},
];

function matchingOptions(index: number) {
  const offset = (index * 3) % matchingMethods.length;
  return [...matchingMethods.slice(offset), ...matchingMethods.slice(0, offset)];
}
---

<CourseSlideLayout {title} {description} lessonDeck>
  <LessonDeckChrome {courseHref} lessonTitle="Qualitative Data Analysis and Reporting" />
  <main class="deck qa-deck" aria-label="Qualitative Data Analysis and Reporting slide deck">
    <section class="slide is-active" data-title="Qualitative Data Analysis and Reporting" aria-hidden="false"><div class="slide-inner title-slide"><header class="slide-header"><span class="eyebrow">DEDC02 · Topic 7 · Advanced Research Method</span></header><div class="title-rule"></div><div data-language="en"><h1>Qualitative<br />Data Analysis<br />and Reporting</h1><p class="lead">What are we looking at? What can we claim? How do we show the path from data to interpretation?</p></div><div data-language="zh" hidden lang="zh-Hant"><h1>質性資料<br />分析與報告</h1><p class="lead">我們在看甚麼？能提出甚麼主張？如何展示從資料到詮釋的路徑？</p></div></div></section>

    <section class="slide" data-title="Opening vote" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Opening · live vote → peer discussion</span></header><div data-language="en"><h2>What would you call this?</h2><blockquote>“I did not trust the new feedback tool until a colleague showed me how she used it with her own class.”</blockquote><p>Choose the strongest label for <em>the whole excerpt</em>. Then explain what your choice captures and misses.</p><div class="qa-quiz" data-qa-quiz data-answer="code"><button type="button" data-choice="topic">Teacher training</button><button type="button" data-choice="code">Peer modelling builds trust</button><button type="button" data-choice="theme">Technology is good</button><p role="status" data-feedback hidden></p></div><p class="qa-teacher">Which words in the excerpt warrant your label? Would the label still work for another teacher’s account?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>你會如何命名這段資料？</h2><blockquote>「直到同事示範她如何在自己的班級使用新回饋工具，我才開始信任它。」</blockquote><p>為<em>整段資料</em>選擇最合適的標籤，再說明它抓住甚麼、遺漏甚麼。</p><div class="qa-quiz" data-qa-quiz data-answer="code"><button type="button" data-choice="topic">教師培訓</button><button type="button" data-choice="code">同儕示範建立信任</button><button type="button" data-choice="theme">科技很好</button><p role="status" data-feedback hidden></p></div><p class="qa-teacher">片段中的哪些字句支持你的標籤？另一位教師的敘述也適用嗎？</p></div></div></section>

    <section class="slide" data-title="Learning route" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Learning route</span></header><div data-language="en"><h2>Five moves through today’s lesson</h2><ol class="qa-steps"><li><b>01</b><span>Name the analytic unit: excerpt, code, category, topic, theme.</span></li><li><b>02</b><span>Make and challenge interpretations using the same short dataset.</span></li><li><b>03</b><span>Explore eight approaches through a method map, with thematic-analysis varieties and the practice passages included in the slides.</span></li><li><b>04</b><span>Choose an approach for a research scenario and defend the fit.</span></li><li><b>05</b><span>Explain the evidence for your interpretation and report the analytic route.</span></li></ol></div><div data-language="zh" hidden lang="zh-Hant"><h2>本課的五個步驟</h2><ol class="qa-steps"><li><b>01</b><span>辨識分析單位：片段、代碼、類別、話題與主題。</span></li><li><b>02</b><span>以同一組短資料建立並檢驗詮釋。</span></li><li><b>03</b><span>以方法地圖探索八種取向、主題分析種類及投影片中的練習文本。</span></li><li><b>04</b><span>為研究情境選擇方法並論證其適切性。</span></li><li><b>05</b><span>解釋詮釋的證據，交代分析路徑。</span></li></ol></div></div></section>

    <section class="slide" data-title="Five analytic terms" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Concept cards · click to compare</span></header><div data-language="en"><h2>Five terms that do different work</h2><p>Open the cards in any order. Which one is closest to the participant’s words? Which one makes the largest interpretive claim?</p><div class="qa-term-grid">{terms.map((term) => <details><summary>{term.en}</summary><p>{term.definition}</p><small>Example: {term.example}</small></details>)}</div><p class="qa-teacher">Why might “teacher training” be a topic while “peer modelling builds trust” is a code?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>五個作用不同的術語</h2><p>以任何次序打開卡片。哪一項最接近參與者的原話？哪一項提出較大的詮釋主張？</p><div class="qa-term-grid">{terms.map((term) => <details><summary>{term.zh}</summary><p>{term.definitionZh}</p><small>例子：{term.exampleZh}</small></details>)}</div><p class="qa-teacher">為何「教師培訓」可能只是話題，而「同儕示範建立信任」是一個代碼？</p></div></div></section>

    <section class="slide" data-title="Term matching" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Activity 1 · check → peer explanation</span></header><div data-language="en"><h2>Match the analytic role</h2><p>Choose the role of each example. Check your choices, then compare one disputed answer with a partner.</p><div class="qa-match" data-qa-match><label>“Training”<select data-answer="topic"><option value="">Choose…</option><option value="code">Code</option><option value="category">Category</option><option value="topic">Topic</option><option value="theme">Theme</option></select></label><label>“Seeking informal help”<select data-answer="code"><option value="">Choose…</option><option value="code">Code</option><option value="category">Category</option><option value="topic">Topic</option><option value="theme">Theme</option></select></label><label>“Sources of support”<select data-answer="category"><option value="">Choose…</option><option value="code">Code</option><option value="category">Category</option><option value="topic">Topic</option><option value="theme">Theme</option></select></label><label>“Teachers’ confidence depended on informal peer validation when official guidance was thin”<select data-answer="theme"><option value="">Choose…</option><option value="code">Code</option><option value="category">Category</option><option value="topic">Topic</option><option value="theme">Theme</option></select></label><button type="button" data-check>Check matches</button><p role="status" data-result></p></div><p class="qa-teacher">Could the last sentence be defended from one quotation alone?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>配對各項分析角色</h2><p>判斷每個例子的角色。檢查答案，再與同伴討論一個有爭議的選擇。</p><div class="qa-match" data-qa-match><label>「培訓」<select data-answer="topic"><option value="">選擇……</option><option value="code">代碼</option><option value="category">類別</option><option value="topic">話題</option><option value="theme">主題</option></select></label><label>「尋求非正式協助」<select data-answer="code"><option value="">選擇……</option><option value="code">代碼</option><option value="category">類別</option><option value="topic">話題</option><option value="theme">主題</option></select></label><label>「支援來源」<select data-answer="category"><option value="">選擇……</option><option value="code">代碼</option><option value="category">類別</option><option value="topic">話題</option><option value="theme">主題</option></select></label><label>「正式指引不足時，教師的信心取決於非正式同儕確認」<select data-answer="theme"><option value="">選擇……</option><option value="code">代碼</option><option value="category">類別</option><option value="topic">話題</option><option value="theme">主題</option></select></label><button type="button" data-check>檢查配對</button><p role="status" data-result></p></div><p class="qa-teacher">最後一句能否只靠一段引文支持？</p></div></div></section>

    <section class="slide" data-title="One dataset" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Shared fictional dataset · source IDs preserved</span></header><div data-language="en"><h2>Three teachers, one question</h2><p class="qa-question"><strong>Question:</strong> How do teachers build confidence when trying a new feedback tool?</p><div class="qa-excerpts"><article><b>T1</b><p>“The workshop showed the buttons, but I did not try it until Mei sat beside me and showed me her class example.”</p></article><article><b>T2</b><p>“I watched the recording twice. I still asked a colleague whether my feedback sounded right.”</p></article><article><b>T3</b><p>“The training gave me a usable routine. I tried it that afternoon and adjusted it after students responded.”</p></article></div><p class="qa-teacher">What is similar? What differs? Which account challenges an easy claim that peer support is always necessary?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>三位教師，一個問題</h2><p class="qa-question"><strong>問題：</strong>教師在嘗試新的回饋工具時如何建立信心？</p><div class="qa-excerpts"><article><b>T1</b><p>「工作坊示範了按鈕，但直到美坐在我旁邊，用她班上的例子教我，我才真正試用。」</p></article><article><b>T2</b><p>「我看了兩次錄影，仍然問同事我的回饋是否恰當。」</p></article><article><b>T3</b><p>「培訓給了我可用的步驟。我當天下午就試用，並根據學生的反應作出調整。」</p></article></div><p class="qa-teacher">哪些地方相似？哪些不同？哪一個敘述挑戰了「一定需要同儕支援」的簡單說法？</p></div></div></section>

    <section class="slide" data-title="Code the segments" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Activity 2 · choose and justify</span></header><div data-language="en"><h2>Which code earns its place?</h2><p>For T1’s “Mei sat beside me and showed me her class example”, choose a code that stays close to the action yet contributes to the question.</p><div class="qa-quiz" data-qa-quiz data-answer="code"><button type="button" data-choice="topic">Technology</button><button type="button" data-choice="code">Learning through peer modelling</button><button type="button" data-choice="theme">Teachers always need colleagues</button><p role="status" data-feedback hidden></p></div><label class="qa-write">Write another possible code and explain the difference.<textarea data-save="alternate-code" rows="3" placeholder="My code…"></textarea></label><p class="qa-teacher">What would you code in T2? Should T3 receive the same code? Why?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>哪個代碼最有根據？</h2><p>對T1的「美坐在我旁邊，用她班上的例子教我」，選擇貼近行動、又有助回答問題的代碼。</p><div class="qa-quiz" data-qa-quiz data-answer="code"><button type="button" data-choice="topic">科技</button><button type="button" data-choice="code">透過同儕示範學習</button><button type="button" data-choice="theme">教師總是需要同事</button><p role="status" data-feedback hidden></p></div><label class="qa-write">寫出另一個可行代碼，解釋其差別。<textarea data-save="alternate-code-zh" rows="3" placeholder="我的代碼……"></textarea></label><p class="qa-teacher">你會如何編碼T2？T3應否使用同一個代碼？為甚麼？</p></div></div></section>

    <section class="slide" data-title="Topic versus theme" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Activity 3 · claim check</span></header><div data-language="en"><h2>A topic names the area. A theme says something about it.</h2><div class="qa-compare"><article><small>Topic heading</small><h3>Teacher training</h3><p>Tells us what the material concerns.</p></article><article><small>Candidate interpretive theme</small><h3>Confidence depends on usable guidance, whether formal or peer-led.</h3><p>Connects T1–T3 around a central idea while leaving room for different routes.</p></article></div><div class="qa-quiz" data-qa-quiz data-answer="b"><p>Which further evidence would most strengthen the candidate theme?</p><button type="button" data-choice="a">The number of times “training” appears</button><button type="button" data-choice="b">More accounts showing how guidance was used and when it was insufficient</button><button type="button" data-choice="c">A quotation from T1 repeated three times</button><p role="status" data-feedback hidden></p></div><p class="qa-teacher">Does the claim overreach? How would T3 change your wording?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>話題指出領域；主題提出對該領域的理解。</h2><div class="qa-compare"><article><small>話題標題</small><h3>教師培訓</h3><p>說明資料談及甚麼。</p></article><article><small>候選詮釋主題</small><h3>無論來自正式培訓或同儕，有用的指引都可能建立信心。</h3><p>以一個核心概念連繫T1至T3，同時容納不同途徑。</p></article></div><div class="qa-quiz" data-qa-quiz data-answer="b"><p>哪類補充證據最能加強這個候選主題？</p><button type="button" data-choice="a">「培訓」一詞出現的次數</button><button type="button" data-choice="b">更多關於如何使用指引及何時不足的敘述</button><button type="button" data-choice="c">把T1的同一引文重複三次</button><p role="status" data-feedback hidden></p></div><p class="qa-teacher">這項主張有否超出證據？T3會如何改變你的措辭？</p></div></div></section>

    <section class="slide" data-title="Analytic trail" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Evidence trail</span></header><div data-language="en"><h2>Keep each inference inspectable</h2><div class="qa-trail"><span>Source excerpt<br /><b>T1, T2, T3</b></span><span>Meaningful segments<br /><b>What is happening?</b></span><span>Initial codes<br /><b>Short labels</b></span><span>Categories or patterns<br /><b>Compare cases</b></span><span>Candidate theme / account<br /><b>What does it mean?</b></span><span>Finding<br /><b>Claim + evidence + limits</b></span></div><p class="qa-note">Use this evidence trail to connect your interpretations to the data. Adapt the analytic steps to your chosen method. Reflexive thematic analysis is recursive; grounded theory, narrative analysis, discourse analysis and IPA make different analytic moves.</p><p class="qa-teacher">Which step involves the greatest interpretation, and how would you justify it using the data?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>讓每一步推論可供檢視</h2><div class="qa-trail"><span>來源片段<br /><b>T1、T2、T3</b></span><span>有意義的片段<br /><b>正在發生甚麼？</b></span><span>初始代碼<br /><b>簡短標籤</b></span><span>類別或模式<br /><b>比較個案</b></span><span>候選主題／敘述<br /><b>它有甚麼意義？</b></span><span>研究發現<br /><b>主張＋證據＋界限</b></span></div><p class="qa-note">運用這條證據鏈，把你的詮釋與資料連繫起來，並按所選方法調整分析步驟。反思性主題分析會反覆往返；紮根理論、敘事分析、話語分析及IPA的分析步驟亦各有不同。</p><p class="qa-teacher">哪一步涉及最多詮釋？你會如何用資料支持這項決定？</p></div></div></section>

    <section class="slide" data-title="Coding, displays and software" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Analytic supports · compare three tools</span></header><div data-language="en"><h2>What helps the researcher think?</h2><div class="qa-method"><article><small>Saldaña (2021)</small><h3>Coding as a heuristic</h3><p>Codes can be revised and grouped into categories. Ask whether a proposed “theme” is only a topic heading.</p></article><article><small>Miles, Huberman &amp; Saldaña (2014)</small><h3>Display the data</h3><p>Matrices and networks make comparisons and exceptions visible; conclusions still need checking.</p></article><article><small>Lewins &amp; Silver (2007); Mortelmans (2024)</small><h3>Use software purposefully</h3><p>CAQDAS/NVivo can organise, retrieve and display material. The researcher chooses units, labels and interpretations.</p></article></div><p class="qa-teacher">If software returns every excerpt coded “support”, what analytic question must you still answer?</p><p class="qa-source">References: <em>The Coding Manual</em>, ch. 1; <em>Qualitative Data Analysis</em>, chs. 4–5, 11; <em>Using Software in Qualitative Research</em>, chs. 1, 5–6; <em>Doing Qualitative Data Analysis with NVivo</em>.</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>甚麼能幫助研究者思考？</h2><div class="qa-method"><article><small>Saldaña（2021）</small><h3>以編碼探索</h3><p>代碼可以修訂並組成類別。檢查所謂「主題」是否只是話題標題。</p></article><article><small>Miles、Huberman與Saldaña（2014）</small><h3>展示資料</h3><p>矩陣與網絡可呈現比較和例外；結論仍須檢驗。</p></article><article><small>Lewins與Silver（2007）；Mortelmans（2024）</small><h3>有目的地使用軟件</h3><p>CAQDAS/NVivo能整理、檢索及展示資料；分析單位、標籤和詮釋由研究者決定。</p></article></div><p class="qa-teacher">若軟件找出所有標為「支援」的片段，你仍須回答甚麼分析問題？</p><p class="qa-source">參考文獻：《The Coding Manual》第1章；《Qualitative Data Analysis》第4–5、11章；《Using Software in Qualitative Research》第1、5–6章；《Doing Qualitative Data Analysis with NVivo》。</p></div></div></section>

    <section class="slide" data-title="Choose an analytic aim" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Method atlas · start with the intended answer</span></header><div data-language="en"><h2>Which kind of answer do you need?</h2><div class="qa-aim-grid"><article><b>Describe content</b><p>What kinds of messages or practices appear?</p><small>Content analysis</small></article><article><b>Interpret patterns</b><p>What shared meanings organise accounts?</p><small>Thematic / framework analysis</small></article><article><b>Explain a process</b><p>How does something develop through action?</p><small>Grounded theory</small></article><article><b>Study stories or language</b><p>How is experience narrated or a position constructed?</p><small>Narrative / discourse analysis</small></article></div><p class="qa-teacher">What data would each question require? Which choice would change your interview or document selection?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>你需要哪一類答案？</h2><div class="qa-aim-grid"><article><b>描述內容</b><p>出現哪些訊息或做法？</p><small>內容分析</small></article><article><b>詮釋模式</b><p>哪些共同意義統整敘述？</p><small>主題分析或框架分析</small></article><article><b>解釋過程</b><p>某現象如何透過行動逐步發展？</p><small>紮根理論</small></article><article><b>分析故事或語言</b><p>經驗如何被講述？角色如何被建構？</p><small>敘事／話語分析</small></article></div><p class="qa-teacher">各問題需要哪些資料？哪項選擇會改變訪談或文件的選取？</p></div></div></section>

    <section class="slide" data-title="Explore qualitative analysis methods" aria-hidden="true"><div class="slide-inner">
      <header class="slide-header"><span class="eyebrow">Method map · open → explore → question</span></header>
      <div data-language="en"><h2>Explore qualitative analysis methods</h2><p>Open a method card to explore its purpose, practical steps, possible outputs and questions to ask AI. Start with thematic analysis to compare its varieties and practise with the texts included in this slide.</p><QualitativeMethodExplorer language="en" /></div>
      <div data-language="zh" hidden lang="zh-Hant"><h2>探索質性資料分析方法</h2><p>打開方法卡，探索其目的、步驟、可能成果及可向AI提出的問題。先從主題分析開始，比較其取向，並用本頁的文本練習。</p><QualitativeMethodExplorer language="zh" /></div>
    </div></section>

    <section class="slide" data-title="Method selection clinic" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Activity 4 · match → explain → compare</span></header>
        <div data-language="en">
          <h2>Which method fits the question?</h2>
          <p>Match all 10 scenarios to the best-fitting method for the stated aim. Methods may be used more than once. Explain your choice before checking; use “Mix order” to practise again.</p>
          <div class="qa-scenarios" data-qa-scenarios>
            {scenarios.map((scenario, index) => <label data-scenario-id={scenario.id}>
              <b data-case-number>Case {index + 1}</b><span>{scenario.en}</span>
              <select data-answer={scenario.answer} data-why={scenario.why}>
                <option value="">Choose a method…</option>
                {matchingOptions(index).map((option) => <option value={option.value}>{option.en}</option>)}
              </select><small data-case-feedback></small>
            </label>)}
          </div>
          <div class="qa-scenario-actions"><button class="qa-action" type="button" data-check-scenarios="en">Check and explain</button><button class="qa-action" type="button" data-shuffle-scenarios>Mix order</button></div>
          <p data-scenario-result role="status"></p>
          <p class="qa-teacher">Choose two scenarios using the same method. What makes that method appropriate in both? Rewrite one research question so that another method would fit better.</p>
        </div>
        <div data-language="zh" hidden lang="zh-Hant">
          <h2>哪種方法與研究問題相配？</h2>
          <p>為10個情境配對最符合所述目標的方法。同一方法可以使用多次。檢查前先解釋理由；按「打亂次序」可再次練習。</p>
          <div class="qa-scenarios" data-qa-scenarios>
            {scenarios.map((scenario, index) => <label data-scenario-id={scenario.id}>
              <b data-case-number>情境 {index + 1}</b><span>{scenario.zh}</span>
              <select data-answer={scenario.answer} data-why={scenario.whyZh}>
                <option value="">選擇方法……</option>
                {matchingOptions(index).map((option) => <option value={option.value}>{option.zh}</option>)}
              </select><small data-case-feedback></small>
            </label>)}
          </div>
          <div class="qa-scenario-actions"><button class="qa-action" type="button" data-check-scenarios="zh">檢查並解釋</button><button class="qa-action" type="button" data-shuffle-scenarios>打亂次序</button></div>
          <p data-scenario-result role="status"></p>
          <p class="qa-teacher">選兩個使用同一方法的情境。該方法為何適合兩者？改寫其中一個研究問題，使另一種方法更合適。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Same data, different lenses" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Activity 5 · switch lenses</span></header><div data-language="en"><h2>Three readings of one excerpt</h2><p>Return to T1. Select a lens and predict what the analyst would look for before revealing the prompt.</p><div class="qa-lenses" data-qa-lenses><div role="group" aria-label="Analysis lens"><button type="button" data-lens="thematic" aria-pressed="true">Thematic</button><button type="button" data-lens="content" aria-pressed="false">Content</button><button type="button" data-lens="discourse" aria-pressed="false">Discourse</button></div><p data-lens-output role="status">How does peer demonstration contribute to confidence across T1–T3?</p></div><p class="qa-teacher">Which lens best fits the original research question? What new question would make another lens preferable?</p></div><div data-language="zh" hidden lang="zh-Hant"><h2>同一片段的三種讀法</h2><p>回到T1。選擇分析視角，在提示出現前先預測分析者會關注甚麼。</p><div class="qa-lenses" data-qa-lenses><div role="group" aria-label="分析視角"><button type="button" data-lens="thematic" aria-pressed="true">主題分析</button><button type="button" data-lens="content" aria-pressed="false">內容分析</button><button type="button" data-lens="discourse" aria-pressed="false">話語分析</button></div><p data-lens-output role="status">在T1至T3之中，同儕示範如何促成信心？</p></div><p class="qa-teacher">哪種視角最適合原來的研究問題？改成甚麼問題後，另一種視角會更合適？</p></div></div></section>

    <section class="slide" data-title="Reporting an analysis" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Reporting · method before findings</span></header><div data-language="en"><h2>Make your analytic process transparent</h2><ol class="qa-steps"><li><b>1</b><span>Name the analytic approach and why it fits the question and data.</span></li><li><b>2</b><span>Describe the data, unit of analysis, analysts and their relevant positioning.</span></li><li><b>3</b><span>Explain the actual steps: coding or another procedure, comparison, revisions and exceptions.</span></li><li><b>4</b><span>Report how each finding is grounded in excerpts, context and a bounded claim.</span></li></ol><p class="qa-note">Use the target journal’s instructions. APA JARS–Qual is a useful reporting prompt across qualitative traditions, not a replacement for method-specific reasoning.</p><p class="qa-source"><a href="https://apastyle.apa.org/jars" target="_blank" rel="noopener noreferrer">APA JARS–Qual ↗</a></p></div><div data-language="zh" hidden lang="zh-Hant"><h2>清楚交代你的分析過程</h2><ol class="qa-steps"><li><b>1</b><span>說明分析方法及其與問題和資料的契合理由。</span></li><li><b>2</b><span>交代資料、分析單位、分析者及相關研究者定位。</span></li><li><b>3</b><span>解釋實際步驟：編碼或其他程序、比較、修訂及例外情況。</span></li><li><b>4</b><span>以片段、語境及有界限的主張支持每項發現。</span></li></ol><p class="qa-note">遵循目標期刊要求。APA JARS–Qual可作報告提示，但不能代替各方法所需的分析推理。</p><p class="qa-source"><a href="https://apastyle.apa.org/jars" target="_blank" rel="noopener noreferrer">APA JARS–Qual ↗</a></p></div></div></section>


    <section class="slide" data-title="Sources and close" aria-hidden="true"><div class="slide-inner"><header class="slide-header"><span class="eyebrow">Exit · further reading</span></header><div data-language="en"><h2>Carry one distinction into your next analysis</h2><p class="lead small">A code labels a segment. A category groups codes. A topic names an area. An interpretive theme explains a pattern of meaning in relation to a question.</p><p class="qa-teacher">Name one method, the question it answers, and the form its finding would take.</p><div class="qa-source-grid"><a href="https://doi.org/10.1191/1478088706qp063oa" target="_blank" rel="noopener noreferrer">Braun &amp; Clarke · thematic analysis ↗</a><a href="https://doi.org/10.1177/160940690600500107" target="_blank" rel="noopener noreferrer">Fereday &amp; Muir-Cochrane · hybrid thematic analysis ↗</a><a href="https://doi.org/10.1177/1049732305276687" target="_blank" rel="noopener noreferrer">Hsieh &amp; Shannon · content analysis ↗</a><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC3848812/" target="_blank" rel="noopener noreferrer">Gale et al. · framework method ↗</a><a href="https://apastyle.apa.org/jars" target="_blank" rel="noopener noreferrer">APA JARS–Qual · reporting ↗</a></div><p class="qa-source">Course overviews: Cohen, Manion &amp; Morrison (2018), <em>Research Methods in Education</em>; Denzin &amp; Lincoln (2018), <em>The SAGE Handbook of Qualitative Research</em>.</p><a class="qa-return" href={courseHref}>Back to DEDC02 course materials →</a></div><div data-language="zh" hidden lang="zh-Hant"><h2>帶走一個清楚的區分</h2><p class="lead small">代碼標記片段；類別組合代碼；話題指出領域；詮釋性主題則回應研究問題，解釋意義模式。</p><p class="qa-teacher">說出一種方法、它能回答的問題，以及可能形成的研究發現。</p><div class="qa-source-grid"><a href="https://doi.org/10.1191/1478088706qp063oa" target="_blank" rel="noopener noreferrer">Braun與Clarke · 主題分析 ↗</a><a href="https://doi.org/10.1177/160940690600500107" target="_blank" rel="noopener noreferrer">Fereday與Muir-Cochrane · 混合式主題分析 ↗</a><a href="https://doi.org/10.1177/1049732305276687" target="_blank" rel="noopener noreferrer">Hsieh與Shannon · 內容分析 ↗</a><a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC3848812/" target="_blank" rel="noopener noreferrer">Gale等 · 框架分析 ↗</a><a href="https://apastyle.apa.org/jars" target="_blank" rel="noopener noreferrer">APA JARS–Qual · 報告 ↗</a></div><p class="qa-source">課程綜覽讀物：Cohen、Manion與Morrison（2018），<em>Research Methods in Education</em>；Denzin與Lincoln（2018），<em>The SAGE Handbook of Qualitative Research</em>。</p><a class="qa-return" href={courseHref}>返回DEDC02課程材料 →</a></div></div></section>
