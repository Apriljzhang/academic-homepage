              <button type="button" draggable="true" data-role-chip="latent-variable" data-label="Latent Variable">Latent Variable</button>
            </div>
            <div class="relationship-canvas-grid">
              <article class="relationship-canvas-card" data-model-card>
                <h3>Direct relationship <span>Regression / path analysis</span></h3>
                <figure class="map-figure"><div class="map-canvas direct-canvas" aria-label="Blank observed-variable rectangle points directly to another blank observed-variable rectangle.">
                  <button type="button" class="map-shape map-box role-slot" data-answer="independent-x" data-placeholder="" data-empty-label="Blank rectangle at the start of a direct path" data-explanation="Independent Variable / X begins a directional path: it is the presumed cause or predictor."></button>
