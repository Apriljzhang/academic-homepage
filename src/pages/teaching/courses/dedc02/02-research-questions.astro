  .compact-timer { display: flex; min-height: 2.55rem; align-items: center; gap: .2rem; border: 1px solid var(--line); border-radius: 999px; padding: .15rem .3rem .15rem .65rem; background: rgba(255,255,255,.97); box-shadow: 0 .35rem 1rem rgba(15,74,50,.08); }
