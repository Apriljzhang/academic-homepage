                  <button type="button" class="map-shape map-box role-slot mediation-m" data-answer="mediator-m" data-placeholder="" data-empty-label="Blank rectangle between the first and last variables" data-explanation="Mediator / M sits between X and Y: it explains the pathway through which X may relate to Y."></button>
                  <span class="canvas-arrow mediation-b" aria-hidden="true"></span>
                  <button type="button" class="map-shape map-box role-slot mediation-y" data-answer="dependent-y" data-placeholder="" data-empty-label="Blank rectangle at the end of an indirect path" data-explanation="Dependent Variable / Y is the outcome at the end of the mediated pathway."></button>
                  <span class="mediation-direct" aria-hidden="true"></span>
                </div><figcaption>A pathway plus a direct path.</figcaption></figure>
                <p class="map-slot-explanation" data-model-slot-explanation data-default="After checking, click a filled shape to see its role." aria-live="polite">After checking, click a filled shape to see its role.</p>
