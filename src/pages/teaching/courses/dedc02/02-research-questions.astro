---
import CourseSlideLayout from '../../../../layouts/CourseSlideLayout.astro';
import { withBase } from '../../../../utils/paths';

const title = '2. Research Questions, Hypotheses and Variables · DEDC02';
const description = 'An interactive lesson that builds a research question, hypothesis, variables and literature search through one AI-literacy case.';
const courseHref = withBase('/teaching/courses/dedc02');
const comicHref = withBase('/teaching/courses/dedc02/the-claus-hypothesis.png');
const correlationComicHref = withBase('/teaching/courses/dedc02/xkcd-correlation.png');
---

<CourseSlideLayout {title} {description}>
  <section class="pdf-cover" aria-hidden="true">
    <span class="eyebrow">DEDC02 · Advanced Research Method · Orientation</span>
    <h1>Research<br />Questions</h1>
    <div class="pdf-message-block">
      <h2>Personal message</h2>
      <p data-pdf-message-print></p>
    </div>
  </section>

  <div class="top-tools" aria-label="Language and timer controls">
    <button class="translate-button global-translate" type="button" aria-pressed="false" data-global-translate>中文</button>
    <div class="compact-timer" aria-label="Activity timer">
      <input type="number" min="0.1" step="0.5" inputmode="decimal" placeholder="min" aria-label="Timer minutes" data-timer-minutes />
      <output data-timer-output hidden aria-live="polite">00:00</output>
      <button type="button" data-timer-start>Start</button>
      <button type="button" class="timer-reset-button" data-timer-reset aria-label="Reset timer">↻</button>
      <span class="visually-hidden" data-timer-status role="status" aria-live="assertive"></span>
    </div>
  </div>

  <main class="deck" aria-label="Research Questions slide deck">
    <section class="slide is-active" data-title="Orientation · Research questions, hypotheses and variables" aria-hidden="false">
      <div class="slide-inner title-slide">
        <header class="slide-header title-header">
          <span class="eyebrow">DEDC02 · Advanced Research Method · Orientation</span>
          <button class="translate-button" type="button" aria-pressed="false">中文</button>
        </header>
        <div class="title-rule"></div>
        <div class="language-panel" data-language="en">
          <h1>Research<br />Questions</h1>
          <p class="lead">Build from a research question to hypotheses, variables and literature-search terms through one AI-literacy case.</p>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h1>研究<br />問題</h1>
          <p class="lead">透過一個人工智能素養案例，從研究問題逐步建立假設、變量和文獻檢索詞。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Orientation · Learning aims" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Orientation</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>By the end, you can…</h2>
          <ol class="number-list">
            <li><span><strong>Frame</strong> a focused research problem and question.</span></li>
            <li><span><strong>Distinguish</strong> research questions from hypotheses and choose a claim type.</span></li>
            <li><span><strong>Operationalise and relate</strong> variables.</span></li>
            <li><span><strong>Build</strong> literature-search terms from a topic, question or hypothesis, and variables.</span></li>
          </ol>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>完成本課後，你可以⋯⋯</h2>
          <ol class="number-list">
            <li><span><strong>建構</strong>聚焦的研究課題與研究問題。</span></li>
            <li><span><strong>區分</strong>研究問題與假設，並選擇主張類型。</span></li>
            <li><span><strong>操作化並連結</strong>變量。</span></li>
            <li><span><strong>從</strong>主題、研究問題或假設及變量建立文獻檢索詞。</span></li>
          </ol>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Instruction · Research questions and paradigms" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Instruction</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Research questions and paradigm</h2>
          <p class="lead">How different research paradigms shape research questions for the same topic:</p>
          <blockquote>“Structured AI-literacy instruction, guided AI practice and AI-literacy scores in digital education”</blockquote>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>研究問題與研究範式</h2>
          <p class="lead">不同的研究範式如何塑造同一主題的研究問題：</p>
          <blockquote>「數字教育中的結構化人工智能素養教學、引導式人工智能實作與人工智能素養分數」</blockquote>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Example · Paradigms applied to AI literacy" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Example</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Three paradigms, one topic</h2>
          <div class="paradigm-three">
            <article><h3>Positivism</h3><p class="focus">Measurable, observable, causal relationships</p><p>To what extent does structured AI-literacy instruction predict AI-literacy scores through guided AI practice?</p></article>
            <article><h3>Constructivism</h3><p class="focus">Learners’ meaning-making, multiple realities</p><p>How do students make sense of structured AI-literacy instruction and guided AI practice in a digital education course?</p></article>
            <article><h3>Pragmatism</h3><p class="focus">Practical outcomes, mixed methods</p><p>How can evidence about AI-literacy scores and students’ experiences of guided AI practice improve a structured AI-literacy module?</p></article>
          </div>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>三種研究範式，同一主題</h2>
          <div class="paradigm-three">
            <article><h3>實證主義</h3><p class="focus">可測量、可觀察、因果關係</p><p>結構化人工智能素養教學在多大程度上透過引導式人工智能實作預測人工智能素養分數？</p></article>
            <article><h3>建構主義</h3><p class="focus">學習者的意義建構、多重現實</p><p>學生如何在數字教育課程中理解結構化人工智能素養教學與引導式人工智能實作？</p></article>
            <article><h3>實用主義</h3><p class="focus">實際結果、混合方法</p><p>如何結合人工智能素養分數與學生對引導式人工智能實作的經驗，以改進結構化人工智能素養單元？</p></article>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="How-to · Identify a research problem and check the topic" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">How-to</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Research problem</h2>
          <p class="intro-line">Use the shared case: it is unclear whether structured AI-literacy instruction creates enough guided AI practice to improve students’ AI-literacy scores. To locate a research problem in any study, ask:</p>
          <ul class="source-list">
            <li>What was the issue, problem or controversy that the researcher wanted to address?</li>
            <li>What controversy leads to a need for this study?</li>
            <li>What was the concern being addressed “behind” this study?</li>
            <li>Is there a sentence like “The problem addressed in this study is…”?</li>
          </ul>
          <section class="topic-check-section">
            <h3>Topics to avoid</h3>
            <div class="avoid-grid">
              <details><summary>Too big</summary><p>Do not try to design, deliver and evaluate one AI-literacy curriculum across every age group, discipline, platform and outcome. Ask whether your time, experience and resources match the scope.</p></details>
              <details><summary>Too trivial</summary><p>Ask whether the results matter beyond yourself. Whether three students prefer one AI tool may yield little value; examining how structured instruction, guided practice and access to devices relate to AI-literacy scores has a clearer contribution.</p></details>
              <details><summary>Lacking in resource materials</summary><p>Look for warning signs: very few references to the proposed AI-literacy construct, instructional approach or measure in textbooks, practitioner journals, refereed journals or credible websites.</p></details>
              <details><summary>Lacking in sponsorship</summary><p>Secure support from course leaders, instructors and the people responsible for students’ access to AI tools and devices before planning the study.</p></details>
              <details><summary>Intractable</summary><p>Be suspicious of a promise to solve every ethical, pedagogical and assessment problem created by AI. Ask what one feasible study can genuinely address.</p></details>
            </div>
          </section>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>研究課題</h2>
          <p class="intro-line">使用貫穿案例：目前尚不清楚結構化人工智能素養教學是否能帶來足夠的引導式人工智能實作，從而提升學生的人工智能素養分數。要找出任何研究中的研究課題，請問自己：</p>
          <ul class="source-list">
            <li>研究者想要處理的議題、問題或爭議是甚麼？</li>
            <li>甚麼爭議導致需要進行這項研究？</li>
            <li>這項研究「背後」正在處理的關注是甚麼？</li>
            <li>文中是否有一句類似「本研究處理的問題是……」？</li>
          </ul>
          <section class="topic-check-section">
            <h3>應避免的主題</h3>
            <div class="avoid-grid">
              <details><summary>範圍太大</summary><p>不要試圖為所有年齡層、學科、平台和結果設計、實施並評估一套人工智能素養課程。問自己時間、經驗與資源是否與研究範圍相稱。</p></details>
              <details><summary>過於瑣碎</summary><p>問自己研究結果是否對他人也有意義，而不只對自己有意義。研究三名學生是否偏好某一人工智能工具，可能價值有限；探討結構化教學、引導式實作與裝置使用機會如何連結人工智能素養分數，則有更清晰的貢獻。</p></details>
              <details><summary>缺乏資源材料</summary><p>留意警號：主要教科書、實務期刊、同儕評審期刊或可靠網站中，極少提到所提出的人工智能素養構念、教學方法或測量方式。</p></details>
              <details><summary>缺乏贊助</summary><p>規劃研究前，先取得課程負責人、教師，以及負責學生使用人工智能工具和裝置的人士的支持。</p></details>
              <details><summary>棘手的問題</summary><p>對「解決人工智能帶來的所有倫理、教學和評核問題」這類承諾保持懷疑。問自己一項可行研究真正能處理甚麼。</p></details>
            </div>
          </section>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Activity · Build your research chain" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Activity</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Building up your research</h2>
          <p class="activity-prompt"><strong>Your turn:</strong> use your own study to draft a topic, problem, purpose and research question. Your wording will reappear in a later activity, where you can revise it.</p>
          <div class="build-form" data-build-examples>
            <div class="build-field">
              <button type="button" class="build-label" data-build-example-toggle="topic-example" aria-expanded="false" aria-controls="topic-example">Topic</button>
              <div class="build-entry">
                <label class="visually-hidden" for="build-topic">Topic</label>
                <textarea id="build-topic" data-save="topic" placeholder="The broad subject matter addressed by the study."></textarea>
                <p class="build-example" id="topic-example" hidden><strong>Example:</strong> AI literacy in digital education.</p>
              </div>
            </div>
            <div class="build-field">
              <button type="button" class="build-label" data-build-example-toggle="problem-example" aria-expanded="false" aria-controls="problem-example">Problem</button>
              <div class="build-entry">
                <label class="visually-hidden" for="build-problem">Problem</label>
                <textarea id="build-problem" data-save="problem" placeholder="A general educational issue, concern, or controversy addressed in research that narrows the topic."></textarea>
                <p class="build-example" id="problem-example" hidden><strong>Example:</strong> It is unclear whether structured AI-literacy instruction creates enough guided AI practice to improve students’ AI-literacy scores.</p>
              </div>
            </div>
            <div class="build-field">
              <button type="button" class="build-label" data-build-example-toggle="purpose-example" aria-expanded="false" aria-controls="purpose-example">Purpose</button>
              <div class="build-entry">
                <label class="visually-hidden" for="build-purpose">Purpose</label>
                <textarea id="build-purpose" data-save="purpose" placeholder="The major intent or objective of the study used to address the problem."></textarea>
                <p class="build-example" id="purpose-example" hidden><strong>Example:</strong> To examine how structured AI-literacy instruction, guided AI practice and AI-literacy scores are related among first-year undergraduates.</p>
              </div>
            </div>
            <div class="build-field">
              <button type="button" class="build-label" data-build-example-toggle="question-example" aria-expanded="false" aria-controls="question-example">Question</button>
              <div class="build-entry">
                <label class="visually-hidden" for="build-question">Question</label>
                <textarea id="build-question" data-save="question" placeholder="Research questions narrow the purpose into specific questions that the researcher would like answered or addressed in the study."></textarea>
                <p class="build-example" id="question-example" hidden><strong>Example:</strong> Among first-year undergraduates, does structured AI-literacy instruction improve AI-literacy scores through guided AI practice, after considering prior AI experience and access to devices?</p>
              </div>
            </div>
          </div>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>逐步建立你的研究</h2>
          <p class="activity-prompt"><strong>輪到你：</strong>以自己的研究為例，草擬主題、研究課題、研究目的和研究問題。你的文字會在後面的活動再次出現，供你修訂。</p>
          <div class="build-form" data-build-examples>
            <div class="build-field">
              <button type="button" class="build-label" data-build-example-toggle="topic-example-zh" aria-expanded="false" aria-controls="topic-example-zh">主題</button>
              <div class="build-entry">
                <label class="visually-hidden" for="build-topic-zh">主題</label>
                <textarea id="build-topic-zh" data-save="topic-zh" placeholder="研究涉及的廣泛主題"></textarea>
                <p class="build-example" id="topic-example-zh" hidden><strong>例子：</strong>數字教育中的人工智能素養。</p>
              </div>
            </div>
            <div class="build-field">
              <button type="button" class="build-label" data-build-example-toggle="problem-example-zh" aria-expanded="false" aria-controls="problem-example-zh">研究課題</button>
              <div class="build-entry">
                <label class="visually-hidden" for="build-problem-zh">研究課題</label>
                <textarea id="build-problem-zh" data-save="problem-zh" placeholder="在縮小主題範圍的研究中解決的一般教育問題、關注點或爭議"></textarea>
                <p class="build-example" id="problem-example-zh" hidden><strong>例子：</strong>目前尚不清楚結構化人工智能素養教學是否能帶來足夠的引導式人工智能實作，從而提升學生的人工智能素養分數。</p>
              </div>
            </div>
            <div class="build-field">
              <button type="button" class="build-label" data-build-example-toggle="purpose-example-zh" aria-expanded="false" aria-controls="purpose-example-zh">研究目的</button>
              <div class="build-entry">
                <label class="visually-hidden" for="build-purpose-zh">研究目的</label>
                <textarea id="build-purpose-zh" data-save="purpose-zh" placeholder="用於解決問題的研究的主要意圖或目標"></textarea>
                <p class="build-example" id="purpose-example-zh" hidden><strong>例子：</strong>探討一年級本科生的結構化人工智能素養教學、引導式人工智能實作與人工智能素養分數如何相關。</p>
              </div>
            </div>
            <div class="build-field">
              <button type="button" class="build-label" data-build-example-toggle="question-example-zh" aria-expanded="false" aria-controls="question-example-zh">研究問題</button>
              <div class="build-entry">
                <label class="visually-hidden" for="build-question-zh">研究問題</label>
                <textarea id="build-question-zh" data-save="question-zh" placeholder="研究問題將目的縮小到研究人員希望在研究中回答或解決的特定問題"></textarea>
                <p class="build-example" id="question-example-zh" hidden><strong>例子：</strong>在一年級本科生中，考慮先前人工智能經驗與裝置使用機會後，結構化人工智能素養教學是否透過引導式人工智能實作提升人工智能素養分數？</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Activity · Narrow a question with PICO" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Activity</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Narrow a question with PICO</h2>
          <div class="narrowing-activity">
            <ul class="source-list compact-list">
              <li><strong>Primary topic:</strong> AI Literacy in Digital Education</li>
              <li><strong>Study path:</strong> structured AI-literacy instruction → guided AI practice → AI-literacy score</li>
              <li><strong>Additional variables:</strong> prior AI experience and access to devices</li>
            </ul>
            <div class="pico-guides">
              <article><span class="pico-label">P</span><h3>Population</h3><p>Who is the study relevant to? <strong>Example:</strong> first-year undergraduates in a digital education course.</p></article>
              <article><span class="pico-label">I</span><h3>Intervention</h3><p>What programme is examined? <strong>Example:</strong> a four-week structured AI-literacy module.</p></article>
              <article><span class="pico-label">C</span><h3>Comparator</h3><p>What will it be compared with? <strong>Example:</strong> usual course activity without the module.</p></article>
              <article><span class="pico-label">O</span><h3>Outcome</h3><p>What is expected to change? <strong>Example:</strong> post-module AI-literacy questionnaire scores.</p></article>
            </div>
            <div class="pico-next-step">
              <aside class="devising-panel">
                <h3>Devise the question</h3>
                <p>Research questions are not the start of the research; they usually stem from its purpose, objectives and design.</p>
                <p class="starter-label">Start with:</p>
                <div class="word-line"><span>what</span><span>what if</span><span>who</span><span>when</span><span>where</span><span>which</span><span>whence</span><span>whither</span><span>why</span><span>how</span></div>
              </aside>
              <p class="pico-question"><strong>Worked example:</strong> Among first-year undergraduates, does a four-week structured AI-literacy module, compared with usual course activity, improve AI-literacy scores?</p>
            </div>
          </div>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>以 PICO 收窄研究問題</h2>
          <div class="narrowing-activity">
            <ul class="source-list compact-list">
              <li><strong>貫穿主題：</strong>數字教育中的人工智能素養</li>
              <li><strong>研究路徑：</strong>結構化人工智能素養教學 → 引導式人工智能實作 → 人工智能素養分數</li>
              <li><strong>附加變量：</strong>先前使用人工智能的經驗及裝置使用機會</li>
            </ul>
            <div class="pico-guides">
              <article><span class="pico-label">P</span><h3>研究對象</h3><p>研究與誰相關？<strong>例：</strong>修讀數字教育課程的一年級本科生。</p></article>
              <article><span class="pico-label">I</span><h3>干預</h3><p>研究哪一種方案？<strong>例：</strong>為期四週的結構化人工智能素養單元。</p></article>
              <article><span class="pico-label">C</span><h3>比較／對照</h3><p>與甚麼比較？<strong>例：</strong>沒有該單元的一般課程活動。</p></article>
              <article><span class="pico-label">O</span><h3>結果</h3><p>預期會改變的是甚麼？<strong>例：</strong>單元後的人工智能素養問卷分數。</p></article>
            </div>
            <div class="pico-next-step">
              <aside class="devising-panel">
                <h3>擬定問題</h3>
                <p>研究問題不是研究的開始；通常源於研究目的、目標與設計。</p>
                <p class="starter-label">可從以下開頭：</p>
                <div class="word-line"><span>甚麼</span><span>如果</span><span>誰</span><span>何時</span><span>何地</span><span>哪一個</span><span>從何而來</span><span>去往何方</span><span>為甚麼</span><span>如何</span></div>
              </aside>
              <p class="pico-question"><strong>貫穿例子：</strong>在一年級本科生中，與一般課程活動相比，為期四週的結構化人工智能素養單元能否提高人工智能素養分數？</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Instruction · Types and questions to avoid" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Instruction</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Types of research questions</h2>
          <div class="type-grid">
            <details><summary>Descriptive</summary><p>What is happening? Describe facts, patterns or situations. <strong>Example:</strong> What AI-literacy scores do first-year undergraduates report before the module?</p></details>
            <details><summary>Exploratory</summary><p>What might be going on? Explore under-researched or new areas. <strong>Example:</strong> How do students describe guided AI practice during the module?</p></details>
            <details><summary>Explanatory</summary><p>Why or how does this happen? Identify causes, mechanisms or relationships. <strong>Example:</strong> How might guided AI practice explain the link between instruction and AI-literacy scores?</p></details>
            <details><summary>Comparative</summary><p>How do groups, contexts or interventions differ? <strong>Example:</strong> Do students receiving structured instruction differ in AI-literacy scores from those receiving usual activity?</p></details>
            <details><summary>Predictive</summary><p>What will happen? Forecast outcomes based on variables. <strong>Example:</strong> Do prior AI experience and access to devices predict AI-literacy scores?</p></details>
            <details><summary>Evaluative</summary><p>How effective is this? Assess quality, impact or success. <strong>Example:</strong> How effective is the module in improving AI-literacy scores?</p></details>
            <details><summary>Development-related</summary><p>How can we create or improve something? Focus on innovation/design. <strong>Example:</strong> How can guided AI practice be redesigned to support ethical AI use?</p></details>
            <details><summary>Normative</summary><p>What should be? Address values, ethics or policy. <strong>Example:</strong> What ethical AI-literacy outcomes should a digital education module prioritise?</p></details>
            <details><summary>Emancipatory</summary><p>How can inequalities be challenged? Give voice to the marginalised. <strong>Example:</strong> How do unequal device access and prior opportunity shape participation in guided AI practice?</p></details>
            <details><summary>Empowerment</summary><p>How can people gain agency? Enable learners, teachers or communities to take control. <strong>Example:</strong> How can students use AI-literacy knowledge to question and verify AI outputs?</p></details>
          </div>
          <section class="question-card-section">
            <h3>Research questions to avoid</h3>
            <div class="avoid-question-grid">
              <details><summary>Multiple questions at a time</summary><p>Do students receiving structured AI-literacy instruction score higher, practise AI more, trust AI more and use AI more ethically?</p></details>
              <details><summary>False dichotomies</summary><p>Should an AI-literacy module prioritise improving scores or ethical AI use?</p></details>
              <details><summary>Making false assumptions</summary><p>Why do students with low AI literacy refuse to engage in guided AI practice?</p></details>
              <details><summary>Tautological questions</summary><p>Why do students with high AI-literacy scores have high AI literacy?</p></details>
              <details><summary>Too broad</summary><p>What are the effects of AI-literacy instruction on students?</p></details>
              <details><summary>Too simple</summary><p>How are universities improving AI literacy?</p></details>
              <details><summary>Biased and leading</summary><p>How can structured AI-literacy instruction solve students’ lack of AI literacy?</p></details>
            </div>
          </section>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>研究問題的類型</h2>
          <div class="type-grid">
            <details><summary>描述性</summary><p>正在發生甚麼？描述事實、模式或情況。<strong>例子：</strong>一年級本科生在單元前報告了哪些人工智能素養分數？</p></details>
            <details><summary>探索性</summary><p>可能正在發生甚麼？探索研究不足或新的領域。<strong>例子：</strong>學生如何描述在單元期間的引導式人工智能實作？</p></details>
            <details><summary>解釋性</summary><p>為甚麼或如何發生？確定原因、機制或關係。<strong>例子：</strong>引導式人工智能實作如何解釋教學與人工智能素養分數之間的關係？</p></details>
            <details><summary>比較性</summary><p>群體、情境或干預有何不同？<strong>例子：</strong>接受結構化教學的學生與接受一般活動的學生，其人工智能素養分數是否不同？</p></details>
            <details><summary>預測性</summary><p>將會發生甚麼？根據變量預測結果。<strong>例子：</strong>先前人工智能經驗與裝置使用機會能否預測人工智能素養分數？</p></details>
            <details><summary>評估性</summary><p>成效如何？評估品質、影響或成功。<strong>例子：</strong>該單元在提升人工智能素養分數方面有多有效？</p></details>
            <details><summary>發展相關</summary><p>如何創造或改進某項事物？聚焦創新／設計。<strong>例子：</strong>如何重新設計引導式人工智能實作，以支持合乎倫理的人工智能使用？</p></details>
            <details><summary>規範性</summary><p>應該怎樣？處理價值、倫理或政策。<strong>例子：</strong>數字教育單元應優先培養哪些合乎倫理的人工智能素養成果？</p></details>
            <details><summary>解放性</summary><p>如何挑戰不平等？讓邊緣群體發聲。<strong>例子：</strong>不平等的裝置使用機會與先前接觸經驗如何塑造學生參與引導式人工智能實作？</p></details>
            <details><summary>賦權性</summary><p>人們如何獲得能動性？讓學習者、教師或社群掌握主導權。<strong>例子：</strong>學生如何運用人工智能素養知識質疑並核實人工智能輸出？</p></details>
          </div>
          <section class="question-card-section">
            <h3>應避免的研究問題</h3>
            <div class="avoid-question-grid">
              <details><summary>一次提出多個問題</summary><p>接受結構化人工智能素養教學的學生是否分數較高、更多使用人工智能、更加信任人工智能，並更合乎倫理地使用人工智能？</p></details>
              <details><summary>錯誤的二分法</summary><p>人工智能素養單元應優先提升分數，還是優先培養合乎倫理的人工智能使用？</p></details>
              <details><summary>作出錯誤假設</summary><p>為甚麼人工智能素養較低的學生拒絕參與引導式人工智能實作？</p></details>
              <details><summary>同義反覆問題</summary><p>為甚麼人工智能素養分數高的學生具有較高的人工智能素養？</p></details>
              <details><summary>範圍過廣</summary><p>人工智能素養教學對學生有甚麼影響？</p></details>
              <details><summary>過於簡單</summary><p>大學如何提升人工智能素養？</p></details>
              <details><summary>有偏見和引導性</summary><p>結構化人工智能素養教學如何能解決學生缺乏人工智能素養的問題？</p></details>
            </div>
          </section>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Activity · Revise research questions" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Activity</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Revise your research questions</h2>
          <p class="intro-line">Refine the topic, problem, purpose and question so they fit one feasible study.</p>
          <div class="build-form">
            <label><span>Topic</span><textarea data-save="revise-topic" placeholder="The broad subject matter addressed by the study."></textarea></label>
            <label><span>Problem</span><textarea data-save="revise-problem" placeholder="A general educational issue, concern, or controversy addressed in research that narrows the topic."></textarea></label>
            <label><span>Purpose</span><textarea data-save="revise-purpose" placeholder="The major intent or objective of the study used to address the problem."></textarea></label>
            <label><span>Question</span><textarea data-save="revise-question" placeholder="Research questions narrow the purpose into specific questions that the researcher would like answered or addressed in the study."></textarea></label>
          </div>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>修訂你的研究問題</h2>
          <p class="intro-line">請修訂主題、研究課題、目的和問題，使它們都適合一項可行研究。</p>
          <div class="build-form">
            <label><span>主題</span><textarea data-save="revise-topic-zh" placeholder="研究涉及的廣泛主題"></textarea></label>
            <label><span>研究課題</span><textarea data-save="revise-problem-zh" placeholder="在縮小主題範圍的研究中解決的一般教育問題、關注點或爭議"></textarea></label>
            <label><span>研究目的</span><textarea data-save="revise-purpose-zh" placeholder="用於解決問題的研究的主要意圖或目標"></textarea></label>
            <label><span>研究問題</span><textarea data-save="revise-question-zh" placeholder="研究問題將目的縮小到研究人員希望在研究中回答或解決的特定問題"></textarea></label>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="How-to · Scope research questions" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">How-to</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <details class="question-reveal">
            <summary>How many research questions should I have?</summary>
            <div class="question-reveal-content">
              <p class="lead medium">Whilst there are no hard and fast rules, a general principle is to have as few as necessary, but no fewer.</p>
              <p class="intro-line">Research questions may comprise:</p>
              <ul class="source-list">
                <li>A descriptive question: What AI-literacy scores and guided AI-practice patterns are present?</li>
                <li>A comparison or relationship question: Does structured instruction relate to guided practice and AI-literacy scores?</li>
                <li>A “so what?” question: How should the module change if prior AI experience or device access shapes the results?</li>
              </ul>
            </div>
          </details>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <details class="question-reveal">
            <summary>應該有多少條研究問題？</summary>
            <div class="question-reveal-content">
              <p class="lead medium">雖然沒有硬性規定，一般原則是盡可能少，但不能更少。</p>
              <p class="intro-line">研究問題可以包括：</p>
              <ul class="source-list">
                <li>描述性問題：存在哪些人工智能素養分數與引導式人工智能實作模式？</li>
                <li>比較或關係問題：結構化教學是否與引導式實作及人工智能素養分數相關？</li>
                <li>「那又怎樣？」問題：若先前人工智能經驗或裝置使用機會影響結果，應如何修改單元？</li>
              </ul>
            </div>
          </details>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Instruction · Questions and hypotheses" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Instruction</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Research questions and hypotheses</h2>
          <div class="compare-table">
            <article><h3>Qualitative research</h3><ul><li>Uses research questions</li><li>Seeks information on a single concept</li><li>Asks participants to share ideas and builds general themes</li><li>Uses a more open-ended stance</li><li>Seeks a deep understanding of the views of one group or single individuals</li></ul></article>
            <article><h3>Quantitative research</h3><ul><li>Uses hypotheses</li><li>Identifies and measures multiple variables</li><li>Tests theories that predict results from relating variables</li><li>Uses a closed-ended stance and selects instruments before the study begins</li><li>Measures differences among groups or changes over time</li></ul></article>
          </div>
          <p class="hypothesis-note inductive-palette-note">Many qualitative studies do not test hypotheses; they explore questions.</p>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>研究問題與假設</h2>
          <div class="compare-table">
            <article><h3>定性研究</h3><ul><li>使用研究問題</li><li>尋求有關單一概念的資料</li><li>請參與者分享想法，並建立一般主題</li><li>採用較開放的立場</li><li>深入理解一個群體或個別人士的觀點</li></ul></article>
            <article><h3>定量研究</h3><ul><li>使用假設</li><li>識別並測量多個變量</li><li>檢驗從變量關係預測結果的理論</li><li>採用封閉式立場，並在研究開始前選擇工具</li><li>測量群體差異或個體隨時間的變化</li></ul></article>
          </div>
          <p class="hypothesis-note inductive-palette-note">許多定性研究不檢驗假設，而是探索研究問題。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Instruction · What is a hypothesis?" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Instruction</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Hypothesis</h2>
          <div class="hypothesis-introduction">
            <div class="hypothesis-definition">
              <p class="lead medium">A hypothesis is a precise, testable prediction about the relationship between two or more variables. It should be grounded in theory or prior evidence, and the data should be able to show that it is wrong.</p>
              <p class="lead medium">It is not simply an “educated guess”: a research question stays open, while a hypothesis commits to a specific expected pattern.</p>
              <div class="reasoning-compare">
                <aside class="inductive-callout"><strong>Inductive reasoning</strong><span>Moves from observations or patterns to a tentative hypothesis. It helps generate a hypothesis, but does not prove it.</span></aside>
                <aside class="deductive-callout"><strong>Deductive reasoning</strong><span>Starts with a theory or hypothesis and derives a testable prediction. It helps test whether evidence is consistent with the hypothesis.</span></aside>
              </div>
            </div>
            <figure class="comic-figure">
              <img src={comicHref} alt="The Claus Hypothesis comic: observations about Santa lead to the provisional conclusion that Santa Claus is a professor, followed by a null-hypothesis joke." loading="lazy" decoding="async" />
            </figure>
          </div>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>假設</h2>
          <div class="hypothesis-introduction">
            <div class="hypothesis-definition">
              <p class="lead medium">假設是對兩個或以上變量之間關係的精確、可檢驗預測。它應以理論或既有證據為基礎，而資料應能顯示它可能是錯的。</p>
              <p class="lead medium">假設不只是「有根據的猜測」：研究問題保持開放，而假設則承諾一種具體的預期模式。</p>
              <div class="reasoning-compare">
                <aside class="inductive-callout"><strong>歸納推理</strong><span>從觀察或模式走向暫時性假設；有助於提出假設，但不能證明假設。</span></aside>
                <aside class="deductive-callout"><strong>演繹推理</strong><span>從理論或假設推導可檢驗的預測；有助於檢驗證據是否與假設一致。</span></aside>
              </div>
            </div>
            <figure class="comic-figure">
              <img src={comicHref} alt="《聖誕老人假設》漫畫：幾項關於聖誕老人的觀察引出聖誕老人是教授的暫時結論，並以零假設作笑點。" loading="lazy" decoding="async" />
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Example · Null and alternative hypotheses" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Example</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Null and alternative hypotheses</h2>
          <div class="hypothesis-pair">
            <article><h3>Null hypothesis H₀</h3><p>Tests in the general population that there is no change, no relationship or no difference.</p><p class="formula">There is no difference (or relationship) between…</p></article>
            <article><h3>Alternative hypothesis H₁, H₂, H₃…</h3><p>May be true if the null is rejected; suggests a change, relationship or difference.</p><p class="formula">Higher · lower · more positive · more favourable</p></article>
          </div>
          <h3 class="hypothesis-subtitle">Example</h3>
          <div class="hypothesis-example">
            <article class="hypothesis-example-null"><h3>Null hypothesis (H₀)</h3><p>There is no significant difference in AI-literacy scores between students who receive structured AI-literacy instruction and those who receive usual course activity.</p></article>
            <article class="hypothesis-example-alternative"><h3>Alternative hypothesis (H₁)</h3><p>Students who receive structured AI-literacy instruction achieve significantly higher AI-literacy scores than those who receive usual course activity.</p></article>
          </div>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>零假設與備擇假設</h2>
          <div class="hypothesis-pair">
            <article><h3>零假設 H₀</h3><p>在一般母體中檢驗沒有變化、沒有關係或沒有差異。</p><p class="formula">……之間沒有差異（或關係）</p></article>
            <article><h3>備擇假設 H₁、H₂、H₃……</h3><p>若零假設被拒絕，則可能成立；表示有變化、關係或差異。</p><p class="formula">較高 · 較低 · 更正面 · 更有利</p></article>
          </div>
          <h3 class="hypothesis-subtitle">例子</h3>
          <div class="hypothesis-example">
            <article class="hypothesis-example-null"><h3>零假設（H₀）</h3><p>接受結構化人工智能素養教學與接受一般課程活動的學生，其人工智能素養分數沒有顯著差異。</p></article>
            <article class="hypothesis-example-alternative"><h3>備擇假設（H₁）</h3><p>接受結構化人工智能素養教學的學生，其人工智能素養分數顯著高於接受一般課程活動的學生。</p></article>
          </div>
        </div>
      </div>
    </section>

    <section class="slide hypothesis-types-slide" data-title="Instruction · Types of hypotheses" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Instruction</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Types of hypotheses</h2>
          <p class="intro-line">First decide whether you are comparing groups or examining an association. Then decide whether prior theory or evidence justifies predicting a direction.</p>
          <div class="hypothesis-types-layout">
            <div class="hypothesis-types-content">
              <div class="hypothesis-type-grid">
                <article><span class="type-kicker">Difference · non-directional</span><h3>Difference without a direction</h3><p>Compares groups but does not say which group will score higher.</p><p class="type-example"><strong>Example:</strong> AI-literacy scores differ between students who receive structured AI-literacy instruction and students who do not.</p></article>
                <article><span class="type-kicker">Difference · directional</span><h3>Difference with a direction</h3><p>Compares groups and predicts which way the outcome will differ.</p><p class="type-example"><strong>Example:</strong> Students who receive structured AI-literacy instruction will have higher AI-literacy scores than students who do not.</p></article>
                <article><span class="type-kicker">Correlation · non-directional</span><h3>Association without a direction</h3><p>States that two measured variables are related without predicting a positive or negative pattern.</p><p class="type-example"><strong>Example:</strong> Guided AI-practice engagement is associated with AI-literacy scores.</p></article>
                <article><span class="type-kicker">Correlation · directional</span><h3>Association with a direction</h3><p>States whether the association is positive or negative.</p><p class="type-example"><strong>Example:</strong> More guided AI practice is positively associated with higher AI-literacy scores.</p></article>
              </div>
              <p class="hypothesis-caution"><strong>Plan before seeing the data:</strong> choose a directional or non-directional form in advance. An association alone does not establish causation.</p>
            </div>
            <figure class="hypothesis-types-comic">
              <img src={correlationComicHref} alt="Three-panel comic explaining that correlation does not imply causation: after taking a statistics class, the speaker no longer makes that mistake." width="1394" height="620" loading="lazy" decoding="async" />
            </figure>
          </div>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>假設的類型</h2>
          <p class="intro-line">先決定你是在比較群體，還是在檢驗變量之間的關聯；再決定既有理論或證據是否足以支持方向性的預測。</p>
          <div class="hypothesis-types-layout">
            <div class="hypothesis-types-content">
              <div class="hypothesis-type-grid">
                <article><span class="type-kicker">差異 · 非方向性</span><h3>沒有方向的差異</h3><p>比較群體，但不說明哪一個群體的分數較高。</p><p class="type-example"><strong>例子：</strong>接受結構化人工智能素養教學與未接受教學的學生，其人工智能素養分數存在差異。</p></article>
                <article><span class="type-kicker">差異 · 方向性</span><h3>有方向的差異</h3><p>比較群體，並預測結果差異的方向。</p><p class="type-example"><strong>例子：</strong>接受結構化人工智能素養教學的學生，其人工智能素養分數將高於未接受教學的學生。</p></article>
                <article><span class="type-kicker">相關 · 非方向性</span><h3>沒有方向的關聯</h3><p>指出兩個測量變量有關聯，但不預測正向或負向模式。</p><p class="type-example"><strong>例子：</strong>引導式人工智能實作的投入與人工智能素養分數相關。</p></article>
                <article><span class="type-kicker">相關 · 方向性</span><h3>有方向的關聯</h3><p>指出關聯是正向還是負向。</p><p class="type-example"><strong>例子：</strong>更多引導式人工智能實作與較高的人工智能素養分數呈正相關。</p></article>
              </div>
              <p class="hypothesis-caution"><strong>在查看資料前先作規劃：</strong>預先選擇方向性或非方向性的表述。單憑關聯不能確立因果關係。</p>
            </div>
            <figure class="hypothesis-types-comic">
              <img src={correlationComicHref} alt="三格漫畫說明相關不等於因果：人物修讀統計課後，不再犯這個錯誤。" width="1394" height="620" loading="lazy" decoding="async" />
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="How-to · Write a hypothesis" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">How-to</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>How to write the hypothesis</h2>
          <ol class="hypothesis-steps">
            <li><span>01</span><strong>Start from the research question</strong><p>Rewrite the question as a statement that commits to a specific answer.</p></li>
            <li><span>02</span><strong>Identify the variables</strong><p>Mark the predictor or Independent Variable (IV) and the outcome or Dependent Variable (DV).</p></li>
            <li><span>03</span><strong>Add measurement detail</strong><p>Name the instrument or operational measure for each variable.</p></li>
            <li><span>04</span><strong>Specify direction if justified</strong><p>Use higher, lower, positive or negative only when theory or evidence supports it.</p></li>
            <li><span>05</span><strong>Pair with a null hypothesis</strong><p>State the no-difference or no-association claim for statistical inference.</p></li>
          </ol>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>如何撰寫假設</h2>
          <ol class="hypothesis-steps">
            <li><span>01</span><strong>從研究問題開始</strong><p>把問題改寫成承諾具體答案的陳述。</p></li>
            <li><span>02</span><strong>識別變量</strong><p>標記預測變量或自變量（IV），以及結果或因變量（DV）。</p></li>
            <li><span>03</span><strong>加入測量細節</strong><p>為每一個變量說明工具或操作性測量方式。</p></li>
            <li><span>04</span><strong>在有理據時說明方向</strong><p>只有在理論或證據支持時，才使用較高、較低、正向或負向。</p></li>
            <li><span>05</span><strong>配對零假設</strong><p>為統計推論說明沒有差異或沒有關聯的主張。</p></li>
          </ol>
        </div>
      </div>
    </section>

    <section class="slide" data-title="How-to · Hypothesis templates" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">How-to</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Hypothesis templates</h2>
          <p class="intro-line">Replace the brackets with your own population, variables, measures and comparison. Use a direction only when theory or prior evidence supports it.</p>
          <div class="template-grid">
            <article><span class="type-kicker">Directional difference</span><h3>Compare two groups</h3><p class="template-line">For [population] receiving [intervention/exposure], the mean [outcome] score, measured with [measure], will be [higher/lower] than in [comparison group].</p></article>
            <article><span class="type-kicker">Directional correlation</span><h3>Relate two variables</h3><p class="template-line">Among [population], [predictor], measured by [measure], will be [positively/negatively] associated with [outcome], measured by [measure].</p></article>
            <article><span class="type-kicker">Moderation</span><h3>Specify a conditional effect</h3><p class="template-line">The relationship between [predictor] and [outcome] will be [stronger/weaker] for [population] with [higher/lower] [moderator].</p></article>
            <article><span class="type-kicker">Null hypothesis</span><h3>State the no-effect claim</h3><p class="template-line">H₀: [outcome] will not differ between [intervention group] and [comparison group].</p></article>
          </div>
          <p class="hypothesis-caution"><strong>Non-directional option:</strong> say that groups “differ” or variables “are associated” without adding higher, lower, positive or negative.</p>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>假設模板</h2>
          <p class="intro-line">把你自己的研究對象、變量、測量方式與比較組填入方括號。只有在理論或既有證據支持時，才加入方向。</p>
          <div class="template-grid">
            <article><span class="type-kicker">方向性差異</span><h3>比較兩個群體</h3><p class="template-line">對於接受［干預／暴露］的［研究對象］，以［測量方式］測量的平均［結果］分數將［高於／低於］［比較組］。</p></article>
            <article><span class="type-kicker">方向性相關</span><h3>連結兩個變量</h3><p class="template-line">在［研究對象］中，以［測量方式］測量的［預測變量］將與以［測量方式］測量的［結果］呈［正／負］相關。</p></article>
            <article><span class="type-kicker">調節作用</span><h3>說明條件性效果</h3><p class="template-line">［預測變量］與［結果］的關係，對具有［較高／較低］［調節變量］的［研究對象］而言將更［強／弱］。</p></article>
            <article><span class="type-kicker">零假設</span><h3>說明沒有作用的主張</h3><p class="template-line">H₀：［結果］在［干預組］與［比較組］之間沒有差異。</p></article>
          </div>
          <p class="hypothesis-caution"><strong>非方向性選項：</strong>說明群體「存在差異」或變量「相關」，但不加入較高、較低、正向或負向。</p>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Activity · Strengthen a hypothesis" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Activity</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Full hypothesis examples</h2>
          <p class="intro-line">Improve each weak hypothesis by typing a more precise, testable version. Then reveal the referenced answer and compare your wording.</p>
          <div class="full-example-grid hypothesis-practice" data-hypothesis-practice>
            <article>
              <h3>Example 1 · Difference</h3>
              <p class="weak-version"><span>Weak version</span>Structured AI-literacy instruction helps students.</p>
              <label class="hypothesis-entry"><span>Your improved hypothesis</span><textarea data-save="hypothesis-difference-en" placeholder="Include the population, comparison, outcome measure and direction."></textarea></label>
              <button type="button" class="answer-toggle" data-reveal-answer="hypothesis-answer-difference-en" data-show-label="Reveal referenced answer" data-hide-label="Hide referenced answer" aria-expanded="false">Reveal referenced answer</button>
              <div class="referenced-answer" id="hypothesis-answer-difference-en" hidden><span>Referenced answer</span><p>Among first-year undergraduates, students assigned to a four-week structured AI-literacy module will achieve higher mean scores on a post-module AI-literacy questionnaire than students completing usual course activity.</p></div>
              <p class="why-example" data-answer-quality-check hidden><strong>Quality check:</strong> It names the population, intervention, comparison, outcome measure and time point; the assigned comparison supports the stated causal design.</p>
            </article>
            <article>
              <h3>Example 2 · Correlation</h3>
              <p class="weak-version"><span>Weak version</span>Guided AI practice is related to AI literacy.</p>
              <label class="hypothesis-entry"><span>Your improved hypothesis</span><textarea data-save="hypothesis-correlation-en" placeholder="Name both measured variables and state the direction of association."></textarea></label>
              <button type="button" class="answer-toggle" data-reveal-answer="hypothesis-answer-correlation-en" data-show-label="Reveal referenced answer" data-hide-label="Hide referenced answer" aria-expanded="false">Reveal referenced answer</button>
              <div class="referenced-answer" id="hypothesis-answer-correlation-en" hidden><span>Referenced answer</span><p>Among first-year undergraduates, guided AI-practice scores recorded during the module will be positively associated with post-module AI-literacy questionnaire scores.</p></div>
              <p class="why-example" data-answer-quality-check hidden><strong>Quality check:</strong> It identifies both measured variables and the direction while avoiding a causal claim.</p>
            </article>
          </div>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>完整的假設例子</h2>
          <p class="intro-line">請把每個較弱的假設改寫成更精確、可檢驗的表述。然後揭示參考答案，與自己的文字比較。</p>
          <div class="full-example-grid hypothesis-practice" data-hypothesis-practice>
            <article>
              <h3>例子 1 · 差異</h3>
              <p class="weak-version"><span>較弱的表述</span>結構化人工智能素養教學有助學生。</p>
              <label class="hypothesis-entry"><span>你改寫的假設</span><textarea data-save="hypothesis-difference-zh" placeholder="加入研究對象、比較組、結果測量與方向。"></textarea></label>
              <button type="button" class="answer-toggle" data-reveal-answer="hypothesis-answer-difference-zh" data-show-label="揭示參考答案" data-hide-label="隱藏參考答案" aria-expanded="false">揭示參考答案</button>
              <div class="referenced-answer" id="hypothesis-answer-difference-zh" hidden><span>參考答案</span><p>在一年級本科生中，被分配參加為期四週結構化人工智能素養單元的學生，其單元後人工智能素養問卷平均分數將高於進行一般課程活動的學生。</p></div>
              <p class="why-example" data-answer-quality-check hidden><strong>品質檢查：</strong>它說明研究對象、干預、比較組、結果測量與時間點；分配式比較配合其因果研究設計。</p>
            </article>
            <article>
              <h3>例子 2 · 相關</h3>
              <p class="weak-version"><span>較弱的表述</span>引導式人工智能實作與人工智能素養有關。</p>
              <label class="hypothesis-entry"><span>你改寫的假設</span><textarea data-save="hypothesis-correlation-zh" placeholder="列出兩個可測量的變量，並說明關聯方向。"></textarea></label>
              <button type="button" class="answer-toggle" data-reveal-answer="hypothesis-answer-correlation-zh" data-show-label="揭示參考答案" data-hide-label="隱藏參考答案" aria-expanded="false">揭示參考答案</button>
              <div class="referenced-answer" id="hypothesis-answer-correlation-zh" hidden><span>參考答案</span><p>在一年級本科生中，單元期間記錄的引導式人工智能實作分數將與單元後人工智能素養問卷分數呈正相關。</p></div>
              <p class="why-example" data-answer-quality-check hidden><strong>品質檢查：</strong>它指出兩個可測量變量及關係方向，同時避免提出因果主張。</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="slide hypothesis-avoid-slide" data-title="Check · Hypotheses to avoid" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header hypothesis-avoid-header"><span class="eyebrow">Check</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Hypothesis to Avoid</h2>
          <div class="hypothesis-avoid-grid">
            <details>
              <summary>Too many predictions</summary>
              <p><strong>Why avoid it:</strong> Split separate outcomes into H₁, H₂ and H₃ so each claim can be tested clearly.<span class="avoid-example"><strong>Weak example:</strong> Students who receive AI-literacy instruction will have higher AI-literacy scores, practise AI more, feel more confident and use AI more ethically.</span></p>
            </details>
            <details>
              <summary>Not falsifiable</summary>
              <p><strong>Why avoid it:</strong> Name a specific pattern or direction that the data could contradict.<span class="avoid-example"><strong>Weak example:</strong> AI-literacy instruction will improve students’ learning in a meaningful way.</span></p>
            </details>
            <details>
              <summary>Causal language without a suitable design</summary>
              <p><strong>Why avoid it:</strong> Use “is associated with” for correlational evidence; reserve causal claims for designs that support them.<span class="avoid-example"><strong>Weak example:</strong> Guided AI practice causes higher AI-literacy scores.</span></p>
            </details>
            <details>
              <summary>No literature grounding</summary>
              <p><strong>Why avoid it:</strong> Show the logic from theory or a prior finding to an implication and then to a prediction.<span class="avoid-example"><strong>Weak example:</strong> AI literacy is important, so structured instruction will increase AI-literacy scores.</span></p>
            </details>
            <details>
              <summary>Vague outcome</summary>
              <p><strong>Why avoid it:</strong> Specify what will change and how it will be measured.<span class="avoid-example"><strong>Weak example:</strong> AI-literacy instruction improves students’ AI literacy.</span></p>
            </details>
            <details>
              <summary>Direction chosen after the data</summary>
              <p><strong>Why avoid it:</strong> Choose directional or non-directional wording before inspecting the results.<span class="avoid-example"><strong>Weak example:</strong> Start with “guided AI practice will be associated with AI-literacy scores,” then change it to “will be positively associated” after seeing the results.</span></p>
            </details>
          </div>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>應避免的假設</h2>
          <div class="hypothesis-avoid-grid">
            <details>
              <summary>一個假設有太多預測</summary>
              <p><strong>為甚麼要避免：</strong>把不同結果分成 H₁、H₂ 與 H₃，讓每個主張都能清楚檢驗。<span class="avoid-example"><strong>較弱例子：</strong>接受人工智能素養教學的學生，人工智能素養分數較高、更多進行人工智能實作、更有信心，而且更合乎倫理地使用人工智能。</span></p>
            </details>
            <details>
              <summary>無法證偽</summary>
              <p><strong>為甚麼要避免：</strong>指出資料可能反駁的具體模式或方向。<span class="avoid-example"><strong>較弱例子：</strong>人工智能素養教學會以有意義的方式改善學生的學習。</span></p>
            </details>
            <details>
              <summary>研究設計不足卻使用因果語言</summary>
              <p><strong>為甚麼要避免：</strong>對相關性證據使用「相關」；只有研究設計支持時才提出因果主張。<span class="avoid-example"><strong>較弱例子：</strong>引導式人工智能實作會造成較高的人工智能素養分數。</span></p>
            </details>
            <details>
              <summary>沒有文獻基礎</summary>
              <p><strong>為甚麼要避免：</strong>展示由理論或既有發現到推論，再到預測的邏輯。<span class="avoid-example"><strong>較弱例子：</strong>人工智能素養很重要，所以結構化教學會提高人工智能素養分數。</span></p>
            </details>
            <details>
              <summary>結果表述含糊</summary>
              <p><strong>為甚麼要避免：</strong>說明甚麼會改變，以及如何測量。<span class="avoid-example"><strong>較弱例子：</strong>人工智能素養教學提升學生的人工智能素養。</span></p>
            </details>
            <details>
              <summary>看過資料後才選方向</summary>
              <p><strong>為甚麼要避免：</strong>在查看結果前，先選擇方向性或非方向性的措辭。<span class="avoid-example"><strong>較弱例子：</strong>先寫「引導式人工智能實作與人工智能素養分數相關」，看到正向結果後才改成「呈正相關」。</span></p>
            </details>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Instruction · Concept, construct and variable" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Instruction</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Concept, construct and variable</h2>
          <div class="concept-grid">
            <details class="concept-card"><summary><span class="concept-step">01</span><span>Concept</span></summary><div class="concept-card-body"><p>A generalisable property or characteristic associated with an object, event or person.</p><p class="example-line">AI literacy is the broad idea of understanding, using and evaluating AI in education.</p></div></details>
            <details class="concept-card"><summary><span class="concept-step">02</span><span>Construct</span></summary><div class="concept-card-body"><p>An abstract concept chosen or created to explain a phenomenon. It may combine several related concepts.</p><p class="example-line">AI literacy can be specified as a multidimensional construct involving knowing and understanding AI, using and applying AI, evaluating and corroborating AI-generated content, and incorporating it ethically and effectively (Ng et al., 2024).</p></div></details>
            <details class="concept-card"><summary><span class="concept-step">03</span><span>Variable</span></summary><div class="concept-card-body"><p>A measurable representation, or proxy, of a construct. Its value can vary across the cases studied.</p><p class="example-line">An AI literacy questionnaire or scale score is a variable used to represent this construct; its value can differ across learners (Ng et al., 2024; Kim et al., 2026).</p></div></details>
          </div>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>概念、構念與變量</h2>
          <div class="concept-grid">
            <details class="concept-card"><summary><span class="concept-step">01</span><span>概念</span></summary><div class="concept-card-body"><p>與物件、事件或人物相關，而且可以概括的屬性或特徵。</p><p class="example-line">人工智能素養是在教育中理解、使用和評估人工智能的廣義概念。</p></div></details>
            <details class="concept-card"><summary><span class="concept-step">02</span><span>構念</span></summary><div class="concept-card-body"><p>為解釋某種現象而選擇或創建的抽象概念，可以由幾個相關概念組成。</p><p class="example-line">人工智能素養可以界定為多維構念，包括認識和理解人工智能、使用和應用人工智能、評估和核實人工智能生成的內容，以及以合乎倫理和有效的方式整合這些內容（Ng et al., 2024）。</p></div></details>
            <details class="concept-card"><summary><span class="concept-step">03</span><span>變量</span></summary><div class="concept-card-body"><p>構念的可測量表徵或代理指標，其數值可以因研究個案而異。</p><p class="example-line">人工智能素養問卷或量表分數是用來表徵該構念的變量；其數值可以因學習者而異（Ng et al., 2024；Kim et al., 2026）。</p></div></details>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Activity · Identify the family of variables" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Activity</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>The family of variables</h2>
          <p class="activity-prompt"><strong>First try:</strong> identify possible outcomes, predictors, and controls of your own study before learning the formal labels.</p>
          <div class="variable-form">
            <label>What outcomes in my study am I trying to explain?<textarea></textarea></label>
            <label>What variables or factors influence the outcomes?<textarea></textarea></label>
            <label>What variables do I need to also measure (i.e., control) so that I can make sure that my major factors influence outcomes and not other factors?<textarea></textarea></label>
          </div>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>變量家族</h2>
          <p class="activity-prompt"><strong>先試一試：</strong>在學習正式名稱前，先找出自己研究中可能的結果、預測因素和控制變量。</p>
          <div class="variable-form">
            <label>我的研究試圖解釋哪些結果？<textarea></textarea></label>
            <label>哪些變量或因素影響這些結果？<textarea></textarea></label>
            <label>我還需要測量哪些變量（即控制變量），以確保主要因素而不是其他因素影響結果？<textarea></textarea></label>
          </div>
        </div>
      </div>
    </section>

    <section class="slide concept-measure-slide" data-title="How-to · Move from abstract to measurable" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">How-to</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Move from abstract to measurable</h2>
          <div class="illustration-layout">
            <figure>
              <div class="research-plane-diagram" role="group" aria-label="Click a card to reveal its AI-literacy example in the theoretical or empirical plane.">
                <div class="diagram-plane theoretical-plane"><span class="plane-label">Theoretical plane</span><button type="button" class="diagram-node plane-flip-card" data-variable-role-card aria-pressed="false" aria-label="Construct A; activate to reveal the example."><span class="plane-card-inner"><span class="plane-card-face plane-card-front"><strong>Construct A</strong><small>Click to reveal example</small></span><span class="plane-card-face plane-card-back"><strong>Structured AI-literacy learning</strong><small>Example</small></span></span></button><span class="diagram-relation"><b>→</b><small>Proposition</small></span><button type="button" class="diagram-node plane-flip-card" data-variable-role-card aria-pressed="false" aria-label="Construct B; activate to reveal the example."><span class="plane-card-inner"><span class="plane-card-face plane-card-front"><strong>Construct B</strong><small>Click to reveal example</small></span><span class="plane-card-face plane-card-back"><strong>AI literacy</strong><small>Example</small></span></span></button></div>
                <div class="operational-links" aria-hidden="true"><span>↓</span><small>Operationalise</small><span>↓</span></div>
                <div class="diagram-plane empirical-plane"><span class="plane-label">Empirical plane</span><button type="button" class="diagram-node plane-flip-card" data-variable-role-card aria-pressed="false" aria-label="Variable A; activate to reveal the example."><span class="plane-card-inner"><span class="plane-card-face plane-card-front"><strong>Variable A</strong><small>Click to reveal example</small></span><span class="plane-card-face plane-card-back"><strong>Structured instruction exposure</strong><small>Example</small></span></span></button><span class="diagram-relation"><b>→</b><small>Hypothesis</small></span><button type="button" class="diagram-node plane-flip-card" data-variable-role-card aria-pressed="false" aria-label="Variable B; activate to reveal the example."><span class="plane-card-inner"><span class="plane-card-face plane-card-front"><strong>Variable B</strong><small>Click to reveal example</small></span><span class="plane-card-face plane-card-back"><strong>AI-literacy score</strong><small>Example</small></span></span></button></div>
              </div>
              <figcaption>Click a card to reveal an AI-literacy example. Constructs become measurable variables through operational definitions.</figcaption>
            </figure>
            <ol class="illustration-notes">
              <li><strong>Theoretical plane:</strong> constructs are abstract ideas connected by propositions.</li>
              <li><strong>Operational bridge:</strong> define exactly how each construct will be measured.</li>
              <li><strong>Empirical plane:</strong> variables contain the observed values tested in hypotheses.</li>
            </ol>
          </div>
          <div class="measure-examples">
            <p><strong>AI literacy</strong> <span>construct</span> → <strong>post-module questionnaire score</strong> <span>variable</span></p>
            <p><strong>Guided AI practice</strong> <span>construct</span> → <strong>practice-record or rubric score</strong> <span>variable</span></p>
          </div>
          <p class="measurement-check"><strong>Always ask:</strong> Does this variable represent the construct well?</p>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>從抽象概念走向測量</h2>
          <div class="illustration-layout">
            <figure>
              <div class="research-plane-diagram" role="group" aria-label="點選卡片以顯示理論或經驗層面的人工智能素養例子。">
                <div class="diagram-plane theoretical-plane"><span class="plane-label">理論層面</span><button type="button" class="diagram-node plane-flip-card" data-variable-role-card aria-pressed="false" aria-label="構念 A；點選以顯示例子。"><span class="plane-card-inner"><span class="plane-card-face plane-card-front"><strong>構念 A</strong><small>點選以顯示例子</small></span><span class="plane-card-face plane-card-back"><strong>結構化人工智能素養學習</strong><small>例子</small></span></span></button><span class="diagram-relation"><b>→</b><small>命題</small></span><button type="button" class="diagram-node plane-flip-card" data-variable-role-card aria-pressed="false" aria-label="構念 B；點選以顯示例子。"><span class="plane-card-inner"><span class="plane-card-face plane-card-front"><strong>構念 B</strong><small>點選以顯示例子</small></span><span class="plane-card-face plane-card-back"><strong>人工智能素養</strong><small>例子</small></span></span></button></div>
                <div class="operational-links" aria-hidden="true"><span>↓</span><small>操作化</small><span>↓</span></div>
                <div class="diagram-plane empirical-plane"><span class="plane-label">經驗層面</span><button type="button" class="diagram-node plane-flip-card" data-variable-role-card aria-pressed="false" aria-label="變量 A；點選以顯示例子。"><span class="plane-card-inner"><span class="plane-card-face plane-card-front"><strong>變量 A</strong><small>點選以顯示例子</small></span><span class="plane-card-face plane-card-back"><strong>結構化教學暴露</strong><small>例子</small></span></span></button><span class="diagram-relation"><b>→</b><small>假設</small></span><button type="button" class="diagram-node plane-flip-card" data-variable-role-card aria-pressed="false" aria-label="變量 B；點選以顯示例子。"><span class="plane-card-inner"><span class="plane-card-face plane-card-front"><strong>變量 B</strong><small>點選以顯示例子</small></span><span class="plane-card-face plane-card-back"><strong>人工智能素養分數</strong><small>例子</small></span></span></button></div>
              </div>
              <figcaption>點選卡片以顯示人工智能素養例子。透過操作性定義，把構念轉化為可測量的變量。</figcaption>
            </figure>
            <ol class="illustration-notes">
              <li><strong>理論層面：</strong>構念是抽象想法，彼此由命題連接。</li>
              <li><strong>操作化橋樑：</strong>明確界定每個構念將如何測量。</li>
              <li><strong>經驗層面：</strong>變量包含觀察所得的數值，並用於檢驗假設。</li>
            </ol>
          </div>
          <div class="measure-examples">
            <p><strong>人工智能素養</strong> <span>構念</span> → <strong>單元後問卷分數</strong> <span>變量</span></p>
            <p><strong>引導式人工智能實作</strong> <span>構念</span> → <strong>實作記錄或評分量表分數</strong> <span>變量</span></p>
          </div>
          <p class="measurement-check"><strong>始終要問：</strong>這個變量是否能良好地代表該構念？</p>
        </div>
      </div>
    </section>

    <section class="slide operationalization-slide" data-title="Instruction · Operationalization" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Instruction</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Operationalization</h2>
          <p class="lead small-lead">Start with an open question. Operationalization specifies who is studied, what happens, what is measured and when, so that a testable hypothesis can be stated.</p>
          <div class="operationalization-layout">
            <div class="operationalization-example">
              <div class="operationalization-card question-card"><span class="operationalization-label">Research question</span><p>Can a structured AI-literacy module help students develop AI literacy?</p></div>
              <div class="operationalization-arrow" aria-hidden="true">↓</div>
              <div class="operationalization-details">
                <div><strong>Participants</strong><span>first-year undergraduates in a digital education course</span></div>
                <div><strong>Comparison conditions</strong><span>a four-week structured AI-literacy module or usual course activities</span></div>
                <div><strong>Potential mechanism</strong><span>the quantity and quality of tutor-supported guided AI tasks</span></div>
                <div><strong>Outcome</strong><span>change from baseline to post-module AI-literacy questionnaire score</span></div>
                <div><strong>Controls</strong><span>baseline AI-literacy score, prior AI experience and access to devices</span></div>
              </div>
              <div class="operationalization-arrow" aria-hidden="true">↓</div>
              <div class="operationalization-card refined-card"><span class="operationalization-label">Operationalized hypothesis (H₁)</span><p>Among first-year undergraduates, students who complete a four-week structured AI-literacy module will achieve higher post-module AI-literacy questionnaire scores than peers receiving usual course activities, after adjusting for baseline AI-literacy score, prior AI experience and access to devices.</p></div>
            </div>
          </div>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>操作化</h2>
          <p class="lead small-lead">先從開放的問題開始。操作化說明研究誰、提供甚麼、測量甚麼和何時測量，從而可提出可檢驗的假設。</p>
          <div class="operationalization-layout">
            <div class="operationalization-example">
              <div class="operationalization-card question-card"><span class="operationalization-label">研究問題</span><p>結構化人工智能素養單元能否幫助學生發展人工智能素養？</p></div>
              <div class="operationalization-arrow" aria-hidden="true">↓</div>
              <div class="operationalization-details">
                <div><strong>參與者</strong><span>修讀數字教育課程的一年級本科生</span></div>
                <div><strong>比較條件</strong><span>為期四週的結構化人工智能素養單元或一般課程活動</span></div>
                <div><strong>潛在機制</strong><span>教師支援的引導式人工智能任務的數量與品質</span></div>
                <div><strong>結果</strong><span>從基線至單元後的人工智能素養問卷分數變化</span></div>
                <div><strong>控制變量</strong><span>基線人工智能素養分數、先前人工智能經驗與裝置使用機會</span></div>
              </div>
              <div class="operationalization-arrow" aria-hidden="true">↓</div>
              <div class="operationalization-card refined-card"><span class="operationalization-label">操作化後的假設（H₁）</span><p>在一年級本科生中，完成為期四週的結構化人工智能素養單元的學生，相較於接受一般課程活動的同儕，將取得更高的單元後人工智能素養問卷分數；分析時控制基線人工智能素養分數、先前人工智能經驗與裝置使用機會。</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="slide" data-title="Instruction · Types of variables" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Instruction</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Types of variables</h2>
          <p class="lead small-lead">Ask two questions in order. First identify the job a variable does in the study; then identify the data type used to measure it. Open a leaf to reveal its explanation and example.</p>
          <div class="variable-lens" aria-label="Two ways to classify a variable">
            <div class="variable-lens-root">How do we look at a variable?</div>
            <div class="variable-lens-split" aria-hidden="true"></div>
            <div class="variable-lens-branches">
              <section class="variable-lens-branch" aria-labelledby="variable-job-heading">
                <div class="variable-lens-question">
                  <span>Question 1</span><h3 id="variable-job-heading">What is its job?</h3><p>The causal anatomy: where it sits in the story’s timeline.</p>
                </div>
                <div class="variable-lens-list">
                  <details class="variable-lens-leaf"><summary><strong>The Actor · Independent Variable (X)</strong><span>Starts the action</span></summary><p>The variable that triggers a change or is manipulated by the researcher. <strong>Example:</strong> a four-week structured AI-literacy module.</p></details>
                  <details class="variable-lens-leaf"><summary><strong>The Outcome · Dependent Variable (Y)</strong><span>The effect to explain</span></summary><p>The variable that reacts: the behaviour or result at the end of the story. <strong>Example:</strong> a student’s post-module AI-literacy score.</p></details>
                  <details class="variable-lens-leaf"><summary><strong>The Background · Control Variable</strong><span>Held constant</span></summary><p>Factors held in place so they do not disrupt the main comparison. <strong>Example:</strong> the same module length, learning platform and scoring instrument for every student.</p></details>
                  <details class="variable-lens-leaf"><summary><strong>The Bridge · Mediator (M)</strong><span>How or why X leads to Y</span></summary><p>The internal mechanism linking X to Y: X → M → Y. <strong>Example:</strong> guided AI practice may bridge structured instruction and AI-literacy scores.</p></details>
                  <details class="variable-lens-leaf"><summary><strong>The Context · Moderator (W)</strong><span>When or for whom X leads to Y</span></summary><p>The boundary condition that changes the strength of the X → Y relationship. <strong>Example:</strong> prior AI experience may change how strongly instruction relates to AI-literacy scores.</p></details>
                </div>
              </section>
              <section class="variable-lens-branch" aria-labelledby="variable-data-heading">
                <div class="variable-lens-question">
                  <span>Question 2</span><h3 id="variable-data-heading">What is its data type?</h3><p>The mathematical anatomy: how it is measured and which statistical tools fit.</p>
                </div>
                <div class="variable-lens-list">
                  <details class="variable-lens-leaf variable-data-lens"><summary><strong>Categorical / Qualitative</strong><span>Words, groups or labels</span></summary><div class="variable-data-lens-detail"><div>Data described by words, groups or labels.</div><div class="variable-lens-subtypes"><div><strong>Nominal</strong><span>Unordered categories. <b>Example:</b> instructional condition: structured module or usual course activity.</span></div><div><strong>Ordinal</strong><span>Ordered categories with imprecise distances. <b>Example:</b> self-rated AI confidence: disagree, neutral or agree.</span></div></div></div></details>
                  <details class="variable-lens-leaf variable-data-lens"><summary><strong>Numerical / Quantitative</strong><span>True quantities</span></summary><div class="variable-data-lens-detail"><div>Data expressed as numbers with quantitative meaning.</div><div class="variable-lens-subtypes"><div><strong>Discrete</strong><span>Fixed, countable values. <b>Example:</b> number of guided AI-practice tasks completed.</span></div><div><strong>Continuous</strong><span>Measured values that can take unlimited decimal values within a range. <b>Example:</b> time spent on guided AI practice.</span></div></div></div></details>
                </div>
              </section>
            </div>
          </div>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>變量的類型</h2>
          <p class="lead small-lead">依次問兩個問題：先識別變量在研究中的角色，再識別用來測量它的資料類型。點選每個末端方框，可查看說明和例子。</p>
          <div class="variable-lens" aria-label="兩種分類變量的方式">
            <div class="variable-lens-root">如何看待一個變量？</div>
            <div class="variable-lens-split" aria-hidden="true"></div>
            <div class="variable-lens-branches">
              <section class="variable-lens-branch" aria-labelledby="variable-job-heading-zh">
                <div class="variable-lens-question">
                  <span>問題 1</span><h3 id="variable-job-heading-zh">它的角色是甚麼？</h3><p>因果結構：它在研究故事的時間線中位於哪裡。</p>
                </div>
                <div class="variable-lens-list">
                  <details class="variable-lens-leaf"><summary><strong>行動者 · 自變量（X）</strong><span>開始行動</span></summary><p>啟動改變或由研究者操控的變量。<strong>例子：</strong>為期四週的結構化人工智能素養單元。</p></details>
                  <details class="variable-lens-leaf"><summary><strong>結果 · 因變量（Y）</strong><span>需要解釋的效果</span></summary><p>會作出反應的變量：故事終點的行為或結果。<strong>例子：</strong>學生的單元後人工智能素養分數。</p></details>
                  <details class="variable-lens-leaf"><summary><strong>背景 · 控制變量</strong><span>保持一致</span></summary><p>被固定下來、以免干擾主要比較的因素。<strong>例子：</strong>每位學生均使用相同的單元長度、學習平台和評分工具。</p></details>
                  <details class="variable-lens-leaf"><summary><strong>橋樑 · 中介變量（M）</strong><span>X 如何或為何導向 Y</span></summary><p>連結 X 與 Y 的內部機制：X → M → Y。<strong>例子：</strong>引導式人工智能實作可能連結結構化教學與人工智能素養分數。</p></details>
                  <details class="variable-lens-leaf"><summary><strong>情境 · 調節變量（W）</strong><span>何時或對誰 X 導向 Y</span></summary><p>改變 X → Y 關係強度的邊界條件。<strong>例子：</strong>先前人工智能經驗可能改變教學與人工智能素養分數的關係強度。</p></details>
                </div>
              </section>
              <section class="variable-lens-branch" aria-labelledby="variable-data-heading-zh">
                <div class="variable-lens-question">
                  <span>問題 2</span><h3 id="variable-data-heading-zh">它的資料類型是甚麼？</h3><p>數學結構：它如何被測量，以及適合使用哪些統計工具。</p>
                </div>
                <div class="variable-lens-list">
                  <details class="variable-lens-leaf variable-data-lens"><summary><strong>類別／質性</strong><span>文字、群組或標籤</span></summary><div class="variable-data-lens-detail"><div>以文字、群組或標籤描述的資料。</div><div class="variable-lens-subtypes"><div><strong>名義</strong><span>沒有次序的類別。<b>例子：</b>教學條件：結構化單元或一般課程活動。</span></div><div><strong>序數</strong><span>有次序、但距離未必精確的類別。<b>例子：</b>自評人工智能信心：不同意、中立或同意。</span></div></div></div></details>
                  <details class="variable-lens-leaf variable-data-lens"><summary><strong>數值／量化</strong><span>真正的數量</span></summary><div class="variable-data-lens-detail"><div>以具有量化意義的數字表示的資料。</div><div class="variable-lens-subtypes"><div><strong>離散</strong><span>固定、可數的數值。<b>例子：</b>完成的引導式人工智能實作任務數量。</span></div><div><strong>連續</strong><span>在一定範圍內可取無限小數值的測量。<b>例子：</b>投入引導式人工智能實作的時間。</span></div></div></div></details>
                </div>
              </section>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="slide relationship-types-slide" data-title="Instruction · Types of variable relationships" aria-hidden="true">
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Instruction</span><button class="translate-button" type="button" aria-pressed="false">中文</button></header>
        <div class="language-panel" data-language="en">
          <h2>Types of variable relationships</h2>
          <p class="lead small-lead">Read the arrow before interpreting a model: variables may move together, one may predict another, or a third may change the relationship between them.</p>
          <div class="relationship-type-grid">
            <article class="relationship-type-card">
              <span class="relationship-type-kicker">Symmetrical / association</span>
              <h3>Variables change together</h3>
              <div class="relationship-visual association-visual" role="img" aria-label="Variable A and Variable B connected by a curved two-headed arrow."><span class="relationship-node node-a">A</span><span class="association-path" aria-hidden="true"></span><span class="relationship-node node-b">B</span></div>
              <p><strong>Concept:</strong> A and B change together, but neither is necessarily causing the other.</p>
              <p class="relationship-math"><strong>Math term:</strong> covariance or correlation</p>
              <p class="relationship-examples"><strong>Examples:</strong><span>Ice-cream sales and shark attacks both rise in summer; one does not cause the other.</span><span>Guided AI practice and AI-literacy scores may covary because prior AI experience affects both.</span></p>
            </article>
            <article class="relationship-type-card">
              <span class="relationship-type-kicker">Asymmetrical / causal</span>
              <h3>One variable predicts another</h3>
              <div class="relationship-visual causal-visual" role="img" aria-label="Variable X points directly to Variable Y."><span class="relationship-node node-x">X</span><span class="causal-path" aria-hidden="true"></span><span class="relationship-node node-y">Y</span></div>
              <p><strong>Concept:</strong> One variable directly predicts, influences or changes another in a specified direction.</p>
              <p class="relationship-math"><strong>Math term:</strong> regression; a directional beta coefficient</p>
              <p class="relationship-examples"><strong>Examples:</strong><span>Hours studied → exam score.</span><span>Structured AI-literacy instruction → post-module AI-literacy score.</span></p>
            </article>
            <article class="relationship-type-card">
              <span class="relationship-type-kicker">Conditional / interaction</span>
              <h3>A third variable changes the arrow</h3>
              <div class="relationship-visual interaction-visual" role="img" aria-label="Moderator W points to the arrow from Variable X to Variable Y."><span class="relationship-node node-w">W</span><span class="moderation-path" aria-hidden="true"></span><span class="relationship-node node-x">X</span><span class="causal-path" aria-hidden="true"></span><span class="relationship-node node-y">Y</span></div>
              <p><strong>Concept:</strong> The X–Y relationship is not fixed; it changes depending on a third variable.</p>
              <p class="relationship-math"><strong>Math term:</strong> interaction effect or moderation</p>
              <p class="relationship-examples"><strong>Examples:</strong><span>Exercise → muscle mass is stronger or weaker depending on diet.</span><span>Prior AI experience may change how strongly instruction relates to AI-literacy scores.</span></p>
            </article>
          </div>
        </div>
        <div class="language-panel" data-language="zh" hidden lang="zh-Hant">
          <h2>變量關係的類型</h2>
          <p class="lead small-lead">在解讀模型前，先閱讀箭頭：變量可以一起變化、一個預測另一個，或由第三個變量改變兩者之間的關係。</p>
          <div class="relationship-type-grid">
            <article class="relationship-type-card">
              <span class="relationship-type-kicker">對稱／關聯</span>
              <h3>變量一起變化</h3>
              <div class="relationship-visual association-visual" role="img" aria-label="變量 A 與變量 B 由彎曲的雙向箭頭連結。"><span class="relationship-node node-a">A</span><span class="association-path" aria-hidden="true"></span><span class="relationship-node node-b">B</span></div>
              <p><strong>概念：</strong>A 與 B 一起變化，但不代表其中一個必然造成另一個。</p>
              <p class="relationship-math"><strong>數學術語：</strong>共變異數或相關</p>
              <p class="relationship-examples"><strong>例子：</strong><span>雪糕銷量與鯊魚襲擊事件在夏季同時上升；兩者並非互為因果。</span><span>引導式人工智能實作與人工智能素養分數可能一起變化，因為先前人工智能經驗同時影響兩者。</span></p>
            </article>
            <article class="relationship-type-card">
              <span class="relationship-type-kicker">非對稱／因果</span>
              <h3>一個變量預測另一個</h3>
              <div class="relationship-visual causal-visual" role="img" aria-label="變量 X 直接指向變量 Y。"><span class="relationship-node node-x">X</span><span class="causal-path" aria-hidden="true"></span><span class="relationship-node node-y">Y</span></div>
              <p><strong>概念：</strong>一個變量以指定方向直接預測、影響或改變另一個變量。</p>
              <p class="relationship-math"><strong>數學術語：</strong>迴歸；方向性的 beta 係數</p>
              <p class="relationship-examples"><strong>例子：</strong><span>溫習時數 → 考試分數。</span><span>結構化人工智能素養教學 → 單元後人工智能素養分數。</span></p>
            </article>
            <article class="relationship-type-card">
              <span class="relationship-type-kicker">條件／交互作用</span>
              <h3>第三個變量改變箭頭</h3>
              <div class="relationship-visual interaction-visual" role="img" aria-label="調節變量 W 指向變量 X 至變量 Y 的箭頭。"><span class="relationship-node node-w">W</span><span class="moderation-path" aria-hidden="true"></span><span class="relationship-node node-x">X</span><span class="causal-path" aria-hidden="true"></span><span class="relationship-node node-y">Y</span></div>
              <p><strong>概念：</strong>X 與 Y 的關係並非固定；它會因第三個變量而改變。</p>
              <p class="relationship-math"><strong>數學術語：</strong>交互作用效應或調節</p>
              <p class="relationship-examples"><strong>例子：</strong><span>運動 → 肌肉量的關係會因飲食而變強或變弱。</span><span>先前人工智能經驗可能改變教學與人工智能素養分數關係的強度。</span></p>
            </article>
          </div>
        </div>
      </div>
    </section>

