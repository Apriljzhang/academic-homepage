  .deck-controls button, .home-button { display: grid; min-width: 2.35rem; min-height: 2.35rem; place-items: center; border: 0; border-radius: 999px; padding: 0 .65rem; background: transparent; color: var(--green-mid); font: 700 .86rem/1 'Source Sans 3', sans-serif; text-decoration: none; cursor: pointer; }
  .deck-controls button:hover, .home-button:hover { background: var(--green-soft); }
  .home-glyph { position: relative; display: block; width: .8rem; height: .62rem; margin-top: .2rem; border: 2px solid currentColor; border-top: 0; }
  .home-glyph::before { content: ''; position: absolute; top: -.34rem; left: .08rem; width: .48rem; height: .48rem; border-top: 2px solid currentColor; border-left: 2px solid currentColor; transform: rotate(45deg); }
  .slide-count { min-width: 4.5rem !important; }
