  .covariance-arc { position: relative; grid-column: 1; grid-row: 1 / -1; justify-self: end; width: 1.05rem; height: 3.2rem; border-right: 2px solid var(--green-mid); border-radius: 0 1.2rem 1.2rem 0; }
  .covariance-arc::before, .covariance-arc::after { content: ''; position: absolute; right: -.31rem; width: 0; height: 0; border-left: .38rem solid var(--green-mid); border-top: .23rem solid transparent; border-bottom: .23rem solid transparent; }
  .covariance-arc::before { top: -.13rem; transform: rotate(-42deg); }
