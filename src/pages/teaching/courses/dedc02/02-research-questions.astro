  .keyword-steps li::before { content: counter(keyword, decimal-leading-zero); color: var(--green-mid); font-size: .75rem; font-weight: 700; }
  .keyword-steps strong { margin: auto 0 .45rem; }
  .keyword-steps span { color: var(--muted); font-size: .85rem; line-height: 1.4; }
  .operator-line { display: flex; flex-wrap: wrap; align-items: center; gap: .55rem; margin-top: 1rem; color: var(--muted); font-size: .82rem; }
