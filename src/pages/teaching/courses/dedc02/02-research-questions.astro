    .pdf-cover h1 { margin: .35in 0 .55in; }
    .pdf-message-block { max-width: 9.5in; padding-top: .25in; border-top: 2px solid var(--green-mid); }
    .pdf-message-block h2 { font-size: 2rem; }
    .pdf-message-block p { white-space: pre-wrap; color: var(--muted); font-size: 1.1rem; line-height: 1.55; }
    .deck { min-height: 0; overflow: visible; }
    .slide { display: block !important; width: 13.333in; min-height: 7.5in; padding: .45in .65in; page-break-after: always; animation: none !important; }
    .slide-inner { min-height: 6.6in; }
    .deck-controls, .overview-dialog, .tool-dialog, .top-tools, .translate-button { display: none !important; }
  }
  @media (prefers-reduced-motion: reduce) { .slide.is-active { animation: none; } }
</style>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const currentLabel = document.querySelector<HTMLElement>('.slide-count span');
  const totalLabel = document.querySelector<HTMLElement>('[data-slide-total]');
  const progress = document.querySelector<HTMLElement>('.progress-track span');
  const overview = document.querySelector<HTMLDialogElement>('.overview-dialog');
  const overviewList = overview?.querySelector('ol');
  const globalTranslate = document.querySelector<HTMLButtonElement>('[data-global-translate]');
  let current = 0;
  if (totalLabel) totalLabel.textContent = String(slides.length);
  slides.forEach((slide) => { slide.dataset.language = 'en'; });

  function syncGlobalTranslate() {
    if (!globalTranslate) return;
    const isChinese = slides[current]?.dataset.language === 'zh';
    globalTranslate.textContent = isChinese ? 'English' : '中文';
    globalTranslate.setAttribute('aria-pressed', String(isChinese));
  }

  function showSlide(index: number) {
    current = Math.max(0, Math.min(slides.length - 1, index));
    slides.forEach((slide, slideIndex) => {
      const active = slideIndex === current;
      slide.classList.toggle('is-active', active);
      slide.setAttribute('aria-hidden', String(!active));
    });
    if (currentLabel) currentLabel.textContent = String(current + 1);
    if (progress) progress.style.width = `${((current + 1) / slides.length) * 100}%`;
    overviewList?.querySelectorAll('li').forEach((item, itemIndex) => item.classList.toggle('is-current', itemIndex === current));
    history.replaceState(null, '', `#slide-${current + 1}`);
    syncGlobalTranslate();
  }

  document.querySelectorAll<HTMLElement>('[data-nav]').forEach((button) => {
    button.addEventListener('click', () => showSlide(current + (button.dataset.nav === 'next' ? 1 : -1)));
  });

  globalTranslate?.addEventListener('click', () => {
    const slide = slides[current];
    if (!slide) return;
    const toChinese = slide.dataset.language !== 'zh';
    slide.dataset.language = toChinese ? 'zh' : 'en';
    slide.querySelectorAll<HTMLElement>('[data-language="en"]').forEach((panel) => panel.hidden = toChinese);
    slide.querySelectorAll<HTMLElement>('[data-language="zh"]').forEach((panel) => panel.hidden = !toChinese);
    syncGlobalTranslate();
  });

  if (overviewList) {
    slides.forEach((slide, index) => {
      const item = document.createElement('li');
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = slide.dataset.title || `Slide ${index + 1}`;
      button.addEventListener('click', () => { showSlide(index); overview?.close(); });
      item.append(button);
      overviewList.append(item);
    });
  }

  document.querySelector('[data-overview]')?.addEventListener('click', () => overview?.showModal());
  document.querySelector('[data-close-overview]')?.addEventListener('click', () => overview?.close());
  document.querySelector('[data-fullscreen]')?.addEventListener('click', () => document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen());

  document.querySelectorAll<HTMLButtonElement>('[data-variable-role-card]').forEach((card) => {
    card.addEventListener('click', () => {
      const flipped = card.classList.toggle('is-flipped');
      card.setAttribute('aria-pressed', String(flipped));
    });
  });

  const savedFields = Array.from(document.querySelectorAll<HTMLTextAreaElement>('textarea[data-save]'));
  savedFields.forEach((field) => {
    const key = `dedc02-w2-source-${field.dataset.save}`;
    try { field.value = localStorage.getItem(key) || ''; } catch {}
    field.addEventListener('input', () => { try { localStorage.setItem(key, field.value); } catch {} });
  });

  document.querySelectorAll<HTMLElement>('[data-build-examples]').forEach((buildForm) => {
    const triggers = Array.from(buildForm.querySelectorAll<HTMLButtonElement>('[data-build-example-toggle]'));
    triggers.forEach((trigger) => {
      const targetId = trigger.dataset.buildExampleToggle;
      const target = targetId ? document.getElementById(targetId) : null;
      if (!target) return;

      trigger.addEventListener('click', () => {
        const shouldOpen = trigger.getAttribute('aria-expanded') !== 'true';
        triggers.forEach((other) => {
          other.setAttribute('aria-expanded', 'false');
          const otherTargetId = other.dataset.buildExampleToggle;
          if (otherTargetId) {
            const otherTarget = document.getElementById(otherTargetId);
            if (otherTarget) otherTarget.hidden = true;
          }
        });
        if (shouldOpen) {
          trigger.setAttribute('aria-expanded', 'true');
          target.hidden = false;
        }
      });
    });
  });

  const revisionPairs = [
    ['topic', 'revise-topic'],
    ['problem', 'revise-problem'],
    ['purpose', 'revise-purpose'],
    ['question', 'revise-question'],
    ['topic-zh', 'revise-topic-zh'],
    ['problem-zh', 'revise-problem-zh'],
    ['purpose-zh', 'revise-purpose-zh'],
    ['question-zh', 'revise-question-zh'],
  ] as const;

  revisionPairs.forEach(([sourceName, revisionName]) => {
    const source = document.querySelector<HTMLTextAreaElement>(`textarea[data-save="${sourceName}"]`);
    const revision = document.querySelector<HTMLTextAreaElement>(`textarea[data-save="${revisionName}"]`);
    if (!source || !revision) return;

    const revisionKey = `dedc02-w2-source-${revisionName}`;
    const editedKey = `dedc02-w2-revision-edited-${revisionName}`;
    let revisionEdited = false;
    try {
      revisionEdited = localStorage.getItem(editedKey) === 'true' || (revision.value.trim().length > 0 && revision.value !== source.value);
    } catch {}

    const copyStartingPoint = () => {
      if (revisionEdited) return;
      revision.value = source.value;
      try { localStorage.setItem(revisionKey, revision.value); } catch {}
    };

    copyStartingPoint();
    source.addEventListener('input', copyStartingPoint);
    revision.addEventListener('input', () => {
      revisionEdited = true;
      try { localStorage.setItem(editedKey, 'true'); } catch {}
    });
  });

  document.querySelectorAll<HTMLElement>('[data-variable-match]').forEach((activity) => {
    const chips = Array.from(activity.querySelectorAll<HTMLButtonElement>('[data-role-chip]'));
    const slots = Array.from(activity.querySelectorAll<HTMLButtonElement>('[data-answer]'));
    const status = activity.querySelector<HTMLElement>('[data-variable-match-status]');
    const modelTitles = Array.from(activity.closest<HTMLElement>('.language-panel')?.querySelectorAll<HTMLElement>('[data-model-title]') || []);
    let selectedChip: HTMLButtonElement | null = null;

    function hideModelTitles() {
      modelTitles.forEach((title) => { title.textContent = title.dataset.modelWaiting || ''; });
    }

    function revealModelTitles() {
      modelTitles.forEach((title) => { title.textContent = title.dataset.modelAnswer || title.dataset.modelWaiting || ''; });
    }

    hideModelTitles();

    function selectChip(chip: HTMLButtonElement | null) {
      selectedChip = chip;
      chips.forEach((item) => {
        const selected = item === chip;
        item.classList.toggle('is-selected', selected);
        item.setAttribute('aria-pressed', String(selected));
      });
    }

    function clearMatchFeedback() {
      slots.forEach((slot) => slot.classList.remove('is-correct', 'is-incorrect'));
      if (status) status.textContent = '';
    }

    function checkAnswers() {
      const filled = slots.filter((slot) => slot.dataset.currentRole).length;
      clearMatchFeedback();
      if (filled < slots.length) {
        hideModelTitles();
        if (status) status.textContent = activity.dataset.incompleteMessage || '';
        return;
      }

      revealModelTitles();
      const correct = slots.filter((slot) => slot.dataset.currentRole === slot.dataset.answer).length;
      slots.forEach((slot) => {
        const isCorrect = slot.dataset.currentRole === slot.dataset.answer;
        slot.classList.toggle('is-correct', isCorrect);
        slot.classList.toggle('is-incorrect', !isCorrect);
      });
      if (status) status.textContent = correct === slots.length ? (activity.dataset.completeMessage || '') : (activity.dataset.reviewMessage || '');
    }

    function placeRole(slot: HTMLButtonElement, role: string, label: string) {
      slot.dataset.currentRole = role;
      slot.textContent = label;
      slot.classList.add('is-filled');
      hideModelTitles();
      clearMatchFeedback();
    }

    chips.forEach((chip) => {
      chip.setAttribute('aria-pressed', 'false');
      chip.addEventListener('click', () => selectChip(selectedChip === chip ? null : chip));
      chip.addEventListener('dragstart', (event) => {
        selectChip(chip);
        event.dataTransfer?.setData('application/x-dedc02-role', JSON.stringify({ role: chip.dataset.roleChip, label: chip.dataset.label || chip.textContent || '' }));
        if (event.dataTransfer) event.dataTransfer.effectAllowed = 'copy';
      });
    });

    slots.forEach((slot) => {
      slot.addEventListener('click', () => {
        if (!selectedChip?.dataset.roleChip) return;
        placeRole(slot, selectedChip.dataset.roleChip, selectedChip.dataset.label || selectedChip.textContent || '');
      });
      slot.addEventListener('dragover', (event) => { event.preventDefault(); slot.classList.add('is-dragover'); });
      slot.addEventListener('dragleave', () => slot.classList.remove('is-dragover'));
      slot.addEventListener('drop', (event) => {
        event.preventDefault();
        slot.classList.remove('is-dragover');
        try {
          const payload = JSON.parse(event.dataTransfer?.getData('application/x-dedc02-role') || '{}');
          if (payload.role && payload.label) placeRole(slot, payload.role, payload.label);
        } catch {}
      });
    });

    activity.querySelector('[data-variable-match-check]')?.addEventListener('click', checkAnswers);

    activity.querySelector('[data-variable-match-clear]')?.addEventListener('click', () => {
      slots.forEach((slot) => {
        slot.textContent = slot.dataset.placeholder || '';
        delete slot.dataset.currentRole;
        slot.classList.remove('is-filled', 'is-correct', 'is-incorrect', 'is-dragover');
      });
      selectChip(null);
      hideModelTitles();
      clearMatchFeedback();
    });
  });

  const timerInput = document.querySelector<HTMLInputElement>('[data-timer-minutes]');
  const timerStart = document.querySelector<HTMLButtonElement>('[data-timer-start]');
  const timerReset = document.querySelector<HTMLButtonElement>('[data-timer-reset]');
  const timerOutput = document.querySelector<HTMLOutputElement>('[data-timer-output]');
  const timerStatus = document.querySelector<HTMLElement>('[data-timer-status]');
  let timerRemainingMs = 0;
  let timerDeadline = 0;
  let timerInterval = 0;
  let timerDisplayActive = false;
  let audioContext: AudioContext | null = null;

  function formatTime(milliseconds: number) {
    const seconds = Math.max(0, Math.ceil(milliseconds / 1000));
    return `${String(Math.floor(seconds / 60)).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}`;
  }

  function paintTimer() {
    const time = formatTime(timerRemainingMs);
    if (timerOutput) { timerOutput.textContent = time; timerOutput.hidden = !timerDisplayActive; }
    if (timerInput) timerInput.hidden = timerDisplayActive;
  }

  async function primeAudio() {
    const AudioContextClass = window.AudioContext || (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
    if (!AudioContextClass) return;
    audioContext ||= new AudioContextClass();
    if (audioContext.state === 'suspended') await audioContext.resume();
  }

  function playDing() {
    if (!audioContext) return;
    const now = audioContext.currentTime;
    const gain = audioContext.createGain();
    gain.gain.setValueAtTime(0.0001, now);
    gain.gain.exponentialRampToValueAtTime(0.24, now + 0.02);
    gain.gain.exponentialRampToValueAtTime(0.0001, now + 1.1);
    gain.connect(audioContext.destination);
    [880, 1320].forEach((frequency) => {
      const oscillator = audioContext!.createOscillator();
      oscillator.type = 'sine';
      oscillator.frequency.setValueAtTime(frequency, now);
      oscillator.connect(gain);
      oscillator.start(now);
      oscillator.stop(now + 1.1);
    });
  }

  function stopTimer() {
    window.clearInterval(timerInterval);
    timerInterval = 0;
  }

  function finishTimer() {
    stopTimer();
    timerRemainingMs = 0;
    paintTimer();
    if (timerStart) timerStart.textContent = 'Start';
    if (timerStatus) timerStatus.textContent = 'Time is up.';
    timerOutput?.classList.add('is-finished');
    playDing();
    window.setTimeout(() => timerOutput?.classList.remove('is-finished'), 1200);
  }

  function tickTimer() {
    timerRemainingMs = Math.max(0, timerDeadline - Date.now());
    if (timerRemainingMs <= 0) finishTimer();
    else paintTimer();
  }

  timerStart?.addEventListener('click', async () => {
    if (timerInterval) {
      timerRemainingMs = Math.max(0, timerDeadline - Date.now());
      stopTimer();
      timerStart.textContent = 'Resume';
      if (timerStatus) timerStatus.textContent = 'Paused.';
      paintTimer();
      return;
    }
    if (timerRemainingMs <= 0) {
      const minutes = Number(timerInput?.value || 0);
      if (!Number.isFinite(minutes) || minutes <= 0) {
        if (timerStatus) timerStatus.textContent = 'Enter a time greater than 0 minutes.';
        timerInput?.focus();
        return;
      }
      timerRemainingMs = minutes * 60_000;
    }
    timerDisplayActive = true;
    await primeAudio();
    timerDeadline = Date.now() + timerRemainingMs;
    timerStart.textContent = 'Pause';
    if (timerStatus) timerStatus.textContent = 'Timer running. A ding will sound when time is up.';
    timerOutput?.classList.remove('is-finished');
    paintTimer();
    timerInterval = window.setInterval(tickTimer, 250);
  });

  timerReset?.addEventListener('click', () => {
    stopTimer();
    timerRemainingMs = 0;
    timerDeadline = 0;
    timerDisplayActive = false;
    if (timerStart) timerStart.textContent = 'Start';
    if (timerStatus) timerStatus.textContent = '';
    if (timerInput) timerInput.value = '';
    timerOutput?.classList.remove('is-finished');
    paintTimer();
    timerInput?.focus();
  });

  timerInput?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') { event.preventDefault(); timerStart?.click(); }
  });

  const pdfDialog = document.querySelector<HTMLDialogElement>('.pdf-dialog');
  const pdfMessage = document.querySelector<HTMLTextAreaElement>('[data-pdf-message]');
  const pdfMessagePrint = document.querySelector<HTMLElement>('[data-pdf-message-print]');
  const pdfStatus = document.querySelector<HTMLElement>('[data-pdf-status]');
  const originalTitle = document.title;
  try { if (pdfMessage) pdfMessage.value = localStorage.getItem('dedc02-w2-personal-pdf-message-v1') || ''; } catch {}
  pdfMessage?.addEventListener('input', () => {
    try { localStorage.setItem('dedc02-w2-personal-pdf-message-v1', pdfMessage.value); } catch {}
  });
  document.querySelectorAll('[data-pdf-open]').forEach((button) => button.addEventListener('click', () => {
    pdfDialog?.showModal();
    window.setTimeout(() => pdfMessage?.focus(), 0);
  }));
  document.querySelector('[data-pdf-download]')?.addEventListener('click', () => {
    const message = pdfMessage?.value.trim() || '';
    if (!message) {
      if (pdfStatus) pdfStatus.textContent = 'Type a message before creating your PDF.';
      pdfMessage?.focus();
      return;
    }
    if (pdfMessagePrint) pdfMessagePrint.textContent = message;
    document.title = 'DEDC02-W2-Research-Questions-personal-copy';
    pdfDialog?.close();
    window.requestAnimationFrame(() => window.print());
  });
  window.addEventListener('afterprint', () => { document.title = originalTitle; });

  document.addEventListener('keydown', (event) => {
    if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return;
    if (event.key === 'ArrowRight' || event.key === 'PageDown' || event.key === ' ') { event.preventDefault(); showSlide(current + 1); }
    if (event.key === 'ArrowLeft' || event.key === 'PageUp') { event.preventDefault(); showSlide(current - 1); }
    if (event.key === 'Home') showSlide(0);
    if (event.key === 'End') showSlide(slides.length - 1);
    if (event.key.toLowerCase() === 'o') overview?.showModal();
    if (event.key.toLowerCase() === 'f') document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen();
  });

  let touchX = 0;
  document.addEventListener('touchstart', (event) => { touchX = event.changedTouches[0]?.clientX || 0; }, { passive: true });
  document.addEventListener('touchend', (event) => {
    const dx = (event.changedTouches[0]?.clientX || 0) - touchX;
    if (Math.abs(dx) > 70) showSlide(current + (dx < 0 ? 1 : -1));
  }, { passive: true });

  const initialHash = Number(location.hash.replace('#slide-', ''));
  showSlide(Number.isFinite(initialHash) && initialHash > 0 ? initialHash - 1 : 0);
</script>
