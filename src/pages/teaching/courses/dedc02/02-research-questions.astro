    .hypothesis-pair, .compare-table, .three-source { grid-template-columns: 1fr; }
    .paradigm-three, .avoid-grid, .type-grid, .avoid-question-grid, .variable-form, .keyword-steps, .concept-grid, .pico-guides, .hypothesis-type-grid, .template-grid, .full-example-grid, .hypothesis-avoid-grid, .hypothesis-steps { grid-template-columns: repeat(2, 1fr); }
    .hypothesis-types-layout { grid-template-columns: 1fr; }
    .hypothesis-types-slide .hypothesis-type-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hypothesis-types-comic { width: min(100%, 38rem); margin: .65rem auto 0; }
    .illustration-layout, .confounder-layout, .hypothesis-introduction, .operationalization-layout, .literature-keyword-activity { grid-template-columns: 1fr; }
    .relationship-type-grid { grid-template-columns: 1fr; }
    .variable-lens-root { width: 100%; }
    .variable-lens-split, .variable-lens-branch::before { display: none; }
    .variable-lens-branches { grid-template-columns: 1fr; }
