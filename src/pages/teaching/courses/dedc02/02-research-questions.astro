    .paradigm-three, .avoid-grid, .type-grid, .avoid-question-grid, .variable-form, .keyword-steps, .concept-grid, .measure-examples, .hayes-model-grid, .pico-guides, .hypothesis-type-grid, .template-grid, .full-example-grid, .hypothesis-avoid-grid, .hypothesis-steps, .variable-lens-subtypes { grid-template-columns: 1fr; }
    .hypothesis-avoid-slide h2 { font-size: clamp(2.5rem, 12vw, 4rem); }
    .hypothesis-types-slide .hypothesis-type-grid { grid-template-columns: 1fr; }
