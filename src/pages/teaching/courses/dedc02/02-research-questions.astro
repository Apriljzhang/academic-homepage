  .overview-dialog ol { display: grid; grid-template-columns: repeat(2, 1fr); gap: .4rem; padding: 0; list-style-position: inside; }
  .overview-dialog li button { width: calc(100% - 2rem); border: 0; padding: .5rem; background: transparent; color: var(--green); text-align: left; cursor: pointer; }
  .overview-dialog li.is-current { background: var(--green-soft); }
  .overview-dialog > p { color: var(--muted); font-size: .8rem; }
