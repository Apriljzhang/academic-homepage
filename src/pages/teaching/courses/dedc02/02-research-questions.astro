  .sem-errors { display: grid; grid-template-columns: repeat(3, 1fr); gap: .25rem; }
  .sem-errors i { display: block; width: .42rem; height: .42rem; justify-self: center; border: 1px solid var(--green-mid); border-radius: 50%; }
  .measurement-arrow { position: relative; display: block; justify-self: center; width: 2px; height: .72rem; background: var(--green-mid); }
  .measurement-arrow::after { content: ''; position: absolute; bottom: -.02rem; left: 50%; width: 0; height: 0; border-top: .32rem solid var(--green-mid); border-left: .24rem solid transparent; border-right: .24rem solid transparent; transform: translateX(-50%); }
  .sem-structural-arrow { width: 100%; }
  .map-slot-explanation { min-height: 2.45rem; margin: 0; padding: .35rem .4rem; border-left: .18rem solid var(--green-mid); background: #fff; color: var(--muted); font-size: .64rem; line-height: 1.25; }
  .map-slot-explanation.is-active { border-color: #cb7436; background: #fff7f0; color: #75401f; }
