  .tool-dialog::backdrop { background: rgba(15,74,50,.35); }
  .tool-dialog h2 { margin: 0; font-size: 2rem; letter-spacing: -.02em; }
  .tool-dialog > p { color: var(--muted); }
  .tool-dialog-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-bottom: .7rem; border-bottom: 1px solid var(--line); }
  .tool-dialog-head button { border: 0; background: transparent; color: var(--green-mid); font-size: 2rem; cursor: pointer; }
  .pdf-message-entry { display: grid; gap: .4rem; color: var(--green); font-weight: 700; }
  .tool-actions { display: flex; gap: .6rem; margin-top: 1rem; }
  .tool-actions button { border: 1px solid var(--green-mid); border-radius: 999px; padding: .65rem 1rem; background: var(--green-mid); color: #fff; font: 700 .9rem/1 'Source Sans 3', sans-serif; cursor: pointer; }
  .tool-actions button.secondary { background: #fff; color: var(--green-mid); }
  .tool-status { min-height: 1.2rem; margin: .7rem 0 0; color: var(--muted); font-size: .82rem; }
  .pdf-message-entry textarea { min-height: 8rem; }
  @keyframes enter { from { opacity: 0; transform: translateX(8px); } to { opacity: 1; transform: none; } }
  @keyframes timer-pulse { 50% { transform: scale(1.05); } }
  @media (max-width: 820px) {
