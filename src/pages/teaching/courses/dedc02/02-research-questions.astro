    .plane-flip-card.diagram-node { min-height: 2.8rem; }
    .plane-card-face small { font-size: .58rem; }
    .diagram-relation b, .model-arrow { font-size: 1.45rem; }
    .variable-model-diagram { gap: .3rem .18rem; padding: .45rem; }
    .moderator-node { min-width: 4.8rem; }
    .model-node strong { font-size: .72rem; }
