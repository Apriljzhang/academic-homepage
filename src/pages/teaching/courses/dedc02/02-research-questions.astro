    .paradigm-three, .avoid-grid, .type-grid, .avoid-question-grid, .variable-types, .variable-form, .keyword-steps, .concept-grid, .measure-examples, .hayes-model-grid, .pico-guides, .hypothesis-type-grid, .template-grid, .full-example-grid, .mistake-grid, .hypothesis-steps { grid-template-columns: 1fr; }
    .operationalization-details div { grid-template-columns: 1fr; gap: .15rem; }
    .diagram-plane { gap: .35rem; padding: 1.65rem .5rem .7rem; }
    .diagram-node { min-height: 2.8rem; font-size: .78rem; }
