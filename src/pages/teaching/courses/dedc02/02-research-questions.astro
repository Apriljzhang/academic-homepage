                <span class="map-node iv-map-node">Intelligence</span><span class="map-arrow iv-map-arrow" aria-hidden="true">→</span><span class="map-node dv-map-node">Earning potential</span>
                <span class="map-node confounder-map-node">Socioeconomic background</span><span class="map-arrow confounder-left-arrow" aria-hidden="true">↖</span><span class="map-arrow confounder-right-arrow" aria-hidden="true">↗</span>
