    .paradigm-three, .avoid-grid, .type-grid, .avoid-question-grid, .variable-types, .variable-form, .keyword-steps, .concept-grid, .pico-guides, .hypothesis-type-grid, .template-grid, .full-example-grid, .mistake-grid, .hypothesis-steps { grid-template-columns: repeat(2, 1fr); }
    .illustration-layout, .variable-illustration, .confounder-layout, .hypothesis-introduction, .operationalization-layout { grid-template-columns: 1fr; }
