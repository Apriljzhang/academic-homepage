---
import CourseSlideLayout from '../../../../../layouts/CourseSlideLayout.astro';
import LessonDeckChrome from '../../../../../components/lessons/LessonDeckChrome.astro';
import Unit9Session1Mat from '../../../../../components/lessons/Unit9Session1Mat.astro';
import Unit9Session2Game from '../../../../../components/lessons/Unit9Session2Game.astro';
import { unit9Sessions, type Unit9Session } from '../../../../../data/generalEnglishUnit9';
import '../../../../../styles/general-english-unit5.css';
import '../../../../../styles/general-english-unit9.css';
import { withBase } from '../../../../../utils/paths';
export function getStaticPaths() {
  return unit9Sessions.map(session => ({ params: { session: session.slug }, props: { session } }));
}
interface Props { session: Unit9Session; }
const { session } = Astro.props;
const title = `${session.title.en} · Unit 9 Session ${session.number} · General English I · April Jiawei Zhang`;
const description = `Perspectives I, Unit 9: All in a day’s work. Session ${session.number}, 75 minutes. ${session.outcome.en}`;
const courseHref = withBase('/teaching/courses/general-english');
const next = unit9Sessions[session.number];
let elapsed = 0;
const slides = session.slides.map(slide => {
  const start = elapsed;
  elapsed += slide.minutes;
  return { ...slide, start, end: elapsed };
});
const languages = ['en', 'zh'] as const;
---
<CourseSlideLayout {title} {description} lessonDeck>
  <LessonDeckChrome {courseHref} courseLabel="General English I course materials" lessonTitle={`Unit 9 · Session ${session.number} · ${session.title.en}`} classDraw />
  <main class="deck u5-deck u9-deck" data-unit9-session={session.number} data-session-title={session.title.en} aria-label={`Unit 9 Session ${session.number}: ${session.title.en}`}>
    {slides.map((slide, index) => <section class:list={['slide', { 'is-active': index === 0 }]} data-title={slide.title.en} aria-hidden={index !== 0}>
      <div class="slide-inner">
        <header class="slide-header"><span class="eyebrow">Perspectives I · Unit 9 · Session {session.number} / 4</span><span class="u5-timing">{slide.minutes ? `${slide.start}–${slide.end} min · ${slide.minutes} min` : 'After class'}</span></header>
        {languages.map(lang => <div data-language={lang} lang={lang === 'zh' ? 'zh-Hant' : 'en'} hidden={lang !== 'en'}>
          {slide.cover && <div class="title-rule"></div>}
          {slide.cover ? <h1>{slide.title[lang]}</h1> : <h2>{slide.title[lang]}</h2>}
          <p class="lead">{slide.lead[lang]}</p>
          {slide.ref && <p class="u5-ebook"><span>{/\bp{1,2}\./.test(slide.ref) ? (lang === 'en' ? 'E-book reference' : '電子書參考') : (lang === 'en' ? 'Class task' : '課堂任務')}</span>{slide.ref}</p>}
          {slide.handoutCue && <aside class="u5-handout-cue" aria-label={lang === 'en' ? 'Handout support' : '講義支援'}><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 3h8l4 4v14H6z" /><path d="M14 3v5h4M9 12h6M9 16h6" /></svg><p>{slide.handoutCue[lang]}</p></aside>}
          {slide.reading && <article class="u5-reading" aria-label={lang === 'en' ? 'Class reading' : '課堂閱讀'}>{slide.reading.map(paragraph => <p><strong>[{paragraph.number}]</strong> {paragraph.text[lang]}</p>)}</article>}
          {slide.game && <Unit9Session2Game kind={slide.game} {lang} />}
          {slide.mat && <Unit9Session1Mat kind={slide.mat} {lang} />}
          {slide.timeline && <ol class="u9-timeline">{slide.timeline.map(point => <li>{point[lang]}</li>)}</ol>}
          {slide.wordBank && <dl class="u5-word-bank">{slide.wordBank.map(item => <div><dt lang="en">{item.word}</dt><dd>{item.meaning[lang]}</dd></div>)}</dl>}
          {slide.table && <div class="u5-table"><table><thead><tr>{slide.table.headers.map(header => <th scope="col">{header[lang]}</th>)}</tr></thead><tbody>{slide.table.rows.map(row => <tr>{row.map(cell => <td>{cell[lang]}</td>)}</tr>)}</tbody></table></div>}
          {slide.columns && <div class="u5-columns">{slide.columns.map(col => <article><h3>{col.title[lang]}</h3><ul>{col.lines.map(line => <li>{line[lang]}</li>)}</ul></article>)}</div>}
          {slide.example && <blockquote class="u5-example" lang="en">{slide.example}</blockquote>}
          {slide.steps && <ol class="u5-steps">{slide.steps.map(step => <li>{step[lang]}</li>)}</ol>}
          {slide.quiz && <div class="u5-quizzes">{slide.quiz.map((quiz) => <fieldset data-u9-quiz data-correct={quiz.correct} data-explanation={quiz.feedback[lang]} data-language-code={lang}><legend>{quiz.prompt[lang]}</legend><div class="u5-choices">{quiz.choices.map((choice, choiceIndex) => <button type="button" data-choice={choiceIndex} aria-pressed="false">{choice[lang]}</button>)}</div><p class="u5-feedback" data-quiz-feedback role="status"></p></fieldset>)}</div>}
          {slide.practice && <><ol class="u5-practice" start={slide.practice[0]?.number}>{slide.practice.map(item => <li value={item.number} lang="en">{item.prompt}</li>)}</ol><details class="u5-reveal"><summary>{lang === 'en' ? 'Check answers' : '核對答案'}</summary><ol class="u5-practice u5-answers" start={slide.practice[0]?.number}>{slide.practice.map(item => <li value={item.number} lang="en">{item.answer}</li>)}</ol></details></>}
          {slide.reveal && <details class="u5-reveal"><summary>{slide.reveal.title[lang]}</summary><ul>{slide.reveal.lines.map(line => <li>{line[lang]}</li>)}</ul></details>}
          {slide.fields && <div class="u9-responses">{slide.fields.map(field => <label class="u9-field" for={`${slide.id}-${field.key}-${lang}`}>
            <span>{field.label[lang]}</span>
            <textarea id={`${slide.id}-${field.key}-${lang}`} data-u9-field={field.key} data-field-label={field.label.en} rows={field.rows} placeholder={field.hint || (lang === 'en' ? 'Write in English, or prepare brief notes before speaking.' : '用英語寫作，或先準備簡短口語筆記。')} spellcheck="true" lang="en"></textarea>
            <span class="u9-field-status" data-u9-status role="status"></span>
          </label>)}</div>}
          {slide.teacher && <details class="u5-reveal u9-teacher"><summary>{lang === 'en' ? 'Teaching note' : '教學提示'}</summary><p>{slide.teacher[lang]}</p></details>}
          {slide.export && <div class="u9-export"><p>{lang === 'en' ? 'Writing stays in this browser and is not submitted. Download your notes to keep a copy.' : '文字保留於此瀏覽器，不會提交；請下載筆記以保留副本。'}</p><button type="button" data-u9-download>{lang === 'en' ? 'Download my work' : '下載我的作品'}</button><button type="button" data-u9-print>{lang === 'en' ? 'Print my work' : '列印我的作品'}</button><a href={withBase('/teaching/courses/general-english/unit-9/practice')}>{lang === 'en' ? 'Practice sheets' : '練習紙'}</a><p data-u9-export-status role="status"></p></div>}
          {slide.takeaway && <p class="u5-takeaway">{slide.takeaway[lang]}</p>}
          {slide.links && <p class="u5-links">{slide.links.map(link => <a href={link.href.startsWith('/') ? withBase(link.href) : link.href} download={link.download || undefined} target={link.href.startsWith('/') ? undefined : '_blank'} rel={link.href.startsWith('/') ? undefined : 'noopener noreferrer'}>{link.label[lang]}</a>)}</p>}
          {slide.source && <p class="source-note">{slide.source[lang]}</p>}
          {index === slides.length - 1 && <p class="u5-next"><a href={withBase('/teaching/courses/general-english/unit-9')}>{lang === 'en' ? 'Unit 9 overview' : '第九單元總覽'}</a>{next && <a href={withBase(`/teaching/courses/general-english/unit-9/${next.slug}`)}>{lang === 'en' ? `Next: Session ${next.number}` : `下一節：第${next.number}節`}</a>}</p>}
        </div>)}
      </div>
    </section>)}
  </main>
  <article class="u9-print-notes" aria-label="My lesson work"></article>
  <script>import '../../../../../scripts/generalEnglishUnit9';</script>
</CourseSlideLayout>
