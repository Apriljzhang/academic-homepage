---
import { withBase } from '../../../../utils/paths';
const prompts = [
  ['Where is it?', '它在哪裡？'], ['When did you go there?', '你何時到訪？'],
  ['How old is it?', '它有多少年歷史？'], ['Why is it special?', '它有甚麼特別？'],
  ['Who lives or used to live there?', '誰住在那裡，或曾經住在那裡？'], ['What did you do there?', '你在那裡做了甚麼？'],
];
---
<!doctype html><html lang="en-GB"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><title>My secret home · General English worksheet</title><meta name="description" content="A printable two-page planning and writing worksheet for General English, Perspectives II, Unit 2E." /></head>
<body>
  <nav><a href={withBase('/teaching/courses/general-english')}>← General English</a><button type="button" id="print-worksheet">Print worksheet / 列印工作紙</button></nav>
  <main>
    <section class="sheet">
      <p class="meta">General English · Perspectives II · Unit 2E</p><h1>My secret home</h1>
      <p>Name / 姓名: __________________________ &nbsp; Class / 班別: ______________</p>
      <h2>1. My theme / 我的主題</h2><p>□ A game base &nbsp; □ An idol retreat &nbsp; □ A dream escape</p>
      <p>Invent a home and imagine your visit. Keep the owner, game or theme secret.<br /><span lang="zh-Hant">設計一個虛構的家，想像自己曾經到訪。暫時保密屋主、遊戲或主題。</span></p>
      <h2>2. Six details / 六項資料</h2><div class="boxes">{prompts.map(([en,zh],i)=><div><b>{i+1}. {en}</b><span lang="zh-Hant">{zh}</span></div>)}</div>
      <h2>3. My words and clues / 詞語與線索</h2>
      <p class="bank">bright 明亮的 · colourful 色彩繽紛的 · modern 現代的 · unusual 不尋常的<br />small 小的 · spacious 寬敞的 · cosy 舒適溫馨的 · comfortable 舒服的<br />peaceful 寧靜的 · quiet 安靜的 · noisy 嘈雜的 · lively 熱鬧的</p>
      <p>My four adjectives: ___________________________________________________</p><p>My two clues: ________________________________________________________</p>
    </section>
    <section class="sheet">
      <p class="meta">General English · Perspectives II · Unit 2E</p><h1>A visit to my secret home</h1>
      <p>Write 80–100 words. Include six details, four adjectives and two clues.<br /><span lang="zh-Hant">寫80–100個英文單字，包含六項資料、四個形容詞和兩項線索。</span></p>
      <p class="support">Last ___, I visited ___. It is in/on/near ___. It is ___ years old.<br />It is special because ___. ___ lives / used to live there.<br />During my visit, I ___. My favourite part was ___ because ___.</p>
      <p class="small">Support option: begin with six clear sentences. / 支援選項：先寫六句清楚的句子。</p>
      <div class="writing-lines" aria-label="Space for your handwritten description">{Array.from({length:12},()=> <div></div>)}</div>
      <h2>Reader check / 讀者檢查</h2><p>□ Six details &nbsp; □ Four suitable adjectives &nbsp; □ One useful suggestion</p>
      <p>I think the owner, game or theme is __________________ because ______________<br />____________________________________________________________________</p>
      <h2>Exit ticket / 離堂小結</h2><p>My improved sentence: __________________________________________________<br />____________________________________________________________________</p><p>One adjective I can use again: ______________________________________________</p>
    </section>
  </main>
  <script>document.querySelector('#print-worksheet')?.addEventListener('click',()=>window.print());</script>
</body></html>
<style is:global>
  *{box-sizing:border-box}body{margin:0;background:#f3f6f3;color:#173c2b;font:16px/1.5 Arial,'PingFang TC',sans-serif}nav{display:flex;align-items:center;justify-content:space-between;gap:1rem;max-width:210mm;margin:1rem auto;padding:0 1rem}a{color:#1f6b45}button{border:1px solid #1f6b45;border-radius:4px;padding:.7rem 1rem;background:#fff;color:#1f6b45;cursor:pointer;font:inherit;min-height:44px}button:focus-visible,a:focus-visible{outline:3px solid #1f6b45;outline-offset:3px}.sheet{max-width:210mm;min-height:285mm;margin:1rem auto;padding:15mm;background:#fff}.meta{font-size:11px;border-bottom:1px solid #bad8c5;padding-bottom:6px}h1{font-size:28px;margin:12px 0}h2{font-size:17px;margin:16px 0 6px}p{margin:8px 0}.boxes{display:grid;grid-template-columns:1fr 1fr;gap:10px}.boxes>div{border:1px solid #9ab9a6;padding:8px;min-height:31mm;font-size:13px}.boxes span{display:block;font-size:11px;color:#506b5b}.bank,.support{font-size:13px;padding:10px;border:1px solid #bad8c5}.writing-lines>div{height:8mm;border-bottom:1px solid #9ab9a6}.small{font-size:12px}@media(max-width:600px){body{font-size:14px}.sheet{padding:1rem;min-height:0}.boxes{grid-template-columns:1fr}nav{flex-wrap:wrap}}@page{size:A4;margin:0}@media print{body{background:#fff;color:#000;font-size:11pt;line-height:1.45}nav{display:none}.sheet{width:210mm;max-width:none;height:297mm;min-height:0;margin:0;padding:13mm 15mm;break-after:page}.sheet:last-child{break-after:auto}h1{font-size:22pt}h2{font-size:12pt}.boxes{grid-template-columns:1fr 1fr}.boxes>div{min-height:31mm}.bank,.support{font-size:10pt}.meta{font-size:9pt}.writing-lines>div{height:8mm}.small{font-size:9pt}}
</style>
