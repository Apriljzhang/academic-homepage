---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
import PageShell from '../../../../components/PageShell.astro';
import { withBase } from '../../../../utils/paths';
const title = 'General English · April Jiawei Zhang';
const description = 'Undergraduate General English teaching materials using Perspectives II. Interactive lessons with games, descriptive language and supported writing.';
---
<BaseLayout {title} {description}>
  <SiteHeader />
  <main id="main-content" class="min-h-[50vh] w-full bg-page">
    <PageShell accentBar>
      <p class="type-label text-secondary">Undergraduate course</p>
      <h1 class="mt-2 font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl lg:text-5xl">General English</h1>
      <p class="type-intro mt-4">Perspectives II</p>
      <div class="mt-8 max-w-4xl border-t border-border pt-6">
        <h2 class="type-label text-secondary">Course materials</h2>
        <ol class="mt-4 grid gap-2">
          <li><a href={withBase('/teaching/courses/general-english/special-places')} class="group flex items-center justify-between gap-3 rounded-lg border border-border bg-surface px-4 py-3 no-underline hover:border-secondary"><span class="font-semibold text-ink group-hover:text-secondary">Week 9. Special things, special places</span><span class="text-secondary" aria-hidden="true">→</span></a></li>
        </ol>
        <p class="mt-4 text-sm text-muted">Perspectives II, Unit 2E · Writing a description</p>
      </div>
      <a href={withBase('/teaching/approach')} class="mt-8 inline-flex text-sm font-semibold">← Back to CityU courses</a>
    </PageShell>
  </main>
  <SiteFooter />
</BaseLayout>
