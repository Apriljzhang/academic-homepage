---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
import PageShell from '../../../../components/PageShell.astro';
import { withBase } from '../../../../utils/paths';
import { unit5Sessions } from '../../../../data/generalEnglishUnit5';
const title = 'General English I · Perspectives I · April Jiawei Zhang';
const description = 'General English I for first-year undergraduates using Perspectives I. Interactive lesson slides, e-book activities, Class F and Class D name draws and an activity timer.';
---
<BaseLayout {title} {description}>
  <SiteHeader />
  <main id="main-content" class="min-h-[50vh] w-full bg-page">
    <PageShell accentBar>
      <p class="type-label text-secondary">Undergraduate course</p>
      <h1 class="mt-2 font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl lg:text-5xl">General English I</h1>
      <p class="type-intro mt-4">Perspectives I · First-year undergraduates</p>
      <div class="mt-8 max-w-4xl border-t border-border pt-6">
        <h2 class="text-xl font-semibold text-ink">Unit 5. Family and friends</h2>
        <p class="mt-2 text-muted">Four sessions of 75 minutes. Use the slides with your e-book; audio and video are in the e-book.</p>
        <ol class="mt-4 grid gap-2">
          {unit5Sessions.map(session => <li><a href={withBase(`/teaching/courses/general-english/unit-5/${session.slug}`)} class="inline-block py-2 font-semibold">{session.number}. {session.title.en}</a><span class="ml-3 text-sm text-muted">{session.sections}</span></li>)}
        </ol>
        <a href={withBase('/teaching/courses/general-english/unit-5')} class="mt-3 inline-flex text-sm font-semibold">Unit 5 overview and learning goals</a>
      </div>
      <div class="mt-8 max-w-4xl border-t border-border pt-6">
        <h2 class="text-xl font-semibold text-ink">Earlier lesson</h2>
        <a href={withBase('/teaching/courses/general-english/special-places')} class="mt-3 inline-block py-2 font-semibold">Special things, special places</a>
        <p class="mt-1 text-sm text-muted">Week 9 · Perspectives I, Unit 2E · Writing a description</p>
      </div>
      <a href={withBase('/teaching/approach')} class="mt-8 inline-flex text-sm font-semibold">← Back to CityU courses</a>
    </PageShell>
  </main>
  <SiteFooter />
</BaseLayout>
