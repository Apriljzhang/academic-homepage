---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../../components/SiteHeader.astro';
import SiteFooter from '../../../../../components/SiteFooter.astro';
import PageShell from '../../../../../components/PageShell.astro';
import { unit5Sessions } from '../../../../../data/generalEnglishUnit5';
import { withBase } from '../../../../../utils/paths';
const title = 'Family and friends · Unit 5 · General English I · April Jiawei Zhang';
const description = 'Perspectives I, Unit 5: Family and friends. Four 75-minute interactive lessons for first-year undergraduate General English.';
---
<BaseLayout {title} {description}>
  <SiteHeader />
  <main id="main-content" class="min-h-[50vh] w-full bg-page">
    <PageShell accentBar>
      <p class="type-label text-secondary">General English I · Perspectives I · Unit 5</p>
      <h1 class="mt-2 font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl lg:text-5xl">Family and friends</h1>
      <p class="type-intro mt-4">Four sessions, 75 minutes each. Talk about your people, explore experiences and celebrations, and invite someone into your group.</p>
      <p class="mt-4 max-w-3xl text-muted">Use your e-book alongside the slides. Page numbers refer to the printed page numbers; play the audio and video inside the e-book. Each deck includes Class F and Class D name draws, the activity timer and Chinese support.</p>
      <ol class="mt-8 max-w-4xl divide-y divide-border border-y border-border">
        {unit5Sessions.map(session => <li class="py-5">
          <h2 class="text-xl font-semibold"><a href={withBase(`/teaching/courses/general-english/unit-5/${session.slug}`)}>{session.number}. {session.title.en}</a></h2>
          <p class="mt-1 text-sm text-muted">{session.sections} · pp. {session.pages} · 75 minutes</p>
          <p class="mt-2">{session.outcome.en}</p>
          {session.handout && <p class="mt-2 text-sm"><a href={withBase(session.handout)} download>{session.number === 4 ? 'Celebration calendar and worksheet (PDF)' : 'Student reading and practice (PDF)'}</a></p>}
          {session.number === 4 && <p class="mt-2 text-sm"><a href={withBase('/teaching/courses/general-english/unit-5/invitations-language-bank.pdf')} download>Invitation language bank (PDF)</a></p>}
        </li>)}
      </ol>
      <div class="mt-8 max-w-3xl">
        <h2 class="text-xl font-semibold">Your Unit 5 work</h2>
        <p class="mt-3">In Session 4, build your own celebration calendar, invite classmates, and record who can attend. Use what you learn to write an informal invitation and a polite reply. Keep your calendar, invitation map and written notes as your Unit 5 work.</p>
      </div>
      <a href={withBase('/teaching/courses/general-english')} class="mt-8 inline-flex text-sm font-semibold">← General English I</a>
    </PageShell>
  </main>
  <SiteFooter />
</BaseLayout>
