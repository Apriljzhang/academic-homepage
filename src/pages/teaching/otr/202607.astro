---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import OtrProtectedDeck from '../../../components/teaching/OtrProtectedDeck';
import { person } from '../../../data/cv';

const title = `Assessment for/as Learning in the Age of AI · Open Teaching Resources · ${person.fullDisplayName}`;
const description =
  'A password-protected full-window information deck for Capital Normal University students on Assessment for/as Learning and learner agency in the age of generative AI.';
---

<BaseLayout {title} {description}>
  <main id="main-content" class="h-dvh min-h-dvh w-full overflow-hidden bg-page">
    <OtrProtectedDeck client:load />
  </main>
</BaseLayout>

<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
  }

  .otr-deck button,
  .otr-deck a {
    touch-action: manipulation;
  }

  @media print {
    html,
    body {
      height: auto;
      overflow: visible;
    }

    .otr-deck {
      height: auto !important;
      min-height: 0 !important;
    }
  }
</style>
