---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PageShell from '../../../components/PageShell.astro';
import SectionSubnav from '../../../components/SectionSubnav.astro';
import { teachingSubnav } from '../../../data/sectionNav';
import { person } from '../../../data/cv';
import { withBase } from '../../../utils/paths';

const title = `Open Teaching Resources · ${person.fullDisplayName}`;
const description = `Open, interactive teaching resources by ${person.fullDisplayName}, organised by year and month.`;
---

<BaseLayout {title} {description}>
  <SiteHeader />
  <main id="main-content" class="min-h-0 w-full bg-page">
    <PageShell accentBar>
      <SectionSubnav ariaLabel="Teaching section" items={teachingSubnav} />
      <div class="py-6">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">Teaching library</p>
        <h1 class="mt-2 font-serif text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Open Teaching Resources</h1>
        <p class="mt-4 max-w-3xl text-pretty text-lg leading-relaxed text-muted">
          Reusable teaching materials for educators and learners. Resources are organised by publication year and month
          and designed to work on phones, laptops and classroom displays.
        </p>

        <section class="mt-10" aria-labelledby="resources-2026">
          <div class="flex items-end justify-between gap-4 border-b border-border pb-3">
            <h2 id="resources-2026" class="font-serif text-2xl font-semibold text-ink">2026</h2>
            <span class="font-mono text-xs font-bold text-muted">1 resource</span>
          </div>
          <ul class="mt-5">
            <li>
              <a
                href={withBase('/teaching/otr/202607')}
                class="group grid gap-5 rounded-2xl border border-border bg-surface p-5 text-ink no-underline shadow-sm transition-transform hover:-translate-y-0.5 hover:border-secondary motion-reduce:transform-none sm:grid-cols-[8rem_1fr_auto] sm:items-center"
              >
                <div>
                  <p class="font-mono text-sm font-bold text-primary">2026 / 07</p>
                  <p class="mt-1 text-xs uppercase tracking-wide text-muted">150 minutes</p>
                </div>
                <div>
                  <h3 class="font-serif text-xl font-semibold group-hover:text-primary">
                    Assessment for/as Learning in the Age of AI
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-muted">
                    A password-protected 150-minute information deck for Capital Normal University students on keeping
                    thinking, judgement and learner agency when AI can complete the task.
                  </p>
                </div>
                <span class="text-2xl text-primary" aria-hidden="true">→</span>
              </a>
            </li>
          </ul>
        </section>
      </div>
    </PageShell>
  </main>
  <SiteFooter />
</BaseLayout>
