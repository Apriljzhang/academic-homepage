---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageShell from '../../components/PageShell.astro';
import SectionSubnav from '../../components/SectionSubnav.astro';
import MainWithAside from '../../components/MainWithAside.astro';
import TeachingSectionAside from '../../components/TeachingSectionAside.astro';
import { teachingSubnav } from '../../data/sectionNav';
import { person } from '../../data/cv';
import { doingResearchTheme, eapTrainingTheme } from '../../data/training';
import { withBase } from '../../utils/paths';

const title = `Training · ${person.fullDisplayName}`;
const description = `Doing Research, English for Academic Purposes and professional-development materials — ${person.fullDisplayName}.`;
const doingResearchPath = withBase(`/teaching/training/${doingResearchTheme.slug}`);
const studentPath = withBase('/teaching/training/app/');
const hostPath = withBase('/teaching/training/app/host');
const tirfPath = withBase('/teaching/training/tirf/');
const qMethodologyPath = withBase('/teaching/training/q-methodology/');
const themePath = withBase(`/teaching/training/${eapTrainingTheme.slug}`);
---

<BaseLayout {title} {description}>
  <SiteHeader />
  <main id="main-content" class="min-h-[50vh] w-full bg-page">
    <PageShell accentBar>
      <h1 class="font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl lg:text-5xl">Training</h1>
      <MainWithAside asideLabel="Teaching menu" wide>
        <div>
          <SectionSubnav ariaLabel="Teaching section" items={teachingSubnav} />

          <p class="type-intro mt-8 text-pretty">
            Training themes, interactive workshops, and professional-development materials for language education.
            Browse the open materials below or enter an access code for a training room.
          </p>

          <h2 class="type-label mt-8 text-secondary">Courses</h2>
          <ul class="mt-3 grid gap-2 sm:grid-cols-2" aria-label="Courses">
            <li>
              <a href={doingResearchPath} class="group flex min-h-24 items-center justify-between gap-3 rounded-lg border border-border bg-surface px-4 py-3 no-underline transition hover:border-secondary hover:bg-main-faint">
                <span>
                  <span class="block text-xs font-semibold uppercase tracking-[0.12em] text-secondary">Research Literacy</span>
                  <span class="mt-1 block text-base font-semibold text-ink group-hover:text-secondary">Doing Research</span>
                </span>
                <span class="shrink-0 text-lg text-secondary" aria-hidden="true">→</span>
              </a>
            </li>
            <li>
              <a href={themePath} class="group flex min-h-24 items-center justify-between gap-3 rounded-lg border border-border bg-surface px-4 py-3 no-underline transition hover:border-secondary hover:bg-main-faint">
                <span>
                  <span class="block text-xs font-semibold uppercase tracking-[0.12em] text-secondary">Research Literacy</span>
                  <span id="eap-theme-heading" class="mt-1 block text-base font-semibold text-ink group-hover:text-secondary">{eapTrainingTheme.title}</span>
                  <span class="mt-1 block text-sm text-muted">{eapTrainingTheme.context}</span>
                </span>
                <span class="shrink-0 text-lg text-secondary" aria-hidden="true">→</span>
              </a>
            </li>
          </ul>

          <h2 class="type-label mt-10 text-secondary">Selected workshops</h2>
          <ul class="mt-3 space-y-2">
            <li class="rounded-lg border border-border bg-surface px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">January 2026</p>
              <h2 class="mt-1 text-base font-semibold text-ink">
                Foundations and GenAI tools of Formative Assessment: Identifying the ‘Why’ and ‘How’
              </h2>
              <p class="mt-1 text-sm text-muted">
                ILTA Symposium · Lembaga Peperiksaan Malaysia · Selangor, Malaysia
              </p>
            </li>
            <li class="rounded-lg border border-border bg-surface px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">July 2026</p>
              <h2 class="mt-1 text-base font-semibold text-ink">
                Formative Assessment Frameworks & GenAI
              </h2>
              <p class="mt-1 text-sm text-muted">
                International Training and Testing Centre (ITTC) summer training · Capital Normal University
              </p>
              <div class="mt-3 flex flex-wrap items-center gap-2">
                <a
                  href={studentPath}
                  class="inline-flex rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white no-underline hover:opacity-95"
                >
                  Open workshop
                </a>
                <a
                  href={hostPath}
                  class="inline-flex rounded-full border border-border bg-page px-5 py-2.5 text-sm font-semibold text-ink no-underline hover:bg-surface"
                >
                  Instructor dashboard
                </a>
                <label for="trainingCode" class="sr-only">Enter access code</label>
                <input
                  id="trainingCode"
                  type="text"
                  inputmode="text"
                  autocomplete="off"
                  placeholder="Enter access code"
                  class="w-52 rounded-full border border-border bg-page px-4 py-2 text-sm font-normal text-ink"
                />
                <button
                  id="trainingOpen"
                  type="button"
                  class="rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white no-underline hover:opacity-95"
                >
                  Open with code
                </button>
              </div>
              <p id="trainingHint" class="mt-2 text-xs text-muted" hidden></p>
            </li>
            <li class="rounded-lg border border-border bg-surface px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">24 October 2026</p>
              <h2 class="mt-1 text-base font-semibold text-ink">AI Empowered Formative Assessment in TESOL: Designing Feedback Reflection and Learner Action</h2>
              <p class="mt-1 text-sm text-muted">AI4ELE / TIRF · BNBU, Zhuhai · A hands-on hour designing classroom language-assessment activities with Codex and WorkBuddy.</p>
              <form id="tirfEntry" class="mt-3 flex flex-wrap items-center gap-2">
                <label for="tirfCode" class="sr-only">TIRF workshop access code</label>
                <input id="tirfCode" name="code" type="text" inputmode="numeric" autocomplete="off" placeholder="Enter access code" required aria-describedby="tirfHint" class="w-52 rounded-full border border-border bg-page px-4 py-2 text-sm font-normal text-ink" />
                <button type="submit" class="rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white hover:opacity-95">Open TIRF workshop</button>
              </form>
              <p id="tirfHint" class="mt-2 text-xs text-muted" role="status" hidden></p>
              <a href={tirfPath} class="mt-2 inline-block text-sm">Workshop entry page</a>
            </li>
            <li class="rounded-lg border border-border bg-surface px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">November 2026</p>
              <h2 class="mt-1 text-base font-semibold text-ink">Q methodology for postgraduate research</h2>
              <p class="mt-1 text-sm text-muted">A 15 minute introduction to shared viewpoints, with a Q sorting activity and practical research guidance.</p>
              <form id="qMethodologyEntry" class="mt-3 flex flex-wrap items-center gap-2">
                <label for="qMethodologyCode" class="sr-only">Q methodology access code</label>
                <input id="qMethodologyCode" name="code" type="text" inputmode="numeric" autocomplete="off" placeholder="Enter access code" required aria-describedby="qMethodologyHint" class="w-52 rounded-full border border-border bg-page px-4 py-2 text-sm font-normal text-ink" />
                <button type="submit" class="rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white hover:opacity-95">Open Q methodology slides</button>
              </form>
              <p id="qMethodologyHint" class="mt-2 text-xs text-muted" role="status" hidden></p>
              <noscript><a href={qMethodologyPath}>Open the workshop entry page</a></noscript>
            </li>
          </ul>
        </div>
        <TeachingSectionAside slot="aside" />
      </MainWithAside>
    </PageShell>
  </main>
  <SiteFooter />

  <script is:inline define:vars={{ studentPath, hostPath, qMethodologyPath, tirfPath }}>
    (function () {
      const input = document.getElementById('trainingCode');
      const btn = document.getElementById('trainingOpen');
      const hint = document.getElementById('trainingHint');
      function open() {
        const code = (input?.value || '').trim().toLowerCase();
        if (code === '202610') {
          try { sessionStorage.setItem('tirf-202610-access', 'yes'); } catch {}
          window.location.href = tirfPath;
          return;
        }
        if (code === '202611') {
          try { sessionStorage.setItem('q-methodology-202611-access', 'yes'); } catch {}
          window.location.href = qMethodologyPath;
          return;
        }
        if (code === '202607') {
          window.location.href = studentPath;
          return;
        }
        if (code === '202607host') {
          window.location.href = hostPath;
          return;
        }
        if (hint) {
          hint.hidden = false;
          hint.textContent = 'Unrecognised code.';
          hint.style.color = '#a65d4a';
        }
      }
      btn?.addEventListener('click', open);
      input?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') open();
      });
      document.getElementById('tirfEntry')?.addEventListener('submit', (event) => {
        event.preventDefault();
        const input = document.getElementById('tirfCode');
        const hint = document.getElementById('tirfHint');
        if ((input?.value || '').trim() === '202610') {
          try { sessionStorage.setItem('tirf-202610-access', 'yes'); } catch {}
          window.location.href = tirfPath;
        } else if (hint) {
          hint.hidden = false;
          hint.textContent = 'That code does not match this workshop. Please check the code provided by your instructor.';
          input?.setAttribute('aria-invalid', 'true');
        }
      });
      document.getElementById('qMethodologyEntry')?.addEventListener('submit', (event) => {
        event.preventDefault();
        const qInput = document.getElementById('qMethodologyCode');
        const qHint = document.getElementById('qMethodologyHint');
        if ((qInput?.value || '').trim() === '202611') {
          try { sessionStorage.setItem('q-methodology-202611-access', 'yes'); } catch {}
          window.location.href = qMethodologyPath;
        } else if (qHint) {
          qHint.hidden = false;
          qHint.textContent = 'That code does not match this workshop. Please check the code provided by your instructor.';
          qInput?.setAttribute('aria-invalid', 'true');
        }
      });
    })();
  </script>
</BaseLayout>
