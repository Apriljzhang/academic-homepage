---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageShell from '../../components/PageShell.astro';
import SectionSubnav from '../../components/SectionSubnav.astro';
import MainWithAside from '../../components/MainWithAside.astro';
import TeachingSectionAside from '../../components/TeachingSectionAside.astro';
import { teachingSubnav } from '../../data/sectionNav';
import { person } from '../../data/cv';
import { eapTrainingTheme } from '../../data/training';
import { withBase } from '../../utils/paths';

const title = `Training · ${person.fullDisplayName}`;
const description = `English for Academic Purposes and interactive professional-development materials — ${person.fullDisplayName}.`;
const studentPath = withBase('/teaching/training/app/');
const hostPath = withBase('/teaching/training/app/host');
const themePath = withBase(`/teaching/training/${eapTrainingTheme.slug}`);

function sessionPath(slug: string): string {
  return withBase(`/teaching/training/${eapTrainingTheme.slug}/${slug}`);
}
---

<BaseLayout {title} {description}>
  <SiteHeader />
  <main id="main-content" class="min-h-[50vh] w-full bg-page">
    <PageShell accentBar>
      <h1 class="font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl lg:text-5xl">Training</h1>
      <MainWithAside asideLabel="Teaching menu" wide>
        <div>
          <SectionSubnav ariaLabel="Teaching section" items={teachingSubnav} />

          <p class="type-intro mt-8 text-pretty">
            Training themes, interactive workshops, and professional-development materials for language education.
            Browse the open materials below or enter an access code for a training room.
          </p>

          <section class="mt-10" aria-labelledby="eap-theme-heading">
            <div class="rounded-xl border border-border bg-surface p-5 sm:p-6">
              <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                <div class="max-w-3xl">
                  <p class="type-label text-secondary">Training theme · {eapTrainingTheme.shortTitle}</p>
                  <h2 id="eap-theme-heading" class="mt-2 font-serif text-2xl font-semibold text-ink sm:text-3xl">
                    {eapTrainingTheme.title}
                  </h2>
                  <p class="type-card-title mt-2 text-secondary">{eapTrainingTheme.context}</p>
                  <p class="type-body mt-3 text-muted">{eapTrainingTheme.description}</p>
                </div>
                <a
                  href={themePath}
                  class="inline-flex shrink-0 items-center rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white no-underline hover:opacity-95"
                >
                  Open theme →
                </a>
              </div>

              <ol class="mt-6 grid gap-2 sm:grid-cols-2">
                {
                  eapTrainingTheme.sessions.map((session) => (
                    <li>
                      <a
                        href={sessionPath(session.slug)}
                        class="group flex items-center gap-4 rounded-lg border border-border bg-page px-4 py-3 no-underline transition hover:border-primary hover:bg-main-faint"
                      >
                        <span class="type-label shrink-0 text-secondary">
                          {String(session.number).padStart(2, '0')}
                        </span>
                        <span class="type-card-title flex-1 group-hover:text-primary">{session.title}</span>
                        <span class="text-lg text-primary" aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))
                }
              </ol>
            </div>
          </section>

          <h2 class="type-label mt-10 text-secondary">Selected workshops</h2>
          <ul class="mt-4 space-y-4">
            <li class="rounded-xl border border-border bg-surface p-5">
              <p class="type-label text-muted">January 2026</p>
              <h2 class="type-card-title mt-1">
                Foundations and GenAI tools of Formative Assessment: Identifying the ‘Why’ and ‘How’
              </h2>
              <p class="mt-2 text-sm text-muted">
                ILTA Symposium · Lembaga Peperiksaan Malaysia · Selangor, Malaysia
              </p>
              <p class="mt-3 text-sm leading-relaxed text-muted">
                Interactive professional development on formative assessment principles, classroom strategies, and
                GenAI-assisted tools for education officers and teachers.
              </p>
            </li>
            <li class="rounded-xl border border-border bg-surface p-5">
              <p class="type-label text-muted">July 2026</p>
              <h2 class="type-card-title mt-1">
                Formative Assessment Frameworks & GenAI
              </h2>
              <p class="mt-2 text-sm text-muted">
                International Training and Testing Centre (ITTC) summer training · Capital Normal University
              </p>
              <div class="mt-4 flex flex-wrap items-center gap-3">
                <a
                  href={studentPath}
                  class="inline-flex rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white no-underline hover:opacity-95"
                >
                  Open workshop
                </a>
                <a
                  href={hostPath}
                  class="inline-flex rounded-full border border-border bg-page px-5 py-2.5 text-sm font-semibold text-ink no-underline hover:bg-surface"
                >
                  Instructor dashboard
                </a>
                <label for="trainingCode" class="sr-only">Enter access code</label>
                <input
                  id="trainingCode"
                  type="text"
                  inputmode="text"
                  autocomplete="off"
                  placeholder="Enter access code"
                  class="w-52 rounded-full border border-border bg-page px-4 py-2 text-sm font-normal text-ink"
                />
                <button
                  id="trainingOpen"
                  type="button"
                  class="rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white no-underline hover:opacity-95"
                >
                  Open with code
                </button>
              </div>
              <p id="trainingHint" class="mt-2 text-xs text-muted" hidden></p>
            </li>
          </ul>
        </div>
        <TeachingSectionAside slot="aside" />
      </MainWithAside>
    </PageShell>
  </main>
  <SiteFooter />

  <script is:inline define:vars={{ studentPath, hostPath }}>
    (function () {
      const input = document.getElementById('trainingCode');
      const btn = document.getElementById('trainingOpen');
      const hint = document.getElementById('trainingHint');
      function open() {
        const code = (input?.value || '').trim().toLowerCase();
        if (code === '202607') {
          window.location.href = studentPath;
          return;
        }
        if (code === '202607host') {
          window.location.href = hostPath;
          return;
        }
        if (hint) {
          hint.hidden = false;
          hint.textContent = 'Unrecognised code.';
          hint.style.color = '#a65d4a';
        }
      }
      btn?.addEventListener('click', open);
      input?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') open();
      });
    })();
  </script>
</BaseLayout>
