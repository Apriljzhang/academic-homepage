---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageShell from '../../components/PageShell.astro';
import SectionSubnav from '../../components/SectionSubnav.astro';
import MainWithAside from '../../components/MainWithAside.astro';
import TeachingSectionAside from '../../components/TeachingSectionAside.astro';
import { teachingSubnav } from '../../data/sectionNav';
import {
  person,
  teachingCoursesMastersCityU,
  teachingCoursesDoctoralCityU,
} from '../../data/cv';

const title = `CityU courses · ${person.fullDisplayName}`;
const description = `Master’s and doctoral courses at City University of Macau — ${person.fullDisplayName}.`;
---

<BaseLayout {title} {description}>
  <SiteHeader />
  <main id="main-content" class="min-h-[50vh] w-full bg-page">
    <PageShell accentBar>
      <h1 class="font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl lg:text-5xl">
        CityU courses
      </h1>
      <MainWithAside asideLabel="Teaching menu" wide>
        <div>
          <SectionSubnav ariaLabel="Teaching section" items={teachingSubnav} />

          <div class="mt-6 grid max-w-4xl gap-8 lg:grid-cols-2 lg:gap-10">
            <div>
              <h3 class="type-label text-secondary">Master’s courses</h3>
              <ul class="mt-3 flex flex-col gap-2">
                {
                  teachingCoursesMastersCityU.map((c) => (
                    <li class="rounded-lg border border-border bg-surface px-3 py-2 text-sm">
                      <span class="font-mono font-semibold text-primary">{c.code}</span>
                      <span class="text-ink"> — {c.name}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div>
              <h3 class="type-label text-secondary">Doctoral courses</h3>
              <ul class="mt-3 flex flex-col gap-2">
                {
                  teachingCoursesDoctoralCityU.map((c) => (
                    <li class="rounded-lg border border-border bg-surface px-3 py-2 text-sm">
                      <span class="font-mono font-semibold text-primary">{c.code}</span>
                      <span class="text-ink"> — {c.name}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

        </div>
        <TeachingSectionAside slot="aside" />
      </MainWithAside>
    </PageShell>
  </main>
  <SiteFooter />
</BaseLayout>
